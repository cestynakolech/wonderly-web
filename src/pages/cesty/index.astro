---
import CestyLayout from '../../layouts/CestyLayout.astro';
import { roky } from '../../data/cesty/roky';
import { MAPA_SIRKA, MAPA_VYSKA } from '../../data/cesty/mapa';
---

<CestyLayout titulek="Cesty na kolech – Wonderly">
	<h1>Cesty na kolech</h1>
	<p>
		Cestovatelský deník z cyklovýprav po Evropě. Vyber rok na mapě nebo tlačítkem a podívej se,
		kudy jsme jeli.
	</p>
	<ul class="tlacitka">
		{
			roky.map((r) => (
				<li>
					<a href={`/cesty/${r.rok}`}>{r.rok} – {r.zeme}</a>
				</li>
			))
		}
		<li><a href="/cesty/vse">Všechna místa</a></li>
	</ul>
	<svg class="mapa" viewBox={`0 0 ${MAPA_SIRKA} ${MAPA_VYSKA}`} role="img" aria-label="Mapa Evropy s roky výprav">
		<image href="/cesty/mapa-evropa.svg" width={MAPA_SIRKA} height={MAPA_VYSKA} />
		{
			roky.map((r) => (
				<a href={`/cesty/${r.rok}`}>
					<circle class="pin" cx={r.pinEvropa.x} cy={r.pinEvropa.y} r="7" stroke-width="2" />
					<text class="pin-popisek" x={r.pinEvropa.x} y={r.pinEvropa.y - 12} text-anchor="middle" font-size="16" stroke-width="3">
						{r.rok}
					</text>
				</a>
			))
		}
	</svg>
	<footer>
		Mapový podklad:
		<a
			href="https://commons.wikimedia.org/wiki/File:Blank_map_of_Europe_(with_disputed_regions).svg"
			rel="license noopener"
			>Blank map of Europe</a
		>, autor maix (Wikimedia Commons), licence
		<a href="https://creativecommons.org/licenses/by-sa/3.0/" rel="license noopener">CC BY-SA 3.0</a>
		– upraveno (přidány piny).
	</footer>
</CestyLayout>
