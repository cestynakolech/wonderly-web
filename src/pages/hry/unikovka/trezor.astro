---
import SkolaLayout from '../../../layouts/SkolaLayout.astro';
import { createHash } from 'node:crypto';
import { TAJNY_KOD } from '../../../data/hry';

// ve zdrojáku stránky je jen otisk — kód nejde vykoukat přes „zobrazit zdroj"
const OTISK = createHash('sha256').update(TAJNY_KOD).digest('hex');
---

<SkolaLayout titulek="Trezor — úniková laborka">
	<div id="trezor" data-otisk={OTISK}>
		<h1><span class="podtrh">🧰 TREZOR</span></h1>
		<div id="zadani">
			<p class="pokyn">Zadejte tajný kód — číslice ve správném pořadí podle stanovišť:</p>
			<input id="kod" inputmode="numeric" maxlength="6" placeholder="______" autocomplete="off" />
			<button id="otevrit" class="velke-tlacitko">Otevřít trezor 🔓</button>
			<p id="zprava" class="zprava" hidden></p>
		</div>
		<div id="vitezstvi" hidden>
			<div class="oslava">🎉🔓🎉</div>
			<h2>TREZOR OTEVŘEN!</h2>
			<p id="cas" class="cas"></p>
			<p>Běžte se zapsat k učiteli — a gratulujeme, fyzikové!</p>
		</div>
	</div>
</SkolaLayout>

<script>
	const koren = document.getElementById('trezor');
	const OTISK = koren.dataset.otisk;
	const $ = (id) => document.getElementById(id);
	let zamek = 0;

	async function otisk(text) {
		const data = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
		return [...new Uint8Array(data)].map((b) => b.toString(16).padStart(2, '0')).join('');
	}

	$('otevrit').addEventListener('click', async () => {
		if (Date.now() < zamek) return;
		const pokus = $('kod').value.trim();
		if ((await otisk(pokus)) === OTISK) {
			$('zadani').hidden = true;
			$('vitezstvi').hidden = false;
			const start = +localStorage.getItem('unikovka-start');
			if (start) {
				const vteriny = Math.round((Date.now() - start) / 1000);
				$('cas').textContent = `Váš čas: ${Math.floor(vteriny / 60)} min ${vteriny % 60} s`;
			}
			localStorage.removeItem('unikovka-start');
		} else {
			zamek = Date.now() + 30_000;
			$('zprava').hidden = false;
			let zbyva = 30;
			$('zprava').textContent = `🚨 Špatný kód! Trezor se zamkl na ${zbyva} vteřin.`;
			const id = setInterval(() => {
				zbyva--;
				if (zbyva <= 0) {
					clearInterval(id);
					$('zprava').textContent = 'Trezor je zase připraven — zkontrolujte pořadí číslic!';
					return;
				}
				$('zprava').textContent = `🚨 Špatný kód! Trezor se zamkl na ${zbyva} vteřin.`;
			}, 1000);
		}
	});
</script>

<style>
	#trezor { max-width: 520px; margin: 0 auto; text-align: center; }
	.pokyn { font-size: 1.15rem; font-weight: 700; }
	#kod { font-size: 3rem; letter-spacing: 0.8rem; width: 100%; max-width: 20rem; text-align: center;
		border: 4px solid #333; border-radius: 14px; padding: 0.4rem; }
	.velke-tlacitko { display: block; margin: 1rem auto; font-size: 1.3rem; padding: 0.7rem 2rem;
		border-radius: 12px; border: 3px solid #333; background: #ffe066; cursor: pointer; font-weight: 800; }
	.zprava { font-size: 1.1rem; font-weight: 700; color: #d9480f; }
	.oslava { font-size: 3.5rem; }
	.cas { font-size: 1.6rem; font-weight: 800; }
</style>
