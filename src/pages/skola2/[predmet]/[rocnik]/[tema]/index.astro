---
import SkolaLayout from '../../../../../layouts/SkolaLayout.astro';
import { predmety, rocniky } from '../../../../../data/predmety';
import { temata } from '../../../../../data/temata';

export function getStaticPaths() {
	const paths = [];
	for (const [klic, seznam] of Object.entries(temata)) {
		const [predmetSlug, rocnikSlug] = klic.split('/');
		const predmet = predmety.find((p) => p.slug === predmetSlug);
		const rocnik = rocniky.find((r) => r.slug === rocnikSlug);
		for (const tema of seznam) {
			paths.push({
				params: { predmet: predmetSlug, rocnik: rocnikSlug, tema: tema.slug },
				props: { predmet, rocnik, tema },
			});
		}
	}
	return paths;
}

const { predmet, rocnik, tema } = Astro.props;
---

<SkolaLayout
	titulek={`${tema.nazev} – ${predmet.nazev} ${rocnik.nazev} – Wonderly`}
	drobky={[
		{ text: '2. stupeň', href: '../../../' },
		{ text: predmet.nazev, href: '../../' },
		{ text: rocnik.nazev, href: '../' },
	]}
>
	<h1><span class="podtrh">{tema.nazev}</span></h1>
	{
		tema.podtemata && tema.podtemata.length > 0 ? (
			<>
				<p class="uvodni-text">Vyber si podtéma.</p>
				<ul class="karty">
					{tema.podtemata.map((pt, i) => (
						<li>
							<a class="karta" href={`${pt.slug}/`}>
								<span class="cislo">{i + 1}</span>
								<span class="nazev">{pt.nazev}</span>
							</a>
						</li>
					))}
				</ul>
			</>
		) : (
			<p class="uvodni-text">Obsah připravujeme.</p>
		)
	}
</SkolaLayout>
