---
import CestyLayout from '../../layouts/CestyLayout.astro';
import type { Jazyk, Rok } from '../../data/cesty/typy';
import { MAPA_SIRKA, MAPA_VYSKA, rozmistiPopisky, spocitejVyrez } from '../../data/cesty/mapa';
import { TEXTY, cestaCesty, formatujDatum, prelozPopis, prelozZemi } from '../../data/cesty/preklady';

interface Props {
	data: Rok;
	jazyk: Jazyk;
}

const { data, jazyk } = Astro.props;
const t = TEXTY[jazyk];

const vyrez = data.vyrez ?? spocitejVyrez(data.mesta);
// Velikost pinů a písma se škáluje s výřezem, aby na obrazovce vypadaly vždy stejně
const pinR = vyrez.sirka / 45;
const pismo = vyrez.sirka / 30;

const videaPodleId = new Map(data.videa.map((v) => [v.id, v]));
// Popisky se rozmisťují tak, aby se nepřekrývaly; co se nevejde, sloučí se do „N míst"
const popisky = rozmistiPopisky(data.mesta, pinR, pismo, vyrez);
---

<CestyLayout titulek={`${t.nadpis} ${data.rok} – Wonderly`} jazyk={jazyk} podcesta={String(data.rok)}>
	<p><a href={cestaCesty(jazyk)}>&larr; {t.vsechnyRoky}</a></p>
	<h1>{data.rok} – {prelozZemi(data.zeme, jazyk)}</h1>
	<svg
		class="mapa"
		viewBox={`${vyrez.x} ${vyrez.y} ${vyrez.sirka} ${vyrez.vyska}`}
		role="img"
		aria-label={`${t.mapaRoku} ${data.rok}`}
	>
		<image href="/cesty/mapa-evropa.svg" width={MAPA_SIRKA} height={MAPA_VYSKA} />
		{
			data.mesta.map((m) => (
				<a href={`#${m.slug}`}>
					<circle class="pin" cx={m.x} cy={m.y} r={pinR} stroke-width={pinR / 3.5} />
				</a>
			))
		}
		{
			popisky.map((p) => {
				const text = (
					<text
						class={p.shluk ? 'pin-popisek pin-shluk' : 'pin-popisek'}
						x={p.x}
						y={p.y}
						text-anchor={p.kotva}
						font-size={p.fs}
						stroke-width={pismo / 5}
					>
						{p.text}
					</text>
				);
				return p.slug ? <a href={`#${p.slug}`}>{text}</a> : text;
			})
		}
	</svg>
	<section class="mesta">
		{
			data.mesta.map((m) => {
				const video = m.videoId ? videaPodleId.get(m.videoId) : undefined;
				return (
					<article id={m.slug}>
						<h2>{m.nazev}</h2>
						<p class="meta">
							{prelozZemi(m.zeme, jazyk)} · {formatujDatum(m.datum, jazyk)}
						</p>
						<p>{prelozPopis(m.popis, jazyk)}</p>
						{video && (
							<p>
								<a href={video.odkaz} rel="noopener">
									🎬 {video.nazev}
								</a>
							</p>
						)}
						{m.report && (
							<details class="bertik-report">
								<summary>{t.bertikReport}</summary>
								{m.report
									.split('\n')
									.map((odstavec) => odstavec.trim())
									.filter(Boolean)
									.map((odstavec) => (
										<p>{odstavec}</p>
									))}
							</details>
						)}
						{m.galerie && (
							<div class="galerie" data-slozka={m.galerie}>
								<p class="galerie-nacitani">Načítám fotky…</p>
							</div>
						)}
						{m.stellplatze && m.stellplatze.length > 0 && (
							<>
								<h3>Stellplatz</h3>
								<ul>
									{m.stellplatze.map((s) => (
										<li>
											{s.odkaz ? <a href={s.odkaz} rel="noopener">{s.nazev}</a> : s.nazev}
											{s.poznamka && ` – ${s.poznamka}`}
										</li>
									))}
								</ul>
							</>
						)}
					</article>
				);
			})
		}
	</section>
</CestyLayout>

<script is:inline>
	// fotogalerie: seznam fotek se načte z úložiště přes /media/seznam,
	// zobrazí se náhledy a kliknutím se otevře fotka v plné velikosti
	for (const galerie of document.querySelectorAll('.galerie')) {
		const slozka = galerie.dataset.slozka;
		fetch(`/media/seznam?slozka=${encodeURIComponent(slozka)}`)
			.then((odpoved) => odpoved.json())
			.then((soubory) => {
				const originaly = soubory.filter((s) => !s.includes('/nahledy/'));
				galerie.innerHTML = '';
				if (originaly.length === 0) return;
				for (const original of originaly) {
					const nazev = original.split('/').pop();
					const nahled = `${slozka}/nahledy/${nazev.replace(/\.[^.]+$/, '.jpg')}`;
					const odkaz = document.createElement('a');
					odkaz.href = `/media/${original}`;
					odkaz.target = '_blank';
					odkaz.rel = 'noopener';
					const obrazek = document.createElement('img');
					obrazek.src = `/media/${nahled}`;
					obrazek.loading = 'lazy';
					obrazek.alt = nazev;
					odkaz.appendChild(obrazek);
					galerie.appendChild(odkaz);
				}
			})
			.catch(() => {
				galerie.innerHTML = '';
			});
	}
</script>

<style is:global>
	.galerie {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 8px;
		margin: 1rem 0;
	}
	.galerie img {
		width: 100%;
		height: 110px;
		object-fit: cover;
		border-radius: 8px;
		display: block;
		transition: transform 0.15s ease;
	}
	.galerie img:hover {
		transform: scale(1.04);
	}
	.galerie-nacitani {
		color: var(--ztlumeny);
		font-size: 0.9rem;
	}
	.bertik-report {
		margin: 1rem 0;
		padding: 0.6rem 1rem;
		border: 1px dashed var(--ztlumeny, #999);
		border-radius: 10px;
	}
	.bertik-report summary {
		cursor: pointer;
		font-weight: bold;
	}
	.bertik-report p {
		margin: 0.6rem 0;
	}
</style>
