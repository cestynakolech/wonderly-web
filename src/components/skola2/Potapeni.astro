---
// F6 Potápění: Těžký diver v hlubokých vodách — tlak narůstá s hloubkou
// Hydraulické přítlaky, dekompresi (vzdušniny), limity ponoru
// Interaktivní: hloubka → tlak, času bezpečnosti
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Potápění: Tlak v hloubkách 🕹️</span></h2>
	<p>Potápěč je vystavený obrovským tlakům. Pokud je tlak příliš velký, nebo příliš dlouho v hloubce, hrozí <strong>dekompresi</strong> (vzdušniny v těle) a další nebezpečí. Vzorec: <strong>p = p₀ + ρ·g·h</strong> (atmosférický tlak + hydrostatický).</p>
	
	<svg id="potapeni-svg" viewBox="0 0 500 450" role="img" aria-label="Potápění: tlak a bezpečnost v hloubkách">
		<!-- moře -->
		<defs>
			<linearGradient id="okeánGradient" x1="0%" y1="0%" x2="0%" y2="100%">
				<stop offset="0%" style="stop-color:#4da6ff;stop-opacity:0.7" />
				<stop offset="100%" style="stop-color:#001a4d;stop-opacity:0.9" />
			</linearGradient>
		</defs>
		<rect x="40" y="60" width="420" height="380" fill="url(#okeánGradient)" stroke="#2b2a26" stroke-width="3" />
		<line x1="40" y1="60" x2="460" y2="60" stroke="#2b2a26" stroke-width="3" />
		<text x="35" y="55" font-size="12" font-weight="bold" fill="#1971c2">povrch</text>
		
		<!-- měřítko hloubky (vlevo) -->
		<line x1="20" y1="60" x2="20" y2="440" stroke="#2b2a26" stroke-width="2" />
		<text x="10" y="65" text-anchor="end" font-size="11" fill="#2b2a26">0 m</text>
		<text x="10" y="250" text-anchor="end" font-size="11" fill="#2b2a26">20 m</text>
		<text x="10" y="435" text-anchor="end" font-size="11" fill="#2b2a26">40 m</text>
		
		<!-- potápěč na třech hloubkách -->
		<g id="potapeni-potapec1">
			<circle cx="200" cy="100" r="12" fill="#ff6b6b" stroke="#2b2a26" stroke-width="2" />
			<line x1="200" y1="112" x2="200" y2="135" stroke="#2b2a26" stroke-width="2" />
			<text x="250" y="110" font-size="12" font-weight="bold" fill="#2b2a26">0 m: Bezpečné</text>
		</g>
		
		<g id="potapeni-potapec2">
			<circle cx="200" cy="220" r="12" fill="#ffcc00" stroke="#2b2a26" stroke-width="2" />
			<line x1="200" y1="232" x2="200" y2="255" stroke="#2b2a26" stroke-width="2" />
			<text x="250" y="230" font-size="12" font-weight="bold" fill="#2b2a26">20 m: Opatrně</text>
		</g>
		
		<g id="potapeni-potapec3">
			<circle cx="200" cy="340" r="12" fill="#e03131" stroke="#2b2a26" stroke-width="2" />
			<line x1="200" y1="352" x2="200" y2="375" stroke="#2b2a26" stroke-width="2" />
			<text x="250" y="350" font-size="12" font-weight="bold" fill="#2b2a26">40 m: Velmi nebezpečné</text>
		</g>
		
		<!-- tlak v bublinách (vpravo) -->
		<g id="potapeni-tlak1">
			<rect x="360" y="85" width="90" height="50" fill="#90ee90" opacity="0.8" stroke="#2b2a26" stroke-width="2" rx="5" />
			<text x="405" y="110" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">p = 101 kPa</text>
		</g>
		
		<g id="potapeni-tlak2">
			<rect x="360" y="205" width="90" height="50" fill="#ffeb99" opacity="0.8" stroke="#2b2a26" stroke-width="2" rx="5" />
			<text x="405" y="230" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">p = 301 kPa</text>
		</g>
		
		<g id="potapeni-tlak3">
			<rect x="360" y="325" width="90" height="50" fill="#ff9999" opacity="0.8" stroke="#2b2a26" stroke-width="2" rx="5" />
			<text x="405" y="350" text-anchor="middle" font-size="13" font-weight="bold" fill="#fff">p = 501 kPa</text>
		</g>
	</svg>
	
	<label class="sim-posuvnik">
		Hloubka: <output id="potapeni-out-h"></output> metrů
		<input type="range" id="potapeni-slider-h" min="0" max="40" step="2" value="0" />
	</label>
	
	<div id="potapeni-vypocet" style="background: #f1f3f5; border-radius: 8px; padding: 0.7rem; margin-top: 1rem; font-weight: 700;">
		<p style="margin: 0;"><strong>Vzorec:</strong> p = p₀ + ρ·g·h = 101 + 100·h (kPa)</p>
		<p id="potapeni-result" style="margin: 0.5rem 0 0 0; color: #1971c2;"></p>
		<p id="potapeni-bezpecnost" style="margin: 0.5rem 0 0 0; font-size: 0.95rem; color: #666;"></p>
	</div>
</section>

<script>
	const sliderH = document.getElementById('potapeni-slider-h');
	const outH = document.getElementById('potapeni-out-h');
	const resultEl = document.getElementById('potapeni-result');
	const bezpecnostEl = document.getElementById('potapeni-bezpecnost');
	
	const p0 = 101; // atmosférický tlak (kPa)
	const rho_g = 100; // ρ·g = 1000 × 10 = 10000 Pa = 100 kPa (za 10 m)
	
	function prekresli() {
		const h = +sliderH.value;
		const p = p0 + rho_g * (h / 10); // celkový tlak v kPa
		
		outH.textContent = h;
		
		resultEl.textContent = `Celkový tlak: p = 101 + 100 × ${(h/10).toFixed(1)} = ${p.toFixed(0)} kPa ≈ ${(p / 101).toFixed(1)}× atmosféry`;
		
		// Bezpečnost
		let bezpecnost = '';
		let zprava = '';
		if (h <= 12) {
			bezpecnost = '✅ BEZPEČNÉ — Rekreační potápěči obvykle zůstávají do 12 m.';
			zprava = 'Čas bez problémů: ~60 minut';
		} else if (h <= 25) {
			bezpecnost = '⚠️ OPATRNĚ — Prohloubená potápění. Nutna specifikovaná příprava.';
			zprava = 'Čas bez problémů: ~20 minut (pak hrozí dekomprese)';
		} else if (h <= 40) {
			bezpecnost = '🚨 VELMI NEBEZPEČNÉ — Technické potápění, riziko nitrogen narkoze.';
			zprava = 'Čas bez problémů: <10 minut (dlouhá dekompresi)';
		} else {
			bezpecnost = '💀 EXTRÉMNÍ — Zásadně bez speciálního vybavení a proškolení!';
			zprava = 'Dekompresi může trvat hodiny.';
		}
		
		bezpecnostEl.textContent = `${bezpecnost} ${zprava}`;
		
		// Vizuální změna (barva pozadí podle hloubky)
		const intenzita = Math.min(1, h / 30);
		document.getElementById('potapeni-svg').style.opacity = 0.9 + intenzita * 0.1;
	}
	
	sliderH.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#potapeni-svg { width: 100%; max-width: 500px; border: 3px solid #2b2a26; border-radius: 12px; background: #f0f0f0; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 500px; display: block; margin-top: 0.3rem; }
</style>
