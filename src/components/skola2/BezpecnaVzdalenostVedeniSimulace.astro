---
// Bezpečnost u elektrického vedení (F9, elektricka-energie-a-bezpecnost/
// ucinky-proudu-bezpecnost). PŘEPRACOVÁNO 22. 8. 2026 — původní verze měla
// šest tříd napětí s "bezpečnou vzdáleností" 7/10/12/15/20/25 m. Tato čísla
// se programovým prohledáním všech PDF 9. ročníku i elektřiny 8. ročníku
// NENAŠLA v ŽÁDNÉM podkladu učitele — byla vymyšlená a smazána (feedback
// "kontrolovat-spravnost-textu"). Zdroj pravdy je PDF "16 Účinky proudu na
// lidský organismus. Bezpečnost při práci s elektrickými zařízeními" (9. roč.,
// /Users/Shared/Škola/9/1 Elektřina/16 …/16. …pdf).
//
// Co PDF SKUTEČNĚ říká (str. 4, doslovně):
//   "Nedotýkáme se nosných elektrických stožárů elektrického vedení ani
//    drátů spadlých na zem."
//   "Nejvyšší bezpečná hodnota stejnosměrného napětí podle normy je 25 V
//    a střídavého napětí 12 V."
// A (str. 3, doslovně):
//   "Vysoká napětí způsobují tepelná poškození, v tomto případě nemusí
//    dojít ani k fyzickému kontaktu vodiče a organismu, protože může
//    vzniknout na větší vzdálenost elektrický oblouk, např. při blesku."
// A (str. 5, první pomoc, doslovně):
//   "zraněného oddělíme od vodičů izolujícím předmětem… Nikdy se zraněného
//    ani jeho oděvu nedotýkáme holou rukou, dokud není zraněný mimo dosah
//    elektrického proudu."
//
// Nová simulace má DVA nezávislé posuvníky, oba jen s ÚDAJI Z PDF:
//   1) situace u vedení (4 stavy) — žádné metry, jen kvalitativní odstup
//      (daleko / blízko bez dotyku / dotyk stožáru / dotyk spadlého drátu).
//      Stav "blízko bez dotyku" je STÁLE nebezpečný (oblouk může přeskočit
//      vzduchem i bez dotyku, str. 3) — nevzniká dojem, že stačí "kousek dál".
//   2) napětí zdroje, kterého se osoba dotýká holou rukou (12 V / 25 V /
//      230 V) — přímo testuje hranici bezpečného napětí z normy (str. 4).
// Statická scéna beze smyčky requestAnimationFrame — vykresluje se znovu při
// každé změně posuvníku (čistá funkce stavu).
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Bezpečnost u elektrického vedení ⚡🕹️</span></h2>
	<p>
		U elektrického vedení nerozhoduje jen <strong>dotyk</strong> — u vysokého
		napětí umí proud <strong>přeskočit vzduchem obloukem</strong>, i když se
		vedení vůbec nedotkneš. Vyzkoušej, které chování je bezpečné, a pak zkus,
		jaké napětí smíš bez rizika chytit holou rukou.
	</p>

	<svg id="bvv-svg" viewBox="0 0 640 320" role="img" aria-label="Vlevo stožár elektrického vedení se spadlým drátem a postava v různých situacích, vpravo zdroj napětí a ruka, která se ho dotýká">
		<rect x="0" y="0" width="640" height="320" fill="#eef6ff" />
		<rect x="0" y="255" width="640" height="65" fill="#d8f5a2" />
		<line x1="0" y1="255" x2="640" y2="255" stroke="#2b2a26" stroke-width="3" />
		<line x1="382" y1="10" x2="382" y2="310" stroke="#adb5bd" stroke-width="2" stroke-dasharray="4,4" />
		<g id="bvv-stozar"></g>
		<g id="bvv-oblouk"></g>
		<g id="bvv-postava"></g>
		<g id="bvv-popisky"></g>
		<g id="bvv-zdroj"></g>
	</svg>

	<label class="sim-posuvnik">
		Situace u vedení: <output id="bvv-out-situace"></output>
		<input type="range" id="bvv-situace" min="0" max="3" step="1" value="0" />
	</label>
	<label class="sim-posuvnik">
		Napětí zdroje, kterého se dotýkám rukou: <output id="bvv-out-napeti"></output>
		<input type="range" id="bvv-napeti" min="0" max="2" step="1" value="0" />
	</label>

	<p class="bvv-stav" id="bvv-stav"></p>
	<p class="bvv-stav" id="bvv-stav-napeti"></p>

	<p class="bvv-poznamka">
		Když se někdo sám nemůže od vodiče odtrhnout: nejdřív vypni proud
		(vypínač, jistič), a pokud to nejde, odděl ho <strong>izolující tyčí</strong>
		(dřevo, plast) — nikdy se ho ani jeho oděvu <strong>nedotýkej holou rukou</strong>,
		dokud není mimo dosah proudu. Pak volej 155.
	</p>
</section>

<script>
	function platnyIndex(hodnota, max, vychozi) {
		const n = Math.round(Number(hodnota));
		return Number.isInteger(n) && n >= 0 && n <= max ? n : vychozi;
	}

	const VIEW_W = 640, VIEW_H = 320, OKRAJ = 6;

	// 4 situace u vedení — POPIS je opsaný z PDF (str. 3 a 4), žádné metry.
	const SITUACE = [
		{ nazev: 'daleko od vedení', bezpecno: true, x: 60, dotykStozar: false, dotykDrat: false,
			text: 'Postava stojí daleko od vedení — bezpečno.' },
		{ nazev: 'blízko vedení, bez dotyku', bezpecno: false, x: 200, dotykStozar: false, dotykDrat: false,
			text: 'Pozor: i bez dotyku hrozí riziko — u vysokého napětí může proud přeskočit vzduchem obloukem („nemusí dojít ani k fyzickému kontaktu vodiče a organismu, protože může vzniknout na větší vzdálenost elektrický oblouk“). Drž se daleko.' },
		{ nazev: 'dotýká se stožáru', bezpecno: false, x: 322, dotykStozar: true, dotykDrat: false,
			text: 'Nebezpečno — PDF přímo zakazuje: „Nedotýkáme se nosných elektrických stožárů elektrického vedení ani drátů spadlých na zem.“' },
		{ nazev: 'dotýká se spadlého drátu na zemi', bezpecno: false, x: 150, dotykStozar: false, dotykDrat: true,
			text: 'Nebezpečno — PDF přímo zakazuje: „Nedotýkáme se nosných elektrických stožárů elektrického vedení ani drátů spadlých na zem.“' },
	];

	// Bezpečné napětí PODLE NORMY (PDF str. 4): stejnosměrné do 25 V,
	// střídavé do 12 V. 230 V ze zásuvky je mnohonásobně nad hranicí.
	const NAPETI = [
		{ popis: '12 V (bezpečné střídavé napětí podle normy)', bezpecne: true },
		{ popis: '25 V (bezpečné stejnosměrné napětí podle normy)', bezpecne: true },
		{ popis: '230 V ze zásuvky (vysoko nad bezpečnou hranicí)', bezpecne: false },
	];

	const STOZAR_X = 330;

	function plaketa(textX, textY, text, barva) {
		const sirka = String(text).length * 7 + 8;
		const rectX = Math.max(OKRAJ, Math.min(VIEW_W - OKRAJ - sirka, textX - sirka / 2));
		const rectY = Math.max(OKRAJ, Math.min(VIEW_H - OKRAJ - 18, textY - 14));
		return `<rect x="${rectX.toFixed(1)}" y="${rectY.toFixed(1)}" width="${sirka}" height="18" rx="4" fill="#ffffff" stroke="${barva}" stroke-width="1.5" />`
			+ `<text x="${(rectX + sirka / 2).toFixed(1)}" y="${(rectY + 14).toFixed(1)}" text-anchor="middle" font-size="11" font-weight="bold" fill="${barva}">${text}</text>`;
	}

	function stozarHtml() {
		const x = STOZAR_X;
		let s = '';
		s += `<line x1="${x}" y1="255" x2="${x}" y2="60" stroke="#495057" stroke-width="6" />`;
		s += `<line x1="${x - 40}" y1="90" x2="${x + 40}" y2="90" stroke="#495057" stroke-width="5" />`;
		s += `<line x1="${x - 26}" y1="255" x2="${x}" y2="90" stroke="#868e96" stroke-width="3" />`;
		s += `<line x1="${x + 26}" y1="255" x2="${x}" y2="90" stroke="#868e96" stroke-width="3" />`;
		// dráty visící ze stožáru, vedou k levému okraji panelu
		s += `<path d="M10,${100} Q${x - 150},70 ${x - 40},90" fill="none" stroke="#2b2a26" stroke-width="2" />`;
		s += `<path d="M10,${120} Q${x - 150},95 ${x + 40},90" fill="none" stroke="#2b2a26" stroke-width="2" />`;
		return s;
	}

	// spadlý drát ležící na zemi od paty stožáru směrem doleva
	function spadlyDratHtml() {
		return `<path d="M${STOZAR_X - 26},255 Q${STOZAR_X - 90},262 ${STOZAR_X - 165},254" fill="none" stroke="#2b2a26" stroke-width="3" />`;
	}

	function postavaHtml(x, barva) {
		let s = '';
		s += `<circle cx="${x}" cy="228" r="9" fill="${barva}" stroke="#2b2a26" stroke-width="2.5" />`;
		s += `<line x1="${x}" y1="237" x2="${x}" y2="255" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${x}" y1="241" x2="${x - 9}" y2="255" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${x}" y1="241" x2="${x + 9}" y2="255" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${x}" y1="243" x2="${x - 8}" y2="234" stroke="#2b2a26" stroke-width="3" />`;
		s += `<line x1="${x}" y1="243" x2="${x + 8}" y2="234" stroke="#2b2a26" stroke-width="3" />`;
		return s;
	}

	function obloukPath(x1, y1, x2, y2) {
		const dy = y2 - y1;
		const kroky = 6;
		let d = `M${x1.toFixed(1)},${y1.toFixed(1)}`;
		for (let i = 1; i < kroky; i++) {
			const t = i / kroky;
			const vychylka = i % 2 === 0 ? 9 : -9;
			const px = x1 + vychylka;
			const py = y1 + dy * t;
			d += ` L${px.toFixed(1)},${py.toFixed(1)}`;
		}
		d += ` L${x2.toFixed(1)},${y2.toFixed(1)}`;
		return d;
	}

	// pravý panel: zdroj napětí + ruka, která se ho dotýká
	function zdrojHtml(napeti) {
		const cx = 500;
		let s = '';
		s += `<rect x="${cx - 40}" y="150" width="80" height="45" rx="6" fill="#495057" />`;
		s += `<line x1="${cx - 40}" y1="172" x2="${cx - 60}" y2="172" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${cx + 40}" y1="172" x2="${cx + 60}" y2="172" stroke="#2b2a26" stroke-width="4" />`;
		// ruka drží oba konce zdroje
		s += `<circle cx="${cx - 68}" cy="172" r="10" fill="#ffd8a8" stroke="#2b2a26" stroke-width="2" />`;
		s += `<circle cx="${cx + 68}" cy="172" r="10" fill="#ffd8a8" stroke="#2b2a26" stroke-width="2" />`;
		s += plaketa(cx, 130, napeti.popis, napeti.bezpecne ? '#2f9e44' : '#e03131');
		s += plaketa(cx, 210, napeti.bezpecne ? 'bezpečné dotknout se' : 'NEBEZPEČNÉ', napeti.bezpecne ? '#2f9e44' : '#e03131');
		if (!napeti.bezpecne) {
			s += `<path d="${obloukPath(cx - 68, 172, cx - 68, 200)}" fill="none" stroke="#f59f00" stroke-width="3" stroke-linecap="round" />`;
		}
		return s;
	}

	const sliderSituace = document.getElementById('bvv-situace');
	const sliderNapeti = document.getElementById('bvv-napeti');
	const outSituace = document.getElementById('bvv-out-situace');
	const outNapeti = document.getElementById('bvv-out-napeti');

	document.getElementById('bvv-stozar').innerHTML = stozarHtml() + spadlyDratHtml();

	function prekresli() {
		const iS = platnyIndex(sliderSituace.value, SITUACE.length - 1, 0);
		const iN = platnyIndex(sliderNapeti.value, NAPETI.length - 1, 0);
		const situace = SITUACE[iS];
		const napeti = NAPETI[iN];

		outSituace.textContent = situace.nazev;
		outNapeti.textContent = napeti.popis;

		const barva = situace.bezpecno ? '#4dabf7' : '#ff8787';
		document.getElementById('bvv-postava').innerHTML = postavaHtml(situace.x, barva)
			+ plaketa(situace.x, 205, situace.bezpecno ? 'bezpečno' : 'nebezpečno', situace.bezpecno ? '#2f9e44' : '#e03131');

		document.getElementById('bvv-oblouk').innerHTML = situace.bezpecno
			? ''
			: `<path d="${obloukPath(situace.x, 100, situace.x, 218)}" fill="none" stroke="#f59f00" stroke-width="3" stroke-linecap="round" />`;

		document.getElementById('bvv-popisky').innerHTML = plaketa(STOZAR_X, 40, 'vedení vysokého napětí', '#2b2a26');

		document.getElementById('bvv-zdroj').innerHTML = zdrojHtml(napeti);

		document.getElementById('bvv-stav').textContent = situace.text;
		document.getElementById('bvv-stav-napeti').textContent = napeti.bezpecne
			? `${napeti.popis} — proud může touto cestou téct, ale je pod bezpečnou hranicí normy, dotyk holou rukou nehrozí.`
			: `${napeti.popis} — takové napětí je vysoko nad bezpečnou hranicí normy (25 V ss / 12 V st), holou rukou se ho NIKDY nedotýkej.`;
	}

	sliderSituace.addEventListener('input', prekresli);
	sliderNapeti.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#bvv-svg { width: 100%; max-width: 640px; border: 3px solid #2b2a26; border-radius: 12px; background: #eef6ff; margin-bottom: 0.6rem; display: block; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 640px; display: block; margin-top: 0.3rem; }
	.bvv-stav { font-size: 1.02rem; font-weight: 700; min-height: 1.4rem; }
	.bvv-poznamka { font-size: 0.9rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; margin-top: 0.6rem; }
</style>
