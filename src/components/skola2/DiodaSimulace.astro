---
// Dioda a přechod PN (F9, podtéma „Polovodiče typu N a P, dioda"). Dva stavy
// přepínané tlačítky: PROPUSTNÝ směr (typ N na −, typ P na +: hradlová vrstva
// se zužuje, proud prochází, LED svítí) a ZÁVĚRNÝ směr (typ N na +, typ P na −:
// nositelé náboje na okrajích, hradlová vrstva se rozšiřuje, proud neprochází).
// Scéna je čistě KVALITATIVNÍ — výklad nemá práh diody, rezistor ani proud
// v mA, proto tu žádné číslo napětí ani proudu není (do 30. 9. 2026 tu byl
// posuvník −5…+5 V, práh 2 V, 200 Ω a V-A charakteristika — nález kontrolora).
// Šipky jsou v celé smyčce souhlasné:
//   · oranžová = DOHODNUTÝ SMĚR PROUDU (výklad F8: „od + k −, elektrony se
//     pohybují opačně"): od + přes typ P do typu N a k −; totéž ukazuje šipka
//     ve značce diody (výklad: „šipka ukazuje směr, kterým proud smí procházet"),
//   · červená = pohyb nositele náboje: elektron proti proudu (od − do N, přes P
//     ke +), díra ve směru proudu (výklad: „díry se posunují opačným směrem").
// Legenda i barvy jako obrázky téže stránky (obr-02/04/05/06): elektron modrý
// kroužek „−", díra zelený čárkovaný kroužek „+", typ N růžový, typ P béžový.
// Mobil: scéna je úzká (viewBox šířky 360) a všechna písma mají 19 jednotek —
// na telefonu 360 px je scéna ~235 px široká, 19 · 235 / 360 = 12,4 px ≥ 12 px.
// Stav je čistá funkce stavDiody(smer) zavěšená na SVG (__stavDiody), test
// testy/simulace/dioda.mjs ji proměří i s tím, co se opravdu nakreslí.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Dioda — proud jen jedním směrem 🕹️</span></h2>
	<p>Přechod <strong>PN</strong> je srdce diody. Přepínej zapojení zdroje: v <strong>propustném směru</strong> (typ N na −, typ P na +) se hradlová vrstva <strong>zužuje</strong>, proud prochází a LED svítí. V <strong>závěrném směru</strong> (typ N na +, typ P na −) se hradlová vrstva <strong>rozšiřuje</strong> a proud neprochází.</p>
	<p>
		<button type="button" class="dioda-tl dioda-aktivni" id="dioda-tl-propustny" aria-pressed="true">➡️ propustný směr</button>
		<button type="button" class="dioda-tl" id="dioda-tl-zaverny" aria-pressed="false">⛔ závěrný směr</button>
	</p>
	<svg id="dioda-svg" viewBox="0 0 360 516" role="img" aria-label="Zvětšená LED dioda zapojená v propustném směru">
		<defs>
			<marker id="dioda-m-cer" markerUnits="userSpaceOnUse" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto"><path d="M0,0 L12,6 L0,12 z" fill="#e03131" /></marker>
			<marker id="dioda-m-ora" markerUnits="userSpaceOnUse" markerWidth="18" markerHeight="18" refX="15" refY="9" orient="auto"><path d="M0,0 L18,9 L0,18 z" fill="#e8590c" /></marker>
		</defs>
		<!-- popisek scény v rohu, nad vodiči i nositeli náboje -->
		<text x="8" y="24" font-size="19" font-weight="bold" fill="#495057">zvětšená LED dioda</text>
		<text x="352" y="24" text-anchor="end" font-size="19" font-weight="bold" fill="#2b2a26">zdroj</text>
		<!-- obvod: levý vodič od svorky x 168 k typu N, pravý od svorky x 192 k typu P -->
		<path d="M168 62 L14 62 L14 190 L34 190" fill="none" stroke="#2b2a26" stroke-width="4" />
		<path d="M192 62 L346 62 L346 190 L326 190" fill="none" stroke="#2b2a26" stroke-width="4" />
		<!-- zdroj: dlouhá tenká čárka = +, krátká tlustá = − (polarita se otáčí) -->
		<line id="dioda-bat-dlouha" x1="192" y1="40" x2="192" y2="84" stroke="#2b2a26" stroke-width="4" />
		<line id="dioda-bat-kratka" x1="168" y1="50" x2="168" y2="74" stroke="#2b2a26" stroke-width="8" />
		<text id="dioda-bat-plus" x="212" y="56" text-anchor="middle" font-size="22" font-weight="bold" fill="#2b2a26">+</text>
		<text id="dioda-bat-minus" x="148" y="56" text-anchor="middle" font-size="22" font-weight="bold" fill="#2b2a26">−</text>
		<!-- dohodnutý směr proudu na vodičích (jen když proud prochází) -->
		<g id="dioda-proud-vodice" fill="#e8590c">
			<polygon id="dioda-proud-l" points="100,62 80,54 80,70" />
			<polygon id="dioda-proud-p" points="280,62 260,54 260,70" />
		</g>
		<!-- popisky typů nad přechodem -->
		<rect x="72" y="96" width="70" height="28" rx="7" fill="#ffffff" stroke="#495057" stroke-width="2" />
		<text x="107" y="117" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">typ N</text>
		<rect x="222" y="96" width="70" height="28" rx="7" fill="#ffffff" stroke="#495057" stroke-width="2" />
		<text x="257" y="117" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">typ P</text>
		<!-- paprsky LED (jen když svítí) -->
		<g id="dioda-paprsky" stroke="#fab005" stroke-width="4" stroke-linecap="round">
			<line x1="160" y1="132" x2="150" y2="110" />
			<line x1="180" y1="130" x2="180" y2="104" />
			<line x1="200" y1="132" x2="210" y2="110" />
		</g>
		<!-- přechod PN: typ N a typ P ve stejných barvách jako obrázky tématu -->
		<rect x="34" y="136" width="146" height="108" fill="#ffe3e3" stroke="#c2255c" stroke-width="4" />
		<rect x="180" y="136" width="146" height="108" fill="#f3e6c8" stroke="#8a6d3b" stroke-width="4" />
		<rect id="dioda-zona" x="172" y="138" width="16" height="104" fill="#e9ecef" stroke="#868e96" stroke-width="2" />
		<!-- hradlová vrstva: popisek pod přechodem -->
		<line x1="180" y1="244" x2="180" y2="256" stroke="#212529" stroke-width="2" />
		<rect x="95" y="256" width="170" height="28" rx="7" fill="#ffffff" stroke="#495057" stroke-width="2" />
		<text x="180" y="277" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">hradlová vrstva</text>
		<!-- volné elektrony a díry (kreslí skript podle stavu) -->
		<g id="dioda-castice"></g>
		<!-- dohodnutý směr proudu přechodem: od P do N (jen když proud prochází) -->
		<g id="dioda-proud-prechod">
			<line id="dioda-proud-sipka" x1="330" y1="312" x2="30" y2="312" stroke="#e8590c" stroke-width="5" marker-end="url(#dioda-m-ora)" />
			<rect x="85" y="298" width="190" height="28" rx="7" fill="#ffffff" stroke="#e8590c" stroke-width="2" />
			<text x="180" y="319" text-anchor="middle" font-size="19" font-weight="bold" fill="#b33d06">směr proudu: P → N</text>
		</g>
		<!-- plaketa se stavem (dva řádky) -->
		<rect x="8" y="340" width="344" height="62" rx="9" fill="#ffffff" stroke="#495057" stroke-width="2" />
		<text id="dioda-plaketa" x="180" y="364" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26"></text>
		<text id="dioda-plaketa2" x="180" y="392" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26"></text>
		<!-- legenda jako na obrázcích stránky -->
		<circle cx="26" cy="428" r="13" fill="#1971c2" stroke="#0b4f8a" stroke-width="2" />
		<text x="26" y="435" text-anchor="middle" font-size="19" font-weight="bold" fill="#ffffff">−</text>
		<text x="46" y="435" font-size="19" font-weight="bold" fill="#2b2a26">elektron</text>
		<circle cx="176" cy="428" r="13" fill="#ffffff" stroke="#1b6b2d" stroke-width="2" stroke-dasharray="4 2" />
		<text x="176" y="435" text-anchor="middle" font-size="19" font-weight="bold" fill="#1b6b2d">+</text>
		<text x="196" y="435" font-size="19" font-weight="bold" fill="#2b2a26">díra</text>
		<line x1="10" y1="462" x2="46" y2="462" stroke="#e03131" stroke-width="3" marker-end="url(#dioda-m-cer)" />
		<text x="62" y="469" font-size="19" font-weight="bold" fill="#2b2a26">pohyb nositele náboje</text>
		<line x1="10" y1="496" x2="44" y2="496" stroke="#e8590c" stroke-width="5" marker-end="url(#dioda-m-ora)" />
		<text x="62" y="503" font-size="19" font-weight="bold" fill="#2b2a26">směr proudu (od + k −)</text>
	</svg>
	<p class="dioda-stav" id="dioda-stav" aria-live="polite"></p>
</section>

<script>
	// === ČISTÁ ČÁST (stav diody bez DOM — kontrolovatelná výpočtem) ===
	// Přechod PN leží vodorovně mezi 34 a 326 px (styk typů na 180 px), svisle 136…244 px.
	const STYK = 180;
	// hradlová vrstva: v propustném směru úzká, v závěrném široká (jen tvar, ne číslo)
	const ZONA_UZKA = 16, ZONA_SIROKA = 140;
	const DELKA_SIPKY = 26; // šipka pohybu nositele náboje
	const R = 13; // poloměr kroužku nositele (jako na obrázcích stránky)
	// propustný směr: nositelé jsou v obou typech a putují přechodem
	// (výklad: „elektrony ze zdroje proudí do typu N a přes typ P dále až ke
	// kladné svorce. Díry se posunují přes oba typy opačným směrem.")
	const PROPUSTNY_ELEKTRONY = [
		[58, 158], [118, 158], [58, 222], [118, 222], // typ N
		[206, 190], [270, 190], // typ P
		[14, 100], [346, 160], // vodiče: do typu N a z typu P ke kladné svorce
	];
	const PROPUSTNY_DIRY = [
		[92, 190], [156, 190], // typ N
		[234, 158], [300, 158], [234, 222], [300, 222], // typ P
	];
	// závěrný směr: elektrony u okraje typu N, díry u okraje typu P (obr-06)
	const ZAVERNY_ELEKTRONY = [[52, 158], [84, 158], [52, 190], [84, 190], [52, 222], [84, 222]];
	const ZAVERNY_DIRY = [[276, 158], [308, 158], [276, 190], [308, 190], [276, 222], [308, 222]];

	// směr pohybu nositele (jednotkový vektor): elektron proti proudu, díra s proudem
	function smerElektronu(x, y) {
		if (x === 14) return [0, 1]; // levý vodič: od − dolů do typu N
		if (x === 346) return [0, -1]; // pravý vodič: z typu P nahoru ke +
		return [1, 0]; // přechodem od N k P
	}
	function stavDiody(smer) {
		const vede = smer === 'propustny';
		const zona = vede ? ZONA_UZKA : ZONA_SIROKA;
		const elektrony = (vede ? PROPUSTNY_ELEKTRONY : ZAVERNY_ELEKTRONY).map(([x, y]) => ({ x, y, pohyb: vede ? smerElektronu(x, y) : null }));
		const diry = (vede ? PROPUSTNY_DIRY : ZAVERNY_DIRY).map(([x, y]) => ({ x, y, pohyb: vede ? [-1, 0] : null }));
		return {
			smer,
			vede,
			ledSviti: vede,
			zona: { x: STYK - zona / 2, sirka: zona },
			// kladná svorka zdroje (dlouhá čárka) vpravo = u typu P
			plusUP: vede,
			elektrony,
			diry,
			plaketa: vede ? 'Propustný směr: proud prochází,' : 'Závěrný směr: proud neprochází,',
			plaketa2: vede ? 'hradlová vrstva se zužuje.' : 'hradlová vrstva se rozšiřuje.',
			popisSceny: vede
				? 'Zvětšená LED dioda v propustném směru: typ N na záporné svorce, typ P na kladné, úzká hradlová vrstva, elektrony a díry putují přechodem, proud prochází a LED svítí'
				: 'Zvětšená LED dioda v závěrném směru: typ N na kladné svorce, typ P na záporné, elektrony a díry na okrajích, široká hradlová vrstva, proud neprochází',
			popis: vede
				? '💡 PROPUSTNÝ SMĚR: typ N je na záporné svorce, typ P na kladné. Elektrony ze zdroje proudí do typu N a přes typ P dále až ke kladné svorce, díry se posunují opačným směrem. Proud prochází (od + přes typ P a typ N k −, jako šipka ve značce diody) a LED svítí.'
				: '🚫 ZÁVĚRNÝ SMĚR: typ N je na kladné svorce, typ P na záporné. Volné elektrony i díry se přesunou na okraje polovodiče, hradlová vrstva se rozšiřuje. Polovodičem neprocházejí žádní nositelé náboje, proud neprochází a LED nesvítí — dioda je jako vypnutý spínač.',
		};
	}
	// === KONEC ČISTÉ ČÁSTI ===

	const svg = document.getElementById('dioda-svg');
	svg.__stavDiody = stavDiody; // pro nezávislou kontrolu výpočtem
	const g = (id) => document.getElementById(id);
	const nastav = (id, attrs) => { const el = g(id); for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v); };

	function elektron(c) {
		let html = `<circle cx="${c.x}" cy="${c.y}" r="${R}" fill="#1971c2" stroke="#0b4f8a" stroke-width="2" /><text x="${c.x}" y="${c.y + 7}" text-anchor="middle" font-size="19" font-weight="bold" fill="#ffffff">−</text>`;
		if (c.pohyb) html += sipka(c);
		return html;
	}
	function dira(c) {
		let html = `<circle cx="${c.x}" cy="${c.y}" r="${R}" fill="#ffffff" stroke="#1b6b2d" stroke-width="2" stroke-dasharray="4 2" /><text x="${c.x}" y="${c.y + 7}" text-anchor="middle" font-size="19" font-weight="bold" fill="#1b6b2d">+</text>`;
		if (c.pohyb) html += sipka(c);
		return html;
	}
	// šipka pohybu začíná těsně za kroužkem (R + 3 px od středu) a míří ve směru pohybu
	function sipka(c) {
		const [dx, dy] = c.pohyb;
		const x1 = c.x + dx * (R + 3), y1 = c.y + dy * (R + 3);
		return `<line x1="${x1}" y1="${y1}" x2="${x1 + dx * DELKA_SIPKY}" y2="${y1 + dy * DELKA_SIPKY}" stroke="#e03131" stroke-width="3" marker-end="url(#dioda-m-cer)" />`;
	}

	let smer = 'propustny';
	function prekresli() {
		const s = stavDiody(smer);
		nastav('dioda-zona', { x: s.zona.x, width: s.zona.sirka });
		nastav('dioda-paprsky', { opacity: s.ledSviti ? 1 : 0 });
		nastav('dioda-proud-vodice', { opacity: s.vede ? 1 : 0 });
		nastav('dioda-proud-prechod', { opacity: s.vede ? 1 : 0 });
		// zdroj: dlouhá čárka (+) u typu P v propustném směru, u typu N v závěrném
		nastav('dioda-bat-dlouha', { x1: s.plusUP ? 192 : 168, x2: s.plusUP ? 192 : 168 });
		nastav('dioda-bat-kratka', { x1: s.plusUP ? 168 : 192, x2: s.plusUP ? 168 : 192 });
		nastav('dioda-bat-plus', { x: s.plusUP ? 212 : 148 });
		nastav('dioda-bat-minus', { x: s.plusUP ? 148 : 212 });
		nastav('dioda-svg', { 'aria-label': s.popisSceny });
		g('dioda-castice').innerHTML = s.elektrony.map(elektron).join('') + s.diry.map(dira).join('');
		g('dioda-plaketa').textContent = s.plaketa;
		g('dioda-plaketa2').textContent = s.plaketa2;
		g('dioda-stav').textContent = s.popis;
	}

	const TLACITKA = [
		{ id: 'dioda-tl-propustny', smer: 'propustny' },
		{ id: 'dioda-tl-zaverny', smer: 'zaverny' },
	];
	function prepni(novy) {
		smer = novy;
		for (const t of TLACITKA) {
			const zvoleno = t.smer === novy;
			if (zvoleno) g(t.id).classList.add('dioda-aktivni');
			else g(t.id).classList.remove('dioda-aktivni');
			g(t.id).setAttribute('aria-pressed', zvoleno ? 'true' : 'false');
		}
		prekresli();
	}
	for (const t of TLACITKA) g(t.id).addEventListener('click', () => prepni(t.smer));
	prepni(smer);
</script>

<style>
	#dioda-svg { width: 100%; max-width: 460px; display: block; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.dioda-stav { font-size: 1.05rem; font-weight: 700; min-height: 3rem; }
</style>
<style is:global>
	.dioda-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.35rem 0.35rem 0; }
	.dioda-tl.dioda-aktivni { background: #ffe8cc; }
	.dioda-tl:active { transform: translateY(1px); }
</style>
