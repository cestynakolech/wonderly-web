---
// Kondenzace: opačný proces vypařování — plyn se mění zpátky na kapalinu
// Vidíš jak se pára mění zpátky na kapičky vody na chladném povrchu
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Kondenzace 💧</span></h2>
	<p>Kondenzace je opačný proces vypařování. Plyn se ochladí a mění se <strong>zpátky na kapalinu</strong>. Např. rosa na trávě či kapky na zrcadle v koupelně.</p>
	
	<svg id="kond-svg" viewBox="0 0 500 340" role="img" aria-label="Kondenzace páry na chladném povrchu">
		<!-- Nápis -->
		<text x="250" y="25" text-anchor="middle" font-size="16" font-weight="bold" fill="#2b2a26">Kondenzace: Pára → Kapalina</text>
		
		<!-- Chladná plocha (ledová, zrcadlo) -->
		<rect x="80" y="100" width="340" height="20" fill="#b3d9ff" stroke="#1971c2" stroke-width="2" rx="3" />
		<text x="80" y="125" font-size="11" fill="#868e96">Chladný povrch (např. zrcadlo v koupelně)</text>
		
		<!-- Kapky kondenzátu (naformované na povrchu) -->
		<g id="kond-kapky">
			<ellipse id="kapka-1" cx="110" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
			<ellipse id="kapka-2" cx="150" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
			<ellipse id="kapka-3" cx="190" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
			<ellipse id="kapka-4" cx="230" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
			<ellipse id="kapka-5" cx="270" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
			<ellipse id="kapka-6" cx="310" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
			<ellipse id="kapka-7" cx="350" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
			<ellipse id="kapka-8" cx="390" cy="115" rx="6" ry="8" fill="#74c0fc" opacity="0" />
		</g>
		
		<!-- Molekuly páry (nahoře, postupně mizí) -->
		<g id="kond-molekuly-plyn">
			<circle id="par-1" cx="90" cy="60" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
			<circle id="par-2" cx="135" cy="50" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
			<circle id="par-3" cx="180" cy="65" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
			<circle id="par-4" cx="225" cy="55" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
			<circle id="par-5" cx="270" cy="70" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
			<circle id="par-6" cx="315" cy="50" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
			<circle id="par-7" cx="360" cy="65" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
			<circle id="par-8" cx="405" cy="55" r="4" fill="#a5d8ff" opacity="0.8" class="mol-plyn" />
		</g>
		
		<!-- Šipky ukazující pohyb molekul dolů -->
		<defs>
			<marker id="arrow-down" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
				<polygon points="0 0, 10 3, 0 6" fill="#4c6ef5" />
			</marker>
		</defs>
		<line x1="110" y1="75" x2="110" y2="110" stroke="#4c6ef5" stroke-width="1.5" marker-end="url(#arrow-down)" opacity="0" id="sipka-1" />
		<line x1="180" y1="80" x2="180" y2="110" stroke="#4c6ef5" stroke-width="1.5" marker-end="url(#arrow-down)" opacity="0" id="sipka-2" />
		<line x1="270" y1="85" x2="270" y2="110" stroke="#4c6ef5" stroke-width="1.5" marker-end="url(#arrow-down)" opacity="0" id="sipka-3" />
		<line x1="360" y1="80" x2="360" y2="110" stroke="#4c6ef5" stroke-width="1.5" marker-end="url(#arrow-down)" opacity="0" id="sipka-4" />
		
		<!-- Teplota prostředí (výše) -->
		<text x="20" y="240" font-size="13" font-weight="bold" fill="#2b2a26">Teplota páry:</text>
		<rect x="130" y="225" width="200" height="20" fill="none" stroke="#868e96" stroke-width="1" rx="3" />
		<rect id="kond-tepl-ukazatel" x="130" y="225" width="50" height="20" fill="#4c6ef5" rx="3" />
		<text id="kond-tepl-text" x="350" y="240" font-size="13" fill="#2b2a26">20 °C</text>
		
		<!-- Info zpráva -->
		<text x="250" y="290" text-anchor="middle" font-size="11" fill="#868e96">Čím chladnější povrch, tím rychleji se pára kondenzuje</text>
	</svg>
	
	<label class="sim-posuvnik">
		Teplota páry: <output id="kond-hodnota"></output>
		<input type="range" id="kond-slider" min="0" max="40" step="1" value="20" />
	</label>
	
	<p class="tepl-stav" id="kond-stav">Teplota páry 20 °C: Pára se vůbec nekondenzuje (jen málo molekul má nízkou energii).</p>
</section>

<script>
	const slider = document.getElementById('kond-slider');
	const hodnota = document.getElementById('kond-hodnota');
	const stavEl = document.getElementById('kond-stav');
	const teplText = document.getElementById('kond-tepl-text');
	const teplUkazatel = document.getElementById('kond-tepl-ukazatel');
	
	function prekresli() {
		const t = +slider.value; // 0..40 °C
		hodnota.textContent = t + ' °C';
		teplText.textContent = t + ' °C';
		
		// Teplota ukazatel (čím NIŽŠÍ, tím VÍCE se kondenzuje)
		const stupenChladnosti = (40 - t) / 40; // 0 (horko, bez kondenzace) až 1 (chlad, max kondenzace)
		const sirkaTeploty = 200 * (1 - stupenChladnosti / 100);
		teplUkazatel.setAttribute('width', Math.max(0, sirkaTeploty));
		
		// Kondenzace kapky (postupně se objevují)
		const viditelnych = Math.ceil(stupenChladnosti * 8);
		const kapkyIds = ['kapka-1', 'kapka-2', 'kapka-3', 'kapka-4', 'kapka-5', 'kapka-6', 'kapka-7', 'kapka-8'];
		kapkyIds.forEach((id, i) => {
			const el = document.getElementById(id);
			if (i < viditelnych) {
				el.style.opacity = 0.5 + stupenChladnosti * 0.5;
			} else {
				el.style.opacity = 0;
			}
		});
		
		// Molekuly páry mizí (postupně se stahují dolů)
		const paryIds = ['par-1', 'par-2', 'par-3', 'par-4', 'par-5', 'par-6', 'par-7', 'par-8'];
		paryIds.forEach((id, i) => {
			const el = document.getElementById(id);
			const opacita = Math.max(0, 0.8 - stupenChladnosti * 0.9);
			el.style.opacity = opacita;
		});
		
		// Šipky (více viditelné při vyšší chladnosti)
		for (let i = 1; i <= 4; i++) {
			const sipka = document.getElementById(`sipka-${i}`);
			sipka.style.opacity = stupenChladnosti * 0.7;
		}
		
		// Popisy
		if (t > 30) {
			stavEl.textContent = '🌞 Horká pára (nad 30 °C): Molekuly páry mají vysokou energii, kondenzace je velmi pomalá nebo žádná.';
		} else if (t > 15) {
			stavEl.textContent = '🌡️ Mírně chladná (15–30 °C): Začínají se tvořit první kapky. Povrch musí být notně chladný.';
		} else {
			stavEl.textContent = '❄️ Velmi chladná (pod 15 °C): Pára se intenzivně kondenzuje na chladné ploše. Vidíš jasné kapky!';
		}
	}
	
	slider.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#kond-svg { width: 100%; max-width: 500px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 500px; display: block; margin-top: 0.3rem; }
	.tepl-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
