---
// Statická infografika: Pohyb těles — klid vs. pohyb
// SVG vizualizace rozdílu mezi pohybem a klidem
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Klid a pohyb těles 🏃</span></h2>
	<p>Těleso je v <strong>klidu</strong>, když se nemění jeho poloha. Je v <strong>pohybu</strong>, když se jeho poloha mění. Pohyb se měří vůči <strong>vztažné soustavě</strong>.</p>
	<svg viewBox="0 0 600 320" class="infografika-svg">
		<!-- Pozadí -->
		<rect width="600" height="320" fill="#f0f7ff"/>
		<line x1="0" y1="160" x2="600" y2="160" stroke="#ccc" stroke-width="2"/>
		
		<!-- Levá strana: Klid -->
		<text x="80" y="40" class="nadpis">Klid</text>
		<circle cx="80" cy="120" r="35" fill="#4a90e2" stroke="#2b5aa8" stroke-width="2"/>
		<text x="70" y="132" class="popis-text" font-size="20" fill="white" font-weight="bold">A</text>
		<text x="30" y="200" class="label" text-anchor="middle">Poloha se</text>
		<text x="30" y="225" class="label" text-anchor="middle">nemění</text>
		<path d="M 50 180 L 50 250" stroke="#999" stroke-width="1" stroke-dasharray="3,3"/>
		
		<!-- Střed: Čas -->
		<text x="300" y="280" class="label" text-anchor="middle" font-weight="bold">Čas →</text>
		
		<!-- Pravá strana: Pohyb -->
		<text x="520" y="40" class="nadpis">Pohyb</text>
		<circle cx="420" cy="120" r="35" fill="#e85d75" stroke="#b63556" stroke-width="2"/>
		<text x="410" y="132" class="popis-text" font-size="20" fill="white" font-weight="bold">B</text>
		<circle cx="520" cy="120" r="35" fill="#e85d75" stroke="#b63556" stroke-width="2" opacity="0.5"/>
		<text x="510" y="132" class="popis-text" font-size="20" fill="white" font-weight="bold">B'</text>
		<path d="M 480 110 L 550 110" stroke="#ff6b35" stroke-width="3" marker-end="url(#arrowred)"/>
		<text x="520" y="105" class="label" font-size="12">dráha s</text>
		
		<!-- Legenda -->
		<text x="50" y="310" class="legenda-text">🏃 Klid = poloha konstantní vůči vztažné soustavě</text>
		<text x="50" y="330" class="legenda-text">🚗 Pohyb = změna polohy vůči vztažné soustavě</text>
		
		<!-- SVG marker pro šipku -->
		<defs>
			<marker id="arrowred" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
				<path d="M0,0 L0,6 L9,3 z" fill="#ff6b35"/>
			</marker>
		</defs>
	</svg>
</section>

<style>
	.infografika-svg {
		width: 100%;
		max-width: 600px;
		height: auto;
		border: 2px solid #ddd;
		border-radius: 8px;
		background: white;
	}
	.nadpis {
		font-size: 24px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.label {
		font-size: 14px;
		fill: #555;
		font-weight: 500;
	}
	.legenda-text {
		font-size: 12px;
		fill: #666;
	}
	.popis-text {
		font-size: 20px;
	}
</style>
