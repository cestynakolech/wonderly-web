---
// F9 Elektrina — Vedení (vodiče a izolátory, vedení elektrického proudu)
// SVG diagram ukazuje rozdíl mezi vodiči a izolátory na atomární úrovni
---

<section class="ramecek f9-diagram">
	<h3>🔌 Vedení — Vodiče vs. Izolátory</h3>
	<svg viewBox="0 0 400 350" class="diagram-svg vedeni-diagram">
		<!-- Pozadí -->
		<rect width="400" height="350" fill="#f7f9fc" />

		<!-- LEVÁ STRANA: VODIČ (KOV) -->
		<g>
			<text x="100" y="25" text-anchor="middle" font-size="13" font-weight="600" fill="#1565c0">VODIČ (kov − Cu, Al, Fe…)</text>

			<!-- Mřížka atomů -->
			<circle cx="60" cy="70" r="15" fill="none" stroke="#666" stroke-width="2" />
			<circle cx="140" cy="70" r="15" fill="none" stroke="#666" stroke-width="2" />
			<circle cx="60" cy="130" r="15" fill="none" stroke="#666" stroke-width="2" />
			<circle cx="140" cy="130" r="15" fill="none" stroke="#666" stroke-width="2" />

			<!-- Jádra v atomech -->
			<circle cx="60" cy="70" r="3" fill="#666" />
			<circle cx="140" cy="70" r="3" fill="#666" />
			<circle cx="60" cy="130" r="3" fill="#666" />
			<circle cx="140" cy="130" r="3" fill="#666" />

			<!-- VOLNÉ ELEKTRONY v vodiči (kuličky s šipkami - pohyb) -->
			<circle cx="100" cy="50" r="5" fill="#4169e1" stroke="#1e40af" stroke-width="1.5" />
			<path d="M 105 50 L 125 50" stroke="#4169e1" stroke-width="2" marker-end="url(#arrowblue)" />

			<circle cx="80" cy="90" r="5" fill="#4169e1" stroke="#1e40af" stroke-width="1.5" />
			<path d="M 85 90 L 105 90" stroke="#4169e1" stroke-width="2" marker-end="url(#arrowblue)" />

			<circle cx="120" cy="110" r="5" fill="#4169e1" stroke="#1e40af" stroke-width="1.5" />
			<path d="M 115 110 L 95 110" stroke="#4169e1" stroke-width="2" marker-end="url(#arrowblue)" />

			<!-- Text popis -->
			<text x="100" y="170" text-anchor="middle" font-size="10" font-weight="600" fill="#1565c0">Volné elektrony</text>
			<text x="100" y="183" text-anchor="middle" font-size="9" fill="#333">se SNADNO pohybují</text>
			<text x="100" y="195" text-anchor="middle" font-size="9" fill="#333">→ DOBRÝ VODIČ</text>
		</g>

		<!-- PRAVÁ STRANA: IZOLANT -->
		<g>
			<text x="300" y="25" text-anchor="middle" font-size="13" font-weight="600" fill="#d32f2f">IZOLANT (plast, guma, sklo…)</text>

			<!-- Mřížka atomů -->
			<circle cx="260" cy="70" r="15" fill="none" stroke="#666" stroke-width="2" />
			<circle cx="340" cy="70" r="15" fill="none" stroke="#666" stroke-width="2" />
			<circle cx="260" cy="130" r="15" fill="none" stroke="#666" stroke-width="2" />
			<circle cx="340" cy="130" r="15" fill="none" stroke="#666" stroke-width="2" />

			<!-- Jádra v atomech -->
			<circle cx="260" cy="70" r="3" fill="#666" />
			<circle cx="340" cy="70" r="3" fill="#666" />
			<circle cx="260" cy="130" r="3" fill="#666" />
			<circle cx="340" cy="130" r="3" fill="#666" />

			<!-- Elektrony TĚSNĚ vázané na atomech (bez možnosti pohybu) -->
			<circle cx="250" cy="55" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />
			<circle cx="270" cy="55" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />
			<circle cx="330" cy="55" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />
			<circle cx="350" cy="55" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />

			<circle cx="245" cy="75" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />
			<circle cx="275" cy="75" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />
			<circle cx="325" cy="75" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />
			<circle cx="355" cy="75" r="4" fill="#ff6b6b" stroke="#c92a2a" stroke-width="1.5" />

			<!-- Text popis -->
			<text x="300" y="170" text-anchor="middle" font-size="10" font-weight="600" fill="#d32f2f">Elektrony VÁZANÉ</text>
			<text x="300" y="183" text-anchor="middle" font-size="9" fill="#333">se TĚŽKO pohybují</text>
			<text x="300" y="195" text-anchor="middle" font-size="9" fill="#333">→ ŠPATNÝ VODIČ</text>
		</g>

		<!-- Šipky a definice -->
		<g marker-end="url(#arrow)">
			<defs>
				<marker id="arrowblue" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
					<path d="M0,0 L0,6 L9,3 z" fill="#4169e1" />
				</marker>
			</defs>
		</g>

		<!-- Aplikace: tabulka -->
		<rect x="15" y="220" width="370" height="115" fill="#e8f5e9" stroke="#388e3c" stroke-width="1.5" rx="4" />
		<text x="25" y="240" font-size="11" font-weight="600" fill="#2e7d32">Praktické příklady:</text>

		<text x="25" y="258" font-size="9" fill="#333"><tspan font-weight="600" fill="#1565c0">VODIČE:</tspan> měď, hliník, železo, voda s solí</text>
		<text x="25" y="270" font-size="9" fill="#333">→ Drátky v kabelech, drátky do zásuvek, bleskem sem</text>

		<text x="25" y="288" font-size="9" fill="#333"><tspan font-weight="600" fill="#d32f2f">IZOLANTORY:</tspan> plast, guma, sklo, porcelán, suchá dřeva</text>
		<text x="25" y="300" font-size="9" fill="#333">→ Ochrana drátků (plášť kabelu), izolace do zásuvky, rukavice elektrikářů</text>

		<text x="25" y="318" font-size="9" fill="#333"><tspan font-weight="600">PŮLVODIČE:</tspan> křemík, germanium (používají se v tranzistorech, diodách, čipech)</text>
	</svg>

	<div class="poznamka">
		<strong>Zapamatuj si:</strong> Vodiče obsahují volné elektrony, které se snadno pohybují a tvoří proud. 
		Izolátory elektrony drží − proud jimi téměř neteče. Kombinace obojího (vodič v izolačním plášti) 
		je bezpečný kabel.
	</div>
</section>

<style>
	.f9-diagram {
		margin: 1.5rem 0;
		padding: 1.5rem;
		border: 2px solid #388e3c;
		border-radius: 8px;
		background: #f9fafc;
	}

	.f9-diagram h3 {
		margin: 0 0 1rem 0;
		color: #2e7d32;
		font-size: 1.25rem;
	}

	.diagram-svg {
		width: 100%;
		max-width: 500px;
		margin: 1rem auto;
		display: block;
		border-radius: 6px;
		background: white;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.poznamka {
		margin-top: 1rem;
		padding: 0.8rem;
		background: #fff3cd;
		border-left: 4px solid #ffc107;
		border-radius: 4px;
		font-size: 0.95rem;
		color: #856404;
	}
</style>
