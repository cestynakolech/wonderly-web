---
// Vedení proudu v kapalinách (F9): kádinka s elektrodami, baterie 4,5 V, vypínač,
// ampérmetr a žárovka — obvod z výkladu (slug vedeni-proudu-v-kapalinach).
// Jen údaje z výkladu: baterie 4,5 V, NaCl → Na⁺ + Cl⁻, čistá voda s nepatrným
// množstvím iontů H⁺ a OH⁻, pomědění železného předmětu v roztoku skalice modré
// (CuSO₄ → Cu²⁺ + SO₄²⁻, měděná anoda se rozpouští, měď se vylučuje na katodě).
// Pomědění ve stejné orientaci jako obr-05: anoda Cu VLEVO (+), železná lžička VPRAVO (−).
// Proud se NEvyčísluje — jen slovy a výchylkou ručičky: neprochází / velmi malý / prochází.
// Barvy podle jednotné legendy tématu: kation velký červený (#e03131), anion velký
// fialový (#7048e8); modrá (#1971c2) patří jen pólu −.
// Mobil: scéna 360 jednotek → na telefonu (~235 px) písmo ≥ 19 × 235 / 360 ≈ 12,4 px.
// Stav je čistá funkce stavElektrolyzy(rezim, kapalina, sepnuto) a rozmístění
// iontů castice(...) na SVG; ionty se kreslí do innerHTML skupiny #ely-ionty.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Elektrolýza — ionty na cestách 🕹️</span></h2>
	<p>Kapalina vede proud, jen když v ní plavou <strong>volné ionty</strong>. Po zapojení obvodu putují <strong>kationty (+) ke katodě (−)</strong> a <strong>anionty (−) k anodě (+)</strong> — jejich usměrněný pohyb je elektrický proud.</p>
	<p id="ely-rezimy">
		<button type="button" id="ely-r-pokus" class="ely-tl ely-aktivni" data-rezim="pokus">🔦 pokus se žárovkou</button>
		<button type="button" id="ely-r-pomedeni" class="ely-tl" data-rezim="pomedeni">🥄 pomědění lžičky</button>
	</p>
	<p id="ely-kapaliny">
		<button type="button" id="ely-k-destilovana" class="ely-tl ely-aktivni" data-kapalina="destilovana">💧 destilovaná voda</button>
		<button type="button" id="ely-k-roztok" class="ely-tl" data-kapalina="roztok">🧂 voda se solí (roztok)</button>
	</p>
	<svg id="ely-svg" viewBox="0 0 360 400" role="img" aria-label="Kádinka s elektrodami a ionty, nad ní obvod: ampérmetr, baterie, vypínač a žárovka">
		<!-- obvod: levý drát s ampérmetrem, baterie, vypínač, žárovka, pravý drát -->
		<path d="M60 118 L60 90 M60 54 L60 36 L140 36 M152 36 L190 36 M222 36 L246 36 M278 36 L300 36 L300 118" fill="none" stroke="#2b2a26" stroke-width="4" />
		<circle cx="60" cy="72" r="18" fill="#fff" stroke="#2b2a26" stroke-width="3" />
		<line id="ely-rucicka" x1="60" y1="80" x2="60" y2="60" stroke="#c92a2a" stroke-width="3" stroke-linecap="round" />
		<text x="26" y="79" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">A</text>
		<!-- baterie: tlustá krátká deska = −, tenká dlouhá = + (v pomědění se prohodí) -->
		<line id="ely-deska-l" x1="140" x2="140" y1="26" y2="46" stroke="#2b2a26" stroke-width="8" />
		<line id="ely-deska-p" x1="152" x2="152" y1="18" y2="54" stroke="#2b2a26" stroke-width="4" />
		<text id="ely-znak-l" x="126" y="20" text-anchor="middle" font-size="19" font-weight="bold" fill="#1971c2">−</text>
		<text id="ely-znak-p" x="166" y="20" text-anchor="middle" font-size="19" font-weight="bold" fill="#c92a2a">+</text>
		<text x="146" y="76" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">baterie 4,5 V</text>
		<!-- vypínač: páčka se sklopí na pravý kontakt -->
		<circle cx="190" cy="36" r="3.5" fill="#2b2a26" /><circle cx="222" cy="36" r="3.5" fill="#2b2a26" />
		<line id="ely-packa" x1="190" y1="36" x2="218" y2="18" stroke="#2b2a26" stroke-width="4" stroke-linecap="round" />
		<!-- žárovka -->
		<g id="ely-paprsky" stroke="#e8a200" stroke-width="3" stroke-linecap="round">
			<line x1="262" y1="14" x2="262" y2="4" /><line x1="244" y1="20" x2="237" y2="13" /><line x1="280" y1="20" x2="287" y2="13" />
		</g>
		<circle cx="262" cy="36" r="16" fill="#fff" stroke="#2b2a26" stroke-width="3" />
		<circle id="ely-vlakno" cx="262" cy="36" r="11" fill="#ffd43b" />
		<text id="ely-proud" x="180" y="104" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26"></text>
		<!-- kádinka a kapalina -->
		<path d="M30 130 L30 330 L330 330 L330 130" fill="none" stroke="#2b2a26" stroke-width="4" />
		<rect id="ely-voda" x="32" y="150" width="296" height="178" fill="#f1f8ff" />
		<!-- elektrody: levá (v pomědění měděná anoda, ubývá), pravá (v pomědění ji nahradí lžička) -->
		<rect id="ely-el-l" x="52" y="118" width="16" height="172" fill="#868e96" stroke="#2b2a26" stroke-width="2" />
		<rect id="ely-el-p" x="292" y="118" width="16" height="172" fill="#868e96" stroke="#2b2a26" stroke-width="2" />
		<!-- železná lžička na pravé elektrodě (katoda v pomědění); měď pokryje celou ponořenou část -->
		<g id="ely-lzicka">
			<g id="ely-vrstva" fill="#c2703d">
				<rect x="289" y="150" width="22" height="104" rx="4" /><ellipse cx="300" cy="280" rx="23" ry="31" />
			</g>
			<rect x="294" y="118" width="12" height="138" rx="4" fill="#ced4da" stroke="#2b2a26" stroke-width="2" />
			<ellipse cx="300" cy="280" rx="18" ry="26" fill="#dee2e6" stroke="#2b2a26" stroke-width="2.5" />
		</g>
		<!-- ionty a molekuly kreslí skript (castice) -->
		<g id="ely-ionty"></g>
		<!-- popisky elektrod pod kádinkou -->
		<text id="ely-pop-l" x="6" y="356" font-size="19" font-weight="bold" fill="#1971c2"></text>
		<text id="ely-pop-p" x="354" y="356" text-anchor="end" font-size="19" font-weight="bold" fill="#c92a2a"></text>
		<text id="ely-pop-l2" x="6" y="384" font-size="19" font-weight="bold" fill="#a0522d"></text>
		<text id="ely-pop-p2" x="354" y="384" text-anchor="end" font-size="19" font-weight="bold" fill="#495057"></text>
	</svg>
	<p><button type="button" class="ely-tl" id="ely-spinac">🔌 sepni obvod</button></p>
	<p class="ely-vzorec" id="ely-vzorec"></p>
	<p class="ely-stav" id="ely-stav" aria-live="polite">👉 Sepni obvod — a pak zkus, co udělá sůl ve vodě a co režim pomědění.</p>
</section>

<script>
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	// Výchylka ručičky ampérmetru jen názorně, bez stupnice a bez čísla.
	const RUCICKA = { neprochazi: -60, velmiMaly: -30, prochazi: 30 };
	const R_IONTU = 26; // „velký“ kroužek iontu, písmo 19 (vejde se i SO₄²⁻)
	function stavElektrolyzy(rezim, kapalina, sepnuto) {
		const pomedeni = rezim === 'pomedeni';
		const elektrolyt = pomedeni || kapalina === 'roztok'; // roztok CuSO₄ je vždy elektrolyt
		const proud = !sepnuto ? 'neprochazi' : elektrolyt ? 'prochazi' : 'velmiMaly';
		return {
			proud,
			sviti: proud === 'prochazi', // čistá voda: „na rozsvícení žárovky to nestačí“
			rucicka: RUCICKA[proud],
			putuji: sepnuto, // po zapojení obvodu se ionty začnou pohybovat k elektrodám
			vrstva: pomedeni && sepnuto, // měď se vylučuje na katodě (lžičce)
			anodaUbyva: pomedeni && sepnuto, // měděná anoda se postupně rozpouští
			katodaVlevo: !pomedeni, // obr-05: v pomědění je katoda (lžička) vpravo
		};
	}
	// Rozmístění částic. Pokus: katoda vlevo → kationty doleva. Pomědění: zrcadlově (obr-05).
	const POKUS_KATIONTY = [[150, 180], [220, 236], [160, 292]];
	const POKUS_ANIONTY = [[230, 180], [120, 236], [240, 292]];
	function castice(rezim, kapalina) {
		const s = stavElektrolyzy(rezim, kapalina, true);
		if (rezim !== 'pomedeni' && kapalina === 'destilovana') {
			return [
				{ druh: 'kation', text: 'H⁺', x: 150, y: 214, smer: -1 },
				{ druh: 'anion', text: 'OH⁻', x: 210, y: 280, smer: 1 },
				{ druh: 'molekula', x: 110, y: 180 }, { druh: 'molekula', x: 250, y: 176 }, { druh: 'molekula', x: 250, y: 236 },
				{ druh: 'molekula', x: 110, y: 262 }, { druh: 'molekula', x: 120, y: 318 }, { druh: 'molekula', x: 280, y: 318 },
			];
		}
		const zrcadlo = s.katodaVlevo ? (x) => x : (x) => 360 - x;
		const smerKationtu = s.katodaVlevo ? -1 : 1; // kationty ke katodě
		const kat = rezim === 'pomedeni' ? 'Cu²⁺' : 'Na⁺', an = rezim === 'pomedeni' ? 'SO₄²⁻' : 'Cl⁻';
		return [
			...POKUS_KATIONTY.map(([x, y]) => ({ druh: 'kation', text: kat, x: zrcadlo(x), y, smer: smerKationtu })),
			...POKUS_ANIONTY.map(([x, y]) => ({ druh: 'anion', text: an, x: zrcadlo(x), y, smer: -smerKationtu })),
		];
	}
	// trojúhelník šipky: hrot 20 jednotek za okrajem kroužku ve směru pohybu
	function sipka(c) {
		const zaklad = c.x + c.smer * (R_IONTU + 4), hrot = c.x + c.smer * (R_IONTU + 20);
		return `${hrot},${c.y} ${zaklad},${c.y - 7} ${zaklad},${c.y + 7}`;
	}
	// === KONEC ČISTÉ ČÁSTI ===

	let rezim = 'pokus';
	let kapalina = 'destilovana';
	let sepnuto = false;
	const svg = document.getElementById('ely-svg');
	svg.__stavElektrolyzy = stavElektrolyzy; svg.__castice = castice; svg.__sipka = sipka; // pro nezávislou kontrolu
	const g = (id) => document.getElementById(id);
	const nastav = (id, attrs) => { const el = g(id); for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v); };
	const viditelne = (id, ano) => g(id).setAttribute('visibility', ano ? 'visible' : 'hidden');
	const TEXT_PROUDU = { neprochazi: 'proud neprochází', velmiMaly: 'proud velmi malý', prochazi: 'proud prochází' };
	const BARVA = { kation: ['#e03131', '#a61e1e'], anion: ['#7048e8', '#4c2bb0'] };

	function kresliCastice(s) {
		let html = '';
		for (const c of castice(rezim, kapalina)) {
			if (c.druh === 'molekula') {
				html += `<text x="${c.x}" y="${c.y}" text-anchor="middle" font-size="19" fill="#495057">H₂O</text>`;
				continue;
			}
			const [vypln, obrys] = BARVA[c.druh];
			html += `<circle cx="${c.x}" cy="${c.y}" r="${R_IONTU}" fill="${vypln}" stroke="${obrys}" stroke-width="2" />`
				+ `<text x="${c.x}" y="${c.y + 7}" text-anchor="middle" font-size="19" font-weight="bold" fill="#fff">${c.text}</text>`;
			if (s.putuji) html += `<polygon points="${sipka(c)}" fill="#2b2a26" />`;
		}
		g('ely-ionty').innerHTML = html;
	}

	function kresli() {
		const s = stavElektrolyzy(rezim, kapalina, sepnuto);
		const pomedeni = rezim === 'pomedeni';
		const cista = !pomedeni && kapalina === 'destilovana';
		// baterie: záporný pól vždy ke katodě
		const tlusta = { y1: 26, y2: 46, 'stroke-width': 8 }, tenka = { y1: 18, y2: 54, 'stroke-width': 4 };
		nastav('ely-deska-l', s.katodaVlevo ? tlusta : tenka);
		nastav('ely-deska-p', s.katodaVlevo ? tenka : tlusta);
		g('ely-znak-l').textContent = s.katodaVlevo ? '−' : '+';
		g('ely-znak-p').textContent = s.katodaVlevo ? '+' : '−';
		nastav('ely-znak-l', { fill: s.katodaVlevo ? '#1971c2' : '#c92a2a' });
		nastav('ely-znak-p', { fill: s.katodaVlevo ? '#c92a2a' : '#1971c2' });
		// vypínač
		nastav('ely-packa', sepnuto ? { x2: 222, y2: 36 } : { x2: 218, y2: 18 });
		g('ely-spinac').textContent = sepnuto ? '✋ rozpoj obvod' : '🔌 sepni obvod';
		// kapalina: destilovaná čirá, roztok soli namodralý, skalice modrá modřejší
		nastav('ely-voda', { fill: pomedeni ? '#a5d8ff' : kapalina === 'roztok' ? '#d0ebff' : '#f1f8ff' });
		// ampérmetr, žárovka a proud
		nastav('ely-rucicka', { transform: `rotate(${s.rucicka} 60 80)` });
		nastav('ely-vlakno', { opacity: s.sviti ? 1 : 0.06 });
		viditelne('ely-paprsky', s.sviti);
		g('ely-proud').textContent = TEXT_PROUDU[s.proud];
		kresliCastice(s);
		// elektrody: v pomědění vlevo měděná anoda (ubývá), vpravo železná lžička s vrstvou mědi
		nastav('ely-el-l', { fill: pomedeni ? '#c2703d' : '#868e96', x: s.anodaUbyva ? 55 : 52, width: s.anodaUbyva ? 10 : 16 });
		viditelne('ely-el-p', !pomedeni);
		viditelne('ely-lzicka', pomedeni);
		viditelne('ely-vrstva', s.vrstva);
		g('ely-pop-l').textContent = s.katodaVlevo ? 'KATODA (−)' : 'ANODA (+)';
		g('ely-pop-p').textContent = s.katodaVlevo ? 'ANODA (+)' : 'KATODA (−)';
		nastav('ely-pop-l', { fill: s.katodaVlevo ? '#1971c2' : '#c92a2a' });
		nastav('ely-pop-p', { fill: s.katodaVlevo ? '#c92a2a' : '#1971c2' });
		g('ely-pop-l2').textContent = pomedeni ? 'měď (Cu)' : '';
		g('ely-pop-p2').textContent = !pomedeni ? '' : s.vrstva ? 'lžička + měď' : 'lžička (Fe)';
		// přepínač kapalin jen v pokusu
		g('ely-kapaliny').style.display = pomedeni ? 'none' : '';
		g('ely-r-pokus').classList.toggle('ely-aktivni', !pomedeni);
		g('ely-r-pomedeni').classList.toggle('ely-aktivni', pomedeni);
		g('ely-k-destilovana').classList.toggle('ely-aktivni', kapalina === 'destilovana');
		g('ely-k-roztok').classList.toggle('ely-aktivni', kapalina === 'roztok');
		// vysvětlení a hláška
		g('ely-vzorec').innerHTML = !sepnuto
			? 'Obvod je rozpojený — proud <strong>neprochází</strong>.'
			: pomedeni
				? 'Roztok skalice modré: CuSO₄ → Cu²⁺ + SO₄²⁻. Anoda je z mědi, katodou je pokovovaný předmět — <strong>měď se vylučuje na katodě</strong>.'
				: cista
					? 'Ampérmetr ukáže jen <strong>velmi malý proud</strong> — i čistá voda obsahuje nepatrné množství iontů (H⁺ a OH⁻). Na rozsvícení žárovky to nestačí.'
					: 'NaCl → Na⁺ + Cl⁻. Roztok kuchyňské soli je <strong>elektricky vodivý</strong> — proud tvoří usměrněný pohyb iontů.';
		let stav;
		if (pomedeni) {
			stav = sepnuto
				? '🥄 Z měděné anody se do roztoku uvolňují ionty mědi. Kationty Cu²⁺ putují k železné lžičce na KATODĚ a pokrývají ji vrstvou mědi — to je POMĚDĚNÍ. Měděná anoda se postupně rozpouští.'
				: '🥄 Měděná deska (anoda, vlevo) a železná lžička (katoda, vpravo) jsou v roztoku skalice modré (CuSO₄). Sepni obvod!';
		} else if (cista) {
			stav = sepnuto
				? '💧 Destilovaná voda není vodič elektrického proudu: obsahuje jen nepatrné množství iontů (H⁺ a OH⁻). Ampérmetr ukáže jen velmi malý proud a žárovka nesvítí. Přisyp sůl tlačítkem 🧂!'
				: '💧 V destilované vodě jsou hlavně molekuly H₂O a jen nepatrné množství iontů. Sepni obvod — a pak přisyp sůl.';
		} else {
			stav = sepnuto
				? '💡 Kationty Na⁺ putují k záporné KATODĚ, anionty Cl⁻ ke kladné ANODĚ — usměrněný pohyb iontů je proud, žárovka svítí.'
				: '🧂 Sůl se ve vodě rozpadla na ionty Na⁺ a Cl⁻ — roztok je připravený vést proud. Sepni obvod!';
		}
		g('ely-stav').textContent = stav;
	}

	for (const [id, r] of [['ely-r-pokus', 'pokus'], ['ely-r-pomedeni', 'pomedeni']]) {
		g(id).addEventListener('click', () => { rezim = r; kresli(); });
	}
	for (const [id, k] of [['ely-k-destilovana', 'destilovana'], ['ely-k-roztok', 'roztok']]) {
		g(id).addEventListener('click', () => { kapalina = k; kresli(); });
	}
	g('ely-spinac').addEventListener('click', () => { sepnuto = !sepnuto; kresli(); });
	kresli();
</script>

<style>
	#ely-svg { width: 100%; max-width: 460px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.ely-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.ely-tl.ely-aktivni { background: #ffe8cc; }
	.ely-tl:active { transform: translateY(1px); }
	.ely-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.ely-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
