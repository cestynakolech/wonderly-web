---
// Rezistor s proměnným odporem: TÝŽ jezdec ve dvou zapojeních.
// Reostat = zapojena jen část drátu, v sérii se žárovkou → reguluje PROUD.
// Potenciometr = drát připojen oběma konci, jezdec dělí napětí → reguluje NAPĚTÍ.
//
// POZOR na past, kterou našel nezávislý kontrolor: dělič napětí se počítá NAPRÁZDNO,
// takže na výstupu nesmí viset žárovka 10 Ω — zatížený dělič by dával až dvakrát menší
// napětí, než by simulace ukazovala. Proto je u potenciometru na výstupu VOLTMETR
// (odebírá zanedbatelný proud) — a přesně tak se potenciometr v praxi používá:
// ovládání hlasitosti, jasu nebo snímač polohy dodávají napětí do citlivého vstupu.
//
// Zdroj 12 V, odporový drát 40 Ω, žárovka 10 Ω, krok jezdce 25 %:
// reostat  → R = 10/20/30/40/50 Ω, I = 1200/600/400/300/240 mA (vše celé)
// potenciometr → U = 12/9/6/3/0 V (vše celé)
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Reostat a potenciometr — jeden jezdec, dvě práce 🕹️</span></h2>
	<p>Posouvej <strong>jezdcem</strong> po odporovém drátu a přepínej zapojení. Všimni si, že <strong>zapojení mění to, co jezdec ovládá</strong> — jednou proud, podruhé napětí.</p>
	<svg id="reo-svg" viewBox="0 0 520 300" role="img" aria-label="Odporový drát s posuvným jezdcem, zdroj a spotřebič; přepínání mezi zapojením reostatu a potenciometru">
		<!-- spodní kolejnice (záporný pól) -->
		<path d="M60 250 L460 250" fill="none" stroke="#2b2a26" stroke-width="4" />
		<!-- zdroj vlevo: dlouhá tenká deska = +, krátká tlustá = − -->
		<path d="M60 250 L60 168" fill="none" stroke="#2b2a26" stroke-width="4" />
		<line x1="48" y1="168" x2="72" y2="168" stroke="#2b2a26" stroke-width="6" />
		<line x1="42" y1="150" x2="78" y2="150" stroke="#2b2a26" stroke-width="3" />
		<path d="M60 150 L60 96 L110 96" fill="none" stroke="#2b2a26" stroke-width="4" />
		<text x="30" y="146" text-anchor="middle" font-size="15" font-weight="bold" fill="#e03131">+</text>
		<text x="30" y="180" text-anchor="middle" font-size="17" font-weight="bold" fill="#1971c2">−</text>
		<text x="60" y="220" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">12 V</text>

		<!-- odporový drát (40 Ω celkem): levá a pravá část se barví zvlášť -->
		<rect id="reo-cast-l" x="110" y="88" width="0" height="16" fill="#ffa94d" />
		<rect id="reo-cast-p" x="110" y="88" width="300" height="16" fill="#ffec99" />
		<rect x="110" y="88" width="300" height="16" fill="none" stroke="#2b2a26" stroke-width="3" rx="3" />
		<text x="260" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#868e96">odporový drát 40 Ω</text>
		<text id="reo-popis-l" x="180" y="126" text-anchor="middle" font-size="12" font-weight="bold" fill="#e8590c"></text>
		<text id="reo-popis-p" x="360" y="126" text-anchor="middle" font-size="12" font-weight="bold" fill="#f08c00"></text>

		<!-- připojení pravého konce ke kolejnici — JEN u potenciometru -->
		<path id="reo-pravy" d="M410 104 L410 250" fill="none" stroke="#2b2a26" stroke-width="4" opacity="0" />

		<!-- jezdec -->
		<g id="reo-jezdec">
			<path d="M-9 -18 L9 -18 L0 -2 Z" fill="#1971c2" stroke="#2b2a26" stroke-width="2" />
			<line x1="0" y1="-18" x2="0" y2="-40" stroke="#2b2a26" stroke-width="4" />
		</g>
		<!-- vodič od jezdce ke spotřebiči a od spotřebiče zpět na kolejnici (uzavřený obvod!) -->
		<path id="reo-vodic" d="M260 48 L460 48 L460 154" fill="none" stroke="#2b2a26" stroke-width="4" />
		<path d="M460 206 L460 250" fill="none" stroke="#2b2a26" stroke-width="4" />

		<!-- spotřebič vpravo: žárovka (reostat) NEBO voltmetr (potenciometr) -->
		<g id="reo-zarovka-g">
			<circle id="reo-zarovka" cx="460" cy="180" r="26" fill="#ffe066" stroke="#2b2a26" stroke-width="3" />
			<path d="M442 162 L478 198 M478 162 L442 198" fill="none" stroke="#2b2a26" stroke-width="2.5" />
			<text x="460" y="228" text-anchor="middle" font-size="12" font-weight="bold" fill="#868e96">žárovka 10 Ω</text>
		</g>
		<g id="reo-voltmetr-g" opacity="0">
			<circle cx="460" cy="180" r="26" fill="#fff" stroke="#2b2a26" stroke-width="3" />
			<text x="460" y="186" text-anchor="middle" font-size="18" font-weight="bold" fill="#2b2a26">V</text>
			<text x="460" y="228" text-anchor="middle" font-size="12" font-weight="bold" fill="#868e96">voltmetr</text>
		</g>

		<!-- údaje -->
		<text id="reo-udaj1" x="180" y="180" text-anchor="middle" font-size="17" font-weight="bold" fill="#e8590c"></text>
		<text id="reo-udaj2" x="180" y="206" text-anchor="middle" font-size="17" font-weight="bold" fill="#1971c2"></text>
	</svg>

	<label class="sim-posuvnik">
		Poloha jezdce: <output id="reo-out"></output>
		<input type="range" id="reo-jezdec-vstup" min="0" max="100" step="25" value="0" />
	</label>
	<p class="reo-radek">
		<strong>Zapojení:</strong>
		<button type="button" class="reo-tl reo-z-tl reo-aktivni" data-rezim="reostat">reostat (reguluje proud)</button>
		<button type="button" class="reo-tl reo-z-tl" data-rezim="potenciometr">potenciometr (dělí napětí)</button>
	</p>
	<p class="reo-stav" id="reo-stav"></p>
</section>

<script>
	const posuvnik = document.getElementById('reo-jezdec-vstup');
	const out = document.getElementById('reo-out');
	const zTlacitka = document.querySelectorAll('.reo-z-tl');
	const jezdec = document.getElementById('reo-jezdec');
	const vodic = document.getElementById('reo-vodic');
	const castL = document.getElementById('reo-cast-l');
	const castP = document.getElementById('reo-cast-p');
	const popisL = document.getElementById('reo-popis-l');
	const popisP = document.getElementById('reo-popis-p');
	const pravy = document.getElementById('reo-pravy');
	const zarovkaG = document.getElementById('reo-zarovka-g');
	const voltmetrG = document.getElementById('reo-voltmetr-g');
	const zarovka = document.getElementById('reo-zarovka');
	const udaj1 = document.getElementById('reo-udaj1');
	const udaj2 = document.getElementById('reo-udaj2');
	const stavEl = document.getElementById('reo-stav');
	const svg = document.getElementById('reo-svg');

	const U = 12, R_ZAROVKA = 10, R_DRAT = 40;
	const X0 = 110, SIRKA = 300;
	let rezim = 'reostat';

	const cz = (x, des) => x.toLocaleString('cs-CZ', { maximumFractionDigits: des });

	// ČISTÉ funkce — ověřitelné výpočtem bez prohlížeče. f = poloha jezdce zleva (0 až 1).
	function reostat(f) {
		const Rzapojeno = R_DRAT * f;               // do obvodu vstupuje jen LEVÁ část drátu
		const R = R_ZAROVKA + Rzapojeno;
		const I = U / R;
		// jas se řídí VÝKONEM (P = R·I²), ne proudem — proto při 240 mA žárovka jen doutná
		return { Rzapojeno, R, I, jas: (I * I) / ((U / R_ZAROVKA) ** 2) };
	}
	function potenciometr(f) {
		// drát je připojen oběma konci; výstup se bere mezi jezdcem a pravým koncem.
		// Na výstupu je VOLTMETR, který odebírá zanedbatelný proud → dělič naprázdno.
		return { R1: R_DRAT * f, R2: R_DRAT * (1 - f), Uvystup: U * (1 - f) };
	}

	function prekresli() {
		const f = +posuvnik.value / 100;
		const jx = X0 + f * SIRKA;
		out.textContent = Math.round(f * 100) + ' %';
		jezdec.setAttribute('transform', `translate(${jx.toFixed(1)}, 88)`);
		vodic.setAttribute('d', `M${jx.toFixed(1)} 48 L460 48 L460 154`);

		if (rezim === 'reostat') {
			const v = reostat(f);
			// zapojená je jen levá část
			castL.setAttribute('x', X0); castL.setAttribute('width', (f * SIRKA).toFixed(1));
			castP.setAttribute('x', jx.toFixed(1)); castP.setAttribute('width', ((1 - f) * SIRKA).toFixed(1));
			castP.setAttribute('fill', '#f1f3f5');
			popisL.setAttribute('x', (X0 + f * SIRKA / 2).toFixed(1));
			popisL.textContent = f > 0 ? `zapojeno ${cz(v.Rzapojeno, 0)} Ω` : '';
			popisP.setAttribute('x', (jx + (1 - f) * SIRKA / 2).toFixed(1));
			popisP.textContent = f < 1 ? 'nezapojeno' : '';
			pravy.setAttribute('opacity', '0');
			zarovkaG.setAttribute('opacity', '1');
			voltmetrG.setAttribute('opacity', '0');
			udaj1.textContent = `R celkem = ${cz(v.R, 0)} Ω`;
			udaj2.textContent = `I = ${Math.round(v.I * 1000)} mA`;
			zarovka.setAttribute('fill', v.jas < 0.06 ? '#f1d9a0' : `rgb(255, ${Math.round(224 + 10 * v.jas)}, ${Math.round(160 - 58 * v.jas)})`);
			stavEl.textContent = f === 0
				? 'Jezdec vlevo: z drátu není zapojeno nic (0 Ω), obvodem teče největší proud 1200 mA a žárovka svítí naplno.'
				: `Do obvodu je zapojeno ${cz(v.Rzapojeno, 0)} Ω z drátu (pravá část je odpojená). Odpor v obvodu je ${cz(v.R, 0)} Ω, proud klesl na ${Math.round(v.I * 1000)} mA — reostat reguluje PROUD. Umí ho ale jen zmenšit, nikdy ne na nulu: žárovka nakonec jen slabě doutná.`;
		} else {
			const v = potenciometr(f);
			// zapojené jsou OBĚ části — každá jinou barvou
			castL.setAttribute('x', X0); castL.setAttribute('width', (f * SIRKA).toFixed(1));
			castP.setAttribute('x', jx.toFixed(1)); castP.setAttribute('width', ((1 - f) * SIRKA).toFixed(1));
			castP.setAttribute('fill', '#ffec99');
			popisL.setAttribute('x', (X0 + f * SIRKA / 2).toFixed(1));
			popisL.textContent = f > 0 ? `R₁ = ${cz(v.R1, 0)} Ω` : '';
			popisP.setAttribute('x', (jx + (1 - f) * SIRKA / 2).toFixed(1));
			popisP.textContent = f < 1 ? `R₂ = ${cz(v.R2, 0)} Ω` : '';
			pravy.setAttribute('opacity', '1');
			zarovkaG.setAttribute('opacity', '0');
			voltmetrG.setAttribute('opacity', '1');
			udaj1.textContent = 'napětí na výstupu';
			udaj2.textContent = `U = ${cz(v.Uvystup, 0)} V z 12 V`;
			stavEl.textContent = f === 1
				? 'Jezdec úplně vpravo: na výstupu zbylo 0 V. Potenciometr umí stáhnout napětí až na nulu — proto se jím dá ztlumit hlasitost do úplného ticha.'
				: `Jezdec rozdělil drát na dvě části (R₁ = ${cz(v.R1, 0)} Ω a R₂ = ${cz(v.R2, 0)} Ω) a napětí zdroje se mezi ně rozdělilo: na výstup připadá ${cz(v.Uvystup, 0)} V z 12 V. Potenciometr reguluje NAPĚTÍ — takhle funguje ovládání hlasitosti, jasu nebo snímač polohy.`;
		}
	}

	posuvnik.addEventListener('input', prekresli);
	zTlacitka.forEach((tl) => tl.addEventListener('click', () => {
		zTlacitka.forEach((t) => t.classList.remove('reo-aktivni'));
		tl.classList.add('reo-aktivni');
		rezim = tl.dataset.rezim;
		prekresli();
	}));
	prekresli();

	// ověřovací háčky
	svg.__reostat = reostat;
	svg.__potenciometr = potenciometr;
</script>

<style>
	#reo-svg { width: 100%; max-width: 520px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 520px; display: block; margin-top: 0.3rem; }
	.reo-radek { margin: 0.6rem 0; }
	.reo-tl { font: inherit; font-weight: 700; padding: 0.25rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.35rem 0.35rem 0; }
	.reo-tl.reo-aktivni { background: #ffe8cc; }
	.reo-tl:active { transform: translateY(1px); }
	.reo-stav { font-size: 1.05rem; font-weight: 700; min-height: 3.6rem; }
</style>
