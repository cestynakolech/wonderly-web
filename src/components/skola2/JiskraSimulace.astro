---
// Vedení proudu v plynech (F9). Režim „jiskra": dvě kulové elektrody, posuvníky
// napětí (0–18 kV po 3) a vzdálenost (1–5 mm po 1). Vzduch je izolant — prorazí
// ho až ~3 kV na každý milimetr mezery (práh = 3·d kV, vše celé). Režim „bouřka":
// blesk = obří jiskra do bleskosvodu (Franklin a Diviš, kanál 20 000–30 000 °C)
// + úloha „sekundy mezi bleskem a hromem ÷ 3 = km bouřky" (posuvník 3–15 s po 3).
// Bez časové animace; stav = čisté funkce stavJiskry(U,d) a stavBourky(s) na SVG.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Jiskra a blesk — když vzduch přestane izolovat 🕹️</span></h2>
	<p>Vzduch je <strong>špatný vodič</strong> — proud jím projde, až když ho silné elektrické pole <strong>ionizuje</strong>. Na 1 mm vzduchu je potřeba zhruba <strong>3 kV</strong>. Blesk je tatáž jiskra, jen kilometry dlouhá.</p>
	<p id="jis-rezimy">
		<button type="button" class="jis-tl jis-aktivni" data-rezim="jiskra">⚡ jiskra v laboratoři</button>
		<button type="button" class="jis-tl" data-rezim="bourka">🌩️ bouřka venku</button>
	</p>
	<svg id="jis-svg" viewBox="0 0 660 320" role="img" aria-label="Jiskřiště s elektrodami, nebo bouřkový mrak s bleskosvodem">
		<!-- REŽIM JISKRA -->
		<g id="jis-scena-jiskra">
			<line x1="60" y1="160" x2="235" y2="160" stroke="#2b2a26" stroke-width="6" />
			<circle id="jis-koule-l" cx="250" cy="160" r="16" fill="#868e96" stroke="#2b2a26" stroke-width="3" />
			<circle id="jis-koule-p" cy="160" r="16" fill="#868e96" stroke="#2b2a26" stroke-width="3" />
			<line id="jis-drat-p" y1="160" x2="600" y2="160" stroke="#2b2a26" stroke-width="6" />
			<polyline id="jis-jiskra" fill="none" stroke="#fab005" stroke-width="4" stroke-linejoin="round" />
			<text id="jis-mezera-pop" x="330" y="210" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26"></text>
			<text x="120" y="140" font-size="12" fill="#868e96">zdroj vysokého napětí</text>
			<text id="jis-udaje" x="330" y="60" text-anchor="middle" font-size="17" font-weight="bold" fill="#2b2a26"></text>
			<text id="jis-prah-pop" x="330" y="85" text-anchor="middle" font-size="13" fill="#868e96"></text>
		</g>
		<!-- REŽIM BOUŘKA -->
		<g id="jis-scena-bourka" visibility="hidden">
			<rect x="20" y="270" width="620" height="30" fill="#b2f2bb" stroke="#2b2a26" stroke-width="2" />
			<g fill="#adb5bd" stroke="#495057" stroke-width="2">
				<ellipse cx="290" cy="70" rx="90" ry="32" /><ellipse cx="210" cy="85" rx="55" ry="26" /><ellipse cx="380" cy="85" rx="60" ry="26" />
			</g>
			<text x="290" y="78" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">− − − −</text>
			<!-- domek s bleskosvodem -->
			<rect x="440" y="210" width="90" height="60" fill="#ffe8cc" stroke="#2b2a26" stroke-width="3" />
			<polygon points="430,210 540,210 485,175" fill="#e8590c" stroke="#2b2a26" stroke-width="3" />
			<line x1="485" y1="175" x2="485" y2="145" stroke="#2b2a26" stroke-width="4" />
			<text x="580" y="160" font-size="11" fill="#868e96">bleskosvod</text>
			<polyline id="jis-blesk" points="350,100 320,150 345,155 300,215 330,205 290,262 485,148" fill="none" stroke="#fab005" stroke-width="5" stroke-linejoin="round" visibility="hidden" />
			<text id="jis-blesk-info" x="180" y="140" font-size="13" font-weight="bold" fill="#e8590c"></text>
			<text id="jis-bourka-vysledek" x="330" y="30" text-anchor="middle" font-size="15" font-weight="bold" fill="#1971c2"></text>
		</g>
	</svg>
	<div id="jis-ovladani-jiskra">
		<label class="sim-posuvnik">Napětí zdroje: <output id="jis-out-u"></output>
			<input type="range" id="jis-u" min="0" max="18" step="3" value="6" />
		</label>
		<label class="sim-posuvnik">Vzdálenost elektrod: <output id="jis-out-d"></output>
			<input type="range" id="jis-d" min="1" max="5" step="1" value="3" />
		</label>
	</div>
	<div id="jis-ovladani-bourka" style="display:none">
		<p><button type="button" class="jis-tl" id="jis-zablyskni">🌩️ zablýskni</button></p>
		<label class="sim-posuvnik">Hrom slyšíš za: <output id="jis-out-s"></output>
			<input type="range" id="jis-s" min="3" max="15" step="3" value="9" />
		</label>
	</div>
	<p class="jis-vzorec" id="jis-vzorec"></p>
	<p class="jis-stav" id="jis-stav">👉 Zvyšuj napětí, nebo přibliž elektrody — a sleduj, kdy vzduch „praskne".</p>
</section>

<script>
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	const KV_NA_MM = 3; // průrazné napětí vzduchu ≈ 3 kV na 1 mm
	function stavJiskry(U, d) {
		const prah = KV_NA_MM * d; // kV — pro celé d vždy celé
		return { prah, preskoci: U >= prah && U > 0, chybi: Math.max(prah - U, 0) };
	}
	function stavBourky(sekundy) {
		return { km: sekundy / 3 }; // zvuk ~333 m/s → 3 s na 1 km; posuvník po 3 s → celé km
	}
	// === KONEC ČISTÉ ČÁSTI ===

	let rezim = 'jiskra';
	let blesklo = false;
	const svg = document.getElementById('jis-svg');
	svg.__stavJiskry = stavJiskry; svg.__stavBourky = stavBourky; // pro nezávislou kontrolu
	const g = (id) => document.getElementById(id);
	const nastav = (id, attrs) => { const el = g(id); for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v); };

	function kresliJiskru() {
		const U = +g('jis-u').value, d = +g('jis-d').value;
		const s = stavJiskry(U, d);
		g('jis-out-u').textContent = `${U} kV (${(U * 1000).toLocaleString('cs-CZ')} V)`;
		g('jis-out-d').textContent = `${d} mm`;
		// pravá koule: mezera 22 px na mm
		const xL = 266, xP = 266 + d * 22 + 16;
		nastav('jis-koule-p', { cx: xP });
		nastav('jis-drat-p', { x1: xP + 15 });
		g('jis-mezera-pop').textContent = `mezera ${d} mm vzduchu`;
		// klikatá jiskra mezi koulemi
		if (s.preskoci) {
			const stred = (xL + xP - 16) / 2;
			nastav('jis-jiskra', { points: `${xL},160 ${stred - 8},148 ${stred},172 ${stred + 8},150 ${xP - 16},160`, visibility: 'visible' });
		} else nastav('jis-jiskra', { visibility: 'hidden' });
		g('jis-udaje').textContent = s.preskoci ? '⚡ PŘESKOČILA JISKRA!' : 'vzduch drží — jiskra nepřeskočí';
		g('jis-prah-pop').textContent = `práh pro ${d} mm: ${s.prah} kV`;
		g('jis-vzorec').innerHTML = `Potřebné napětí = 3 kV × ${d} mm = <strong>${s.prah} kV</strong>. Máš ${U} kV → ${s.preskoci ? '<strong>vzduch se ionizoval a vede</strong>' : `chybí ještě <strong>${s.chybi} kV</strong>`}.`;
		g('jis-stav').textContent = s.preskoci
			? '⚡ Silné pole vytrhlo elektrony z molekul (IONIZACE) — vzduch se stal vodičem a proud přeskočil jako horká jiskra. Stejně vzniká blesk i oblouk při svařování.'
			: U === 0 ? '🔌 Bez napětí se nic neděje. Přidej napětí, nebo přibliž elektrody.'
			: '🛡️ Vzduch je zatím izolant. Zvyš napětí, nebo elektrody přibliž — na menší mezeru stačí méně kV.';
	}

	function kresliBourku() {
		const s = stavBourky(+g('jis-s').value);
		g('jis-out-s').textContent = `${g('jis-s').value} s`;
		nastav('jis-blesk', { visibility: blesklo ? 'visible' : 'hidden' });
		g('jis-blesk-info').textContent = blesklo ? 'kanál blesku: 20 000–30 000 °C!' : '';
		g('jis-zablyskni').textContent = blesklo ? '🌫️ schovej blesk' : '🌩️ zablýskni';
		g('jis-bourka-vysledek').textContent = `bouřka je ${s.km} km daleko (${g('jis-s').value} s ÷ 3)`;
		g('jis-vzorec').innerHTML = `Světlo blesku vidíš hned, hrom letí jen ~⅓ km za sekundu. Vzdálenost bouřky = sekundy ÷ 3 = ${g('jis-s').value} ÷ 3 = <strong>${s.km} km</strong>.`;
		g('jis-stav').textContent = blesklo
			? '🌩️ Blesk = obří jiskrový výboj dlouhý 2–3 km. Uhodil do BLESKOSVODU (vynález B. Franklina, u nás Prokop Diviš) — ten ho bezpečně svede do země. Hrom je rozpínající se ohřátý vzduch.'
			: '👉 Zablýskni tlačítkem a pak posuvníkem spočítej, jak daleko bouřka je. Čím dřív hrom, tím blíž!';
	}

	function prekresli() {
		g('jis-scena-jiskra').setAttribute('visibility', rezim === 'jiskra' ? 'visible' : 'hidden');
		g('jis-scena-bourka').setAttribute('visibility', rezim === 'bourka' ? 'visible' : 'hidden');
		document.getElementById('jis-ovladani-jiskra').style.display = rezim === 'jiskra' ? '' : 'none';
		document.getElementById('jis-ovladani-bourka').style.display = rezim === 'bourka' ? '' : 'none';
		for (const b of document.querySelectorAll('#jis-rezimy [data-rezim]')) b.classList.toggle('jis-aktivni', b.dataset.rezim === rezim);
		if (rezim === 'jiskra') kresliJiskru(); else kresliBourku();
	}

	document.getElementById('jis-rezimy').addEventListener('click', (e) => {
		const tl = e.target.closest('[data-rezim]');
		if (!tl) return; rezim = tl.dataset.rezim; prekresli();
	});
	g('jis-zablyskni').addEventListener('click', () => { blesklo = !blesklo; kresliBourku(); });
	g('jis-u').addEventListener('input', kresliJiskru);
	g('jis-d').addEventListener('input', kresliJiskru);
	g('jis-s').addEventListener('input', kresliBourku);
	prekresli();
</script>

<style>
	#jis-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.jis-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.jis-tl.jis-aktivni { background: #ffe8cc; }
	.jis-tl:active { transform: translateY(1px); }
	.jis-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.jis-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
