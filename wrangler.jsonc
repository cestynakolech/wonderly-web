{
	"name": "wonderly-web",
	"compatibility_date": "2026-06-11",
	"main": "./worker.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "wonderly-media"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "LIGA",
				"class_name": "LigaMistnost"
			}
		]
	},
	"migrations": [
		{
			"tag": "liga-v1",
			"new_sqlite_classes": ["LigaMistnost"]
		}
	]
}
