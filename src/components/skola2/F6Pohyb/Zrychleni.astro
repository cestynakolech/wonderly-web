---
// F6 Pohyb — Zrychlení (změna rychlosti, definice, výpočet)
// SVG diagram ukazuje zrychlení v různých situacích
---

<section class="ramecek f6-diagram">
	<h3>🚀 Zrychlení — změna rychlosti za jednotku času</h3>
	<svg viewBox="0 0 450 400" class="diagram-svg zrychleni-diagram">
		<!-- Pozadí -->
		<rect width="450" height="400" fill="#f7f9fc" />

		<!-- Název -->
		<text x="225" y="25" text-anchor="middle" font-size="16" font-weight="bold" fill="#1565c0">Zrychlení (a)</text>

		<!-- Definice a vzorec -->
		<rect x="20" y="40" width="410" height="55" fill="#ffebee" stroke="#c41e3a" stroke-width="1.5" rx="4" />
		<text x="30" y="60" font-size="11" font-weight="600" fill="#b71c1c">DEFINICE: Zrychlení = Změna rychlosti ÷ Čas</text>
		<text x="30" y="77" font-size="10" fill="#333">a = Δv / t = (v₂ − v₁) / (t₂ − t₁)</text>
		<text x="30" y="92" font-size="9" fill="#c41e3a">kde: a = zrychlení (m/s²), Δv = změna rychlosti (m/s), t = čas (s)</text>

		<!-- Interpretace zrychlení -->
		<g>
			<!-- Kladné zrychlení -->
			<rect x="20" y="115" width="200" height="95" fill="#c8e6c9" stroke="#2e7d32" stroke-width="1.5" rx="4" />
			<text x="30" y="135" font-size="10" font-weight="600" fill="#1b5e20">Kladné zrychlení (a > 0)</text>
			<text x="30" y="152" font-size="9" fill="#333">• Rychlost ROSTE</text>
			<text x="30" y="165" font-size="9" fill="#333">• Těleso se ZRYCHLUJE</text>

			<!-- Diagram: Rychlost roste -->
			<circle cx="50" cy="175" r="4" fill="#c41e3a" />
			<line x1="60" y1="175" x2="85" y2="175" stroke="#666" stroke-width="2" marker-end="url(#arrowhead-sm-r)" />
			<text x="90" y="180" font-size="8" fill="#333">→</text>

			<circle cx="105" cy="175" r="5" fill="#c41e3a" />
			<line x1="115" y1="175" x2="155" y2="175" stroke="#666" stroke-width="2.5" marker-end="url(#arrowhead-sm-r)" />
			<text x="165" y="180" font-size="8" fill="#333">→→</text>

			<text x="30" y="200" font-size="8" fill="#333">Příklad: Auto zrychluje,</text>
			<text x="30" y="210" font-size="8" fill="#333">zvyšuje si rychlost z 0 na 100 km/h</text>
		</g>

		<!-- Záporné zrychlení (Zpomalení) -->
		<g>
			<rect x="230" y="115" width="200" height="95" fill="#ffccbc" stroke="#d84315" stroke-width="1.5" rx="4" />
			<text x="240" y="135" font-size="10" font-weight="600" fill="#bf360c">Záporné zrychlení (a < 0)</text>
			<text x="240" y="152" font-size="9" fill="#333">• Rychlost KLESÁ</text>
			<text x="240" y="165" font-size="9" fill="#333">• Těleso se ZPOMALUJE</text>

			<!-- Diagram: Rychlost klesá -->
			<circle cx="270" cy="175" r="6" fill="#c41e3a" />
			<line x1="280" y1="175" x2="305" y2="175" stroke="#666" stroke-width="3" marker-end="url(#arrowhead-sm-r)" />
			<text x="310" y="180" font-size="8" fill="#333">→→→</text>

			<circle cx="325" cy="175" r="5" fill="#c41e3a" />
			<line x1="335" y1="175" x2="360" y2="175" stroke="#666" stroke-width="2" marker-end="url(#arrowhead-sm-r)" />
			<text x="365" y="180" font-size="8" fill="#333">→</text>

			<text x="240" y="200" font-size="8" fill="#333">Příklad: Auto brzdí,</text>
			<text x="240" y="210" font-size="8" fill="#333">snižuje si rychlost ze 100 na 0 km/h</text>
		</g>

		<!-- Tabulka s příklady zrychlení -->
		<rect x="20" y="225" width="410" height="95" fill="#e1f5fe" stroke="#0277bd" stroke-width="1.5" rx="4" />
		<text x="30" y="245" font-size="11" font-weight="600" fill="#01579b">Příklady zrychlení v běžném životě</text>

		<!-- Řádky tabulky -->
		<g font-size="9" fill="#333">
			<text x="30" y="265" font-weight="600" fill="#0277bd">Případ</text>
			<text x="180" y="265" font-weight="600" fill="#0277bd">Zrychlení (m/s²)</text>
			<text x="320" y="265" font-weight="600" fill="#0277bd">Typ</text>

			<line x1="20" y1="270" x2="430" y2="270" stroke="#ccc" stroke-width="1" />

			<text x="30" y="287">Volný pád (Země)</text>
			<text x="180" y="287">9,81 m/s²</text>
			<text x="320" y="287">Kladné</text>

			<text x="30" y="302">Auto zrychluje 0-100 km/h (10 s)</text>
			<text x="180" y="302">~2,8 m/s²</text>
			<text x="320" y="302">Kladné</text>

			<text x="30" y="317">Brzdění auta (emergency)</text>
			<text x="180" y="317">−8 až −10 m/s²</text>
			<text x="320" y="317">Záporné</text>
		</g>

		<!-- Graf v-t (rychlost vs čas) s ukázkou zrychlení -->
		<rect x="20" y="335" width="410" height="70" fill="#fff3e0" stroke="#e65100" stroke-width="1.5" rx="4" />
		<text x="30" y="352" font-size="10" font-weight="600" fill="#e65100">Graf v-t: Sklон přímky = zrychlení</text>

		<!-- Miniaturní graf -->
		<g font-size="8" fill="#333">
			<!-- Osy -->
			<line x1="50" y1="380" x2="180" y2="380" stroke="#333" stroke-width="1" />
			<line x1="50" y1="360" x2="50" y2="380" stroke="#333" stroke-width="1" />

			<!-- Přímka: rostoucí (kladné a) -->
			<polyline points="50,378 90,368 130,360 170,370" stroke="#c41e3a" stroke-width="2" fill="none" />
			<text x="155" y="348" font-size="8" fill="#c41e3a" font-weight="600">a > 0</text>

			<!-- Přímka: klesající (záporné a) -->
			<polyline points="230,360 270,368 310,378 350,380" stroke="#d84315" stroke-width="2" fill="none" />
			<text x="295" y="348" font-size="8" fill="#d84315" font-weight="600">a < 0</text>

			<!-- Přímka: vodorovná (a = 0) -->
			<line x1="410" y1="370" x2="430" y2="370" stroke="#2e7d32" stroke-width="2" />
			<text x="410" y="358" font-size="8" fill="#2e7d32" font-weight="600">a = 0</text>

			<text x="65" y="393" font-size="7" fill="#666">čas →</text>
		</g>

		<!-- Arrow markers -->
		<defs>
			<marker id="arrowhead-sm-r" markerWidth="6" markerHeight="6" refX="5" refY="2" orient="auto">
				<polygon points="0 0, 6 2, 0 4" fill="#666" />
			</marker>
		</defs>
	</svg>

	<div class="poznamka">
		<strong>Zapamatuj si:</strong> Zrychlení měří, jak RYCHLE se mění rychlost. Kladné zrychlení = těleso
		se zrychluje. Záporné zrychlení (zpomalení) = těleso se zpomaluje. Jednotka: m/s² (metr za sekundu na druhou).
	</div>
</section>

<style>
	.f6-diagram {
		margin: 1.5rem 0;
		padding: 1.5rem;
		border: 2px solid #1976d2;
		border-radius: 8px;
		background: #f9fafc;
	}

	.f6-diagram h3 {
		margin: 0 0 1rem 0;
		color: #1565c0;
		font-size: 1.25rem;
	}

	.diagram-svg {
		width: 100%;
		max-width: 500px;
		margin: 1rem auto;
		display: block;
		border-radius: 6px;
		background: white;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.poznamka {
		margin-top: 1rem;
		padding: 0.8rem;
		background: #fff3cd;
		border-left: 4px solid #ffc107;
		border-radius: 4px;
		font-size: 0.95rem;
		color: #856404;
	}
</style>
