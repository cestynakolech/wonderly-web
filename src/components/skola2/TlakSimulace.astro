---
// Tlak (F7): interaktivní simulace se čtyřmi scénami
// 1. Co je tlak — částice vzduchu se pohybují a narážejí do stěn
// 2. Tlak = síla/plocha — stlačení zvyšuje tlak (Boyle-Mariotteův zákon)
// 3. Hloubka v kapalinách — větší hloubka = větší tlak
// 4. Atmosferický tlak — vzduch kolem nás vyvíjí sílu
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Tlak — skrytá síla 🕹️</span></h2>
	<p>Tlak vzniká, když částice plynu či kapaliny narážejí do stěn a vyvíjejí na ně sílu. Změníš-li objem, zvýšíš tlak. V hloubce se tlak zvyšuje — a kolem nás všech je atmosferický tlak!</p>

	<!-- SCÉNA 1: Co je tlak — částice narážejí -->
	<div class="scena" id="scena1">
		<h3>Scéna 1: Co je to tlak?</h3>
		<svg viewBox="0 0 400 300" role="img" aria-label="Nádoba s molekulami vzduchu" class="tlak-svg">
			<!-- Nádoba -->
			<rect x="50" y="50" width="300" height="150" fill="#e7f5ff" stroke="#2b2a26" stroke-width="3" />
			<!-- Molekuly vzduchu -->
			<g id="s1-molekuly" fill="#0099ff" opacity="0.7"></g>
			<!-- Teplotní meter -->
			<g>
				<text x="20" y="80" font-size="14" font-weight="bold">T:</text>
				<rect x="20" y="90" width="20" height="60" fill="#fff" stroke="#2b2a26" stroke-width="2" />
				<rect id="s1-teplota-rucka" x="22" y="130" width="16" height="20" fill="#e03131" />
				<text id="s1-temp-val" x="20" y="160" font-size="12">20°C</text>
			</g>
			<!-- Tlak -->
			<text x="200" y="250" text-anchor="middle" font-size="18" font-weight="bold" fill="#2b2a26">Tlak = nárazy částic do stěn</text>
			<text id="s1-tlak-val" x="200" y="275" text-anchor="middle" font-size="16" fill="#0099ff">100 kPa (normální)</text>
		</svg>
		<label class="sim-posuvnik">
			Zvyš teplotu (molekuly se zrychlují):
			<input type="range" id="s1-teplot" min="0" max="2" step="1" value="1" />
		</label>
		<p class="popis" id="s1-text">Když zvýšíš teplotu, molekuly se pohybují rychleji a narážejí do stěn silněji — tlak roste. Toto je Gay-Lussacův zákon: p/T = konst.</p>
	</div>

	<!-- SCÉNA 2: Tlak vs. objem (Boyle-Mariotte) -->
	<div class="scena" id="scena2">
		<h3>Scéna 2: Stlačení zvyšuje tlak</h3>
		<svg viewBox="0 0 500 300" role="img" aria-label="Píst stlačující plyn" class="tlak-svg">
			<!-- Válec s pístem -->
			<g stroke="#2b2a26" stroke-width="3">
				<rect x="50" y="60" width="300" height="180" fill="#f0f0f0" stroke="#2b2a26" />
			</g>
			<!-- Píst -->
			<rect id="s2-pist" x="340" y="60" width="20" height="180" fill="#adb5bd" stroke="#2b2a26" stroke-width="3" />
			<rect id="s2-tyc" x="360" y="140" width="80" height="20" fill="#868e96" stroke="#2b2a26" stroke-width="2" />
			<!-- Molekuly -->
			<g id="s2-molekuly" fill="#0099ff" opacity="0.6"></g>
			<!-- Zobrazení tlaku -->
			<g text-anchor="middle">
				<text x="200" y="270" font-size="14" font-weight="bold" fill="#2b2a26">Objem:</text>
				<text id="s2-objem" x="200" y="290" font-size="18" fill="#0099ff" font-weight="bold">100 %</text>
			</g>
			<g text-anchor="middle">
				<text x="420" y="30" font-size="14" font-weight="bold" fill="#2b2a26">Tlak:</text>
				<text id="s2-tlak" x="420" y="50" font-size="18" fill="#e03131" font-weight="bold">100 kPa</text>
			</g>
		</svg>
		<label class="sim-posuvnik">
			Stlač píst (posuvník doleva):
			<input type="range" id="s2-pist-slider" min="0" max="3" step="1" value="0" />
		</label>
		<p class="popis" id="s2-text">Při **stejné teplotě** — když zmenšíš objem na polovinu, tlak se *zdvojnásobí*. Když zmenšíš na čtvrtinu, tlak se zvětší čtyřikrát. Toto je **Boyle-Mariotteův zákon**: p·V = konst.</p>
	</div>

	<!-- SCÉNA 3: Tlak v kapalinách — hloubka -->
	<div class="scena" id="scena3">
		<h3>Scéna 3: Tlak roste s hloubkou</h3>
		<svg viewBox="0 0 400 400" role="img" aria-label="Voda s měřením tlaku v různých hloubkách" class="tlak-svg">
			<!-- Voda -->
			<rect x="50" y="50" width="300" height="300" fill="#5dade2" opacity="0.6" stroke="#2b2a26" stroke-width="3" />
			<text x="50" y="35" font-size="12" fill="#2b2a26">VODA</text>
			<!-- Manometry v různých hloubkách -->
			<g id="s3-mano1">
				<circle cx="350" cy="80" r="20" fill="#fff" stroke="#2b2a26" stroke-width="2" />
				<text x="350" y="85" text-anchor="middle" font-size="14" font-weight="bold" fill="#2b2a26">1</text>
				<line x1="330" y1="80" x2="330" y2="60" stroke="#2b2a26" stroke-width="2" />
				<text id="s3-p1" x="330" y="50" font-size="12" fill="#2b2a26">101 kPa</text>
			</g>
			<g id="s3-mano2">
				<circle cx="350" cy="175" r="20" fill="#fff" stroke="#2b2a26" stroke-width="2" />
				<text x="350" y="180" text-anchor="middle" font-size="14" font-weight="bold" fill="#2b2a26">2</text>
				<line x1="330" y1="175" x2="330" y2="155" stroke="#2b2a26" stroke-width="2" />
				<text id="s3-p2" x="330" y="145" font-size="12" fill="#2b2a26">111 kPa</text>
			</g>
			<g id="s3-mano3">
				<circle cx="350" cy="270" r="20" fill="#fff" stroke="#2b2a26" stroke-width="2" />
				<text x="350" y="275" text-anchor="middle" font-size="14" font-weight="bold" fill="#2b2a26">3</text>
				<line x1="330" y1="270" x2="330" y2="250" stroke="#2b2a26" stroke-width="2" />
				<text id="s3-p3" x="330" y="240" font-size="12" fill="#2b2a26">121 kPa</text>
			</g>
			<!-- Hloubka -->
			<g text-anchor="middle">
				<text x="30" y="100" font-size="11" fill="#2b2a26">0 m</text>
				<text x="30" y="195" font-size="11" fill="#2b2a26">5 m</text>
				<text x="30" y="290" font-size="11" fill="#2b2a26">10 m</text>
			</g>
		</svg>
		<label class="sim-posuvnik">
			Zvyš hloubku ponoru:
			<input type="range" id="s3-hlubka" min="0" max="2" step="1" value="0" />
		</label>
		<p class="popis" id="s3-text">V kapalinách platí: čím větší hloubka, tím vyšší tlak. Každých 10 metrů hloubky v moři zvýší tlak o ~100 kPa. Proto se potápěči postupně zvykují na tlak — v hloubce 40 m je tlak 5× větší!</p>
	</div>

	<!-- SCÉNA 4: Atmosferický tlak -->
	<div class="scena" id="scena4">
		<h3>Scéna 4: Atmosferický tlak — vzduch kolem nás</h3>
		<svg viewBox="0 0 500 350" role="img" aria-label="Atmosferický tlak" class="tlak-svg">
			<!-- Zemský povrch -->
			<rect x="0" y="200" width="500" height="150" fill="#8b7355" />
			<!-- Vzduch (molekuly) -->
			<g id="s4-molekuly" fill="#87ceeb" opacity="0.5"></g>
			<!-- Člověk (zjednodušené) -->
			<g>
				<circle cx="250" cy="130" r="20" fill="#f4a460" stroke="#2b2a26" stroke-width="2" /> <!-- hlava -->
				<rect x="235" y="150" width="30" height="50" fill="#1e90ff" stroke="#2b2a26" stroke-width="2" /> <!-- tělo -->
				<line x1="235" y1="170" x2="220" y2="200" stroke="#2b2a26" stroke-width="2" /> <!-- levá noha -->
				<line x1="265" y1="170" x2="280" y2="200" stroke="#2b2a26" stroke-width="2" /> <!-- pravá noha -->
			</g>
			<!-- Tlakové šipky -->
			<g id="s4-sipky" stroke="#e03131" stroke-width="3" marker-end="url(#arrowhead)">
				<!-- Šipky ze všech stran -->
				<line x1="100" y1="130" x2="220" y2="130" />
				<line x1="400" y1="130" x2="280" y2="130" />
				<line x1="250" y1="50" x2="250" y2="100" />
				<line x1="250" y2="200" x2="250" y2="150" />
			</g>
			<!-- Text s hodnotou tlaku -->
			<text x="250" y="300" text-anchor="middle" font-size="16" font-weight="bold" fill="#2b2a26">Atmosferický tlak: ~101 kPa (1 bar)</text>
			<text id="s4-sila" x="250" y="330" text-anchor="middle" font-size="14" fill="#e03131">Na tvé tváři: ~2 tun síly!</text>
		</svg>
		<p class="popis" id="s4-text">
			Vzduch má váhu — a kolem nás všech je obaluje. Celá hmota atmosféry tlačí na každého z nás silou cca 2 tuny!
			🤔 Necítíš to, protože tlak je **vyrovnaný** — uvnitř tvého těla je stejný tlak jako venku, takže se vzájemně ruší.
			Kdyby to nebyla pravda, zvětřela by ses jak balónek.
		</p>
	</div>

	<!-- Výběr scén -->
	<div class="sceny-ovladani">
		<button class="scene-btn" data-scene="1" type="button">Scéna 1: Co je to?</button>
		<button class="scene-btn" data-scene="2" type="button">Scéna 2: Stlačení</button>
		<button class="scene-btn" data-scene="3" type="button">Scéna 3: Hloubka</button>
		<button class="scene-btn active" data-scene="4" type="button">Scéna 4: Atmosféra</button>
	</div>
</section>

<script>
	// SCÉNA 1: Teplota a tlak
	const s1Slider = document.getElementById('s1-teplot');
	const s1MolWrapper = document.getElementById('s1-molekuly');
	const s1TempVal = document.getElementById('s1-temp-val');
	const s1TlakVal = document.getElementById('s1-tlak-val');
	const s1Text = document.getElementById('s1-text');
	const s1TepotaRucka = document.getElementById('s1-teplota-rucka');

	function renderS1() {
		const idx = +s1Slider.value;
		const temps = [0, 20, 40];
		const tlaks = [80, 100, 120]; // kPa (zjednodušeno)
		const t = temps[idx];
		const p = tlaks[idx];

		s1TempVal.textContent = `${t}°C`;
		s1TlakVal.textContent = `${p} kPa`;

		// Animace teploty v teploměru
		const ruckaY = [130, 110, 90][idx];
		s1TepotaRucka.setAttribute('y', ruckaY);

		// Molekuly — více energičnější pohyb
		let html = '';
		for (let i = 0; i < 20; i++) {
			const x = 70 + Math.random() * 260;
			const y = 70 + Math.random() * 110;
			const r = [4, 5, 6][idx]; // větší při vyšší teplotě
			html += `<circle cx="${x}" cy="${y}" r="${r}" />`;
		}
		s1MolWrapper.innerHTML = html;

		const msgs = [
			'Při 0°C je tlak ~80 kPa. Molekuly se pohybují pomalu.',
			'Při 20°C je tlak ~100 kPa. Normální pokojová teplota.',
			'Při 40°C je tlak ~120 kPa. Molekuly se pohybují rychleji — nárazy jsou silnější.',
		];
		s1Text.textContent = msgs[idx];
	}
	s1Slider.addEventListener('input', renderS1);
	renderS1();

	// SCÉNA 2: Objem a tlak (Boyle-Mariotte)
	const s2Slider = document.getElementById('s2-pist-slider');
	const s2Pist = document.getElementById('s2-pist');
	const s2MolWrapper = document.getElementById('s2-molekuly');
	const s2ObjeVal = document.getElementById('s2-objem');
	const s2TlakVal = document.getElementById('s2-tlak');
	const s2Text = document.getElementById('s2-text');

	function renderS2() {
		const idx = +s2Slider.value;
		const volumes = [100, 50, 33, 25]; // %
		const tlaks = [100, 200, 300, 400]; // kPa
		const v = volumes[idx];
		const p = tlaks[idx];

		s2ObjeVal.textContent = `${v} %`;
		s2TlakVal.textContent = `${p} kPa`;

		// Pohyb pístu: 340 je úplně venku, 50 je úplně stlačené
		const pistX = 340 - (idx * 72.5);
		s2Pist.setAttribute('x', pistX);
		s2Tyc.setAttribute('x', pistX + 20);

		// Molekuly se "zahušťují"
		let html = '';
		const cols = 4;
		const rows = [3, 5, 7, 9][idx];
		for (let i = 0; i < cols * rows; i++) {
			const colIdx = i % cols;
			const rowIdx = Math.floor(i / cols);
			const xSpacing = (300 - 100) / (cols + 1);
			const ySpacing = (180 - 0) / (rows + 1);
			const x = 50 + 30 + (colIdx + 1) * (xSpacing * v / 100);
			const y = 60 + 30 + (rowIdx + 1) * (ySpacing * v / 100);
			if (x < pistX - 20) html += `<circle cx="${x}" cy="${y}" r="4" />`;
		}
		s2MolWrapper.innerHTML = html;

		const msgs = [
			'Objem = 100 %, tlak = 100 kPa. Normální stav.',
			'Objem = 50 %, tlak = 200 kPa. Píst je stlačený na polovinu — tlak se zdvojnásobil!',
			'Objem = 33 %, tlak = 300 kPa. Stlačení pokračuje — tlak roste.',
			'Objem = 25 %, tlak = 400 kPa. Maximální stlačení — tlak čtyřikrát větší!',
		];
		s2Text.textContent = msgs[idx];
	}
	s2Slider.addEventListener('input', renderS2);
	renderS2();

	// SCÉNA 3: Hloubka a tlak
	const s3Slider = document.getElementById('s3-hlubka');
	const s3P1 = document.getElementById('s3-p1');
	const s3P2 = document.getElementById('s3-p2');
	const s3P3 = document.getElementById('s3-p3');
	const s3Text = document.getElementById('s3-text');

	function renderS3() {
		const idx = +s3Slider.value;
		const depths = [0, 5, 10]; // metry
		const pressures = [101, 111, 121]; // kPa (zjednodušeno: 101 + hloubka*2)
		const d = depths[idx];
		const p = pressures[idx];

		s3P1.textContent = `101 kPa (povrch)`;
		s3P2.textContent = `${pressures[Math.min(1, idx)]} kPa`;
		s3P3.textContent = `${pressures[Math.min(2, idx)]} kPa`;

		const msgs = [
			'Na povrchu: 101 kPa (1 bar). Atmosferický tlak.',
			'V hloubce 5 m: 111 kPa (tlak vody se přidá). Potápěči se zvykují postupně.',
			'V hloubce 10 m: 121 kPa. Tlak se zvyšuje rychle — každých 10 m ~10 kPa.',
		];
		s3Text.textContent = msgs[idx];
	}
	s3Slider.addEventListener('input', renderS3);
	renderS3();

	// SCÉNA 4: Atmosferický tlak — animace molekul
	function animateAtmosphere() {
		const molWrapper = document.getElementById('s4-molekuly');
		let html = '';
		for (let i = 0; i < 80; i++) {
			const x = Math.random() * 500;
			const y = Math.random() * 200; // jen horní část (atmosféra)
			const r = 2 + Math.random() * 2;
			html += `<circle cx="${x}" cy="${y}" r="${r}" />`;
		}
		molWrapper.innerHTML = html;
	}
	animateAtmosphere();
	setInterval(animateAtmosphere, 2000);

	// SCÉNY — přepínání
	const sceneBtns = document.querySelectorAll('.scene-btn');
	const scena1 = document.getElementById('scena1');
	const scena2 = document.getElementById('scena2');
	const scena3 = document.getElementById('scena3');
	const scena4 = document.getElementById('scena4');
	const sceny = [scena1, scena2, scena3, scena4];

	sceneBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const sceneNum = parseInt(btn.getAttribute('data-scene'), 10);
			sceny.forEach((s) => (s.style.display = 'none'));
			sceneBtns.forEach((b) => b.classList.remove('active'));
			sceny[sceneNum - 1].style.display = 'block';
			btn.classList.add('active');
		});
	});

	// Inicializace: zobraz první scénu
	window.addEventListener('load', () => {
		sceny.forEach((s) => (s.style.display = 'none'));
		scena1.style.display = 'block';
	});
</script>

<style>
	.simulace {
		background: #f8f9fa;
		border: 3px solid #2b2a26;
		border-radius: 12px;
		padding: 1.5rem;
		margin: 1.5rem 0;
	}

	.simulace h2 {
		margin: 0 0 0.5rem 0;
	}

	.simulace > p {
		margin-top: 0;
		margin-bottom: 1rem;
		font-size: 1.05rem;
	}

	.scena {
		display: none;
		margin: 1.5rem 0;
	}

	.scena h3 {
		margin-top: 0;
		font-size: 1.2rem;
		color: #0099ff;
	}

	.tlak-svg {
		width: 100%;
		max-width: 500px;
		border: 2px solid #ddd;
		border-radius: 8px;
		background: #fafafa;
		margin: 0.5rem 0;
	}

	.sim-posuvnik {
		display: block;
		font-weight: 700;
		margin: 0.7rem 0;
	}

	.sim-posuvnik input {
		width: 100%;
		max-width: 500px;
		display: block;
		margin-top: 0.3rem;
	}

	.popis {
		font-size: 1rem;
		background: #fffacd;
		border-radius: 8px;
		padding: 0.7rem;
		margin: 0.7rem 0;
		border-left: 4px solid #0099ff;
	}

	.sceny-ovladani {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
		justify-content: center;
	}

	.scene-btn {
		padding: 0.5rem 1rem;
		border: 2px solid #2b2a26;
		border-radius: 8px;
		background: #fff;
		font-weight: 700;
		cursor: pointer;
		font-size: 0.95rem;
		transition: all 0.2s ease;
	}

	.scene-btn:hover {
		background: #e7f5ff;
	}

	.scene-btn.active {
		background: #0099ff;
		color: #fff;
		border-color: #0099ff;
	}

	.scene-btn:active {
		transform: translateY(1px);
	}
</style>
