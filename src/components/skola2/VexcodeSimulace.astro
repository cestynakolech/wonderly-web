---
// VEXcode IQ — první program (informatika 8, vex-iq / vexcode-prvni-program).
//
// Žák skládá bloky (jeď vpřed / otoč se vpravo / otoč se vlevo / čekej) do programu.
// Program běží SHORA DOLŮ, blok po bloku — právě běžící blok se v seznamu zvýrazní.
// Hlavní pointa: POŘADÍ bloků mění výsledek — "otoč pak jeď" skončí jinde než
// "jeď pak otoč", i když jsou to stejné dva bloky. Úkol: dojet přesně na vyznačený
// cíl 🏁; když robot mine, žák pořadí nebo hodnoty bloků opraví a zkusí to znovu.
//
// Souřadnice: 1 čtvereček mřížky = 10 cm (PXCM = 4 px na 1 cm). Nabízené kroky
// (10/20/30 cm, 45/90/180°) proto při zatáčkách po 90°/180° vždy dají přesnou
// polohu na mřížce. Výchozí program:
//   jeď vpřed 30 cm → otoč se vpravo o 90° → jeď vpřed 20 cm
// start (80,360) → po 1. bloku (80,240) → po otočení heading 90° → po 3. bloku
// (160,240) = přesně cíl (30 cm "nahoru", pak 20 cm "doprava"). Ověřeno výpočtem
// (sin/cos pro násobky 90° dají celá čísla, viz FYZIKA/LOGIKA v odpovědi workera).
// Úhel 45° je nabídnutý navíc pro pokusy, ale výchozí trefa ho nepotřebuje.
//
// Animace jednoho bloku běží na PEVNÝ POČET SNÍMKŮ (ne na reálném čase) — funguje
// tedy stejně, i když je requestAnimationFrame v náhledu zpomalený.

const SIRKA = 600;
const VYSKA = 400;
const KROK_MRIZKY = 40; // px = 10 cm

const svisleCary = [];
for (let x = 0; x <= SIRKA; x += KROK_MRIZKY) svisleCary.push(x);
const vodorovneCary = [];
for (let y = 0; y <= VYSKA; y += KROK_MRIZKY) vodorovneCary.push(y);

const START_X = 80;
const START_Y = 360;
const CIL_X = 160;
const CIL_Y = 240;
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vyzkoušej: naprogramuj robota 🕹️</span></h2>
	<p>
		Poskládej bloky do programu tak, aby robot dojel přesně na cíl 🏁. Program se
		vždy provádí <strong>shora dolů, blok po bloku</strong> — právě běžící blok se
		zvýrazní žlutě. <strong>Na pořadí záleží!</strong> Stejné dva bloky v jiném pořadí
		zavedou robota jinam.
	</p>

	<div class="vx-obal">
		<svg id="vx-scena" viewBox={`0 0 ${SIRKA} ${VYSKA}`} role="img" aria-labelledby="vx-popis">
			<title id="vx-popis">Robot na startu má podle naprogramovaných bloků dojet na vyznačený cíl</title>
			<rect x="0" y="0" width={SIRKA} height={VYSKA} fill="#f8f9fa" />
			{svisleCary.map((x) => (
				<line x1={x} y1="0" x2={x} y2={VYSKA} stroke="#dee2e6" stroke-width="1" />
			))}
			{vodorovneCary.map((y) => (
				<line x1="0" y1={y} x2={SIRKA} y2={y} stroke="#dee2e6" stroke-width="1" />
			))}
			<circle cx={CIL_X} cy={CIL_Y} r="12" fill="none" stroke="#e03131" stroke-width="3" stroke-dasharray="4 4" />
			<text x={CIL_X} y={CIL_Y - 18} text-anchor="middle" class="vx-vlajka">🏁</text>
			<circle cx={START_X} cy={START_Y} r="4" fill="#2b2a26" />
			<text x={START_X} y={START_Y + 22} text-anchor="middle" class="vx-popisek">START</text>
			<polyline id="vx-stopa" points="" fill="none" stroke="#1971c2" stroke-width="3" stroke-dasharray="6 5" />
			<g id="vx-robot" transform={`translate(${START_X},${START_Y}) rotate(0)`}>
				<polygon points="0,-20 9,-8 -9,-8" fill="#e03131" stroke="#2b2a26" stroke-width="2" />
				<rect x="-15" y="-12" width="30" height="24" rx="5" fill="#ffd43b" stroke="#2b2a26" stroke-width="3" />
				<rect x="-19" y="-16" width="6" height="10" fill="#2b2a26" />
				<rect x="13" y="-16" width="6" height="10" fill="#2b2a26" />
				<rect x="-19" y="6" width="6" height="10" fill="#2b2a26" />
				<rect x="13" y="6" width="6" height="10" fill="#2b2a26" />
			</g>
		</svg>
		<p class="vx-legenda">🔲 1 čtvereček mřížky = 10 cm</p>
	</div>

	<p class="vx-radek">
		<strong>Přidej blok:</strong>
		<button type="button" class="vx-tl" id="vx-pridej-vpred" data-typ="vpred">+ jeď vpřed</button>
		<button type="button" class="vx-tl" id="vx-pridej-vpravo" data-typ="vpravo">+ otoč se vpravo</button>
		<button type="button" class="vx-tl" id="vx-pridej-vlevo" data-typ="vlevo">+ otoč se vlevo</button>
		<button type="button" class="vx-tl" id="vx-pridej-cekej" data-typ="cekej">+ čekej</button>
	</p>

	<ol id="vx-program" class="vx-program"></ol>

	<p class="vx-radek">
		<button type="button" class="vx-tl vx-hlavni" id="vx-krok">▶︎ jeden blok</button>
		<button type="button" class="vx-tl vx-hlavni" id="vx-spust">⏩ spustit program</button>
		<button type="button" class="vx-tl" id="vx-reset">↺ robota na start</button>
		<button type="button" class="vx-tl" id="vx-vymaz">🗑 smazat program</button>
	</p>

	<p class="vx-stav" id="vx-stav" aria-live="polite"></p>
</section>

<script>
	const PXCM = 4; // px na 1 cm — musí sedět s KROK_MRIZKY (40 px = 10 cm)
	const START = { x: 80, y: 360, heading: 0 };
	const CIL = { x: 160, y: 240 };
	const TOLERANCE_CM = 2; // menší odchylka = "trefil jsi cíl"
	const SNIMKU_NA_BLOK = 24; // pevný počet snímků animace — nezávisí na reálném čase

	const POPISKY = { vpred: 'jeď vpřed', vpravo: 'otoč se vpravo o', vlevo: 'otoč se vlevo o', cekej: 'čekej' };
	const JEDNOTKY = { vpred: 'cm', vpravo: '°', vlevo: '°', cekej: 's' };
	const MOZNOSTI = { vpred: [10, 20, 30], vpravo: [45, 90, 180], vlevo: [45, 90, 180], cekej: [1, 2, 3] };
	const VYCHOZI_HODNOTA = { vpred: 10, vpravo: 90, vlevo: 90, cekej: 1 };

	const robotEl = document.getElementById('vx-robot');
	const stopaEl = document.getElementById('vx-stopa');
	const programEl = document.getElementById('vx-program');
	const stavEl = document.getElementById('vx-stav');
	const btnKrok = document.getElementById('vx-krok');
	const btnSpust = document.getElementById('vx-spust');
	const btnReset = document.getElementById('vx-reset');
	const btnVymaz = document.getElementById('vx-vymaz');

	/** Číslo bez zbytečné desetinné čárky. */
	const cz = (n) => (Number.isInteger(n) ? String(n) : String(Math.round(n * 10) / 10).replace('.', ','));

	// — čisté funkce: z nich se počítá pohyb i vyhodnocení cíle —
	/** Poloha robota PO celém provedení bloku (bez animace). */
	function novaPoloha(stav, blok) {
		if (blok.typ === 'vpred') {
			const rad = (stav.heading * Math.PI) / 180;
			return {
				x: stav.x + blok.hodnota * PXCM * Math.sin(rad),
				y: stav.y - blok.hodnota * PXCM * Math.cos(rad),
				heading: stav.heading,
			};
		}
		if (blok.typ === 'vpravo') return { ...stav, heading: stav.heading + blok.hodnota };
		if (blok.typ === 'vlevo') return { ...stav, heading: stav.heading - blok.hodnota };
		return { ...stav }; // cekej — poloha se nemění
	}

	let nextId = 4;
	let bloky = [
		{ id: 1, typ: 'vpred', hodnota: 30 },
		{ id: 2, typ: 'vpravo', hodnota: 90 },
		{ id: 3, typ: 'vpred', hodnota: 20 },
	];

	let stavAktualni = { ...START };
	let stopaBody = [`${START.x},${START.y}`];
	let ukazatel = 0; // index dalšího bloku, který se má spustit
	let bezicIndex = null; // index bloku, který PRÁVĚ běží (kvůli zvýraznění)
	let bezi = false;

	function vykresliRobota(stav) {
		robotEl.setAttribute('transform', `translate(${stav.x},${stav.y}) rotate(${stav.heading})`);
	}
	function vykresliStopu() {
		stopaEl.setAttribute('points', stopaBody.join(' '));
	}

	function popisekBloku(blok) {
		return `${POPISKY[blok.typ]}`;
	}

	function renderProgram() {
		programEl.innerHTML = '';
		bloky.forEach((blok, index) => {
			const li = document.createElement('li');
			li.className = 'vx-blok' + (bezicIndex === index ? ' vx-blok-aktivni' : '');
			li.dataset.id = String(blok.id);

			const cislo = document.createElement('span');
			cislo.className = 'vx-poradi';
			cislo.textContent = String(index + 1) + '.';

			const text = document.createElement('span');
			text.className = 'vx-blok-text';
			text.textContent = popisekBloku(blok);

			const select = document.createElement('select');
			select.className = 'vx-hodnota';
			select.dataset.id = String(blok.id);
			for (const moznost of MOZNOSTI[blok.typ]) {
				const opt = document.createElement('option');
				opt.value = String(moznost);
				opt.textContent = String(moznost);
				if (moznost === blok.hodnota) opt.selected = true;
				select.appendChild(opt);
			}

			const jednotka = document.createElement('span');
			jednotka.className = 'vx-jednotka';
			jednotka.textContent = JEDNOTKY[blok.typ];

			const tlacitka = document.createElement('span');
			tlacitka.className = 'vx-blok-tlacitka';
			tlacitka.innerHTML = `
				<button type="button" class="vx-nahoru" data-id="${blok.id}" ${index === 0 ? 'disabled' : ''} aria-label="posunout blok nahoru">↑</button>
				<button type="button" class="vx-dolu" data-id="${blok.id}" ${index === bloky.length - 1 ? 'disabled' : ''} aria-label="posunout blok dolů">↓</button>
				<button type="button" class="vx-smaz" data-id="${blok.id}" aria-label="smazat blok">✕</button>
			`;

			li.append(cislo, text, select, jednotka, tlacitka);
			programEl.appendChild(li);
		});
	}

	function ukazStav(text) {
		stavEl.innerHTML = text;
	}

	function resetRobota(hlaska) {
		ukazatel = 0;
		bezicIndex = null;
		bezi = false;
		stavAktualni = { ...START };
		stopaBody = [`${START.x},${START.y}`];
		vykresliRobota(stavAktualni);
		vykresliStopu();
		renderProgram();
		ukazStav(hlaska ?? 'Robot je připravený na startu. Spusť program, nebo si ho poskládej jinak.');
	}

	function vyhodnotCil() {
		const dxCm = (stavAktualni.x - CIL.x) / PXCM;
		const dyCm = (stavAktualni.y - CIL.y) / PXCM;
		const vzdalenostCm = Math.round(Math.hypot(dxCm, dyCm));
		if (vzdalenostCm <= TOLERANCE_CM) {
			ukazStav('🎉 <strong>Trefil jsi cíl!</strong> Robot dojel přesně tam, kam měl.');
		} else {
			ukazStav(
				`Robot minul cíl o <strong>${cz(vzdalenostCm)} cm</strong>. Zkus upravit pořadí bloků nebo jejich hodnoty ` +
					'a spusť to znovu (nebo klikni na „robota na start").'
			);
		}
	}

	/** Animuje jeden blok na pevný počet snímků a pak zavolá onDone(). */
	function animujBlok(index, onDone) {
		if (index >= bloky.length) {
			vyhodnotCil();
			bezi = false;
			onDone(false);
			return;
		}
		bezi = true;
		bezicIndex = index;
		renderProgram();

		const blok = bloky[index];
		const start = { ...stavAktualni };
		const konec = novaPoloha(start, blok);
		let snimek = 0;

		function tik() {
			snimek++;
			const t = Math.min(1, snimek / SNIMKU_NA_BLOK);
			const mezistav = {
				x: start.x + (konec.x - start.x) * t,
				y: start.y + (konec.y - start.y) * t,
				heading: start.heading + (konec.heading - start.heading) * t,
			};
			vykresliRobota(mezistav);
			if (t < 1) {
				requestAnimationFrame(tik);
			} else {
				stavAktualni = konec;
				stopaBody.push(`${konec.x.toFixed(1)},${konec.y.toFixed(1)}`);
				vykresliStopu();
				bezicIndex = null;
				renderProgram();
				onDone(true);
			}
		}
		requestAnimationFrame(tik);
	}

	btnKrok.addEventListener('click', () => {
		if (bezi) return;
		if (bloky.length === 0) {
			ukazStav('Nejdřív přidej aspoň jeden blok.');
			return;
		}
		if (ukazatel >= bloky.length) {
			vyhodnotCil();
			return;
		}
		animujBlok(ukazatel, () => {
			ukazatel++;
		});
	});

	btnSpust.addEventListener('click', () => {
		if (bezi) return;
		if (bloky.length === 0) {
			ukazStav('Nejdřív přidej aspoň jeden blok.');
			return;
		}
		function dalsi() {
			if (ukazatel >= bloky.length) {
				vyhodnotCil();
				return;
			}
			animujBlok(ukazatel, () => {
				ukazatel++;
				dalsi();
			});
		}
		dalsi();
	});

	btnReset.addEventListener('click', () => resetRobota());
	btnVymaz.addEventListener('click', () => {
		if (bezi) return;
		bloky = [];
		resetRobota('Program je smazaný. Poskládej si vlastní bloky a zkus trefit cíl.');
	});

	// — přidávání bloků z palety —
	for (const id of ['vx-pridej-vpred', 'vx-pridej-vpravo', 'vx-pridej-vlevo', 'vx-pridej-cekej']) {
		document.getElementById(id).addEventListener('click', (u) => {
			if (bezi) return;
			const typ = u.currentTarget.dataset.typ;
			bloky.push({ id: nextId++, typ, hodnota: VYCHOZI_HODNOTA[typ] });
			resetRobota();
		});
	}

	// — úpravy uvnitř seznamu (posun, smazání, změna hodnoty) přes delegaci —
	programEl.addEventListener('click', (u) => {
		if (bezi) return;
		const cil = u.target;
		const id = Number(cil.dataset.id);
		if (!id) return;
		const index = bloky.findIndex((b) => b.id === id);
		if (index === -1) return;
		if (cil.classList.contains('vx-nahoru') && index > 0) {
			[bloky[index - 1], bloky[index]] = [bloky[index], bloky[index - 1]];
			resetRobota();
		} else if (cil.classList.contains('vx-dolu') && index < bloky.length - 1) {
			[bloky[index], bloky[index + 1]] = [bloky[index + 1], bloky[index]];
			resetRobota();
		} else if (cil.classList.contains('vx-smaz')) {
			bloky.splice(index, 1);
			resetRobota();
		}
	});

	programEl.addEventListener('change', (u) => {
		if (bezi) return;
		const cil = u.target;
		if (!cil.classList.contains('vx-hodnota')) return;
		const id = Number(cil.dataset.id);
		const blok = bloky.find((b) => b.id === id);
		if (!blok) return;
		blok.hodnota = Number(cil.value);
		resetRobota();
	});

	resetRobota();
</script>

<style>
	.vx-obal { overflow-x: auto; }
	#vx-scena { width: 100%; max-width: 600px; height: auto; display: block; margin: 0.5rem 0; }
	.vx-vlajka { font-size: 22px; }
	.vx-popisek { font-size: 13px; fill: #495057; font-weight: 700; }
	.vx-legenda { font-size: 0.9rem; color: #495057; margin: 0.2rem 0 0.6rem; }

	.vx-radek { margin: 0.5rem 0; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
	.vx-tl {
		font: inherit;
		font-weight: 700;
		padding: 0.3rem 0.9rem;
		border: 3px solid #2b2a26;
		border-radius: 10px;
		background: #fff;
		cursor: pointer;
	}
	.vx-tl.vx-hlavni { background: #d3f9d8; }

	.vx-program {
		list-style: none;
		margin: 0.6rem 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.vx-blok {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		border: 3px solid #2b2a26;
		border-radius: 10px;
		background: #fff;
		padding: 0.35rem 0.7rem;
	}
	.vx-blok.vx-blok-aktivni {
		background: #ffe8cc;
		box-shadow: inset 0 0 0 2px #f08c00;
	}
	.vx-poradi { font-weight: 800; color: #868e96; min-width: 1.5rem; }
	.vx-blok-text { font-weight: 700; }
	.vx-hodnota { font: inherit; font-weight: 700; padding: 0.15rem 0.3rem; border: 2px solid #2b2a26; border-radius: 6px; }
	.vx-jednotka { font-weight: 700; color: #495057; }
	.vx-blok-tlacitka { margin-left: auto; display: flex; gap: 0.3rem; }
	.vx-blok-tlacitka button {
		font: inherit;
		font-weight: 700;
		border: 2px solid #2b2a26;
		border-radius: 6px;
		background: #f1f3f5;
		cursor: pointer;
		padding: 0.1rem 0.5rem;
	}
	.vx-blok-tlacitka button:disabled { opacity: 0.35; cursor: default; }

	.vx-stav { background: #f1f3f5; border-left: 6px solid #1971c2; padding: 0.5rem 0.8rem; margin-top: 0.6rem; }
</style>
