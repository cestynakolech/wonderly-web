---
import CestyLayout from '../../layouts/CestyLayout.astro';
import { roky } from '../../data/cesty/roky';
import { MAPA_SIRKA, MAPA_VYSKA, spocitejVyrez } from '../../data/cesty/mapa';
import { TEXTY, cestaCesty, formatujDatum, prelozZemi } from '../../data/cesty/preklady';
import type { Jazyk } from '../../data/cesty/typy';

interface Props {
	jazyk: Jazyk;
}

const { jazyk } = Astro.props;
const t = TEXTY[jazyk];

const vsechnaMesta = roky.flatMap((r) => r.mesta.map((m) => ({ ...m, rok: r.rok })));
const vyrez = spocitejVyrez(vsechnaMesta);
const pinR = vyrez.sirka / 45;
const pismo = vyrez.sirka / 30;
const podleRoku = [...roky].sort((a, b) => b.rok - a.rok);
---

<CestyLayout titulek={`${t.vsechnaMista} – ${t.nadpis}`} jazyk={jazyk} podcesta="vse">
	<p><a href={cestaCesty(jazyk)}>&larr; {t.zpetNaRoky}</a></p>
	<h1>{t.vsechnaMista}</h1>
	<p>{t.vsechnaMistaUvod}</p>
	<svg
		class="mapa"
		viewBox={`${vyrez.x} ${vyrez.y} ${vyrez.sirka} ${vyrez.vyska}`}
		role="img"
		aria-label={t.mapaVsech}
	>
		<image href="/cesty/mapa-evropa.svg" width={MAPA_SIRKA} height={MAPA_VYSKA} />
		{
			vsechnaMesta.map((m, i) => (
				<a href={cestaCesty(jazyk, `${m.rok}#${m.slug}`)}>
					<circle class="pin" cx={m.x} cy={m.y} r={pinR} stroke-width={pinR / 3.5} />
					<text
						class="pin-popisek"
						x={m.x}
						y={i % 2 === 0 ? m.y - pinR * 2 : m.y + pinR * 2 + pismo * 0.8}
						text-anchor="middle"
						font-size={pismo}
						stroke-width={pismo / 5}
					>
						{m.nazev}
					</text>
				</a>
			))
		}
	</svg>
	{
		podleRoku.map((r) => (
			<section>
				<h2>
					<a href={cestaCesty(jazyk, String(r.rok))}>{r.rok}</a> – {prelozZemi(r.zeme, jazyk)}
				</h2>
				<ul>
					{r.mesta.map((m) => (
						<li>
							<a href={cestaCesty(jazyk, `${r.rok}#${m.slug}`)}>{m.nazev}</a> ({formatujDatum(m.datum, jazyk)})
						</li>
					))}
				</ul>
			</section>
		))
	}
</CestyLayout>
