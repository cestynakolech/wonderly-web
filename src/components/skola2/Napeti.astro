---
// Statická infografika: Elektrické napětí (Napeti)
// Rozdíl nábojů, zdroje napětí, galvani články
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Elektrické napětí ⚡</span></h2>
	<p>Napětí je <strong>rozdíl nábojů</strong> mezi dvěma body. Měří se ve voltech (V) a vzniká v zdrojích napětí.</p>
	<svg viewBox="0 0 800 520" class="infografika-svg">
		<!-- Pozadí -->
		<rect width="800" height="520" fill="#f5f0e8"/>
		
		<!-- Nadpis -->
		<text x="400" y="35" text-anchor="middle" class="main-title">ELEKTRICKÉ NAPĚTÍ — ROZDÍL NÁBOJŮ</text>
		
		<!-- ČÁST 1: MYŠLENKA -->
		<g id="concept">
			<text x="150" y="75" text-anchor="middle" class="section-title">CO JE NAPĚTÍ?</text>
			
			<!-- Záporná svorka (přebytek elektronů) -->
			<circle cx="100" cy="140" r="30" fill="#3498db" stroke="#2980b9" stroke-width="2"/>
			<text x="100" y="140" text-anchor="middle" class="terminal-label" fill="white" font-size="24">−</text>
			<text x="100" y="190" text-anchor="middle" class="terminal-text">Záporná svorka</text>
			<text x="100" y="208" text-anchor="middle" class="terminal-text" font-size="11">přebytek</text>
			<text x="100" y="222" text-anchor="middle" class="terminal-text" font-size="11">elektronů</text>
			
			<!-- Šipka mezi nimi -->
			<line x1="130" y1="140" x2="170" y2="140" stroke="#e74c3c" stroke-width="3"/>
			<path d="M 165 135 L 175 140 L 165 145" fill="#e74c3c"/>
			
			<!-- Kladná svorka (nedostatek elektronů) -->
			<circle cx="200" cy="140" r="30" fill="#e74c3c" stroke="#c0392b" stroke-width="2"/>
			<text x="200" y="140" text-anchor="middle" class="terminal-label" fill="white" font-size="24">+</text>
			<text x="200" y="190" text-anchor="middle" class="terminal-text">Kladná svorka</text>
			<text x="200" y="208" text-anchor="middle" class="terminal-text" font-size="11">nedostatek</text>
			<text x="200" y="222" text-anchor="middle" class="terminal-text" font-size="11">elektronů</text>
			
			<!-- Text -->
			<text x="150" y="260" text-anchor="middle" class="concept-text">Napětí = <strong>potenciální rozdíl</strong></text>
			<text x="150" y="278" text-anchor="middle" class="concept-text" font-size="12">mezi + a − svorkou</text>
		</g>
		
		<!-- ČÁST 2: JEDNOTKY -->
		<g id="units">
			<text x="450" y="75" text-anchor="middle" class="section-title">JEDNOTKY A PŘÍKLADY</text>
			
			<!-- Tabulka jednotek -->
			<rect x="350" y="95" width="200" height="180" fill="#fff" stroke="#95a5a6" stroke-width="2" rx="3"/>
			
			<!-- Hlavička tabulky -->
			<rect x="350" y="95" width="200" height="25" fill="#34495e"/>
			<text x="450" y="113" text-anchor="middle" class="table-header">ZDROJ NAPĚTÍ</text>
			
			<!-- Řádky tabulky -->
			<line x1="350" y1="120" x2="550" y2="120" stroke="#95a5a6" stroke-width="1"/>
			
			<!-- Řada 1: Suchý článek -->
			<text x="360" y="138" class="table-text" font-size="11">Suchý článek</text>
			<text x="520" y="138" text-anchor="end" class="table-value">1,5 V</text>
			
			<!-- Řada 2: Plochá baterie -->
			<text x="360" y="155" class="table-text" font-size="11">Plochá baterie</text>
			<text x="520" y="155" text-anchor="end" class="table-value">4,5 V</text>
			<line x1="350" y1="160" x2="550" y2="160" stroke="#ecf0f1" stroke-width="1"/>
			
			<!-- Řada 3: Autobaterie -->
			<text x="360" y="177" class="table-text" font-size="11">Autobaterie</text>
			<text x="520" y="177" text-anchor="end" class="table-value">12 V</text>
			
			<!-- Řada 4: Zásuvka doma -->
			<text x="360" y="194" class="table-text" font-size="11">Zásuvka (domů)</text>
			<text x="520" y="194" text-anchor="end" class="table-value">230 V</text>
			<line x1="350" y1="200" x2="550" y2="200" stroke="#ecf0f1" stroke-width="1"/>
			
			<!-- Řada 5: Vysoké napětí -->
			<text x="360" y="217" class="table-text" font-size="11">Vedení VN (přenos)</text>
			<text x="520" y="217" text-anchor="end" class="table-value">400 kV</text>
			
			<!-- Jednotka -->
			<text x="450" y="245" text-anchor="middle" class="unit-note">Jednotka: <strong>volt (V)</strong></text>
		</g>
		
		<!-- ČÁST 3: ZDROJE NAPĚTÍ -->
		<rect x="40" y="290" width="720" height="210" fill="#ecf0f1" stroke="#95a5a6" stroke-width="2" rx="8"/>
		
		<text x="400" y="320" text-anchor="middle" class="section-title">ZDROJE ELEKTRICKÉHO NAPĚTÍ</text>
		
		<!-- Chemický zdroj -->
		<g id="chemical-source">
			<text x="130" y="355" text-anchor="middle" class="source-title">CHEMICKÉ ČLÁNKY</text>
			
			<!-- Suchý článek ikona -->
			<rect x="95" y="365" width="35" height="50" fill="#c0c0c0" stroke="#999" stroke-width="2" rx="2"/>
			<line x1="112" y1="375" x2="128" y2="375" stroke="#999" stroke-width="1"/>
			<line x1="112" y1="395" x2="128" y2="395" stroke="#999" stroke-width="1"/>
			<circle cx="112" cy="385" r="3" fill="#333"/>
			<circle cx="128" cy="385" r="3" fill="#333"/>
			<text x="112" y="423" text-anchor="middle" class="source-example" font-size="11">Suchý článek</text>
			<text x="128" y="423" text-anchor="middle" class="source-example" font-size="11">Baterie</text>
			
			<!-- Akumulátor -->
			<rect x="85" y="430" width="70" height="30" fill="#27ae60" stroke="#229954" stroke-width="2" rx="2"/>
			<text x="120" y="450" text-anchor="middle" class="source-example" font-size="11">Akumulátor</text>
			<text x="120" y="465" text-anchor="middle" class="source-note" font-size="10">(dobíjecí)</text>
		</g>
		
		<!-- Generátor -->
		<g id="generator-source">
			<text x="400" y="355" text-anchor="middle" class="source-title">MECHANICKÉ GENERÁTORY</text>
			
			<!-- Dynamo ikona -->
			<circle cx="370" cy="390" r="15" fill="#e74c3c" stroke="#c0392b" stroke-width="2"/>
			<circle cx="370" cy="390" r="10" fill="none" stroke="#c0392b" stroke-width="1"/>
			<text x="370" y="396" text-anchor="middle" class="generator-icon" fill="white" font-size="16">⊗</text>
			
			<text x="370" y="423" text-anchor="middle" class="source-example" font-size="11">Dynamo</text>
			<text x="370" y="438" text-anchor="middle" class="source-note" font-size="10">(u kola)</text>
			
			<!-- Generátor v elektrárně -->
			<circle cx="430" cy="390" r="15" fill="#f39c12" stroke="#d68910" stroke-width="2"/>
			<circle cx="430" cy="390" r="10" fill="none" stroke="#d68910" stroke-width="1"/>
			<path d="M 420 390 L 440 390 M 430 380 L 430 400" stroke="white" stroke-width="2"/>
			
			<text x="430" y="423" text-anchor="middle" class="source-example" font-size="11">Generátor</text>
			<text x="430" y="438" text-anchor="middle" class="source-note" font-size="10">(elektráren)</text>
		</g>
		
		<!-- Slunční článek -->
		<g id="solar-source">
			<text x="670" y="355" text-anchor="middle" class="source-title">SLUNEČNÍ ČLÁNKY</text>
			
			<!-- Panely ikona -->
			<rect x="655" y="365" width="30" height="25" fill="#f1c40f" stroke="#d68910" stroke-width="2"/>
			<line x1="660" y1="365" x2="660" y2="390" stroke="#d68910" stroke-width="1"/>
			<line x1="670" y1="365" x2="670" y2="390" stroke="#d68910" stroke-width="1"/>
			<line x1="680" y1="365" x2="680" y2="390" stroke="#d68910" stroke-width="1"/>
			<line x1="655" y1="375" x2="685" y2="375" stroke="#d68910" stroke-width="1"/>
			<line x1="655" y1="382" x2="685" y2="382" stroke="#d68910" stroke-width="1"/>
			
			<text x="670" y="423" text-anchor="middle" class="source-example" font-size="11">Solární panel</text>
			<text x="670" y="438" text-anchor="middle" class="source-note" font-size="10">(fotoefekt)</text>
		</g>
		
		<!-- Důležitá poznámka -->
		<rect x="100" y="475" width="600" height="35" fill="#fff3cd" stroke="#f1c40f" stroke-width="2" rx="5"/>
		<text x="400" y="496" text-anchor="middle" class="important-note">💡 Alle zdroje napětí mají <strong>dvě svorky: + (kladná) a − (záporná)</strong></text>
	</svg>
</section>

<style>
	.infografika-svg {
		width: 100%;
		max-width: 800px;
		height: auto;
		border: 2px solid #ddd;
		border-radius: 8px;
	}
	
	.main-title {
		font-size: 18px;
		font-weight: bold;
		fill: #2c3e50;
	}
	
	.section-title {
		font-size: 15px;
		font-weight: bold;
		fill: #2c3e50;
	}
	
	.terminal-label {
		font-weight: bold;
	}
	
	.terminal-text {
		font-size: 11px;
		fill: #555;
		font-weight: bold;
	}
	
	.concept-text {
		font-size: 12px;
		fill: #2c3e50;
		font-weight: bold;
	}
	
	.table-header {
		font-size: 12px;
		fill: white;
		font-weight: bold;
	}
	
	.table-text {
		fill: #2c3e50;
		font-weight: bold;
	}
	
	.table-value {
		fill: #e74c3c;
		font-weight: bold;
		font-size: 12px;
	}
	
	.unit-note {
		font-size: 11px;
		fill: #2c3e50;
	}
	
	.source-title {
		font-size: 13px;
		font-weight: bold;
		fill: #2c3e50;
	}
	
	.source-example {
		fill: #2c3e50;
		font-weight: bold;
	}
	
	.source-note {
		fill: #666;
		font-style: italic;
	}
	
	.generator-icon {
		font-weight: bold;
	}
	
	.important-note {
		font-size: 12px;
		fill: #2c3e50;
		text-anchor: middle;
	}
</style>
