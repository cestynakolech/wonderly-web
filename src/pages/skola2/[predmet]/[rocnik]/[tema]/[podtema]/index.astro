import PrenosSimulace from '../../../../../../components/skola2/PrenosSimulace.astro';
import GrafCestaSimulace from '../../../../../../components/skola2/GrafCestaSimulace.astro';
import { predmety, rocniky } from '../../../../../../data/predmety';
import { temata } from '../../../../../../data/temata';
import { kvizy } from '../../../../../../data/kvizy';

export function getStaticPaths() {
	const paths = [];
	for (const [klic, seznamTemat] of Object.entries(temata)) {
		const [predmetSlug, rocnikSlug] = klic.split('/');
		const predmet = predmety.find((p) => p.slug === predmetSlug);
		const rocnik = rocniky.find((r) => r.slug === rocnikSlug);
		for (const tema of seznamTemat) {
			for (const podtema of tema.podtemata ?? []) {
				paths.push({
					params: { predmet: predmetSlug, rocnik: rocnikSlug, tema: tema.slug, podtema: podtema.slug },
					props: { predmet, rocnik, tema, podtema },
				});
			}
		}
	}
	return paths;
}

const { predmet, rocnik, tema, podtema } = Astro.props;
const klicKvizu = `${predmet.slug}/${rocnik.slug}/${tema.slug}/${podtema.slug}`;
const otazky = kvizy[klicKvizu];
const absolutniUrl = `https://lab.wonderly.cz/${klicKvizu}/`;

const ikonyDruhu = { infografika: '🖼️', pdf: '📄', video: '🎬' };
---

<SkolaLayout
	titulek={`${podtema.nazev} – ${tema.nazev} – Wonderly`}
	drobky={[
		{ text: '2. stupeň', href: '../../../../' },
		{ text: predmet.nazev, href: '../../../' },
		{ text: rocnik.nazev, href: '../../' },
		{ text: tema.nazev, href: '../' },
	]}
>
	<h1><span class="podtrh">{podtema.nazev}</span></h1>
	<details class="qr-podtema">
		<summary>📱 QR na toto téma (pro promítnutí)</summary>
		<p>Naskenuj a máš toto téma rovnou v telefonu.</p>
		<QrKod url={absolutniUrl} velikost={150} popis={podtema.nazev} />
	</details>
	{
		podtema.obsah ? (
			<article class="ramecek vyklad" set:html={podtema.obsah} />
		) : (
			<p class="uvodni-text">Obsah připravujeme.</p>
		)
	}
	{
		podtema.odkazy && podtema.odkazy.length > 0 && (
			<section class="ramecek odkazy-sekce">
				<h2><span class="podtrh">🔗 Odkazy k tématu</span></h2>
				<p class="odkazy-pokyn">Klikni, nebo naskenuj QR tabletem či telefonem.</p>
				<div class="odkazy-mrizka">
					{podtema.odkazy.map((o) => (
						<a class="odkaz-karta" href={o.url} target="_blank" rel="noopener">
							<QrKod url={o.url} velikost={110} />
							<span>{o.nazev}</span>
						</a>
					))}
				</div>
			</section>
		)
	}
	{
		podtema.materialy && podtema.materialy.length > 0 && (
			<section>
				<h2><span class="podtrh">Materiály k tématu 📚</span></h2>
				{podtema.materialy
					.filter((m) => m.druh === 'infografika')
					.map((m) => (
						<figure class="infografika">
							<img src={m.cesta} alt={m.nazev} loading="lazy" />
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				{podtema.materialy
					.filter((m) => m.druh === 'video')
					.map((m) => (
						<figure class="video">
							<video src={m.cesta} controls preload="metadata" />
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				{podtema.materialy
					.filter((m) => m.druh === 'youtube')
					.map((m) => (
						<figure class="video">
							<div class="youtube-obal">
								<iframe
									src={`https://www.youtube-nocookie.com/embed/${m.cesta}`}
									title={m.nazev}
									loading="lazy"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
								/>
							</div>
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				{podtema.materialy
					.filter((m) => m.druh === 'audio')
					.map((m) => (
						<figure class="audio">
							<audio src={m.cesta} controls preload="metadata" />
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				<ul class="karty">
					{podtema.materialy
						.filter((m) => m.druh === 'pdf')
						.map((m) => (
							<li>
								<a class="karta" href={m.cesta} target="_blank" rel="noopener">
									<span class="ikona">{ikonyDruhu[m.druh]}</span>
									<span class="nazev">{m.nazev}</span>
									<span class="popisek">otevřít PDF</span>
								</a>
							</li>
						))}
				</ul>
			</section>
		)
	}
	{podtema.interakce === 'hydraulika' && <HydraulikaSimulace />}
	{podtema.interakce === 'skupenstvi' && <SkupenstviSimulace />}
	{podtema.interakce === 'difuze' && <DifuzeSimulace />}
