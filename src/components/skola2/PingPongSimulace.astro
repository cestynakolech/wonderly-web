	svg.__odchylkaZPolohy = odchylkaZPolohy;
	svg.__stav = () => stav;
	svg.__volby = () => volby;
	svg.__meze = { R, STENA, STROP, PALKA_Y, PALKA_POLOVYSKA, PALKA_POLOSIRKA, PALKA_TOP, CERVENY_TOP, TICK_MS, ZIVOTY_START, PAUZA_TICKS, RYCHLOSTI, SMER_START };
	svg.__programRadky = programRadky;
</script>

