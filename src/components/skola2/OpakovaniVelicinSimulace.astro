			<rect id="ov-a-rect-1" x="20" y="156" width="600" height="46" rx="10" fill="#ffffff" stroke="#2b2a26" stroke-width="3" />
			<text x="320" y="185" text-anchor="middle" font-size="17" font-weight="bold" fill="#2b2a26" id="ov-a-text-1"></text>
		</g>
		<g id="ov-a-volba-2" style="cursor:pointer">
			<rect id="ov-a-rect-2" x="20" y="212" width="600" height="46" rx="10" fill="#ffffff" stroke="#2b2a26" stroke-width="3" />
			<text x="320" y="241" text-anchor="middle" font-size="17" font-weight="bold" fill="#2b2a26" id="ov-a-text-2"></text>
		</g>
		<text id="ov-a-hlaska" x="320" y="282" text-anchor="middle" font-size="16" font-weight="bold" fill="#2f9e44"></text>
		<g id="ov-a-dalsi" opacity="0" style="cursor:pointer">
			<rect x="230" y="296" width="180" height="34" rx="10" fill="#ffe8cc" stroke="#2b2a26" stroke-width="3" />
			<text x="320" y="318" text-anchor="middle" font-size="15" font-weight="bold" fill="#2b2a26">Další otázka →</text>
		</g>
		<text id="ov-a-skore" x="320" y="20" text-anchor="middle" font-size="14" font-weight="bold" fill="#495057"></text>
	</svg>

	<h3><span class="podtrh">🅱️ Část B: Kdo k sobě patří</span></h3>
	<p>Klikni na veličinu — zvýrazní se celý řádek se značkou, jednotkou i měřidlem.</p>
	<svg id="ov-b-svg" viewBox="0 0 640 430" role="img" aria-label="Přehledová tabulka veličin, značek, jednotek a měřidel">
		<rect x="0" y="0" width="640" height="430" fill="#f8f9fa" />
		<text x="70" y="24" font-size="13" font-weight="bold" fill="#495057">Veličina</text>
		<text x="230" y="24" font-size="13" font-weight="bold" fill="#495057">Značka</text>
		<text x="330" y="24" font-size="13" font-weight="bold" fill="#495057">Jednotka</text>
		<text x="470" y="24" font-size="13" font-weight="bold" fill="#495057">Měřidlo</text>
		<g id="ov-b-radek-0" style="cursor:pointer">
			<rect id="ov-b-rect-0" x="10" y="40" width="620" height="40" rx="8" fill="#ffffff" stroke="#2b2a26" stroke-width="2" />
