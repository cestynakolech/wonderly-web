---
// Statická infografika: Energie
// Energie se transformuje, ale nemůže zaniknout
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Energie a její přeměny 🔄</span></h2>
	<p>Energie se <strong>nemůže vytvořit ani zničit</strong>, jen se <strong>transformuje</strong> z jedné formy na jinou. Celková energie v izolované soustavě zůstává stálá.</p>
	<svg viewBox="0 0 750 380" class="infografika-svg">
		<!-- Pozadí -->
		<rect width="750" height="380" fill="#f5f0e8"/>
		
		<!-- Nadpis transformace -->
		<text x="375" y="35" text-anchor="middle" class="transform-title">PŘEMĚNA ENERGIÍ V PŘÍRODĚ</text>
		
		<!-- Slunce → Světelná energie -->
		<circle cx="80" cy="100" r="35" fill="#f1c40f"/>
		<text x="80" y="110" text-anchor="middle" class="energy-type">SLUNCE</text>
		<text x="80" y="145" text-anchor="middle" class="energy-label">Světelná</text>
		<text x="80" y="160" text-anchor="middle" class="energy-label">energie</text>
		
		<!-- Šipka -->
		<path d="M 120 100 L 170 100" stroke="#e74c3c" stroke-width="3"/>
		<path d="M 165 95 L 180 100 L 165 105" fill="#e74c3c"/>
		
		<!-- Rostlina → Chemická energie -->
		<rect x="180" y="65" width="60" height="70" fill="#27ae60" stroke="#229954" stroke-width="2" rx="5"/>
		<text x="210" y="110" text-anchor="middle" class="energy-type">ROSTLINA</text>
		<text x="210" y="145" text-anchor="middle" class="energy-label">Chemická</text>
		<text x="210" y="160" text-anchor="middle" class="energy-label">energie</text>
		
		<!-- Šipka -->
		<path d="M 245 100 L 295 100" stroke="#e74c3c" stroke-width="3"/>
		<path d="M 290 95 L 305 100 L 290 105" fill="#e74c3c"/>
		
		<!-- Zvíře (je) → Kinetická + vnitřní energie -->
		<circle cx="350" cy="80" r="25" fill="#8b4513"/>
		<line x1="330" y1="100" x2="310" y2="120" stroke="#8b4513" stroke-width="2"/>
		<line x1="370" y1="100" x2="390" y2="120" stroke="#8b4513" stroke-width="2"/>
		<text x="350" y="110" text-anchor="middle" class="energy-type" fill="white">ZVÍŘE</text>
		<text x="350" y="145" text-anchor="middle" class="energy-label">Kinetická</text>
		<text x="350" y="160" text-anchor="middle" class="energy-label">+ vnitřní</text>
		
		<!-- Šipka -->
		<path d="M 380 100 L 430 100" stroke="#e74c3c" stroke-width="3"/>
		<path d="M 425 95 L 440 100 L 425 105" fill="#e74c3c"/>
		
		<!-- Pohyb → Kinetická + Teplo -->
		<polygon points="500,70 480,130 520,130" fill="#3498db" stroke="#2980b9" stroke-width="2"/>
		<text x="500" y="110" text-anchor="middle" class="energy-type" fill="white">POHYB</text>
		<text x="500" y="145" text-anchor="middle" class="energy-label">Kinetická</text>
		<text x="500" y="160" text-anchor="middle" class="energy-label">+ Teplo</text>
		
		<!-- Šipka -->
		<path d="M 525 100 L 575 100" stroke="#e74c3c" stroke-width="3"/>
		<path d="M 570 95 L 585 100 L 570 105" fill="#e74c3c"/>
		
		<!-- Torní → Tepelná energie (rozptyl) -->
		<rect x="585" y="65" width="60" height="70" fill="#e74c3c" stroke="#c0392b" stroke-width="2" rx="5"/>
		<text x="615" y="110" text-anchor="middle" class="energy-type" fill="white">TRENÍ</text>
		<text x="615" y="145" text-anchor="middle" class="energy-label">Tepelná</text>
		<text x="615" y="160" text-anchor="middle" class="energy-label">energia</text>
		
		<!-- Dolní část: Zákon zachování energie -->
		<rect x="50" y="210" width="650" height="130" fill="#ecf0f1" stroke="#95a5a6" stroke-width="2" rx="8"/>
		
		<text x="375" y="240" text-anchor="middle" class="law-title">ZÁKON ZACHOVÁNÍ ENERGIE</text>
		
		<line x1="60" y1="260" x2="680" y2="260" stroke="#95a5a6" stroke-width="1"/>
		
		<!-- Energetická bilance -->
		<text x="80" y="285" class="balance-label"><tspan font-weight="bold">Na začátku:</tspan> Epol + Ekin + Evnitř = E₀</text>
		<text x="80" y="310" class="balance-label"><tspan font-weight="bold">Na konci:</tspan> Epol' + Ekin' + Evnitř' + Eteplo = E₀</text>
		
		<text x="80" y="335" class="balance-note">Součet všech energií se nemění, jen se transformuje!</text>
	</svg>
</section>

<style>
	.infografika-svg {
		width: 100%;
		max-width: 750px;
		height: auto;
		border: 2px solid #ddd;
		border-radius: 8px;
	}
	.transform-title {
		font-size: 16px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.energy-type {
		font-size: 13px;
		font-weight: bold;
		fill: #333;
	}
	.energy-label {
		font-size: 11px;
		fill: #555;
	}
	.law-title {
		font-size: 15px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.balance-label {
		font-size: 12px;
		fill: #2c3e50;
	}
	.balance-note {
		font-size: 11px;
		fill: #7f8c8d;
		font-style: italic;
	}
</style>
