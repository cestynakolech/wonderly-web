---
// Interaktivní Ohmův zákon: posuvníky napětí U a odporu R, obvod s animovaným
// proudem částic (rychlost ~ I), ampérmetr a graf I–U ukazující přímou úměrnost.
// Kolikrát zvětšíš U, tolikrát vzroste I; větší R = menší proud (přímka se sklopí).
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vyzkoušej Ohmův zákon 🕹️</span></h2>
	<p>Měň <strong>napětí U</strong> a <strong>odpor R</strong> a sleduj proud: <strong>I&nbsp;=&nbsp;U&nbsp;/&nbsp;R</strong>. Tečky jsou částice s nábojem — čím větší proud, tím rychleji obíhají.</p>
	<svg id="ohm-svg" viewBox="0 0 520 340" role="img" aria-label="Elektrický obvod s baterií, rezistorem a ampérmetrem, vpravo graf závislosti proudu na napětí">
		<!-- vodiče obvodu (obdélníková smyčka) -->
		<rect x="60" y="60" width="240" height="200" fill="none" stroke="#2b2a26" stroke-width="4" rx="6" />

		<!-- baterie na levé straně -->
		<rect x="36" y="130" width="48" height="60" fill="#f8f9fa" stroke="#2b2a26" stroke-width="3" rx="6" />
		<line x1="48" y1="145" x2="72" y2="145" stroke="#2b2a26" stroke-width="5" />
		<line x1="54" y1="160" x2="66" y2="160" stroke="#2b2a26" stroke-width="3" />
		<line x1="48" y1="175" x2="72" y2="175" stroke="#2b2a26" stroke-width="5" />
		<text x="60" y="122" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">zdroj</text>
		<text id="ohm-u-text" x="60" y="212" text-anchor="middle" font-size="14" font-weight="bold" fill="#1971c2"></text>

		<!-- rezistor nahoře -->
		<rect x="140" y="46" width="80" height="28" fill="#ffe8cc" stroke="#2b2a26" stroke-width="3" rx="5" />
		<text x="180" y="38" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">rezistor</text>
		<text id="ohm-r-text" x="180" y="66" text-anchor="middle" font-size="14" font-weight="bold" fill="#e8590c"></text>

		<!-- ampérmetr dole -->
		<circle cx="180" cy="260" r="30" fill="#fff" stroke="#2b2a26" stroke-width="3" />
		<text x="180" y="252" text-anchor="middle" font-size="15" font-weight="bold" fill="#2b2a26">A</text>
		<text id="ohm-i-text" x="180" y="272" text-anchor="middle" font-size="13" font-weight="bold" fill="#2f9e44"></text>

		<!-- animované částice proudu (kreslí skript) -->
		<g id="ohm-tecky"></g>

		<!-- graf I–U vpravo -->
		<g font-size="12" fill="#868e96">
			<line x1="350" y1="280" x2="500" y2="280" stroke="#2b2a26" stroke-width="2.5" />
			<line x1="350" y1="280" x2="350" y2="70" stroke="#2b2a26" stroke-width="2.5" />
			<text x="500" y="296" text-anchor="end">U (V)</text>
			<text x="344" y="64" text-anchor="start">I (A)</text>
			<text x="348" y="296" text-anchor="middle">0</text>
			<text x="494" y="276" text-anchor="end" id="ohm-graf-umax">24</text>
			<text x="346" y="80" text-anchor="end" id="ohm-graf-imax">1,2</text>
		</g>
		<line id="ohm-primka" x1="350" y1="280" x2="500" y2="100" stroke="#1971c2" stroke-width="3" />
		<circle id="ohm-bod" cx="400" cy="200" r="7" fill="#e03131" stroke="#fff" stroke-width="2" />
		<text x="425" y="320" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">graf: I je přímo úměrné U</text>
	</svg>
	<label class="sim-posuvnik">
		Napětí U: <output id="ohm-u-out"></output>
		<input type="range" id="ohm-u" min="0" max="24" step="1" value="12" />
	</label>
	<label class="sim-posuvnik">
		Odpor R: <output id="ohm-r-out"></output>
		<input type="range" id="ohm-r" min="20" max="240" step="20" value="60" />
	</label>
	<p class="ohm-stav" id="ohm-stav"></p>
</section>

<script>
	const uSlider = document.getElementById('ohm-u');
	const rSlider = document.getElementById('ohm-r');
	const uOut = document.getElementById('ohm-u-out');
	const rOut = document.getElementById('ohm-r-out');
	const uText = document.getElementById('ohm-u-text');
	const rText = document.getElementById('ohm-r-text');
	const iText = document.getElementById('ohm-i-text');
	const primka = document.getElementById('ohm-primka');
	const bod = document.getElementById('ohm-bod');
	const stavEl = document.getElementById('ohm-stav');
	const teckyG = document.getElementById('ohm-tecky');

	// rozměry smyčky obvodu (musí sedět na <rect> výše)
	const L = 60, T = 60, W = 240, H = 200;
	const obvodDelka = 2 * (W + H); // 880

	// graf: U 0–24 V vodorovně (350→500), I 0–1,2 A svisle (280→70)
	const UMAX = 24, IMAX = 1.2;
	const gx = (u) => 350 + (u / UMAX) * 150;
	const gy = (i) => 280 - (Math.min(i, IMAX) / IMAX) * 210;

	const cz = (x, des) => x.toFixed(des).replace('.', ',');

	// tečky proudu: pevný počet, obíhají po obvodu rychlostí ~ I
	const POCET = 16;
	const tecky = [];
	for (let k = 0; k < POCET; k++) {
		const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
		c.setAttribute('r', '5');
		c.setAttribute('fill', '#fab005');
		c.setAttribute('stroke', '#2b2a26');
		c.setAttribute('stroke-width', '1.5');
		teckyG.appendChild(c);
		tecky.push(c);
	}
	// s = vzdálenost po obvodu od levého horního rohu, po směru hodinových ručiček
	function poloha(s) {
		s = ((s % obvodDelka) + obvodDelka) % obvodDelka;
		if (s < W) return [L + s, T];
		s -= W;
		if (s < H) return [L + W, T + s];
		s -= H;
		if (s < W) return [L + W - s, T + H];
		s -= W;
		return [L, T + H - s];
	}

	let I = 0;
	function prekresli() {
		const U = +uSlider.value;
		const R = +rSlider.value;
		I = U / R;
		uOut.textContent = U + ' V';
		rOut.textContent = R + ' Ω';
		uText.textContent = U + ' V';
		rText.textContent = R + ' Ω';
		iText.textContent = cz(I, 2) + ' A';
		// přímka grafu: I = U/R od 0 do UMAX (oříznutá na IMAX)
		const uKonec = Math.min(UMAX, IMAX * R);
		primka.setAttribute('x1', gx(0)); primka.setAttribute('y1', gy(0));
		primka.setAttribute('x2', gx(uKonec)); primka.setAttribute('y2', gy(uKonec / R));
		bod.setAttribute('cx', gx(U));
		bod.setAttribute('cy', gy(I));

		let popis;
		if (U === 0) popis = 'Bez napětí proud neteče (I = 0 A). Zvyš napětí posuvníkem.';
		else popis = `I = U / R = ${U} V / ${R} Ω = ${cz(I, 2)} A. ` +
			(R >= 160 ? 'Velký odpor → malý proud.' : R <= 40 ? 'Malý odpor → velký proud.' : 'Kolikrát zvětšíš U, tolikrát vzroste I.');
		stavEl.textContent = popis;
	}
	uSlider.addEventListener('input', prekresli);
	rSlider.addEventListener('input', prekresli);
	prekresli();

	// animace: posun teček po obvodu úměrný proudu
	let ofset = 0, minule = performance.now();
	function krok(ted) {
		const dt = Math.min(0.1, (ted - minule) / 1000);
		minule = ted;
		ofset += I * 220 * dt; // 0,2 A → 44 px/s (názorné tempo)
		for (let k = 0; k < POCET; k++) {
			const [x, y] = poloha(ofset + (k / POCET) * obvodDelka);
			tecky[k].setAttribute('cx', x.toFixed(1));
			tecky[k].setAttribute('cy', y.toFixed(1));
		}
		requestAnimationFrame(krok);
	}
	requestAnimationFrame(krok);
</script>

<style>
	#ohm-svg { width: 100%; max-width: 520px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 520px; display: block; margin-top: 0.3rem; }
	.ohm-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
