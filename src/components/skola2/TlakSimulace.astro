---
// Interaktivní tlak (7. ročník, celek Tlak v kapalinách, podtéma Tlak).
//
// Přepsáno 1. 10. 2026 podle návrhu Omega/predavka/2026-10-01/prace/tema4/f7-tlak-b.json
// (klíč „simulace"). Stará verze měla čtyři scény (plyn a teplota, píst, hloubka,
// atmosféra), které do podtématu Tlak nepatří a jejich čísla neměla oporu ve výkladu.
//
// Tři scény, každá jen s tím, co stojí v hlavním výkladu podtématu:
//   A) čokoláda na čtverci 1 m × 1 m: 1–3 dávky po 100 g (≈ 1 N) → p = 1, 2, 3 Pa
//   B) stejná síla, jiná plocha: závaží 5 kg (F = 5 · 10 = 50 N) přímo na písku
//      (100 cm² = 0,01 m² → 5 000 Pa = 5 kPa) nebo na desce 1 m² (na písek 50 Pa,
//      na desku pořád 5 000 Pa) — výklad, Příklad 1
//   C) jedna trojice čísel, tři vzorce: p = F : S, F = p · S, S = F : p
//      (50 N, 0,01 m², 5 000 Pa) — výklad, Příklady 1–3
//
// Všechny výsledky jsou celá čísla; jediné desetinné číslo je 0,01 m² (převod 100 cm²,
// to je samo učivo). Nic se nehýbe samo, nic není náhodné. Stav scén je v SVG atributech
// (opacity, height, y, fill) a v <text>. Hloubka důlku v písku je jen „hlubší × mělčí",
// NEúměrná poměru tlaků 100 : 1. Šířky závaží (10 cm) a desky (1 m) jsou v měřítku 1 : 10.
// Opravy po kontrole 1. 10. 2026: čokoláda ve scéně A je rozsypaná rovnoměrně po celém
// čtverci (ne hromádky — ty by sílu soustředily), mělký důlek pod deskou je vidět,
// třetí řádek rámečku ve scéně C není nikdy prázdný.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vyzkoušej: tlak 🕹️</span></h2>
	<p>
		<strong>Tlak</strong> říká, jak moc je síla soustředěná na plochu: <strong>p = F : S</strong>.
		Vyzkoušej, co se s tlakem stane, když přidáš sílu, a co, když stejnou sílu rozložíš na větší plochu.
	</p>

	<h3>A) Čokoláda na čtverci 1 m × 1 m</h3>
	<svg id="tl-a-svg" viewBox="0 0 440 300" role="img" aria-label="Nastrouhaná čokoláda rovnoměrně rozsypaná po čtverci o ploše 1 metr čtvereční">
		<rect x="0" y="0" width="440" height="300" fill="#eef6ff" />
		<rect x="14" y="10" width="270" height="32" rx="6" fill="#ffffff" stroke="#2b2a26" stroke-width="2" />
		<text x="24" y="34" font-size="22" font-weight="bold" fill="#2b2a26">100 g čokolády ≈ 1 N</text>

		<!-- čtverec 1 m × 1 m -->
		<rect x="30" y="56" width="150" height="150" fill="#fff9db" stroke="#2b2a26" stroke-width="3" />
		<text x="105" y="232" font-size="22" text-anchor="middle" fill="#2b2a26">1 m</text>
		<text x="186" y="139" font-size="22" fill="#2b2a26">1 m</text>

		<!-- nastrouhaná čokoláda ROZSYPANÁ po celém čtverci (síla rozložená na celý 1 m²):
		     každá dávka = 75 drobků v mřížce po 10 j. přes celou plochu, další dávka
		     vyplní mezery mezi předchozími (posyp houstne, nikde nevzniká hromádka).
		     Viditelnost dávky = atribut opacity. -->
		<g id="tl-a-h1" opacity="1">
			<path stroke="#6b3e1f" stroke-width="5" stroke-linecap="round" d="M35 61h0M65 61h0M95 61h0M125 61h0M155 61h0M45 71h0M75 71h0M105 71h0M135 71h0M165 71h0M55 81h0M85 81h0M115 81h0M145 81h0M175 81h0M35 91h0M65 91h0M95 91h0M125 91h0M155 91h0M45 101h0M75 101h0M105 101h0M135 101h0M165 101h0M55 111h0M85 111h0M115 111h0M145 111h0M175 111h0M35 121h0M65 121h0M95 121h0M125 121h0M155 121h0M45 131h0M75 131h0M105 131h0M135 131h0M165 131h0M55 141h0M85 141h0M115 141h0M145 141h0M175 141h0M35 151h0M65 151h0M95 151h0M125 151h0M155 151h0M45 161h0M75 161h0M105 161h0M135 161h0M165 161h0M55 171h0M85 171h0M115 171h0M145 171h0M175 171h0M35 181h0M65 181h0M95 181h0M125 181h0M155 181h0M45 191h0M75 191h0M105 191h0M135 191h0M165 191h0M55 201h0M85 201h0M115 201h0M145 201h0M175 201h0" />
		</g>
		<g id="tl-a-h2" opacity="0">
			<path stroke="#6b3e1f" stroke-width="5" stroke-linecap="round" d="M45 61h0M75 61h0M105 61h0M135 61h0M165 61h0M55 71h0M85 71h0M115 71h0M145 71h0M175 71h0M35 81h0M65 81h0M95 81h0M125 81h0M155 81h0M45 91h0M75 91h0M105 91h0M135 91h0M165 91h0M55 101h0M85 101h0M115 101h0M145 101h0M175 101h0M35 111h0M65 111h0M95 111h0M125 111h0M155 111h0M45 121h0M75 121h0M105 121h0M135 121h0M165 121h0M55 131h0M85 131h0M115 131h0M145 131h0M175 131h0M35 141h0M65 141h0M95 141h0M125 141h0M155 141h0M45 151h0M75 151h0M105 151h0M135 151h0M165 151h0M55 161h0M85 161h0M115 161h0M145 161h0M175 161h0M35 171h0M65 171h0M95 171h0M125 171h0M155 171h0M45 181h0M75 181h0M105 181h0M135 181h0M165 181h0M55 191h0M85 191h0M115 191h0M145 191h0M175 191h0M35 201h0M65 201h0M95 201h0M125 201h0M155 201h0" />
		</g>
		<g id="tl-a-h3" opacity="0">
			<path stroke="#6b3e1f" stroke-width="5" stroke-linecap="round" d="M55 61h0M85 61h0M115 61h0M145 61h0M175 61h0M35 71h0M65 71h0M95 71h0M125 71h0M155 71h0M45 81h0M75 81h0M105 81h0M135 81h0M165 81h0M55 91h0M85 91h0M115 91h0M145 91h0M175 91h0M35 101h0M65 101h0M95 101h0M125 101h0M155 101h0M45 111h0M75 111h0M105 111h0M135 111h0M165 111h0M55 121h0M85 121h0M115 121h0M145 121h0M175 121h0M35 131h0M65 131h0M95 131h0M125 131h0M155 131h0M45 141h0M75 141h0M105 141h0M135 141h0M165 141h0M55 151h0M85 151h0M115 151h0M145 151h0M175 151h0M35 161h0M65 161h0M95 161h0M125 161h0M155 161h0M45 171h0M75 171h0M105 171h0M135 171h0M165 171h0M55 181h0M85 181h0M115 181h0M145 181h0M175 181h0M35 191h0M65 191h0M95 191h0M125 191h0M155 191h0M45 201h0M75 201h0M105 201h0M135 201h0M165 201h0" />
		</g>

		<!-- hodnoty -->
		<text id="tl-a-davky-svg" x="236" y="92" font-size="22" fill="#2b2a26">dávky: 1 × 100 g</text>
		<text id="tl-a-f" x="236" y="134" font-size="22" font-weight="bold" fill="#c92a2a">F = 1 N</text>
		<text id="tl-a-s" x="236" y="176" font-size="22" font-weight="bold" fill="#1864ab">S = 1 m²</text>

		<rect x="20" y="248" width="400" height="44" rx="8" fill="#ffffff" stroke="#2b2a26" stroke-width="2" />
		<text id="tl-a-p" x="220" y="278" font-size="24" font-weight="bold" text-anchor="middle" fill="#2b2a26">p = F : S = 1 : 1 = 1 Pa</text>
	</svg>
	<div class="tl-ovladani">
		<label>počet dávek po 100 g <input id="tl-a-davky" type="range" min="1" max="3" step="1" value="1" /> <span id="tl-a-davky-t">1</span></label>
	</div>
	<p id="tl-a-vysl" class="tl-vysledek"></p>

	<h3>B) Stejná síla, jiná plocha</h3>
	<svg id="tl-b-svg" viewBox="0 0 440 320" role="img" aria-label="Závaží na písku přímo nebo na široké desce">
		<rect x="0" y="0" width="440" height="320" fill="#eef6ff" />
		<rect x="8" y="8" width="424" height="134" rx="8" fill="#ffffff" stroke="#2b2a26" stroke-width="2" />
		<text x="18" y="36" font-size="22" font-weight="bold" fill="#2b2a26">stejná síla F = 5 · 10 = 50 N</text>
		<text id="tl-b-r1" x="18" y="68" font-size="22" fill="#2b2a26">tlak na písek:</text>
		<text id="tl-b-r2" x="18" y="98" font-size="22" font-weight="bold" fill="#c92a2a">p = 50 : 0,01 = 5 000 Pa</text>
		<text id="tl-b-r3" x="18" y="128" font-size="22" fill="#1864ab">tedy 5 000 Pa = 5 kPa</text>

		<!-- písek a důlek (hloubka důlku = atribut height) -->
		<rect x="0" y="240" width="440" height="80" fill="#e9c46a" />
		<rect id="tl-b-dulek" x="192" y="240" width="56" height="36" fill="#a0782c" />

		<!-- deska 1 m² (viditelnost = opacity); šířky v měřítku: závaží 10 cm = 40 j.,
		     deska 1 m = 100 cm = 400 j. (poměr 1 : 10) -->
		<rect id="tl-b-deska" x="20" y="244" width="400" height="6" fill="#8d6e63" stroke="#2b2a26" stroke-width="2" opacity="0" />
		<text id="tl-b-deska-t" x="220" y="278" font-size="22" text-anchor="middle" fill="#2b2a26" opacity="0"></text>

		<!-- závaží 5 kg, podstava 10 cm × 10 cm = 100 cm²; popisek nad ním -->
		<rect id="tl-b-zavazi" x="200" y="236" width="40" height="40" rx="3" fill="#495057" stroke="#2b2a26" stroke-width="3" />
		<text id="tl-b-zavazi-t" x="220" y="226" font-size="21" font-weight="bold" text-anchor="middle" fill="#2b2a26">5 kg</text>

		<text x="220" y="310" font-size="22" text-anchor="middle" fill="#2b2a26">plocha dotyku závaží 100 cm²</text>
	</svg>
	<div class="tl-tlacitka">
		<button id="tl-b-primo" type="button" aria-pressed="true">závaží přímo na písku</button>
		<button id="tl-b-na-desce" type="button" aria-pressed="false">závaží na desce 1 m²</button>
	</div>
	<p id="tl-b-vysl" class="tl-vysledek"></p>

	<h3>C) Jedna trojice čísel, tři vzorce</h3>
	<svg id="tl-c-svg" viewBox="0 0 440 345" role="img" aria-label="Karty síla, plocha a tlak a vzorec pro hledanou veličinu">
		<rect x="0" y="0" width="440" height="345" fill="#eef6ff" />
		<rect id="tl-c-k-F" x="20" y="16" width="120" height="100" rx="10" fill="#ffffff" stroke="#2b2a26" stroke-width="3" />
		<text x="80" y="52" font-size="24" font-weight="bold" text-anchor="middle" fill="#2b2a26">F</text>
		<text id="tl-c-v-F" x="80" y="96" font-size="22" font-weight="bold" text-anchor="middle" fill="#2b2a26">50 N</text>
		<rect id="tl-c-k-S" x="160" y="16" width="120" height="100" rx="10" fill="#ffffff" stroke="#2b2a26" stroke-width="3" />
		<text x="220" y="52" font-size="24" font-weight="bold" text-anchor="middle" fill="#2b2a26">S</text>
		<text id="tl-c-v-S" x="220" y="96" font-size="22" font-weight="bold" text-anchor="middle" fill="#2b2a26">0,01 m²</text>
		<rect id="tl-c-k-p" x="300" y="16" width="120" height="100" rx="10" fill="#ffd43b" stroke="#c92a2a" stroke-width="4" />
		<text x="360" y="52" font-size="24" font-weight="bold" text-anchor="middle" fill="#2b2a26">p</text>
		<text id="tl-c-v-p" x="360" y="96" font-size="22" font-weight="bold" text-anchor="middle" fill="#2b2a26">?</text>

		<rect x="8" y="132" width="424" height="134" rx="8" fill="#ffffff" stroke="#2b2a26" stroke-width="2" />
		<text id="tl-c-vzorec" x="220" y="166" font-size="26" font-weight="bold" text-anchor="middle" fill="#2b2a26">p = F : S</text>
		<text id="tl-c-vypocet" x="220" y="206" font-size="23" font-weight="bold" text-anchor="middle" fill="#c92a2a">p = 50 : 0,01 = 5 000 Pa</text>
		<text id="tl-c-r3" x="220" y="246" font-size="22" text-anchor="middle" fill="#1864ab">tedy 5 000 Pa = 5 kPa</text>

		<text x="220" y="298" font-size="22" text-anchor="middle" fill="#2b2a26">S dosazuj v m²:</text>
		<text x="220" y="328" font-size="22" text-anchor="middle" fill="#2b2a26">100 cm² = 1 dm² = 0,01 m²</text>
	</svg>
	<div class="tl-ovladani">
		<label>hledám <input id="tl-c-hledana" type="range" min="0" max="2" step="1" value="0" /> <span id="tl-c-hledana-t">tlak</span></label>
	</div>
	<p id="tl-c-vysl" class="tl-vysledek"></p>
</section>

<script>
	const $ = (id) => document.getElementById(id);
	const nastav = (id, atributy) => {
		const el = $(id);
		for (const k of Object.keys(atributy)) el.setAttribute(k, atributy[k]);
	};
	/** Česky zapsané číslo: tisíce oddělené nezlomitelnou mezerou, desetinná čárka. */
	const cislo = (n) => {
		const [cela, des] = String(n).split('.');
		const skupiny = cela.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
		return des ? `${skupiny},${des}` : skupiny;
	};

	// ---------- konstanty z výkladu ----------
	const S_CTVERCE = 1; // m² — čtverec 1 m × 1 m (scéna A); jedna dávka 100 g má tíhu asi 1 N
	const M = 5; // kg — závaží (Příklad 1)
	const G = 10; // N/kg
	const S_ZAVAZI_CM2 = 100; // cm² — plocha dotyku závaží
	const CM2_V_M2 = 10000; // cm² v jednom m² (100 dm², každý po 100 cm²)
	const S_DESKY = 1; // m²
	const PA_V_KPA = 1000; // Pa v jednom kPa

	const F = M * G; // 50 N
	const S = S_ZAVAZI_CM2 / CM2_V_M2; // 0,01 m² — převod, bez něj by tlak vyšel 100× menší
	const P_ZAVAZI = F / S; // 5 000 Pa
	const P_DESKY = F / S_DESKY; // 50 Pa (tíhu desky nepočítáme)

	// ---------- A) čokoláda ----------
	function kresliA() {
		const davky = +$('tl-a-davky').value;
		const sila = davky; // každá dávka 100 g ≈ 1 N
		const tlak = sila / S_CTVERCE;
		for (const i of [1, 2, 3]) nastav(`tl-a-h${i}`, { opacity: i <= davky ? 1 : 0 });
		$('tl-a-davky-t').textContent = String(davky);
		$('tl-a-davky-svg').textContent = `dávky: ${davky} × 100 g`;
		$('tl-a-f').textContent = `F = ${sila} N`;
		$('tl-a-s').textContent = `S = ${S_CTVERCE} m²`;
		$('tl-a-p').textContent = `p = F : S = ${sila} : ${S_CTVERCE} = ${tlak} Pa`;
		$('tl-a-vysl').textContent = `${davky} × 100 g čokolády na ploše 1 m² tlačí silou ${sila} N, tlak je ${tlak} Pa. Větší síla na stejné ploše, větší tlak.`;
	}

	// ---------- B) stejná síla, jiná plocha ----------
	// Kresba obou poloh: důlek je u závaží přímo na písku hlubší, pod deskou mělčí
	// (jen hlubší × mělčí, NE v poměru tlaků 100 : 1).
	// Důlek je vždy o 8 j. na každou stranu širší než to, co v něm leží; deska (výška 6)
	// leží na dně mělkého důlku (hloubka 10), takže nad ní i po stranách je důlek vidět.
	const KRESBA = {
		primo: { dulekX: 192, dulekSirka: 56, dulekHloubka: 36, deska: 0, zavaziY: 236 },
		deska: { dulekX: 12, dulekSirka: 416, dulekHloubka: 10, deska: 1, zavaziY: 204 },
	};
	let rezim = 'primo';
	function kresliB() {
		const naDesce = rezim === 'deska';
		const k = naDesce ? KRESBA.deska : KRESBA.primo;
		nastav('tl-b-dulek', { x: k.dulekX, width: k.dulekSirka, height: k.dulekHloubka });
		nastav('tl-b-deska', { opacity: k.deska });
		nastav('tl-b-deska-t', { opacity: k.deska });
		// skrytý popisek je i prázdný — jinak by se měřil jako neviditelný text
		nastav('tl-b-zavazi', { y: k.zavaziY });
		nastav('tl-b-zavazi-t', { y: k.zavaziY - 10 });
		$('tl-b-primo').setAttribute('aria-pressed', String(!naDesce));
		$('tl-b-na-desce').setAttribute('aria-pressed', String(naDesce));
		$('tl-b-deska-t').textContent = naDesce ? `plocha desky ${S_DESKY} m²` : '';
		if (naDesce) {
			$('tl-b-r2').textContent = `p = ${F} : ${S_DESKY} = ${P_DESKY} Pa`;
			$('tl-b-r3').textContent = `tlak na desku: pořád ${cislo(P_ZAVAZI)} Pa`;
			$('tl-b-vysl').textContent = `Deska rozloží sílu na větší plochu, a proto je tlak na písek menší. Přímo na písku je tlak ${cislo(P_ZAVAZI)} Pa, přes desku o ploše 1 m² jen ${P_DESKY} Pa. Tlak závaží na desku se nezměnil.`;
		} else {
			$('tl-b-r2').textContent = `p = ${F} : ${cislo(S)} = ${cislo(P_ZAVAZI)} Pa`;
			$('tl-b-r3').textContent = `tedy ${cislo(P_ZAVAZI)} Pa = ${P_ZAVAZI / PA_V_KPA} kPa`;
			$('tl-b-vysl').textContent = `Závaží tlačí silou ${F} N na plochu 100 cm² = 0,01 m², tlak na písek je ${cislo(P_ZAVAZI)} Pa = ${P_ZAVAZI / PA_V_KPA} kPa. Polož ho na desku a porovnej.`;
		}
	}

	// ---------- C) tři vzorce ----------
	const HLEDANE = [
		// r3 = třetí řádek rámečku, v každém stavu neprázdný (dřív zůstával u tlaku a síly prázdný pruh)
		{ co: 'p', nazev: 'tlak', vzorec: 'p = F : S', vypocet: () => `p = ${F} : ${cislo(S)} = ${cislo(F / S)} Pa`, r3: () => `tedy ${cislo(F / S)} Pa = ${F / S / PA_V_KPA} kPa` },
		{ co: 'F', nazev: 'síla', vzorec: 'F = p · S', vypocet: () => `F = ${cislo(P_ZAVAZI)} · ${cislo(S)} = ${P_ZAVAZI * S} N`, r3: () => `zkouška: ${P_ZAVAZI * S} : ${cislo(S)} = ${cislo(P_ZAVAZI * S / S)} Pa` },
		{ co: 'S', nazev: 'plocha', vzorec: 'S = F : p', vypocet: () => `S = ${F} : ${cislo(P_ZAVAZI)} = ${cislo(F / P_ZAVAZI)} m²`, r3: () => `tedy ${cislo(F / P_ZAVAZI)} m² = ${(F / P_ZAVAZI) * CM2_V_M2} cm²` },
	];
	const HODNOTY = { F: `${F} N`, S: `${cislo(S)} m²`, p: `${cislo(P_ZAVAZI)} Pa` };
	function kresliC() {
		const h = HLEDANE[+$('tl-c-hledana').value];
		for (const co of ['F', 'S', 'p']) {
			const hledam = co === h.co;
			$(`tl-c-v-${co}`).textContent = hledam ? '?' : HODNOTY[co];
			nastav(`tl-c-k-${co}`, hledam
				? { fill: '#ffd43b', stroke: '#c92a2a', 'stroke-width': 4 }
				: { fill: '#ffffff', stroke: '#2b2a26', 'stroke-width': 3 });
		}
		$('tl-c-hledana-t').textContent = h.nazev;
		$('tl-c-vzorec').textContent = h.vzorec;
		$('tl-c-vypocet').textContent = h.vypocet();
		$('tl-c-r3').textContent = h.r3();
		$('tl-c-vysl').textContent = `Hledám ${h.nazev}: ${h.vzorec}. Vzorec p = F : S umíme obrátit na F = p · S a S = F : p.`;
	}

	$('tl-a-davky').addEventListener('input', kresliA);
	$('tl-b-primo').addEventListener('click', () => { rezim = 'primo'; kresliB(); });
	$('tl-b-na-desce').addEventListener('click', () => { rezim = 'deska'; kresliB(); });
	$('tl-c-hledana').addEventListener('input', kresliC);

	kresliA();
	kresliB();
	kresliC();
</script>

<style>
	.simulace svg {
		width: 100%;
		max-width: 440px;
		display: block;
		margin: 0 auto;
		border: 3px solid #2b2a26;
		border-radius: 12px;
	}
	.tl-ovladani {
		display: flex;
		justify-content: center;
		margin: 0.8rem 0;
	}
	.tl-ovladani label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
	}
	.tl-ovladani input[type='range'] {
		min-width: 8rem;
		height: 2.75rem;
