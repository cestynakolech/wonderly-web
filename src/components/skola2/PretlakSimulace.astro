---
// Přetlak, podtlak, vakuum (F7): válec s pístem a manometrem. Posuvník mění
// objem uzavřeného vzduchu (1/2/4/8 dílků) → tlak 400/200/100/50 kPa (okolí
// = 100 kPa = 1 bar), vývěva odčerpá vzduch na ~0 kPa (vakuum). Manometr
// ukazuje ROZDÍL proti okolí: +300/+100/0/−50/−100 kPa — vše celé. Molekuly
// houstnou při stlačení, mizí s vývěvou. Bez časové animace; stav je čistá
// funkce stavPistu(poloha, vyveva) na SVG (__stavPistu).
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Píst, manometr a vývěva 🕹️</span></h2>
	<p>Je-li v nádobě <strong>jiný tlak než venku</strong> (okolo nás je ~100 kPa = 1 bar), vzniká <strong>přetlak</strong>, <strong>podtlak</strong>, nebo po odčerpání vzduchu <strong>vakuum</strong>. Zahýbej pístem a sleduj manometr.</p>
	<svg id="pre-svg" viewBox="0 0 660 320" role="img" aria-label="Válec s pístem, molekulami vzduchu a manometrem">
		<!-- válec -->
		<g stroke="#2b2a26" stroke-width="5" stroke-linecap="round">
			<line x1="40" y1="120" x2="40" y2="260" />
			<line x1="40" y1="120" x2="400" y2="120" />
			<line x1="40" y1="260" x2="400" y2="260" />
		</g>
		<!-- molekuly vzduchu -->
		<g id="pre-molekuly" fill="#74c0fc"></g>
		<!-- píst -->
		<rect id="pre-pist" y="126" width="22" height="128" fill="#adb5bd" stroke="#2b2a26" stroke-width="3" />
		<rect id="pre-tyc" y="182" width="150" height="14" fill="#868e96" stroke="#2b2a26" stroke-width="2" />
		<text id="pre-objem-pop" x="150" y="292" text-anchor="middle" font-size="12" fill="#868e96"></text>
		<!-- vývěva -->
		<g id="pre-vyveva-ikona" visibility="hidden">
			<rect x="60" y="60" width="70" height="40" rx="8" fill="#e9ecef" stroke="#2b2a26" stroke-width="3" />
			<text x="95" y="86" text-anchor="middle" font-size="14" font-weight="bold" fill="#2b2a26">vývěva</text>
			<line x1="95" y1="100" x2="95" y2="120" stroke="#2b2a26" stroke-width="4" />
		</g>
		<!-- manometr -->
		<path d="M460 200 A85 85 0 0 1 630 200" fill="#fff" stroke="#2b2a26" stroke-width="3" />
		<line x1="460" y1="200" x2="630" y2="200" stroke="#2b2a26" stroke-width="3" />
		<g font-size="10" fill="#868e96" text-anchor="middle">
			<text x="472" y="160">PODTLAK</text><text x="545" y="108">0</text><text x="618" y="160">PŘETLAK</text>
		</g>
		<line id="pre-rucicka" x1="545" y1="200" x2="545" y2="128" stroke="#e03131" stroke-width="5" stroke-linecap="round" />
		<circle cx="545" cy="200" r="6" fill="#2b2a26" />
		<text id="pre-rozdil" x="545" y="230" text-anchor="middle" font-size="16" font-weight="bold" fill="#e03131"></text>
		<text x="545" y="250" text-anchor="middle" font-size="11" fill="#868e96">manometr — rozdíl proti okolí</text>
		<text id="pre-tlak" x="545" y="60" text-anchor="middle" font-size="20" font-weight="bold" fill="#2b2a26"></text>
		<text x="545" y="80" text-anchor="middle" font-size="11" fill="#868e96">tlak uvnitř (okolí: 100 kPa = 1 bar)</text>
	</svg>
	<label class="sim-posuvnik">
		Poloha pístu: <output id="pre-out"></output>
		<input type="range" id="pre-slider" min="0" max="3" step="1" value="2" />
	</label>
	<p>
		<button type="button" class="pre-tl" id="pre-vyveva">🔌 zapni vývěvu (odčerpej vzduch)</button>
	</p>
	<p class="pre-vzorec" id="pre-vzorec"></p>
	<p class="pre-stav" id="pre-stav">👉 Stlač píst doleva (přetlak), roztáhni doprava (podtlak) — a pak zkus vývěvu.</p>
</section>

<script>
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	const OBJEMY = [1, 2, 4, 8]; // dílky; výchozí 4 dílky při tlaku okolí
	const OKOLI = 100; // kPa (= 1 bar = 100 000 Pa)
	function stavPistu(poloha, vyveva) {
		const V = OBJEMY[poloha];
		const p = vyveva ? 0 : 400 / V; // stejné množství vzduchu: p·V = konst → 400/200/100/50
		const rozdil = p - OKOLI;
		const pasmo = vyveva ? 'vakuum' : rozdil > 0 ? 'pretlak' : rozdil === 0 ? 'vyrovnano' : 'podtlak';
		return { V, p, rozdil, pasmo };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	let vyveva = false;
	const svg = document.getElementById('pre-svg');
	svg.__stavPistu = stavPistu; // pro nezávislou kontrolu výpočtem
	const g = (id) => document.getElementById(id);
	const nastav = (id, attrs) => { const el = g(id); for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v); };

	function kresli() {
		const poloha = +g('pre-slider').value;
		const s = stavPistu(poloha, vyveva);
		// píst: objem V dílků = šířka V×44 px od levého čela (x=43)
		const pistX = 43 + s.V * 44;
		nastav('pre-pist', { x: pistX });
		// tyč nesmí zasahovat do manometru (začíná na x=460) — šířku omezíme podle polohy pístu
		const tycX = pistX + 22;
		const tycW = Math.max(10, Math.min(150, 450 - tycX));
		nastav('pre-tyc', { x: tycX, width: tycW });
		g('pre-objem-pop').textContent = `uzavřený vzduch: ${s.V} ${s.V === 1 ? 'dílek' : s.V < 5 ? 'dílky' : 'dílků'} objemu`;
		g('pre-out').textContent = ['úplně stlačený', 'stlačený', 'výchozí', 'roztažený'][poloha];
		// molekuly: 12 kusů rozmístěných v objemu (s vývěvou žádné)
		const mol = g('pre-molekuly');
		if (vyveva) mol.innerHTML = '';
		else {
			let html = '';
			for (let i = 0; i < 12; i++) {
				const x = 50 + ((i % 4) + 0.5) * (s.V * 44 - 14) / 4;
				const y = 140 + Math.floor(i / 4) * 40 + (i % 2) * 12;
				html += `<circle cx="${x}" cy="${y}" r="6" />`;
			}
			mol.innerHTML = html;
		}
		g('pre-vyveva-ikona').setAttribute('visibility', vyveva ? 'visible' : 'hidden');
		g('pre-vyveva').textContent = vyveva ? '💨 vpusť vzduch zpátky' : '🔌 zapni vývěvu (odčerpej vzduch)';
		// manometr: kladný rozdíl 0–300 → 0–60°, záporný 0–(−100) → 0–(−60°)
		const deg = s.rozdil >= 0 ? (s.rozdil / 300) * 60 : (s.rozdil / 100) * 60;
		nastav('pre-rucicka', { transform: `rotate(${deg} 545 200)` });
		g('pre-rozdil').textContent = `${s.rozdil > 0 ? '+' : ''}${s.rozdil} kPa`;
		g('pre-tlak').textContent = `${s.p} kPa`;
		g('pre-vzorec').innerHTML = vyveva
			? `Vývěva odčerpala téměř všechen vzduch: tlak ~<strong>0 kPa</strong>, manometr ukazuje <strong>−100 kPa</strong> proti okolí.`
			: `Stejné množství vzduchu v ${s.V} dílcích: tlak = 400 ÷ ${s.V} = <strong>${s.p} kPa</strong> → rozdíl proti okolí <strong>${s.rozdil > 0 ? '+' : ''}${s.rozdil} kPa</strong>.`;
		const STAVY = {
			pretlak: '🎈 PŘETLAK — uvnitř je VÍC než venku. Stejně je na tom nafouknutý míč, pneumatika (hustí se asi na 2,5 baru přetlaku), sprej nebo plíce po nádechu. Vyrábí ho hustilka či kompresor.',
			vyrovnano: '⚖️ Tlaky jsou vyrovnané — uvnitř i venku 100 kPa (1 bar = 100 000 Pa). Manometr ukazuje nulu.',
			podtlak: '🥤 PODTLAK — uvnitř je MÍŇ než venku, okolí se NASÁVÁ dovnitř (tlaky se chtějí vyrovnat). Tak funguje pití brčkem, vysavač, přísavka i plíce před nádechem.',
			vakuum: '🌌 VAKUUM — téměř žádný vzduch (odčerpala ho vývěva). Vakuum je v baňce žárovky, ve vakuově balených potravinách a ve vesmíru.',
		};
		g('pre-stav').textContent = STAVY[s.pasmo];
	}

	g('pre-slider').addEventListener('input', () => { kresli(); });
	g('pre-vyveva').addEventListener('click', () => { vyveva = !vyveva; kresli(); });
	kresli();
</script>

<style>
	#pre-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.pre-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; }
	.pre-tl:active { transform: translateY(1px); }
	.pre-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.pre-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
