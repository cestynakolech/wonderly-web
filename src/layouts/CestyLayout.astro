---
import type { Jazyk } from '../data/cesty/typy';
import { JAZYKY, JAZYK_POPIS, TEXTY, cestaCesty } from '../data/cesty/preklady';

interface Props {
	titulek: string;
	jazyk?: Jazyk;
	/** Část adresy za /cesty (např. "2026" nebo "vse") — pro odkazy přepínače jazyků */
	podcesta?: string;
	/** Krátký popis stránky pro vyhledávače a náhled odkazu */
	popisStranky?: string;
}

const { titulek, jazyk = 'cs', podcesta = '', popisStranky } = Astro.props;
---

<html lang={jazyk}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="ZEylrReeuR3ugh0Twk47nDX7VbeXBb7nKaNOdKxj5qA" />
		<title>{titulek}</title>
		{popisStranky && <meta name="description" content={popisStranky} />}
		{/* Provázání jazykových verzí — vyhledávač i čtečka pak vědí, že jde o tutéž
		    stránku ve čtyřech jazycích, a nabídnou návštěvníkovi tu jeho. */}
		{
			JAZYKY.map((j) => (
				<link rel="alternate" hreflang={j} href={`https://cesty.wonderly.cz${cestaCesty(j, podcesta)}`} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={`https://cesty.wonderly.cz${cestaCesty('cs', podcesta)}`} />
		<link rel="canonical" href={`https://cesty.wonderly.cz${cestaCesty(jazyk, podcesta)}`} />
		<script is:inline>
			// nastavit vzhled dřív, než se stránka vykreslí (žádné bliknutí)
			// localStorage může být zakázané (přísné nastavení cookies) — bez try by
			// tu skript spadl a stránka by zůstala ve světlém režimu i pro toho,
			// kdo si zvolil tmavý
			try {
				const ulozeny = localStorage.getItem('vzhled');
				if (ulozeny === 'dark' || (!ulozeny && matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.dataset.theme = 'dark';
				}
			} catch (e) {
				if (matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.dataset.theme = 'dark';
				}
			}
		</script>
	</head>
	<body>
		<div class="horni-panel">
			<nav class="jazyky" aria-label="Jazyk / Language / Sprache / Langue">
				{
					JAZYKY.map((j) => (
						<a
							href={cestaCesty(j, podcesta)}
							hreflang={j}
							lang={j}
							class={j === jazyk ? 'aktivni' : undefined}
							aria-current={j === jazyk ? 'page' : undefined}
							title={JAZYK_POPIS[j].nazev}
						>
							{/* vlajka je jen ozdoba — čtečka přečte zkratku jazyka */}
							<span class="vlajka" aria-hidden="true">{JAZYK_POPIS[j].vlajka}</span>
							{j.toUpperCase()}
						</a>
					))
				}
			</nav>
			<button id="prepinac-vzhledu" aria-label={TEXTY[jazyk].prepnoutVzhled} title={TEXTY[jazyk].prepnoutVzhled}>◐</button>
		</div>
		<main>
			<slot />
		</main>
		<script is:inline>
			document.getElementById('prepinac-vzhledu').addEventListener('click', () => {
				const koren = document.documentElement;
				const tmavy = koren.dataset.theme === 'dark';
				if (tmavy) {
					delete koren.dataset.theme;
				} else {
					koren.dataset.theme = 'dark';
				}
				localStorage.setItem('vzhled', tmavy ? 'light' : 'dark');
			});

			/* Přepnutí jazyka nesmí zahodit, kam se návštěvník na mapě proklikal.
			   Zanoření mapy se drží v adrese za # (CestyRok.astro), ale odkazy
			   přepínače vedly na holou stránku roku — po přepnutí se muselo klikat
			   znovu od začátku (připomínka učitele 30. 7. 2026). Hash proto do
			   odkazů dopisujeme a při každé změně zanoření aktualizujeme. */
			(function () {
				const odkazy = document.querySelectorAll('.jazyky a');
				if (!odkazy.length) return;
				const zaklady = Array.from(odkazy, (a) => a.getAttribute('href').split('#')[0]);
				const uprav = () => odkazy.forEach((a, i) => { a.href = zaklady[i] + location.hash; });
				uprav();
				window.addEventListener('hashchange', uprav);
				/* Zanoření mapy se ukládá přes history.replaceState, které událost
				   hashchange NEspouští — proto se adresa dopisuje ještě jednou
				   v okamžiku kliknutí, kdy je location.hash vždy aktuální. */
				odkazy.forEach((a, i) => {
					a.addEventListener('click', () => { a.href = zaklady[i] + location.hash; });
				});
			})();
		</script>
		<style is:global>
			:root {
				--pozadi: #ffffff;
				--text: #1c1c1c;
				--ztlumeny: #5f5f5f; /* 7,0:1 na bílé i na --plocha; #777 mělo jen 4,0:1 */
				--cara: #e3e3e3;
				--plocha: #f4f2ee;
				--odkaz: #0b57d0;
				--pin: #d33;
				--pin-hover: #a00;
			}
			:root[data-theme='dark'] {
				--pozadi: #16181c;
				--text: #e8e6e3;
				--ztlumeny: #9a9a9a;
				--cara: #33363c;
				--plocha: #22252b;
				--odkaz: #8ab4f8;
				--pin: #e5484d;
				--pin-hover: #ff6b6b;
			}
			html,
			body {
				margin: 0;
				background: var(--pozadi);
				color: var(--text);
			}
			main {
				max-width: 820px;
				margin: 3rem auto;
				font-family: system-ui, sans-serif;
				padding: 0 1rem;
			}
			a {
				color: var(--odkaz);
			}
			.horni-panel {
				position: fixed;
				top: 0.8rem;
				right: 0.8rem;
				z-index: 10;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.jazyky {
				display: flex;
				gap: 0.15rem;
				padding: 0.2rem;
				border: 1px solid var(--cara);
				border-radius: 999px;
				background: var(--plocha);
			}
			.jazyky a {
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				font-family: system-ui, sans-serif;
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--ztlumeny);
				text-decoration: none;
				padding: 0.3rem 0.5rem;
				border-radius: 999px;
			}
			.jazyky .vlajka {
				font-size: 0.9rem;
				line-height: 1;
			}
			/* na úzkém telefonu by se čtyři jazyky i se zkratkami nevešly vedle
			   nadpisu — tam zůstane jen vlajka */
			@media (max-width: 26rem) {
				.jazyky a {
					font-size: 0;
					gap: 0;
					padding: 0.3rem 0.35rem;
				}
				.jazyky .vlajka {
					font-size: 1.05rem;
				}
			}
			.jazyky a:hover {
				color: var(--text);
			}
			.jazyky a.aktivni {
				color: var(--text);
				background: var(--pozadi);
			}
			#prepinac-vzhledu {
				font-size: 1.25rem;
				line-height: 1;
				padding: 0.45rem 0.55rem;
				border: 1px solid var(--cara);
				border-radius: 999px;
				background: var(--plocha);
				color: var(--text);
				cursor: pointer;
			}
			svg.mapa {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 8px;
				background: var(--plocha);
			}
			.pin {
				fill: var(--pin);
				stroke: var(--pozadi);
				cursor: pointer;
			}
			a:hover .pin {
				fill: var(--pin-hover);
			}
			.pin-popisek {
				font-weight: 700;
				fill: var(--text);
				paint-order: stroke;
				stroke: var(--pozadi);
			}
			.tlacitka {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 1.2rem 0;
				padding: 0;
				list-style: none;
			}
			.tlacitka a {
				display: inline-block;
				padding: 0.55rem 1.1rem;
				border: 1px solid var(--cara);
				border-radius: 999px;
				background: var(--plocha);
				color: var(--text);
				text-decoration: none;
				font-weight: 600;
			}
			.tlacitka a:hover {
				border-color: var(--ztlumeny);
			}
			.mesta article {
				border-top: 1px solid var(--cara);
				margin-top: 1.5rem;
				padding-top: 0.5rem;
			}
			.meta {
				color: var(--ztlumeny);
				font-size: 0.9rem;
			}
			footer {
				margin-top: 2.5rem;
				font-size: 0.8rem;
				color: var(--ztlumeny);
			}
			footer a {
				color: var(--ztlumeny);
			}
		</style>
	</body>
</html>
