	#vs-svg { width: 100%; max-width: 480px; border-radius: 12px; display: block; touch-action: none; }
	#vs-svg:focus { outline: 3px dashed #1971c2; outline-offset: 3px; }
	.vs-radek { margin: 0.6rem 0; }
	.vs-tl { font: inherit; font-weight: 700; padding: 0.25rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.35rem 0.35rem 0; }
	.vs-tl.vs-aktivni { background: #ffe8cc; }
	.vs-tl.vs-hraj { background: #d3f9d8; }
	.vs-tl:active { transform: translateY(1px); }
	.vs-stats { font-weight: 700; margin: 0.5rem 0; }
	.vs-cervene { color: #c92a2a; }
	.vs-bar { display: inline-block; width: 140px; height: 12px; background: #e9ecef; border: 2px solid #2b2a26; border-radius: 6px; overflow: hidden; vertical-align: middle; margin: 0 0.3rem; }
	.vs-bar-vypln { display: block; height: 100%; }
	.vs-program { margin: 0.4rem 0; }
	.vs-program p { margin: 0.12rem 0; font-weight: 700; background: #a5d8ff; border-radius: 4px; padding: 0.1rem 0.45rem; display: block; width: fit-content; }
	.vs-program p.vs-hlava { background: #ffd43b; border-radius: 8px 8px 4px 4px; }
	.vs-program p.vs-nadpis { background: transparent; font-weight: 800; text-decoration: underline; padding: 0.3rem 0 0 0; }
	.vs-program p.vs-vypnuto { background: #ffc9c9; outline: 2px dashed #c92a2a; text-decoration: line-through; opacity: 0.85; }
	.vs-vysvetleni { font-size: 1.05rem; font-weight: 700; min-height: 3.6rem; }
</style>
