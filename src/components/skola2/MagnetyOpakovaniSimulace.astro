	#mopak-a-svg, #mopak-b-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; margin-bottom: 0.6rem; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.mopak-tl { font: inherit; font-weight: 700; padding: 0.4rem 1rem; border: 3px solid #2b2a26; border-radius: 10px; background: #ffd43b; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.mopak-tl:active { transform: translateY(1px); }
	.mopak-tl:disabled { opacity: 0.5; cursor: not-allowed; }
	.mopak-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
