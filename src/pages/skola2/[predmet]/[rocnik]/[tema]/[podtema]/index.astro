---
import SkolaLayout from '../../../../../../layouts/SkolaLayout.astro';
import Kviz from '../../../../../../components/skola2/Kviz.astro';
import QrKod from '../../../../../../components/skola2/QrKod.astro';
import HydraulikaSimulace from '../../../../../../components/skola2/HydraulikaSimulace.astro';
import SkupenstviSimulace from '../../../../../../components/skola2/SkupenstviSimulace.astro';
import ObvodSimulace from '../../../../../../components/skola2/ObvodSimulace.astro';
import HustotaSimulace from '../../../../../../components/skola2/HustotaSimulace.astro';
import TeplomerSimulace from '../../../../../../components/skola2/TeplomerSimulace.astro';
import SkladaniSilSimulace from '../../../../../../components/skola2/SkladaniSilSimulace.astro';
import VrhSimulace from '../../../../../../components/skola2/VrhSimulace.astro';
import { predmety, rocniky } from '../../../../../../data/predmety';
import { temata } from '../../../../../../data/temata';
import { kvizy } from '../../../../../../data/kvizy';

export function getStaticPaths() {
	const paths = [];
	for (const [klic, seznamTemat] of Object.entries(temata)) {
		const [predmetSlug, rocnikSlug] = klic.split('/');
		const predmet = predmety.find((p) => p.slug === predmetSlug);
		const rocnik = rocniky.find((r) => r.slug === rocnikSlug);
		for (const tema of seznamTemat) {
			for (const podtema of tema.podtemata ?? []) {
				paths.push({
					params: { predmet: predmetSlug, rocnik: rocnikSlug, tema: tema.slug, podtema: podtema.slug },
					props: { predmet, rocnik, tema, podtema },
				});
			}
		}
	}
	return paths;
}

const { predmet, rocnik, tema, podtema } = Astro.props;
const klicKvizu = `${predmet.slug}/${rocnik.slug}/${tema.slug}/${podtema.slug}`;
const otazky = kvizy[klicKvizu];
const absolutniUrl = `https://lab.wonderly.cz/${klicKvizu}/`;

const ikonyDruhu = { infografika: '🖼️', pdf: '📄', video: '🎬' };
---

<SkolaLayout
	titulek={`${podtema.nazev} – ${tema.nazev} – Wonderly`}
	drobky={[
		{ text: '2. stupeň', href: '../../../../' },
		{ text: predmet.nazev, href: '../../../' },
		{ text: rocnik.nazev, href: '../../' },
		{ text: tema.nazev, href: '../' },
	]}
>
	<h1><span class="podtrh">{podtema.nazev}</span></h1>
	<details class="qr-podtema">
		<summary>📱 QR na toto téma (pro promítnutí)</summary>
		<p>Naskenuj a máš toto téma rovnou v telefonu.</p>
		<QrKod url={absolutniUrl} velikost={150} popis={podtema.nazev} />
	</details>
	{
		podtema.obsah ? (
			<article class="ramecek vyklad" set:html={podtema.obsah} />
		) : (
			<p class="uvodni-text">Obsah připravujeme.</p>
		)
	}
	{
		podtema.materialy && podtema.materialy.length > 0 && (
			<section>
				<h2><span class="podtrh">Materiály k tématu 📚</span></h2>
				{podtema.materialy
					.filter((m) => m.druh === 'infografika')
					.map((m) => (
						<figure class="infografika">
							<img src={m.cesta} alt={m.nazev} loading="lazy" />
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				{podtema.materialy
					.filter((m) => m.druh === 'video')
					.map((m) => (
						<figure class="video">
							<video src={m.cesta} controls preload="metadata" />
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				{podtema.materialy
					.filter((m) => m.druh === 'youtube')
					.map((m) => (
						<figure class="video">
							<div class="youtube-obal">
								<iframe
									src={`https://www.youtube-nocookie.com/embed/${m.cesta}`}
									title={m.nazev}
									loading="lazy"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
								/>
							</div>
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				{podtema.materialy
					.filter((m) => m.druh === 'audio')
					.map((m) => (
						<figure class="audio">
							<audio src={m.cesta} controls preload="metadata" />
							<figcaption>{m.nazev}</figcaption>
						</figure>
					))}
				<ul class="karty">
					{podtema.materialy
						.filter((m) => m.druh === 'pdf')
						.map((m) => (
							<li>
								<a class="karta" href={m.cesta} target="_blank" rel="noopener">
									<span class="ikona">{ikonyDruhu[m.druh]}</span>
									<span class="nazev">{m.nazev}</span>
									<span class="popisek">otevřít PDF</span>
								</a>
							</li>
						))}
				</ul>
			</section>
		)
	}
	{podtema.interakce === 'hydraulika' && <HydraulikaSimulace />}
	{podtema.interakce === 'skupenstvi' && <SkupenstviSimulace />}
	{podtema.interakce === 'obvod' && <ObvodSimulace />}
	{podtema.interakce === 'hustota' && <HustotaSimulace />}
	{podtema.interakce === 'teplomer' && <TeplomerSimulace />}
	{podtema.interakce === 'skladani-sil' && <SkladaniSilSimulace />}
	{podtema.interakce === 'vrh' && <VrhSimulace />}
	{otazky && <Kviz otazky={otazky} />}
</SkolaLayout>

<style is:global>
	.vyklad h2 {
		margin-top: 0;
	}
	.qr-podtema {
		margin: 0 0 1.2rem;
		font-size: 0.95rem;
		color: var(--ztlumena);
	}
	.qr-podtema summary {
		cursor: pointer;
		font-weight: 600;
	}
	.qr-podtema p {
		margin: 0.5rem 0;
	}
	.infografika,
	.video {
		margin: 1.5rem 0;
		text-align: center;
	}
	.infografika img {
		max-width: min(100%, 34rem);
		height: auto;
		border: 2.5px solid var(--inkoust);
		border-radius: 12px;
		box-shadow: 2px 3px 0 rgba(43, 42, 38, 0.14);
	}
	.video video {
		max-width: min(100%, 34rem);
		border: 2.5px solid var(--inkoust);
		border-radius: 12px;
		box-shadow: 2px 3px 0 rgba(43, 42, 38, 0.14);
	}
	.youtube-obal {
		max-width: min(100%, 34rem);
		margin: 0 auto;
		aspect-ratio: 16 / 9;
		border: 2.5px solid var(--inkoust);
		border-radius: 12px;
		box-shadow: 2px 3px 0 rgba(43, 42, 38, 0.14);
		overflow: hidden;
	}
	.youtube-obal iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
	.audio {
		margin: 1.5rem 0;
		text-align: center;
	}
	.audio audio {
		width: min(100%, 34rem);
	}
	.infografika figcaption,
	.audio figcaption,
	.video figcaption {
		color: var(--ztlumena);
		font-size: 1rem;
		margin-top: 0.4rem;
	}
</style>
