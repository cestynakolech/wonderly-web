	.sb-radek { margin: 0.5rem 0; display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
	.sb-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.9rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; }
