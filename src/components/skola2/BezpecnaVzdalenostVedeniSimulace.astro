---
// Bezpečnost u elektrického vedení (F9, elektricka-energie-a-bezpecnost/
// ucinky-proudu-bezpecnost).
//
// MĚŘÍTKO PRAVDY = živý výklad F9 v src/data/temata.ts (slug
// ucinky-proudu-bezpecnost) + PDF učitele "16 Účinky proudu na lidský
// organismus…" (9. roč.). Simulace netvrdí nic, co ve výkladu není.
//
// Opora ve výkladu (oddíly):
//   "Bezpečné napětí": ve vlhkých prostorách (koupelna, bazén, sklep) platí
//     přísnější mez — stejnosměrné nejvýš 25 V, střídavé jen 12 V; 230 V ze
//     zásuvky je nebezpečné vždycky a všude.
//   "Vedení vysokého napětí": nedotýkáme se nosných stožárů ani drátů spadlých
//     na zem; u vysokého napětí proud přeskočí vzduchem (oblouk), nebezpečí
//     hrozí i bez dotyku → k vedení se nikdy nepřibližuj; spadlý drát bývá pod
//     napětím, volej 112, odcházej drobnými krůčky.
//   "První pomoc": vypni proud; pokud to nejde, odděl izolující tyčí ze suchého
//     dřeva/plastu; nikdy holou rukou; u vysokého napětí se vůbec nepřibližuj;
//     volej 155.
//   "Pro zvídavé": I = 230 : 2 000 = 0,115 A = 115 mA, nad 80 mA = zástava srdce.
//
// OPRAVA 1. 10. 2026 (kontroly kontrola-stash-f9.md B1–B4 a
// kontrola-codex-navrhy.md Z1, Z2, S3, S4, D8): pryč slib napětí "bez rizika",
// termín bez opory v PDF, věta o vlhku v rozporu s výkladem, rada oddělit
// zraněného tyčí u vysokého napětí, zmínky o PDF v žákovském textu; plakety
// nezakrývají stožár, postava "bez dotyku" nestojí na drátu, jiskra u dotyku
// je v místě dotyku (ne z horního vedení).
//
// OPRAVA 2 1. 10. 2026 (kontrola2-simulace-f9.md N1–N3): spadlý drát je
// zjevně PŘETRŽENÝ levý vodič vedení — u ramene stožáru z něj zbyl jen
// visící pahýl s roztřepeným koncem, druhá část visí od okraje scény (od
// dalšího stožáru) dolů na zem. Celý zůstal jen pravý vodič a ten vede NAD
// přetrženým, takže se vodiče nekříží. U 230 V je záblesk v obou místech
// dotyku ruka–vývod zdroje (ne klikatice do vzduchu).
//
// Dva nezávislé posuvníky (celočíselné indexy): situace u vedení (0–3) a
// napětí zdroje (0–2). Statická scéna beze smyčky requestAnimationFrame.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Bezpečnost u elektrického vedení ⚡🕹️</span></h2>
	<p>
		U elektrického vedení nerozhoduje jen <strong>dotyk</strong> — u vysokého
		napětí umí proud <strong>přeskočit vzduchem obloukem</strong>, i když se
		vedení vůbec nedotkneš. Vlevo vyzkoušej, které chování u vedení je správné.
		Vpravo porovnej, které napětí nepřekračuje mez bezpečného napětí a které
		je nebezpečné vždycky.
	</p>

	<svg id="bvv-svg" viewBox="0 0 640 320" role="img" aria-label="Vlevo stožár vedení vysokého napětí, spadlý drát na zemi a postava v různých situacích, vpravo zdroj napětí a ruce, které se ho dotýkají">
		<rect x="0" y="0" width="640" height="320" fill="#eef6ff" />
		<rect x="0" y="255" width="640" height="65" fill="#d8f5a2" />
		<line x1="0" y1="255" x2="640" y2="255" stroke="#2b2a26" stroke-width="3" />
		<line x1="382" y1="10" x2="382" y2="310" stroke="#adb5bd" stroke-width="2" stroke-dasharray="4,4" />
		<g id="bvv-stozar"></g>
		<g id="bvv-oblouk"></g>
		<g id="bvv-postava"></g>
		<g id="bvv-popisky"></g>
		<g id="bvv-zdroj"></g>
	</svg>

	<label class="sim-posuvnik">
		Situace u vedení: <output id="bvv-out-situace"></output>
		<input type="range" id="bvv-situace" min="0" max="3" step="1" value="0" />
	</label>
	<label class="sim-posuvnik">
		Napětí zdroje, kterého se dotýkám rukou: <output id="bvv-out-napeti"></output>
		<input type="range" id="bvv-napeti" min="0" max="2" step="1" value="0" />
	</label>

	<p class="bvv-stav" id="bvv-stav"></p>
	<p class="bvv-stav" id="bvv-stav-napeti"></p>

	<p class="bvv-poznamka">
		Úraz proudem: u <strong>vedení vysokého napětí</strong> nebo spadlého drátu
		se ke zraněnému <strong>vůbec nepřibližuj</strong> — volej 112 a kvůli
		zraněnému i 155. Jinak nejdřív vypni proud (vypínač, jistič, pojistky);
		pokud to nejde a zraněný se stále dotýká vodiče, odděl ho izolující tyčí
		ze suchého dřeva nebo plastu. Nikdy se ho ani jeho oděvu
		<strong>nedotýkej holou rukou</strong>, dokud není mimo dosah proudu.
		Volej 155.
	</p>
</section>

<script>
	function platnyIndex(hodnota, max, vychozi) {
		const n = Math.round(Number(hodnota));
		return Number.isInteger(n) && n >= 0 && n <= max ? n : vychozi;
	}

	const OKRAJ = 6;
	// levý panel (vedení) končí dělicí čarou x = 382, pravý (zdroj) začíná za ní
	const LEVY = [OKRAJ, 382 - OKRAJ];
	const PRAVY = [382 + OKRAJ, 640 - OKRAJ];

	const STOZAR_X = 200;
	const RAMENO_L = STOZAR_X - 40, RAMENO_P = STOZAR_X + 40, RAMENO_Y = 90;
	// levý vodič je přetržený: u ramene zbyl pahýl visící šikmo dolů
	// (roztřepený konec PAHYL_KONEC), zbytek visí od pravého okraje panelu
	// (od dalšího stožáru, bod DRAT_OKRAJ) dolů a na zemi leží VPRAVO od
	// stožáru od x = 246 do x = 318 (roztřepený konec u x = 246, mimo patu vzpěry x = 226)
	const PAHYL_KONEC = [250, 146];
	const DRAT_OKRAJ = [378, 122];
	const DRAT_OD = STOZAR_X + 46, DRAT_DO = STOZAR_X + 118;
	// prohýbá se do trávy, aby nesplýval s čarou země
	const DRAT_D = `M${DRAT_OKRAJ[0]},${DRAT_OKRAJ[1]} Q${DRAT_DO + 14},150 ${DRAT_DO},256 Q${(DRAT_OD + DRAT_DO) / 2},278 ${DRAT_OD},257`;
	// vzpěra stožáru vede z (STOZAR_X − 26, 255) do (STOZAR_X, RAMENO_Y);
	// ve výšce ruky (y = 234) je na x ≈ STOZAR_X − 23 → postava o 8 vlevo od ní
	const VZPERA_X_RUKA = Math.round(STOZAR_X - 26 + 26 * (255 - 234) / (255 - 90));
	const PLAKETA_POSTAVY_Y = 292; // pod čarou země — nic nezakrývá

	// 4 situace u vedení — texty mají oporu ve výkladu F9 (oddíl
	// „Vedení vysokého napětí“), žádné metry.
	const SITUACE = [
		{ nazev: 'daleko od vedení', bezpecno: true, x: 40, dotyk: null,
			text: 'Postava stojí daleko od vedení, mimo ochranné pásmo — tak je to správně.' },
		{ nazev: 'blízko vedení, bez dotyku', bezpecno: false, x: 140, dotyk: null,
			text: 'Nebezpečno — u vysokého napětí umí proud přeskočit vzduchem jako jiskra, které se říká oblouk. Nebezpečí hrozí, i když se stožáru ani drátu vůbec nedotkneš. K vedení se nikdy nepřibližuj.' },
		{ nazev: 'dotýká se stožáru', bezpecno: false, x: VZPERA_X_RUKA - 8, dotyk: 'stozar',
			text: 'Nebezpečno — nosných stožárů elektrického vedení se nedotýkáme a nikdy na ně nelezeme.' },
		{ nazev: 'stojí na spadlém drátu', bezpecno: false, x: Math.round((DRAT_OD + DRAT_DO) / 2), dotyk: 'drat',
			text: 'Nebezpečno — spadlý drát na zemi bývá pořád pod napětím, i když se nehýbe a nejiskří. Nikdy se k němu nepřibližuj, volej 112 a od místa odcházej drobnými krůčky.' },
	];

	// Výklad F9, oddíl „Bezpečné napětí“: přísnější mez pro vlhké prostory
	// je stejnosměrné nejvýš 25 V, střídavé jen 12 V; 230 V nebezpečné vždy.
	const NAPETI = [
		{ popis: '12 V střídavé', bezpecne: true,
			text: '12 V střídavé — nepřekračuje mez bezpečného napětí, a to ani tu přísnější pro vlhké prostory, jako je koupelna (střídavé nejvýš 12 V).' },
		{ popis: '25 V stejnosměrné', bezpecne: true,
			text: '25 V stejnosměrné — nepřekračuje mez bezpečného napětí, a to ani tu přísnější pro vlhké prostory, jako je koupelna (stejnosměrné nejvýš 25 V).' },
		{ popis: '230 V ze zásuvky', bezpecne: false,
			text: '230 V ze zásuvky je nebezpečné vždycky a všude: I = U : R = 230 : 2 000 = 0,115 A, tedy 115 mA — hluboko nad 80 mA, v pásmu zástavy srdce. Holou rukou se ho nikdy nedotýkej.' },
	];

	// plaketa sevřená do zadaného panelu [min, max] — nepřeteče přes dělicí čáru
	function plaketa(textX, textY, text, barva, panel) {
		const sirka = String(text).length * 7 + 8;
		const rectX = Math.max(panel[0], Math.min(panel[1] - sirka, textX - sirka / 2));
		const rectY = Math.max(OKRAJ, Math.min(320 - OKRAJ - 18, textY - 14));
		return `<rect x="${rectX.toFixed(1)}" y="${rectY.toFixed(1)}" width="${sirka}" height="18" rx="4" fill="#ffffff" stroke="${barva}" stroke-width="1.5" />`
			+ `<text x="${(rectX + sirka / 2).toFixed(1)}" y="${(rectY + 14).toFixed(1)}" text-anchor="middle" font-size="11" font-weight="bold" fill="${barva}">${text}</text>`;
	}

	function stozarHtml() {
		const x = STOZAR_X;
		let s = '';
		s += `<line x1="${x}" y1="255" x2="${x}" y2="60" stroke="#495057" stroke-width="6" />`;
		s += `<line x1="${RAMENO_L}" y1="${RAMENO_Y}" x2="${RAMENO_P}" y2="${RAMENO_Y}" stroke="#495057" stroke-width="5" />`;
		s += `<line x1="${x - 26}" y1="255" x2="${x}" y2="${RAMENO_Y}" stroke="#868e96" stroke-width="3" />`;
		s += `<line x1="${x + 26}" y1="255" x2="${x}" y2="${RAMENO_Y}" stroke="#868e96" stroke-width="3" />`;
		// celý pravý vodič: z pravého ramene k okraji panelu, celou délkou NAD
		// přetrženým levým vodičem (nekříží se s ním)
		s += `<path id="bvv-vodic" d="M${RAMENO_P},${RAMENO_Y} Q${x + 110},110 378,100" fill="none" stroke="#2b2a26" stroke-width="2" />`;
		// pahýl přetrženého levého vodiče visí z levého ramene
		s += `<path id="bvv-pahyl" d="M${RAMENO_L},${RAMENO_Y} Q${x + 20},116 ${PAHYL_KONEC[0]},${PAHYL_KONEC[1]}" fill="none" stroke="#2b2a26" stroke-width="2" />`;
		s += strapek(PAHYL_KONEC[0], PAHYL_KONEC[1], 0.9);
		return s;
	}

	// roztřepený konec přetrženého drátu: 3 krátká vlákna rozevřená kolem směru u
	function strapek(x, y, u) {
		let s = '';
		for (const du of [-0.6, 0, 0.6]) {
			s += `<line x1="${x}" y1="${y}" x2="${(x + 7 * Math.cos(u + du)).toFixed(1)}" y2="${(y + 7 * Math.sin(u + du)).toFixed(1)}" stroke="#2b2a26" stroke-width="1.5" stroke-linecap="round" />`;
		}
		return s;
	}

	function spadlyDratHtml() {
		return `<path id="bvv-drat" d="${DRAT_D}" fill="none" stroke="#2b2a26" stroke-width="3" />`
			+ strapek(DRAT_OD, 257, Math.PI);
	}

	function postavaHtml(x, barva) {
		let s = '';
		s += `<circle cx="${x}" cy="228" r="9" fill="${barva}" stroke="#2b2a26" stroke-width="2.5" />`;
		s += `<line x1="${x}" y1="237" x2="${x}" y2="255" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${x}" y1="241" x2="${x - 9}" y2="255" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${x}" y1="241" x2="${x + 9}" y2="255" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${x}" y1="243" x2="${x - 8}" y2="234" stroke="#2b2a26" stroke-width="3" />`;
		s += `<line x1="${x}" y1="243" x2="${x + 8}" y2="234" stroke="#2b2a26" stroke-width="3" />`;
		return s;
	}

	// klikatá čára (jiskra/oblouk) z bodu 1 do bodu 2, výchylky kolmo ke směru
	function obloukPath(x1, y1, x2, y2) {
		const dx = x2 - x1, dy = y2 - y1;
		const delka = Math.hypot(dx, dy) || 1;
		const nx = -dy / delka, ny = dx / delka;
		const kroky = 6;
		let d = `M${x1.toFixed(1)},${y1.toFixed(1)}`;
		for (let i = 1; i < kroky; i++) {
			const t = i / kroky;
			const v = i % 2 === 0 ? 9 : -9;
			d += ` L${(x1 + dx * t + nx * v).toFixed(1)},${(y1 + dy * t + ny * v).toFixed(1)}`;
		}
		d += ` L${x2.toFixed(1)},${y2.toFixed(1)}`;
		return d;
	}

	function jiskra(x1, y1, x2, y2) {
		return `<path d="${obloukPath(x1, y1, x2, y2)}" fill="none" stroke="#f59f00" stroke-width="3" stroke-linecap="round" />`;
	}

	// záblesk (paprsky) přímo v bodě dotyku
	function zablesk(x, y) {
		let s = '';
		for (let i = 0; i < 8; i++) {
			const u = (i * Math.PI) / 4;
			s += `<line x1="${(x + 4 * Math.cos(u)).toFixed(1)}" y1="${(y + 4 * Math.sin(u)).toFixed(1)}" x2="${(x + 12 * Math.cos(u)).toFixed(1)}" y2="${(y + 12 * Math.sin(u)).toFixed(1)}" stroke="#f59f00" stroke-width="3" stroke-linecap="round" />`;
		}
		return s;
	}

	// co se kreslí oranžově podle situace: oblouk vzduchem z vedení (bez
	// dotyku), záblesk v místě dotyku stožáru, zvýrazněný drát pod nohama
	function nebezpeciHtml(situace) {
		if (situace.bezpecno) return '';
		if (situace.dotyk === 'stozar') {
			return zablesk(VZPERA_X_RUKA, 234);
		}
		if (situace.dotyk === 'drat') {
			return `<path d="${DRAT_D}" fill="none" stroke="#f59f00" stroke-width="6" opacity="0.85" />`
				+ zablesk(situace.x + 9, 256);
		}
		// blízko bez dotyku: oblouk z konce ramene vzduchem k hlavě
		return jiskra(RAMENO_L, RAMENO_Y + 2, situace.x, 219);
	}

	// pravý panel: zdroj napětí + ruce, které se dotýkají obou vývodů
	function zdrojHtml(napeti) {
		const cx = 511;
		const barva = napeti.bezpecne ? '#2f9e44' : '#e03131';
		let s = '';
		s += `<rect x="${cx - 40}" y="150" width="80" height="45" rx="6" fill="#495057" />`;
		s += `<line x1="${cx - 40}" y1="172" x2="${cx - 60}" y2="172" stroke="#2b2a26" stroke-width="4" />`;
		s += `<line x1="${cx + 40}" y1="172" x2="${cx + 60}" y2="172" stroke="#2b2a26" stroke-width="4" />`;
		s += `<circle cx="${cx - 68}" cy="172" r="10" fill="#ffd8a8" stroke="#2b2a26" stroke-width="2" />`;
		s += `<circle cx="${cx + 68}" cy="172" r="10" fill="#ffd8a8" stroke="#2b2a26" stroke-width="2" />`;
		s += plaketa(cx, 130, napeti.popis, barva, PRAVY);
		s += plaketa(cx, 225, napeti.bezpecne ? 'bezpečné napětí' : 'NEBEZPEČNÉ', barva, PRAVY);
		// 230 V: záblesk přímo v obou místech dotyku ruka–vývod zdroje
		if (!napeti.bezpecne) s += zablesk(cx - 60, 172) + zablesk(cx + 60, 172);
		return s;
	}

	const sliderSituace = document.getElementById('bvv-situace');
	const sliderNapeti = document.getElementById('bvv-napeti');
	const outSituace = document.getElementById('bvv-out-situace');
	const outNapeti = document.getElementById('bvv-out-napeti');

	document.getElementById('bvv-stozar').innerHTML = stozarHtml() + spadlyDratHtml();
	document.getElementById('bvv-popisky').innerHTML = plaketa(STOZAR_X, 40, 'vedení vysokého napětí', '#2b2a26', LEVY);

	function prekresli() {
		const iS = platnyIndex(sliderSituace.value, SITUACE.length - 1, 0);
		const iN = platnyIndex(sliderNapeti.value, NAPETI.length - 1, 0);
		const situace = SITUACE[iS];
		const napeti = NAPETI[iN];

		outSituace.textContent = situace.nazev;
		outNapeti.textContent = napeti.popis;

		const barva = situace.bezpecno ? '#4dabf7' : '#ff8787';
		document.getElementById('bvv-postava').innerHTML = postavaHtml(situace.x, barva)
			+ plaketa(situace.x, PLAKETA_POSTAVY_Y, situace.bezpecno ? 'správně' : 'nebezpečno', situace.bezpecno ? '#2f9e44' : '#e03131', LEVY);
		document.getElementById('bvv-oblouk').innerHTML = nebezpeciHtml(situace);
		document.getElementById('bvv-zdroj').innerHTML = zdrojHtml(napeti);

		document.getElementById('bvv-stav').textContent = situace.text;
		document.getElementById('bvv-stav-napeti').textContent = napeti.text;
	}

	sliderSituace.addEventListener('input', prekresli);
	sliderNapeti.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#bvv-svg { width: 100%; max-width: 640px; border: 3px solid #2b2a26; border-radius: 12px; background: #eef6ff; margin-bottom: 0.6rem; display: block; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 640px; display: block; margin-top: 0.3rem; }
	.bvv-stav { font-size: 1.02rem; font-weight: 700; min-height: 1.4rem; }
	.bvv-poznamka { font-size: 0.9rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; margin-top: 0.6rem; }
</style>
