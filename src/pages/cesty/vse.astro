---
import CestyLayout from '../../layouts/CestyLayout.astro';
import { roky } from '../../data/cesty/roky';
import { MAPA_SIRKA, MAPA_VYSKA, spocitejVyrez } from '../../data/cesty/mapa';

const vsechnaMesta = roky.flatMap((r) => r.mesta.map((m) => ({ ...m, rok: r.rok })));
const vyrez = spocitejVyrez(vsechnaMesta);
const pinR = vyrez.sirka / 45;
const pismo = vyrez.sirka / 30;
const podleRoku = [...roky].sort((a, b) => b.rok - a.rok);
---

<CestyLayout titulek="Všechna místa – Cesty na kolech">
	<p><a href="/cesty">&larr; Zpět na roky</a></p>
	<h1>Všechna místa</h1>
	<p>Všechna navštívená města ze všech roků na jedné mapě.</p>
	<svg
		class="mapa"
		viewBox={`${vyrez.x} ${vyrez.y} ${vyrez.sirka} ${vyrez.vyska}`}
		role="img"
		aria-label="Mapa všech navštívených měst"
	>
		<image href="/cesty/mapa-evropa.svg" width={MAPA_SIRKA} height={MAPA_VYSKA} />
		{
			vsechnaMesta.map((m, i) => (
				<a href={`/cesty/${m.rok}#${m.slug}`}>
					<circle class="pin" cx={m.x} cy={m.y} r={pinR} stroke-width={pinR / 3.5} />
					<text
						class="pin-popisek"
						x={m.x}
						y={i % 2 === 0 ? m.y - pinR * 2 : m.y + pinR * 2 + pismo * 0.8}
						text-anchor="middle"
						font-size={pismo}
						stroke-width={pismo / 5}
					>
						{m.nazev}
					</text>
				</a>
			))
		}
	</svg>
	{
		podleRoku.map((r) => (
			<section>
				<h2>
					<a href={`/cesty/${r.rok}`}>{r.rok}</a> – {r.zeme}
				</h2>
				<ul>
					{r.mesta.map((m) => (
						<li>
							<a href={`/cesty/${r.rok}#${m.slug}`}>{m.nazev}</a> ({m.datum})
						</li>
					))}
				</ul>
			</section>
		))
	}
</CestyLayout>
