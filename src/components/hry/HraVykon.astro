---
/**
 * Hra pro skupinu „Kdo má větší výkon?“ — Výkon (fyzika 8).
 * Každá opora je doslovný úryvek výkladu podtématu vykon a každá karta
 * nese také stránku PDF učebnice. Scény jsou vlastní inline SVG se SMIL.
 */
type Odpoved = 'A' | 'B';
type Moznost = { popis: string; doplnek: string };
type Karta = {
	id: string;
	scena: string;
	otazka: string;
	spravne: Odpoved;
	proc: string;
	opora: string;
	zdroj: string;
};
type Kolo = {
	cislo: number; nazev: string; pravidlo: string; opora: string;
	moznosti: Record<Odpoved, Moznost>; body: number; karty: Karta[];
};

const KOLA: Kolo[] = [
	{
		cislo: 1,
		nazev: 'Kdo má větší výkon?',
		pravidlo: 'Při stejné práci má větší výkon ten, kdo ji vykoná za kratší čas. Za stejný čas má větší výkon ten, kdo vykoná větší práci.',
		opora: 'Kdo zvládne stejnou práci za kratší čas, má větší výkon',
		moznosti: {
			A: { popis: 'PRVNÍ', doplnek: 'první člověk nebo stroj' },
			B: { popis: 'DRUHÝ', doplnek: 'druhý člověk nebo stroj' },
		},
		body: 1,
		karty: [
			{ id: 'k1-srovnani-1', scena: 'srovnani-1', otazka: 'Dělník a bagr vykonají stejnou práci. Bagr ji dokončí za kratší čas. Kdo z dvojice má větší výkon?', spravne: 'B',
				proc: 'Bagr vykoná stejnou práci za kratší čas, a proto má větší výkon.',
				opora: 'Bagr ji ale udělá za kratší čas.', zdroj: 's. 1' },
			{ id: 'k1-srovnani-2', scena: 'srovnani-2', otazka: 'Dva stroje vykonají stejnou práci. První ji dokončí za delší čas. Který má větší výkon?', spravne: 'B',
				proc: 'Při stejné práci znamená delší čas menší výkon, takže větší výkon má druhý stroj.',
				opora: 'Kdo zvládne stejnou práci za kratší čas, má větší výkon', zdroj: 's. 2' },
			{ id: 'k1-srovnani-3', scena: 'srovnani-3', otazka: 'Dva stroje pracují stejně dlouho. První vykoná větší práci. Který má větší výkon?', spravne: 'A',
				proc: 'Za stejný čas znamená větší vykonaná práce větší výkon.',
				opora: 'Větší práce za určitý čas znamená větší výkon', zdroj: 's. 1' },
			{ id: 'k1-srovnani-4', scena: 'srovnani-4', otazka: 'Dva lidé vykonají stejnou práci. Druhý ji dokončí za delší čas. Který má větší výkon?', spravne: 'A',
				proc: 'Druhý člověk potřebuje na stejnou práci delší čas, takže větší výkon má první.',
				opora: 'Kdo zvládne stejnou práci za kratší čas, má větší výkon', zdroj: 's. 2' },
			{ id: 'k1-srovnani-5', scena: 'srovnani-5', otazka: 'Dva stroje pracují stejně dlouho. První vykoná menší práci než druhý. Který má větší výkon?', spravne: 'B',
				proc: 'Za stejný čas má menší výkon stroj s menší prací, takže větší výkon má druhý.',
				opora: 'menší práce za stejný čas menší výkon.', zdroj: 's. 1' },
		],
	},
	{
		cislo: 2,
		nazev: 'Násobit, nebo dělit?',
		pravidlo: 'Vyber početní operaci, kterou použiješ ve vztazích pro výkon, práci a čas.',
		opora: 'Vykonanou práci W vydělíme časem t.',
		moznosti: {
			A: { popis: 'NÁSOBIT', doplnek: 'použij násobení' },
			B: { popis: 'DĚLIT', doplnek: 'použij dělení' },
		},
		body: 1,
		karty: [
			{ id: 'k2-vykon', scena: 'vzorec-vykon', otazka: 'Znáš práci W a čas t. Jakou operací vypočítáš výkon P?', spravne: 'B',
				proc: 'Výkon vypočítáme jako práci dělenou časem: P = W : t.',
				opora: 'Vykonanou práci W vydělíme časem t.', zdroj: 's. 2' },
			{ id: 'k2-prace', scena: 'vzorec-prace', otazka: 'Znáš výkon P a čas t. Jakou operací vypočítáš práci W?', spravne: 'A',
				proc: 'Práci vypočítáme jako výkon krát čas: W = P · t.',
				opora: 'Odtud také W = P · t', zdroj: 's. 4' },
			{ id: 'k2-cas', scena: 'vzorec-cas', otazka: 'Znáš práci W a výkon P. Jakou operací vypočítáš čas t?', spravne: 'B',
				proc: 'Čas vypočítáme jako práci dělenou výkonem: t = W : P.',
				opora: 'a t = W : P', zdroj: 's. 4' },
			{ id: 'k2-sila-rychlost', scena: 'vzorec-sila-rychlost', otazka: 'Znáš sílu F a rychlost v. Jakou operací vypočítáš výkon P?', spravne: 'A',
				proc: 'Výkon při pohybu vypočítáme jako sílu krát rychlost: P = F · v.',
				opora: 'Platí P = F · v', zdroj: 's. 4' },
			{ id: 'k2-rychlost', scena: 'vzorec-rychlost', otazka: 'Znáš výkon P a sílu F. Jakou operací vypočítáš rychlost v?', spravne: 'B',
				proc: 'Rychlost vypočítáme jako výkon dělený silou: v = P : F.',
				opora: 'tedy i v = P : F a F = P : v', zdroj: 's. 4' },
		],
	},
	{
		cislo: 3,
		nazev: 'FINÁLE: Platí, nebo neplatí?',
		pravidlo: 'Rozhodni, zda uvedený výrok o výkonu a jeho jednotkách platí.',
		opora: 'Jednotka je watt (W).',
		moznosti: {
			A: { popis: 'PLATÍ', doplnek: 'výrok je správný' },
			B: { popis: 'NEPLATÍ', doplnek: 'výrok je chybný' },
		},
		body: 2,
		karty: [
			{ id: 'k3-kilowatt', scena: 'prevod-kilowatt', otazka: 'Výrok: 1 kW se rovná 1 000 000 W.', spravne: 'B',
				proc: 'Neplatí: 1 kW = 1 000 W.',
				opora: '1 kW (kilowatt) = 1 000 W', zdroj: 's. 2' },
			{ id: 'k3-jeden-watt', scena: 'jeden-watt', otazka: 'Výrok: Když těleso vykoná práci 1 J za 1 s, má výkon 1 W.', spravne: 'A',
				proc: 'Platí: výkon 1 W znamená práci 1 J vykonanou za 1 s.',
				opora: 'Výkon 1 W znamená, že těleso za 1 s vykoná práci 1 J.', zdroj: 's. 3' },
			{ id: 'k3-dva-kilowatty', scena: 'dva-kilowatty', otazka: 'Výrok: Výkon 2 kW znamená práci 2 kJ vykonanou za 1 s.', spravne: 'A',
				proc: 'Platí: při výkonu 2 kW vykoná těleso za 1 s práci 2 kJ.',
				opora: 'Výkon 2 kW znamená práci 2 kJ za 1 s.', zdroj: 's. 3' },
			{ id: 'k3-kilowatthodina', scena: 'kilowatthodina', otazka: 'Výrok: 1 kWh je výkon stroje o výkonu 1 kW za 1 hodinu.', spravne: 'B',
				proc: 'Neplatí: 1 kWh je práce stroje o výkonu 1 kW za 1 hodinu, není to výkon.',
				opora: '1 kWh je práce stroje o výkonu 1 kW za 1 hodinu', zdroj: 's. 6' },
			{ id: 'k3-megawatt', scena: 'prevod-megawatt', otazka: 'Výrok: 1 MW se rovná 1 000 000 W.', spravne: 'A',
				proc: 'Platí: 1 MW = 1 000 000 W.',
				opora: '1 MW (megawatt) = 1 000 000 W', zdroj: 's. 2' },
		],
	},
];

const karty = KOLA.flatMap((k) => k.karty);
const NAPIS: Record<string, string> = {
	'k1-srovnani-1': 'větší výkon: BAGR',
	'k1-srovnani-2': 'větší výkon: DRUHÝ',
	'k1-srovnani-3': 'větší výkon: PRVNÍ',
	'k1-srovnani-4': 'větší výkon: PRVNÍ',
	'k1-srovnani-5': 'větší výkon: DRUHÝ',
	'k2-vykon': 'DĚLIT: P = W : t',
	'k2-prace': 'NÁSOBIT: W = P · t',
	'k2-cas': 'DĚLIT: t = W : P',
	'k2-sila-rychlost': 'NÁSOBIT: P = F · v',
	'k2-rychlost': 'DĚLIT: v = P : F',
	'k3-jeden-watt': 'PLATÍ',
	'k3-dva-kilowatty': 'PLATÍ',
	'k3-kilowatt': 'NEPLATÍ · 1 kW = 1 000 W',
	'k3-megawatt': 'PLATÍ',
	'k3-kilowatthodina': 'NEPLATÍ · je to práce',
};

const pozadi = (barva = '#e7f5ff') => `<rect width="640" height="400" fill="${barva}"/>`;
const podlaha = '<rect y="318" width="640" height="82" fill="#dee2e6"/><line x1="0" y1="318" x2="640" y2="318" stroke="#495057" stroke-width="4"/>';
const stroj = (x: number, barva: string, _znak: string, trvani: string) => `<g data-objekt="stroj">
<rect data-cast="podvozek" x="${x}" y="268" width="150" height="30" rx="10" fill="#343a40" stroke="#212529" stroke-width="4"/>
<rect data-cast="motor" x="${x + 12}" y="224" width="82" height="48" rx="8" fill="${barva}" stroke="#212529" stroke-width="4"/>
<path data-cast="kabina" d="M${x + 94} 268 V218 H${x + 126} L${x + 144} 268 Z" fill="#d0ebff" stroke="#212529" stroke-width="4"/>
<path data-cast="vyfuk" d="M${x + 28} 224 V205 H${x + 42}" fill="none" stroke="#212529" stroke-width="7" stroke-linecap="round"/>
<circle cx="${x + 38}" cy="300" r="16" fill="#343a40" stroke="#212529" stroke-width="3"/><circle cx="${x + 112}" cy="300" r="16" fill="#343a40" stroke="#212529" stroke-width="3"/>
<animateTransform attributeName="transform" type="translate" values="0 0;0 -8;0 0" dur="${trvani}s" repeatCount="indefinite"/></g>`;
const postava = (x: number, barva: string, trvani: string, maKrompac = false) => `<g data-objekt="clovek">
<circle cx="${x + 75}" cy="224" r="25" fill="#ffd8a8" stroke="#212529" stroke-width="4"/>
<path d="M${x + 75} 257 V292 M${x + 75} 265 L${x + 40} 282 M${x + 75} 265 L${x + 110} 282 M${x + 75} 292 L${x + 48} 310 M${x + 75} 292 L${x + 102} 310" fill="none" stroke="${barva}" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"/>
${maKrompac ? `<path data-cast="krompac" d="M${x + 110} 282 L${x + 130} 230 M${x + 115} 226 Q${x + 130} 230 ${x + 143} 240" fill="none" stroke="#495057" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>` : ''}
<animateTransform attributeName="transform" type="translate" values="0 0;0 -5;0 0" dur="${trvani}s" repeatCount="indefinite"/></g>`;
const bagr = (x: number, barva: string, trvani: string) => `<g data-objekt="bagr">
<rect data-cast="pas" x="${x + 2}" y="291" width="136" height="25" rx="12" fill="#343a40" stroke="#212529" stroke-width="4"/>
<circle cx="${x + 31}" cy="303" r="9" fill="#adb5bd"/><circle cx="${x + 68}" cy="303" r="9" fill="#adb5bd"/><circle cx="${x + 105}" cy="303" r="9" fill="#adb5bd"/>
<rect x="${x + 28}" y="238" width="88" height="55" rx="8" fill="${barva}" stroke="#212529" stroke-width="4"/>
<path d="M${x + 68} 238 V211 H${x + 111} L${x + 124} 238" fill="#d0ebff" stroke="#212529" stroke-width="4"/>
<path data-cast="rameno" d="M${x + 53} 252 L${x - 11} 211 L${x - 48} 274" fill="none" stroke="${barva}" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
<path data-cast="lzice" d="M${x - 59} 266 Q${x - 28} 272 ${x - 17} 295 Q${x - 58} 304 ${x - 70} 283 Z" fill="${barva}" stroke="#212529" stroke-width="4"/>
<animateTransform attributeName="transform" type="translate" values="0 0;0 -7;0 0" dur="${trvani}s" repeatCount="indefinite"/></g>`;
const rucicky: Record<string, string> = {
	'kratší čas': 'M38 88 L49 76 M38 88 L51 94',
	'stejný čas': 'M38 88 V74 M38 88 L49 94',
	'delší čas': 'M38 88 L29 101 M38 88 L49 94',
};
const trvaniPro = (cas: string) => cas === 'kratší čas' ? '1.8' : cas === 'delší čas' ? '3.0' : '2.4';
const posunRucicky = (x: number, cas: string) => rucicky[cas].replace(/([ML])(-?\d+)/g, (_, povel, souradnice) => `${povel}${Number(souradnice) + x}`);
const ukazatele = (x: number, cas: string, prace: number) => `<g>
<rect x="${x}" y="52" width="180" height="120" rx="16" fill="#fff" stroke="#495057" stroke-width="3"/>
<circle cx="${x + 38}" cy="88" r="21" fill="#fff" stroke="#495057" stroke-width="3"/>
<path data-cas="${cas}" d="${posunRucicky(x, cas)}" stroke="#495057" stroke-width="3" stroke-linecap="round"/>
<text x="${x + 68}" y="95" font-size="20" font-weight="700">${cas}</text>
<text x="${x + 14}" y="145" font-size="18" font-weight="700">práce</text>
${Array.from({ length: prace }, (_, i) => `<rect x="${x + 78 + i * 25}" y="124" width="20" height="20" rx="3" fill="#ffd43b" stroke="#7c5c00" stroke-width="2"/>`).join('')}
</g>`;
const objekt = (x: number, barva: string, znak: string, lide: boolean, jeBagr: boolean, trvani: string) =>
	lide ? postava(x, barva, trvani, /dělník/i.test(znak)) : jeBagr ? bagr(x, barva, trvani) : stroj(x, barva, znak, trvani);
const srovnani = (leva: string, prava: string, znakA: string, znakB: string, casA: string, casB: string, praceA: number, praceB: number, lideA: boolean, lideB: boolean, bagrA: boolean, bagrB: boolean, barvaA = '#f08c00', barvaB = '#1971c2') =>
	`${pozadi()}${podlaha}${ukazatele(60, casA, praceA)}${ukazatele(400, casB, praceB)}${objekt(75, barvaA, znakA || leva, lideA, bagrA, trvaniPro(casA))}${objekt(415, barvaB, znakB || prava, lideB, bagrB, trvaniPro(casB))}
<text x="150" y="365" text-anchor="middle" font-size="24" font-weight="700">${leva}</text>
<text x="490" y="365" text-anchor="middle" font-size="24" font-weight="700">${prava}</text>`;
const velikostSymbolu = (text: string) => text.length > 4 ? 34 : 44;
const vzorec = (symboly: string[], barva: string) => `${pozadi('#fff9db')}
<path d="M100 205 H540" stroke="#495057" stroke-width="8" stroke-linecap="round" stroke-dasharray="18 12">
<animate attributeName="stroke-dashoffset" from="0" to="-60" dur="2s" repeatCount="indefinite"/></path>
${symboly.map((s, i) => `<g><circle cx="${150 + i * 170}" cy="205" r="58" fill="${i === symboly.length - 1 ? '#fff' : barva}" stroke="#212529" stroke-width="4"/>
<text x="${150 + i * 170}" y="220" text-anchor="middle" font-size="${velikostSymbolu(s)}" font-weight="800">${s}</text>
<animateTransform attributeName="transform" type="translate" values="0 0;0 -9;0 0" dur="${2 + i * 0.3}s" repeatCount="indefinite"/></g>`).join('')}`;
const velikostVyroku = (text: string) => text.length > 15 ? 24 : text.length > 12 ? 26 : 34;
const vyrok = (leva: string, prava: string, barva = '#6741d9') => `${pozadi('#f3f0ff')}
<rect x="48" y="128" width="215" height="145" rx="20" fill="#fff" stroke="#212529" stroke-width="4"/>
<rect x="377" y="128" width="215" height="145" rx="20" fill="#fff" stroke="#212529" stroke-width="4"/>
<text x="155" y="215" text-anchor="middle" font-size="${velikostVyroku(leva)}" font-weight="800">${leva}</text>
<text x="485" y="215" text-anchor="middle" font-size="${velikostVyroku(prava)}" font-weight="800">${prava}</text>
<path d="M278 200 H362" stroke="${barva}" stroke-width="9" stroke-linecap="round" stroke-dasharray="18 12">
<animate attributeName="stroke-dashoffset" from="0" to="-60" dur="1.8s" repeatCount="indefinite"/></path>
<circle cx="320" cy="200" r="13" fill="${barva}"><animate attributeName="r" values="10;17;10" dur="1.8s" repeatCount="indefinite"/></circle>`;

function scenaSvg(s: string): string {
	switch (s) {
		case 'srovnani-1': return srovnani('první: dělník', 'druhý: bagr', '', '', 'delší čas', 'kratší čas', 3, 3, true, false, false, true, '#9c5b20', '#fab005');
		case 'srovnani-2': return srovnani('první: stroj', 'druhý: stroj', '', '', 'delší čas', 'kratší čas', 3, 3, false, false, false, false, '#2f9e44', '#1971c2');
		case 'srovnani-3': return srovnani('první: stroj', 'druhý: stroj', '', '', 'stejný čas', 'stejný čas', 4, 2, false, false, false, false, '#c2410c', '#5f3dc4');
		case 'srovnani-4': return srovnani('první: člověk', 'druhý: člověk', '', '', 'kratší čas', 'delší čas', 3, 3, true, true, false, false, '#0b7285', '#e8590c');
		case 'srovnani-5': return srovnani('první: stroj', 'druhý: stroj', '', '', 'stejný čas', 'stejný čas', 2, 4, false, false, false, false, '#7048e8', '#2b8a3e');
		case 'vzorec-vykon': return vzorec(['W', 't', 'P ?'], '#74c0fc');
		case 'vzorec-prace': return vzorec(['P', 't', 'W ?'], '#ffd43b');
		case 'vzorec-cas': return vzorec(['W', 'P', 't ?'], '#ff922b');
		case 'vzorec-sila-rychlost': return vzorec(['F', 'v', 'P ?'], '#8ce99a');
		case 'vzorec-rychlost': return vzorec(['P', 'F', 'v ?'], '#b197fc');
		case 'jeden-watt': return vyrok('1 J za 1 s', '1 W ?');
		case 'dva-kilowatty': return vyrok('2 kJ za 1 s', '2 kW ?' , '#1971c2');
		case 'prevod-kilowatt': return vyrok('1 kW', '1 000 000 W ?', '#e03131');
		case 'prevod-megawatt': return vyrok('1 MW', '1 000 000 W ?', '#2b8a3e');
		case 'kilowatthodina': return vyrok('1 kW za 1 h', 'práce, či výkon?', '#c2410c');
		default: return '';
	}
}

const RAMECEK: Record<string, [number, number]> = {
	'prevod-kilowatt': [100, 440], 'prevod-megawatt': [100, 440], 'kilowatthodina': [100, 440],
};
const scenyHtml: Record<string, string> = {};
for (const c of karty) {
	const [rx, rw] = RAMECEK[c.scena] ?? [100, 440];
	scenyHtml[c.id] = `<svg viewBox="0 0 640 400" role="img" aria-label="${c.otazka}" xmlns="http://www.w3.org/2000/svg" font-family="sans-serif">
${scenaSvg(c.scena)}
<g data-odhal="1" opacity="0"><rect x="${rx}" y="2" width="${rw}" height="40" rx="12" fill="#fff" stroke="#2b8a3e" stroke-width="4"/>
<text x="${rx + rw / 2}" y="30" text-anchor="middle" font-size="22" font-weight="800" fill="#1b4d2a">${NAPIS[c.id]}</text></g></svg>`;
}
const maxBodu = KOLA.reduce((s, k) => s + k.karty.length * k.body, 0);
---

<div id="hra-vykon" data-kola={JSON.stringify(KOLA)}>
	<section id="nastaveni">
		<h1><span class="podtrh">⚡ Kdo má větší výkon?</span></h1>
		<p class="podnadpis">Hra pro třídu · Výkon · 8. ročník · asi 12 minut</p>
		<ol class="pravidla">
			<li><b>3 kola (5 + 5 + 5 karet):</b> větší výkon · vztahy · jednotky a význam.</li>
			<li>Na každé kartě je animovaná scéna a otázka. Týmy se poradí a po odpočtu <b>zvednou kartu A, nebo B</b>.</li>
			<li>Za správnou odpověď 1 bod, ve <b>FINÁLE 2 body</b>.</li>
		</ol>
		<p class="pozn">Karty A/B: <a href="/hry/karty" target="_blank">vytisknout</a> (C se nepoužije),
			nebo stačí papír s velkým A a B. Maximum je {maxBodu} bodů.</p>
		<div class="volby">
			<label>Počet týmů
				<select id="pocet-tymu">{[2, 3, 4, 5, 6].map((n) => <option value={n} selected={n === 4}>{n}</option>)}</select>
			</label>
			<label>Čas na kartu
				<select id="cas-karty"><option value="10">10 s</option><option value="15" selected>15 s</option><option value="20">20 s</option></select>
			</label>
		</div>
		<div id="jmena-tymu"></div>
		<button id="start" class="velke-tlacitko">Začít hru ▶</button>
	</section>

	<section id="uvod-kola" hidden>
		<p class="cislo-kola" id="uvod-cislo"></p>
		<h1 id="uvod-nazev"></h1>
		<p class="pravidlo" id="uvod-pravidlo"></p>
		<div class="moznosti uvod-moznosti">
			<div class="moznost moznost-A"><b>A</b><span><span class="m-popis" id="uvod-A"></span><small id="uvod-A2"></small></span></div>
			<div class="moznost moznost-B"><b>B</b><span><span class="m-popis" id="uvod-B"></span><small id="uvod-B2"></small></span></div>
		</div>
		<p class="za-body" id="uvod-body"></p>
		<button id="hrajeme" class="velke-tlacitko">Hrajeme ▶</button>
	</section>

	<section id="karta" hidden>
		<header class="lista">
			<span id="lista-kolo"></span><span id="lista-body" class="lista-body"></span>
			<span id="odpocet-cislo" class="odpocet-cislo"></span>
			<button id="cela-obrazovka" class="male-tlacitko" title="Celá obrazovka (na projektor)">⛶</button>
		</header>
		<div id="odpocet-pruh"><div id="odpocet-vypln"></div></div>
		<div class="plocha">
			<div class="leva">
				<div class="scena-obal">{karty.map((k) => <div class="scena skryta" data-karta={k.id} set:html={scenyHtml[k.id]} />)}</div>
				<div id="odhaleni" hidden><p id="proc" class="proc"></p><p class="pokyn">Klepni na týmy, které zvedly správnou kartu ↓</p></div>
			</div>
			<div class="prava">
				<h2 id="otazka"></h2>
				<div class="moznosti">
					<div class="moznost moznost-A" data-m="A"><b>A</b><span><span class="m-popis"></span><small></small></span></div>
					<div class="moznost moznost-B" data-m="B"><b>B</b><span><span class="m-popis"></span><small></small></span></div>
				</div>
				<div class="ovladani"><button id="odhalit" class="velke-tlacitko">Odhalit odpověď ✔</button><button id="dalsi" class="velke-tlacitko" hidden>Další karta ▶</button></div>
			</div>
		</div>
		<div id="tymy" class="tymy"></div>
	</section>

	<section id="vysledky" hidden>
		<h1><span class="podtrh">🎉 Konečné pořadí</span></h1><ol id="podium"></ol>
		<p class="shrnuti">Pamatuj: <b>Výkon říká, jak velká práce se vykoná za jednu sekundu.</b> Stejná práce za kratší čas znamená větší výkon.</p>
		<button id="znovu" class="velke-tlacitko">Nová hra 🔄</button>
	</section>
</div>

<script>
	type Odp = 'A' | 'B';
	type Mozn = { popis: string; doplnek: string };
	type K = { id: string; otazka: string; spravne: Odp; proc: string };
	type Kolo = { cislo: number; nazev: string; pravidlo: string; moznosti: Record<Odp, Mozn>; body: number; karty: K[] };
	type Tym = { jmeno: string; body: number };
	const $ = (id: string) => document.getElementById(id)!;
	const KOLA: Kolo[] = JSON.parse($('hra-vykon').dataset.kola!);
	const omezenyPohyb = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	let tymy: Tym[] = []; let iKolo = 0; let iKarta = 0; let casNaKartu = 15;
	let odpocetId: ReturnType<typeof setInterval> | undefined; let odhaleno = false;
	const kolo = () => KOLA[iKolo]; const karta = () => kolo().karty[iKarta];

	function poradi(t: Tym[]) {
		const s = t.map((x, i) => ({ ...x, i })).sort((a, b) => b.body - a.body || a.i - b.i);
		return s.map((x) => ({ jmeno: x.jmeno, body: x.body, misto: s.findIndex((u) => u.body === x.body) + 1 }));
	}
	function ukaz(sekce: string) {
		for (const id of ['nastaveni', 'uvod-kola', 'karta', 'vysledky']) $(id).hidden = id !== sekce;
		$('hra-vykon').scrollIntoView({ block: 'start' });
	}
	function vykresliJmena() {
		const n = +($('pocet-tymu') as HTMLSelectElement).value;
		const barvy = ['Červení', 'Modří', 'Zelení', 'Žlutí', 'Fialoví', 'Oranžoví'];
		$('jmena-tymu').innerHTML = Array.from({ length: n }, (_, i) => `<input class="jmeno-tymu" value="${barvy[i]}" maxlength="16">`).join('');
	}
	$('pocet-tymu').addEventListener('change', vykresliJmena); vykresliJmena();
	$('start').addEventListener('click', () => {
		tymy = [...document.querySelectorAll<HTMLInputElement>('.jmeno-tymu')].map((el, i) => ({ jmeno: el.value.trim() || `Tým ${i + 1}`, body: 0 }));
		casNaKartu = +($('cas-karty') as HTMLSelectElement).value; iKolo = 0; uvodKola();
	});
	function uvodKola() {
		const k = kolo(); $('uvod-cislo').textContent = `Kolo ${k.cislo} ze ${KOLA.length}`; $('uvod-nazev').textContent = k.nazev;
		$('uvod-pravidlo').textContent = k.pravidlo; $('uvod-A').textContent = k.moznosti.A.popis; $('uvod-A2').textContent = k.moznosti.A.doplnek;
		$('uvod-B').textContent = k.moznosti.B.popis; $('uvod-B2').textContent = k.moznosti.B.doplnek;
		$('uvod-body').textContent = k.body === 1 ? 'Za každou správnou kartu 1 bod.' : `Za každou správnou kartu ${k.body} body!`; ukaz('uvod-kola');
	}
	$('hrajeme').addEventListener('click', () => { iKarta = 0; ukaz('karta'); zobrazKartu(); });
	function zobrazKartu() {
		const k = kolo(); const c = karta(); odhaleno = false;
		$('lista-kolo').textContent = `Kolo ${k.cislo}/${KOLA.length} · karta ${iKarta + 1}/${k.karty.length}`;
		$('lista-body').textContent = k.body === 1 ? 'za 1 bod' : `⭐ FINÁLE · za ${k.body} body`;
		document.querySelectorAll<HTMLElement>('.scena').forEach((s) => s.classList.toggle('skryta', s.dataset.karta !== c.id));
		const sv = document.querySelector<SVGSVGElement>('.scena[data-karta="' + c.id + '"] svg');
		if (sv) { sv.setCurrentTime?.(0); if (omezenyPohyb) sv.pauseAnimations?.(); else sv.unpauseAnimations?.(); }
		document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-odhal]`).forEach((el) => el.setAttribute('opacity', '0'));
		$('otazka').textContent = c.otazka;
		document.querySelectorAll<HTMLElement>('#karta .moznost').forEach((el) => {
			const m = el.dataset.m as Odp; el.querySelector('.m-popis')!.textContent = k.moznosti[m].popis;
			el.querySelector('small')!.textContent = k.moznosti[m].doplnek; el.classList.remove('spravna', 'spatna');
		});
		$('odhaleni').hidden = true; $('odhalit').hidden = false; $('dalsi').hidden = true; vykresliTymy(); spustOdpocet();
	}
	function spustOdpocet() {
		let zbyva = casNaKartu; const vypln = $('odpocet-vypln'); $('odpocet-cislo').textContent = `${zbyva} s`;
		vypln.style.transition = 'none'; vypln.style.width = omezenyPohyb ? '0%' : '100%';
		if (!omezenyPohyb) requestAnimationFrame(() => requestAnimationFrame(() => {
			vypln.style.transition = `width ${casNaKartu}s linear`; vypln.style.width = '0%';
		}));
		clearInterval(odpocetId); odpocetId = setInterval(() => {
			zbyva--; $('odpocet-cislo').textContent = `${Math.max(zbyva, 0)} s`; if (zbyva <= 3 && zbyva > 0) pipni(600);
			if (zbyva <= 0) { clearInterval(odpocetId); pipni(880, 0.4); $('odpocet-cislo').textContent = 'Zvedněte karty!'; }
		}, 1000);
	}
	function pipni(frekvence: number, delka = 0.12) {
		try { const w = window as unknown as { _ctxHry?: AudioContext }; const ctx = (w._ctxHry ??= new AudioContext());
			const osc = ctx.createOscillator(); const gain = ctx.createGain(); osc.frequency.value = frekvence; gain.gain.value = 0.15;
			osc.connect(gain).connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime + delka); } catch { /* bez zvuku */ }
	}
	$('odhalit').addEventListener('click', () => {
		clearInterval(odpocetId); const c = karta(); odhaleno = true; $('odpocet-cislo').textContent = '';
		$('odpocet-vypln').style.transition = 'none'; $('odpocet-vypln').style.width = '0%';
		document.querySelectorAll<HTMLElement>('#karta .moznost').forEach((el) => {
			el.classList.toggle('spravna', el.dataset.m === c.spravne); el.classList.toggle('spatna', el.dataset.m !== c.spravne);
		});
		document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-odhal]`).forEach((el) => el.setAttribute('opacity', '1'));
		$('proc').textContent = `✔ ${c.proc}`; $('odhaleni').hidden = false; $('odhalit').hidden = true; $('dalsi').hidden = false; vykresliTymy();
	});
	function vykresliTymy() {
		$('tymy').innerHTML = tymy.map((t, i) => `<div class="tym-obal"><button class="tym" data-i="${i}" ${odhaleno ? '' : 'disabled'}><span class="tym-jmeno">${t.jmeno}</span><b class="tym-body">${t.body}</b></button></div>`).join('');
		document.querySelectorAll<HTMLButtonElement>('.tym').forEach((b) => b.addEventListener('click', () => b.classList.toggle('oznaceny')));
	}
	$('dalsi').addEventListener('click', () => {
		const body = kolo().body; document.querySelectorAll<HTMLElement>('.tym.oznaceny').forEach((b) => (tymy[+b.dataset.i!].body += body));
		iKarta++; if (iKarta < kolo().karty.length) return zobrazKartu(); iKolo++; if (iKolo < KOLA.length) return uvodKola(); konec();
	});
	function konec() {
		clearInterval(odpocetId); ukaz('vysledky'); const medaile = ['🥇', '🥈', '🥉'];
		$('podium').innerHTML = poradi(tymy).map((t) => `<li class="podium-radek">${medaile[t.misto - 1] ?? '🏅'} ${t.misto}. <b>${t.jmeno}</b> — ${t.body} b.</li>`).join('');
		if (!omezenyPohyb) for (let i = 0; i < 40; i++) { const k = document.createElement('span'); k.className = 'konfeta'; k.textContent = ['🎉', '⭐', '🎊', '⚡'][i % 4];
			k.style.left = Math.random() * 100 + 'vw'; k.style.animationDelay = Math.random() * 2 + 's'; document.body.appendChild(k); }
	}
	$('znovu').addEventListener('click', () => location.reload());
	$('cela-obrazovka').addEventListener('click', () => { if (document.fullscreenElement) document.exitFullscreen(); else $('hra-vykon').requestFullscreen?.(); });
</script>

<style>
	#hra-vykon { max-width: 1200px; margin: 0 auto; background: var(--papir, #f7f4ec); }
	#hra-vykon:fullscreen { max-width: none; padding: 1rem 2rem; overflow: auto; }
	.podnadpis { font-size: 1.3rem; color: #495057; margin-top: -0.6rem; } .pravidla li { margin: 0.3rem 0; }
	.pozn { color: #5c5f66; font-size: 1.1rem; } .volby { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 1rem 0; }
	.volby label { display: flex; flex-direction: column; font-weight: 700; gap: 0.3rem; } .volby select { font-size: 1.2rem; padding: 0.3rem; }
	#jmena-tymu { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem; }
	#jmena-tymu :global(.jmeno-tymu) { font-size: 1.3rem; padding: 0.4rem; border: 2px solid #333; border-radius: 8px; width: 9rem; font-family: inherit; }
	.velke-tlacitko { font-size: 1.5rem; padding: 0.6rem 2rem; border-radius: 12px; border: 3px solid #333; background: #ffe066; cursor: pointer; font-weight: 800; font-family: inherit; }
	.velke-tlacitko:hover { transform: scale(1.04); } .male-tlacitko { font-size: 1rem; padding: 0.4rem 0.8rem; border-radius: 10px; border: 2px solid #888; background: #fff; cursor: pointer; font-family: inherit; margin-left: auto; }
	#uvod-kola { text-align: center; padding-top: 1rem; } .cislo-kola { font-size: 1.6rem; font-weight: 800; color: #c2410c; margin: 0; }
	#uvod-nazev { font-size: 2.9rem; margin: 0.1rem 0 0.4rem; line-height: 1.15; } .pravidlo { font-size: 1.6rem; line-height: 1.35; max-width: 46rem; margin: 0 auto 1rem; }
	.uvod-moznosti { max-width: 46rem; margin: 0 auto; text-align: left; } .za-body { font-size: 1.6rem; font-weight: 800; }
	.lista { display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 1.4rem; font-weight: 800; line-height: 1.2; }
	.lista-body { color: #c2410c; flex: 1; text-align: center; } .odpocet-cislo { min-width: 5rem; text-align: right; color: #c92a2a; }
	#odpocet-pruh { height: 12px; background: #e9ecef; border-radius: 6px; overflow: hidden; margin: 0.3rem 0 0.6rem; }
	#odpocet-vypln { height: 100%; width: 100%; background: linear-gradient(90deg, #40c057, #ffd43b, #fa5252); }
	.plocha { display: grid; grid-template-columns: 3fr 2fr; gap: 1.2rem; align-items: start; } .scena-obal { position: relative; }
	.scena.skryta { visibility: hidden; position: absolute; top: 0; left: 0; width: 100%; pointer-events: none; }
	.scena-obal :global(svg) { display: block; width: 100%; height: auto; border: 3px solid #333; border-radius: 14px; background: #fff; }
	#otazka { font-size: 1.85rem; line-height: 1.2; margin: 0 0 0.8rem; } .moznosti { display: grid; gap: 0.7rem; }
	.moznost { display: flex; align-items: center; gap: 0.9rem; padding: 0.45rem 1rem; border: 4px solid #333; border-radius: 14px; background: #fff; transition: opacity 0.3s; }
	.moznost > b { flex: none; width: 3rem; height: 3rem; border-radius: 50%; color: #fff; font-size: 2rem; display: flex; align-items: center; justify-content: center; }
	.moznost-A > b { background: #e03131; } .moznost-B > b { background: #1971c2; } .m-popis { display: block; font-size: 2rem; font-weight: 800; line-height: 1.1; }
	.moznost small { display: block; font-size: 1.1rem; color: #495057; line-height: 1.2; } .moznost.spravna { background: #d3f9d8; border-color: #2b8a3e; box-shadow: 0 0 0 5px #8ce99a; }
	.moznost.spatna { opacity: 0.35; } .proc { font-size: 1.5rem; font-weight: 700; color: #1b4d2a; margin: 0.5rem 0 0.1rem; line-height: 1.25; }
	.pokyn { font-weight: 700; margin: 0.2rem 0 0; font-size: 1.15rem; color: #495057; } .tymy { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: flex-start; margin-top: 0.7rem; }
	.tymy :global(.tym-obal) { display: flex; gap: 0.25rem; align-items: stretch; } .tymy :global(.tym) { display: flex; align-items: center; gap: 0.6rem; font-size: 1.3rem; font-family: inherit; padding: 0.3rem 0.8rem; border-radius: 12px; border: 3px solid #333; background: #fff; cursor: pointer; color: inherit; }
	.tymy :global(.tym:disabled) { cursor: default; opacity: 1; } .tymy :global(.tym-body) { font-size: 1.8rem; min-width: 2rem; text-align: center; }
	.tymy :global(.tym.oznaceny) { background: #d3f9d8; border-color: #2b8a3e; } .tymy :global(.tym.oznaceny .tym-body::after) { content: ' ✔'; color: #2b8a3e; }
	.ovladani { display: flex; justify-content: flex-end; margin-top: 0.9rem; } #podium { padding: 0; list-style: none; } #podium :global(.podium-radek) { font-size: 2rem; margin: 0.5rem 0; }
	.shrnuti { font-size: 1.4rem; } :global(.konfeta) { position: fixed; top: -3rem; font-size: 1.8rem; animation: pad 3.2s linear infinite; z-index: 99; }
	@keyframes pad { to { transform: translateY(110vh) rotate(360deg); } }
	@media (prefers-reduced-motion: reduce) {
		:global(.konfeta) { display: none !important; animation: none !important; }
		.velke-tlacitko:hover { transform: none; }
		#odpocet-vypln, .moznost { transition: none !important; }
	}
	@media (max-width: 900px) { .plocha { grid-template-columns: 1fr; } #otazka { font-size: 1.5rem; } .lista { font-size: 1.05rem; flex-wrap: wrap; gap: 0.3rem 0.6rem; } .lista-body { white-space: nowrap; flex: none; } .m-popis { font-size: 1.6rem; } }
</style>
