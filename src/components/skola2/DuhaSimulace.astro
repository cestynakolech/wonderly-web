---
// Rozklad světla a duha (F7). Režim „hranol": bílý paprsek se rozloží na
// spektrum 7 barev (červená se láme nejméně → nahoře, fialová nejvíce → dole);
// klik na barvu ji zvýrazní a popíše, tlačítko přidá obrácený hranol = Newtonův
// důkaz 1671 (barvy se složí zpět do bílé). Režim „duha": hlavní oblouk
// (červená nahoře) + přepínatelná vedlejší duha (2 odrazy v kapce, opačné
// pořadí, slabší) a schéma kapky. Bez časové animace; pořadí barev a lom
// = čisté funkce na SVG (__poradiDuhy, __lomBarvy).
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Hranol a duha — bílé světlo je složené 🕹️</span></h2>
	<p>Každá barva se ve skle či vodě <strong>láme jinak</strong> — červená nejméně, fialová nejvíce. Proto hranol i dešťová kapka rozloží bílé světlo na <strong>spektrum sedmi barev</strong>.</p>
	<p id="duha-rezimy">
		<button type="button" class="duha-tl duha-aktivni" data-rezim="hranol">🔺 hranol (Newton 1671)</button>
		<button type="button" class="duha-tl" data-rezim="duha">🌈 duha na obloze</button>
	</p>
	<svg id="duha-svg" viewBox="0 0 660 340" role="img" aria-label="Hranol rozkládající světlo na spektrum, nebo duha s vedlejším obloukem">
		<!-- REŽIM HRANOL -->
		<g id="duha-scena-hranol">
			<line x1="20" y1="170" x2="215" y2="170" stroke="#f8f9fa" stroke-width="0" />
			<line x1="20" y1="170" x2="218" y2="170" stroke="#ced4da" stroke-width="7" />
			<text x="30" y="150" font-size="12" fill="#868e96">bílé světlo</text>
			<polygon points="250,60 190,240 310,240" fill="#d0ebff" fill-opacity="0.75" stroke="#1864ab" stroke-width="3" />
			<g id="duha-vejir"></g>
			<!-- druhý (obrácený) hranol + složený bílý paprsek -->
			<g id="duha-hranol2" visibility="hidden">
				<polygon points="470,250 530,70 410,70 " fill="#d0ebff" fill-opacity="0.75" stroke="#1864ab" stroke-width="3" />
				<line x1="500" y1="160" x2="645" y2="160" stroke="#ced4da" stroke-width="8" />
				<text x="545" y="140" font-size="13" font-weight="bold" fill="#2b2a26">zase BÍLÁ!</text>
			</g>
			<text id="duha-hranol-pop" x="330" y="325" text-anchor="middle" font-size="12" fill="#868e96"></text>
		</g>
		<!-- REŽIM DUHA -->
		<g id="duha-scena-duha" visibility="hidden">
			<rect x="20" y="295" width="620" height="25" fill="#b2f2bb" stroke="#2b2a26" stroke-width="2" />
			<text x="60" y="60" font-size="30">🌦️</text>
			<text x="150" y="45" font-size="12" fill="#868e96">déšť před tebou, Slunce za zády</text>
			<g id="duha-hlavni"></g>
			<g id="duha-vedlejsi" opacity="0.55"></g>
			<text id="duha-popis-hlavni" x="330" y="288" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26"></text>
			<!-- schéma kapky -->
			<circle cx="565" cy="95" r="42" fill="#d0ebff" fill-opacity="0.8" stroke="#1864ab" stroke-width="2.5" />
			<line x1="480" y1="70" x2="540" y2="80" stroke="#ced4da" stroke-width="4" />
			<g id="duha-kapka-1odraz">
				<polyline points="540,80 590,120 545,125" fill="none" stroke="#868e96" stroke-width="2.5" />
				<polyline points="545,125 500,150" fill="none" stroke="#e03131" stroke-width="3" />
				<polyline points="545,125 495,140" fill="none" stroke="#7048e8" stroke-width="3" />
				<text x="600" y="135" font-size="11" fill="#868e96">1 odraz</text>
			</g>
			<g id="duha-kapka-2odrazy" visibility="hidden">
				<polyline points="540,80 590,120 570,60 530,115" fill="none" stroke="#868e96" stroke-width="2.5" />
				<polyline points="530,115 480,130" fill="none" stroke="#7048e8" stroke-width="3" />
				<polyline points="530,115 485,145" fill="none" stroke="#e03131" stroke-width="3" />
				<text x="600" y="135" font-size="11" fill="#868e96">2 odrazy</text>
			</g>
		</g>
	</svg>
	<p id="duha-barvy-chipy"></p>
	<p id="duha-prepinace">
		<button type="button" class="duha-tl" id="duha-hranol2-tl">➕ přidej obrácený hranol</button>
		<button type="button" class="duha-tl" id="duha-vedlejsi-tl" style="display:none">🌈🌈 přidej vedlejší duhu</button>
	</p>
	<p class="duha-stav" id="duha-stav">👉 Klikej na barvy spektra a zjisti, která se láme nejvíc — pak zkus Newtonův pokus s druhým hranolem.</p>
</section>

<script>
	// === ČISTÁ ČÁST (pořadí a lom barev — kontrolovatelná výpočtem) ===
	const BARVY = ['červená', 'oranžová', 'žlutá', 'zelená', 'modrá', 'indigová', 'fialová'];
	const HEXY = ['#e03131', '#f76707', '#ffd43b', '#2f9e44', '#1971c2', '#3b5bdb', '#7048e8'];
	function poradiDuhy(vedlejsi) {
		// hlavní duha: červená NAHOŘE; vedlejší (2 odrazy): pořadí OPAČNÉ
		return vedlejsi ? [...BARVY].reverse() : [...BARVY];
	}
	function lomBarvy(i) {
		// i = 0 (červená, láme se nejméně) … 6 (fialová, nejvíce); y vějíře roste s lomem
		return { poradi: i + 1, y: 110 + i * 30 };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	let rezim = 'hranol';
	let hranol2 = false, vedlejsi = false, vybrana = -1;
	const svg = document.getElementById('duha-svg');
	svg.__poradiDuhy = poradiDuhy; svg.__lomBarvy = lomBarvy; // pro nezávislou kontrolu
	const g = (id) => document.getElementById(id);

	function kresliHranol() {
		const vejir = g('duha-vejir');
		vejir.innerHTML = '';
		for (let i = 0; i < 7; i++) {
			const { y } = lomBarvy(i);
			const sirka = vybrana === i ? 7 : 3.5;
			vejir.innerHTML += hranol2
				? `<polyline points="288,170 430,${130 + i * 12} 470,${150 + i * 3}" fill="none" stroke="${HEXY[i]}" stroke-width="${sirka}" data-barva="${i}" style="cursor:pointer" />`
				: `<line x1="288" y1="170" x2="640" y2="${y}" stroke="${HEXY[i]}" stroke-width="${sirka}" data-barva="${i}" style="cursor:pointer" />`;
		}
		g('duha-hranol2').setAttribute('visibility', hranol2 ? 'visible' : 'hidden');
		g('duha-hranol2-tl').textContent = hranol2 ? '➖ odeber obrácený hranol' : '➕ přidej obrácený hranol';
		g('duha-hranol-pop').textContent = hranol2 ? 'Newtonův pokus: rozložit — a zase složit' : 'spektrum: nahoře červená (nejmenší lom), dole fialová (největší)';
	}

	function kresliDuhu() {
		for (const [gid, jeVedlejsi, r0] of [['duha-hlavni', false, 150], ['duha-vedlejsi', true, 205]]) {
			const el = g(gid);
			el.innerHTML = '';
			if (jeVedlejsi && !vedlejsi) continue;
			const barvy = poradiDuhy(jeVedlejsi);
			barvy.forEach((nazev, i) => {
				const r = r0 - i * 5.5;
				const hex = HEXY[BARVY.indexOf(nazev)];
				el.innerHTML += `<path d="M ${330 - r} 295 A ${r} ${r} 0 0 1 ${330 + r} 295" fill="none" stroke="${hex}" stroke-width="5" />`;
			});
		}
		g('duha-popis-hlavni').textContent = vedlejsi
			? 'hlavní duha: červená nahoře · vedlejší (výš): pořadí OPAČNÉ, slabší'
			: 'hlavní duha: ČERVENÁ nahoře, fialová dole';
		g('duha-kapka-1odraz').setAttribute('visibility', vedlejsi ? 'hidden' : 'visible');
		g('duha-kapka-2odrazy').setAttribute('visibility', vedlejsi ? 'visible' : 'hidden');
		g('duha-vedlejsi-tl').textContent = vedlejsi ? '🌈 nech jen hlavní duhu' : '🌈🌈 přidej vedlejší duhu';
	}

	function chipy() {
		const p = g('duha-barvy-chipy');
		p.innerHTML = '';
		if (rezim !== 'hranol') return;
		BARVY.forEach((nazev, i) => {
			const tl = document.createElement('button');
			tl.type = 'button'; tl.className = 'duha-chip';
			tl.style.background = HEXY[i];
			tl.title = nazev;
			tl.setAttribute('aria-label', nazev);
			tl.addEventListener('click', () => vyberBarvu(i));
			p.appendChild(tl);
		});
	}

	function vyberBarvu(i) {
		vybrana = i;
		kresliHranol();
		const { poradi } = lomBarvy(i);
		g('duha-stav').textContent = i === 0
			? '🔴 ČERVENÁ se láme NEJMÉNĚ ze všech barev — ve spektru je úplně nahoře (a v duze taky).'
			: i === 6
			? '🟣 FIALOVÁ se láme NEJVÍCE — ve spektru je úplně dole. Rozdíl v lomu je příčinou celého rozkladu.'
			: `🎨 ${nazevVelky(BARVY[i])} je ${poradi}. ze sedmi barev spektra — láme se ${poradi <= 3 ? 'méně' : 'více'} než prostřední zelená.`;
	}
	const nazevVelky = (n) => n.charAt(0).toUpperCase() + n.slice(1);

	function prekresli() {
		g('duha-scena-hranol').setAttribute('visibility', rezim === 'hranol' ? 'visible' : 'hidden');
		g('duha-scena-duha').setAttribute('visibility', rezim === 'duha' ? 'visible' : 'hidden');
		g('duha-hranol2-tl').style.display = rezim === 'hranol' ? '' : 'none';
		g('duha-vedlejsi-tl').style.display = rezim === 'duha' ? '' : 'none';
		for (const b of document.querySelectorAll('#duha-rezimy [data-rezim]')) b.classList.toggle('duha-aktivni', b.dataset.rezim === rezim);
		chipy();
		if (rezim === 'hranol') {
			kresliHranol();
			if (vybrana < 0) g('duha-stav').textContent = '👉 Klikej na barvy spektra (pruhy i kolečka) a zjisti, která se láme nejvíc — pak zkus Newtonův pokus s druhým hranolem.';
		} else {
			kresliDuhu();
			g('duha-stav').textContent = '🌈 Duha vzniká rozkladem slunečního světla na dešťových kapkách — Slunce musíš mít ZA ZÁDY. Podstatu vysvětlil lomem český fyzik Jan Marcus Marci.';
		}
	}

	document.getElementById('duha-rezimy').addEventListener('click', (e) => {
		const tl = e.target.closest('[data-rezim]');
		if (!tl) return; rezim = tl.dataset.rezim; prekresli();
	});
	g('duha-vejir').addEventListener('click', (e) => {
		const el = e.target.closest('[data-barva]');
		if (el) vyberBarvu(+el.dataset.barva);
	});
	g('duha-hranol2-tl').addEventListener('click', () => {
		hranol2 = !hranol2;
		kresliHranol();
		g('duha-stav').textContent = hranol2
			? '💡 Newtonův důkaz (1671): obrácený hranol barvy zase SLOŽÍ do bílého světla. Bílé světlo je tedy SLOŽENÉ ze sedmi barev — pruh barev Newton nazval SPEKTRUM.'
			: '🔺 Jeden hranol světlo rozkládá: každá barva se láme jinak, proto se vějíř roztáhne.';
	});
	g('duha-vedlejsi-tl').addEventListener('click', () => {
		vedlejsi = !vedlejsi;
		kresliDuhu();
		g('duha-stav').textContent = vedlejsi
			? '🌈🌈 Vedlejší duha: světlo se v kapce odrazí DVAKRÁT — proto je slabší a pořadí barev má OPAČNÉ (nahoře fialová). Podívej se na schéma kapky vpravo.'
			: '🌈 Hlavní duha: jeden odraz v kapce, červená nahoře, fialová dole.';
	});
	prekresli();
</script>

<style>
	#duha-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.duha-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.duha-tl.duha-aktivni { background: #ffe8cc; }
	.duha-tl:active { transform: translateY(1px); }
	.duha-chip { width: 34px; height: 34px; border: 3px solid #2b2a26; border-radius: 50%; cursor: pointer; margin: 0 0.3rem 0.3rem 0; }
	.duha-chip:active { transform: translateY(1px); }
	.duha-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
