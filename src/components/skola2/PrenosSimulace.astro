---
// Přenos elektrické energie (F9): týž výkon 8 800 kW z elektrárny do města
// třemi způsoby — rovnou 400 V (bez transformace), 22 kV (distribuční),
// 400 kV (přenosová soustava). Proud I = P/U (22 000 / 400 / 22 A — celé)
// a ztráty vedení P = R·I² (R = 5 Ω): 2,42 GW (víc než posíláme — nedorazí
// nic), 800 kW, 2 420 W (skoro nic). Ukazuje, PROČ se napětí transformuje
// nahoru: vysoké napětí = malý proud = malé ztráty. Bez časové animace;
// stav je čistá funkce stavPrenosu(volba) na SVG (__stavPrenosu).
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Proč dráty vedou 400 000 voltů? 🕹️</span></h2>
	<p>Elektrárna posílá městu výkon <strong>8 800 kW</strong>. Vedení má odpor <strong>5 Ω</strong> a ztráty v něm rostou s <strong>druhou mocninou proudu</strong> (P = R·I²). Vyber napětí a sleduj, kolik energie dorazí.</p>
	<p id="pns-volby">
		<button type="button" class="pns-tl" data-volba="0">🔌 rovnou 400 V</button>
		<button type="button" class="pns-tl" data-volba="1">⚡ 22 kV (distribuční)</button>
		<button type="button" class="pns-tl pns-aktivni" data-volba="2">🗼 400 kV (přenosová)</button>
	</p>
	<svg id="pns-svg" viewBox="0 0 660 320" role="img" aria-label="Elektrárna, vedení s transformátory a město">
		<!-- elektrárna -->
		<text x="55" y="215" font-size="44">🏭</text>
		<text x="80" y="245" text-anchor="middle" font-size="11" fill="#868e96">alternátor (trojfázový)</text>
		<!-- transformátory -->
		<rect x="130" y="160" width="34" height="44" rx="6" fill="#ffe8cc" stroke="#2b2a26" stroke-width="3" />
		<text id="pns-trafo1" x="147" y="150" text-anchor="middle" font-size="11" font-weight="bold" fill="#e8590c">⬆ trafo</text>
		<rect x="496" y="160" width="34" height="44" rx="6" fill="#ffe8cc" stroke="#2b2a26" stroke-width="3" />
		<text x="513" y="150" text-anchor="middle" font-size="11" font-weight="bold" fill="#e8590c">⬇ trafo</text>
		<!-- trojfázové vedení (3 vodiče) + stožáry -->
		<g id="pns-vedeni" stroke-width="3" fill="none">
			<line x1="164" y1="170" x2="496" y2="170" /><line x1="164" y1="182" x2="496" y2="182" /><line x1="164" y1="194" x2="496" y2="194" />
		</g>
		<g stroke="#868e96" stroke-width="3">
			<line x1="250" y1="164" x2="250" y2="240" /><line x1="330" y1="164" x2="330" y2="240" /><line x1="410" y1="164" x2="410" y2="240" />
		</g>
		<text x="330" y="258" text-anchor="middle" font-size="11" fill="#868e96">3 vodiče = 3 fáze (posunuté o ⅓ periody)</text>
		<!-- teplo ze ztrát -->
		<text id="pns-teplo" x="330" y="130" text-anchor="middle" font-size="24"></text>
		<text id="pns-ztraty-pop" x="330" y="100" text-anchor="middle" font-size="14" font-weight="bold" fill="#e03131"></text>
		<!-- město -->
		<text id="pns-mesto" x="560" y="215" font-size="44">🏙️</text>
		<text id="pns-dorazi" x="585" y="245" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26"></text>
		<!-- panel hodnot -->
		<g font-size="14" font-weight="bold" fill="#2b2a26" text-anchor="middle">
			<text id="pns-u" x="180" y="45"></text>
			<text id="pns-i" x="380" y="45"></text>
		</g>
		<text x="330" y="300" text-anchor="middle" font-size="11" fill="#868e96">do zásuvky pak trafo sníží napětí na 230 V (fáze–zem); mezi fázemi 400 V</text>
	</svg>
	<p class="pns-vzorec" id="pns-vzorec"></p>
	<p class="pns-stav" id="pns-stav">👉 Vyzkoušej všechna tři napětí a porovnej ztráty.</p>
</section>

<script>
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	const P = 8800000; // W posílaný výkon (8 800 kW)
	const R = 5; // Ω odpor vedení
	const VOLBY = [
		{ nazev: '400 V', U: 400 },
		{ nazev: '22 kV', U: 22000 },
		{ nazev: '400 kV', U: 400000 },
	];
	function stavPrenosu(volba) {
		const { nazev, U } = VOLBY[volba];
		const I = P / U; // 22 000 / 400 / 22 A — celé
		const ztraty = R * I * I; // W: 2 420 000 000 / 800 000 / 2 420 — celé
		const vysledek = ztraty >= P ? 'nic' : ztraty >= P / 100 ? 'vetsina' : 'vse';
		return { nazev, U, I, ztraty, vysledek };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	let volba = 2;
	const svg = document.getElementById('pns-svg');
	svg.__stavPrenosu = stavPrenosu; // pro nezávislou kontrolu výpočtem
	const g = (id) => document.getElementById(id);
	const fmt = (n) => n.toLocaleString('cs-CZ');

	function kresli() {
		const s = stavPrenosu(volba);
		g('pns-u').textContent = `napětí vedení: ${s.nazev}`;
		g('pns-i').textContent = `proud: I = P/U = ${fmt(s.I)} A`;
		// vodiče: barva a tloušťka podle proudu (žhnou při velkých ztrátách)
		const vedeni = g('pns-vedeni');
		vedeni.setAttribute('stroke', s.vysledek === 'nic' ? '#e03131' : s.vysledek === 'vetsina' ? '#f76707' : '#2b2a26');
		vedeni.setAttribute('stroke-width', s.vysledek === 'nic' ? 6 : s.vysledek === 'vetsina' ? 4 : 3);
		g('pns-teplo').textContent = s.vysledek === 'nic' ? '🔥🔥🔥🔥🔥' : s.vysledek === 'vetsina' ? '♨️♨️' : '';
		g('pns-ztraty-pop').textContent = s.vysledek === 'nic'
			? `ztráty ${fmt(s.ztraty / 1000000)} MW — víc, než posíláme!`
			: s.ztraty >= 100000 ? `ztráty ${fmt(s.ztraty / 1000)} kW` : `ztráty jen ${fmt(s.ztraty)} W`;
		g('pns-mesto').setAttribute('opacity', s.vysledek === 'nic' ? 0.25 : s.vysledek === 'vetsina' ? 0.7 : 1);
		g('pns-dorazi').textContent = s.vysledek === 'nic' ? 'město potmě 🌑' : s.vysledek === 'vetsina' ? 'dorazí 8 000 kW' : 'dorazí prakticky vše ✨';
		g('pns-trafo1').textContent = volba === 0 ? '(bez trafa)' : '⬆ trafo';
		for (const b of document.querySelectorAll('#pns-volby [data-volba]')) b.classList.toggle('pns-aktivni', +b.dataset.volba === volba);
		g('pns-vzorec').innerHTML = `I = P / U = 8 800 000 W / ${fmt(s.U)} V = <strong>${fmt(s.I)} A</strong> &nbsp;·&nbsp; ztráty = R·I² = 5 × ${fmt(s.I)}² = <strong>${fmt(s.ztraty)} W</strong>`;
		const STAVY = [
			'🔥 KATASTROFA: při 400 V by tekl proud 22 000 A — ztráty by byly větší než celý posílaný výkon, dráty by se roztavily a do města by nedorazilo NIC. Proto se bez transformace na dálku přenášet nedá.',
			'♨️ Distribuční napětí 22 kV: proud 400 A, ztráty 800 kW — skoro desetina výkonu se cestou promění v teplo drátů. Na kratší vzdálenosti ke spotřebitelům to stačí.',
			'✨ Přenosová soustava 400 kV: proud jen 22 A a ztráty 2 420 W — zanedbatelné. VYSOKÉ NAPĚTÍ = MALÝ PROUD = MALÉ ZTRÁTY. Přesně proto trafo u elektrárny napětí zvyšuje a u města zase snižuje.',
		];
		g('pns-stav').textContent = STAVY[volba];
	}

	document.getElementById('pns-volby').addEventListener('click', (e) => {
		const tl = e.target.closest('[data-volba]');
		if (!tl) return; volba = +tl.dataset.volba; kresli();
	});
	kresli();
</script>

<style>
	#pns-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.pns-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.pns-tl.pns-aktivni { background: #ffe8cc; }
	.pns-tl:active { transform: translateY(1px); }
	.pns-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.pns-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
