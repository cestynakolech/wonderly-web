---
// Vlastní vodivost polovodiče (F9): posuvník teploty −20…100 °C po 20 °C
// (7 kroků, výchozí 20 °C = pokojová teplota). V ČISTÉM polovodiči (křemíku)
// teplo uvolňuje vazebné elektrony → vzniká PÁR elektron+díra.
// Nakreslený počet párů je jen NÁZORNÝ a roste s teplotou ZRYCHLENĚ
// (PDF 13. Polovodiče: „S rostoucí teplotou prudce roste počet volných
// elektronů a děr“, „Nízká teplota – polovodič je spíše izolant“):
// −20 °C 0, 0 °C 0, 20 °C 1, 40 °C 2, 60 °C 3, 80 °C 5, 100 °C 7.
// Scéna netvrdí žádnou přesnou hranici — při nízké teplotě říká jen, že páry
// „skoro nevznikají“ a proud „téměř neteče“. Proud se NEvyčísluje (výklad
// žádnou hodnotu nemá), jen slovy a jasem žárovky. Žárovka a zdroj napětí
// jsou s polovodičem v jednom obvodu (záporný pól vlevo, kladný vpravo).
// Volných elektronů je vždy stejně jako děr (výklad). Značky jako v obrázcích
// výkladu (obr-03/04): elektron = modrý kroužek „−“, díra = zelený ČÁRKOVANÝ
// kroužek „+“. Každý pár má vlastní řádek a elektron s dírou startují od
// středu s odstupem → nic se nepřekrývá. Scéna je 440 px široká s písmem
// ≥ 17 px, aby byla čitelná i na telefonu (~320 px → písmo ≥ 12 px).
// Čisté funkce na SVG (__stavPolovodice, __pozicePartice, __svitZarovky,
// __teplotaText) jsou kontrolovatelné výpočtem bez prohlížeče.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vlastní vodivost polovodiče 🕹️</span></h2>
	<p>V čistém křemíku je za nízké teploty proud <strong>skoro nulový</strong> — elektrony pevně drží ve vazbách a polovodič je spíše izolant. Teplo je z vazby vyrazí a vznikne <strong>pár elektron + díra</strong> (díra je jen <strong>prázdné místo</strong> po uvolněném elektronu, ale chová se jako kladný náboj). Elektrony táhnou k pólu <strong>+</strong>, díry k pólu <strong>−</strong>. S rostoucí teplotou párů <strong>prudce přibývá</strong> a proud roste — u polovodičů přesně naopak než u kovů! (Počet nakreslených párů je jen názorný.)</p>
	<svg id="pol-svg" viewBox="0 0 440 400" role="img" aria-label="Kousek křemíku zapojený se zdrojem a žárovkou do obvodu, elektrony a díry vznikají teplem a putují k pólům">
		<!-- plaketa se stavem -->
		<rect x="20" y="8" width="400" height="60" rx="10" fill="#ffffff" stroke="#2b2a26" stroke-width="2" />
		<text id="pol-teplota-text" x="220" y="33" text-anchor="middle" font-size="18" font-weight="bold" fill="#2b2a26"></text>
		<text id="pol-proud-text" x="220" y="58" text-anchor="middle" font-size="18" font-weight="bold" fill="#2b2a26"></text>
		<text x="220" y="92" text-anchor="middle" font-size="17" fill="#495057">čistý křemík</text>
		<!-- obvod: záporná elektroda → zdroj → žárovka → kladná elektroda -->
		<path d="M60 260 L60 330 L150 330" stroke="#2b2a26" stroke-width="4" fill="none" />
		<path d="M166 330 L274 330" stroke="#2b2a26" stroke-width="4" fill="none" />
		<path d="M306 330 L380 330 L380 260" stroke="#2b2a26" stroke-width="4" fill="none" />
		<!-- zdroj napětí: krátká tlustá deska = −, dlouhá tenká = + -->
		<line x1="150" y1="316" x2="150" y2="344" stroke="#2b2a26" stroke-width="7" />
		<line x1="166" y1="304" x2="166" y2="356" stroke="#2b2a26" stroke-width="3" />
		<text x="140" y="312" text-anchor="end" font-size="24" font-weight="bold" fill="#1971c2">−</text>
		<text x="176" y="312" text-anchor="start" font-size="24" font-weight="bold" fill="#e03131">+</text>
		<text x="158" y="382" text-anchor="middle" font-size="17" fill="#2b2a26">zdroj</text>
		<!-- žárovka v obvodu -->
		<circle id="pol-zarovka" cx="290" cy="330" r="16" fill="#ffe066" stroke="#2b2a26" stroke-width="2" />
		<text x="290" y="336" text-anchor="middle" font-size="17">💡</text>
		<g id="pol-paprsky" stroke="#fab005" stroke-width="3" stroke-linecap="round">
			<line x1="272" y1="314" x2="262" y2="304" />
			<line x1="290" y1="308" x2="290" y2="294" />
			<line x1="308" y1="314" x2="318" y2="304" />
		</g>
		<text x="290" y="382" text-anchor="middle" font-size="17" fill="#2b2a26">žárovka</text>
		<!-- elektrody -->
		<rect x="50" y="100" width="20" height="160" fill="#495057" />
		<rect x="370" y="100" width="20" height="160" fill="#495057" />
		<!-- vzorek křemíku -->
		<rect x="70" y="100" width="300" height="160" fill="#e9ecef" stroke="#2b2a26" stroke-width="4" />
		<!-- teploměr -->
		<rect x="404" y="100" width="16" height="150" rx="8" fill="#fff" stroke="#2b2a26" stroke-width="2" />
		<rect id="pol-teplomer-sloupec" x="408" y="230" width="8" height="20" fill="#e8590c" />
		<circle cx="412" cy="258" r="11" fill="#e8590c" stroke="#2b2a26" stroke-width="2" />
		<!-- pohybující se páry elektron-díra -->
		<g id="pol-castice"></g>
	</svg>
	<label class="sim-posuvnik">
		Teplota polovodiče: <output id="pol-out-t"></output>
		<input type="range" id="pol-slider" min="-20" max="100" step="20" value="20" />
	</label>
	<p class="pol-vzorec" id="pol-vzorec"></p>
	<p class="pol-stav" id="pol-stav" aria-live="polite">👉 Posouvej teplotu a sleduj, jak přibývají páry elektron + díra a jak se zvětšuje proud.</p>
</section>

<script>
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	// názorný počet párů pro −20, 0, 20, 40, 60, 80, 100 °C — přírůstky 0,1,1,1,2,2 (zrychleně)
	const PARY = [0, 0, 1, 2, 3, 5, 7];
	const MAX_PARU = 7; // při 100 °C (nejvyšší poloha posuvníku)
	function stavPolovodice(teplota) {
		const pocetParu = PARY[(teplota + 20) / 20];
		return { teplota, pocetParu, proud: slovniProud(pocetParu) };
	}
	// proud jen slovy — výklad žádnou hodnotu proudu nemá
	function slovniProud(pocetParu) {
		if (pocetParu === 0) return 'téměř neteče';
		if (pocetParu === 1) return 'velmi slabý';
		return pocetParu < 4 ? 'slabý' : 'větší';
	}
	// žárovka: bez párů zhasnutá, s každým dalším párem jasnější
	function svitZarovky(pocetParu) {
		return { paprsky: pocetParu / MAX_PARU, banka: pocetParu > 0 ? '#ffe066' : '#e9ecef' };
	}
	// záporná teplota se znaménkem minus (−), ne spojovníkem (-)
	function teplotaText(teplota) {
		return teplota < 0 ? `−${Math.abs(teplota)} °C` : `${teplota} °C`;
	}
	const OBDOBI = 3000; // "divadelní" doba, za kterou pár doputuje od středu k okraji (ms)
	const X_STRED = 220, X_MINUS = 84, X_PLUS = 356;
	const ODSTUP = 12; // elektron a díra páru začínají 12 px od středu → mezi nimi 24 px, víc než dva poloměry
	const Y_PRVNI = 114, ROZESTUP = 22; // každý pár má svůj řádek (114, 136, … 246)
	// pozice i-tého páru (0-indexovaný) z celkového počtu pocetParu v čase t (ms)
	function pozicePartice(t, i, pocetParu) {
		if (pocetParu <= 0) return null;
		const posun = OBDOBI / pocetParu; // páry vznikají rovnoměrně za sebou
		const faze = ((t - i * posun) % OBDOBI + OBDOBI) % OBDOBI; // 0..OBDOBI
		const zlomek = faze / OBDOBI; // 0 (vznik u středu) → 1 (dorazil k elektrodě)
		const xElektron = X_STRED + ODSTUP + (X_PLUS - X_STRED - ODSTUP) * zlomek;
		const xDira = X_STRED - ODSTUP - (X_STRED - ODSTUP - X_MINUS) * zlomek;
		return { xElektron, xDira, y: Y_PRVNI + i * ROZESTUP };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	const svg = document.getElementById('pol-svg');
	svg.__stavPolovodice = stavPolovodice; // pro nezávislou kontrolu výpočtem
	svg.__pozicePartice = pozicePartice;
	svg.__svitZarovky = svitZarovky;
	svg.__teplotaText = teplotaText;
	const g = (id) => document.getElementById(id);
	const slider = document.getElementById('pol-slider');

	function vykresliCastice(t, s) {
		let html = '';
		for (let i = 0; i < s.pocetParu; i++) {
			const p = pozicePartice(t, i, s.pocetParu);
			if (!p) continue;
			// elektron = modrý kroužek „−“, díra = zelený čárkovaný kroužek „+“ (jako obr-03/04 výkladu)
			html += `<circle cx="${p.xElektron}" cy="${p.y}" r="10" fill="#1971c2" stroke="#0b4f8a" stroke-width="2" /><text x="${p.xElektron}" y="${p.y + 5}" text-anchor="middle" font-size="17" font-weight="bold" fill="#ffffff">−</text>`;
			html += `<circle cx="${p.xDira}" cy="${p.y}" r="10" fill="#ebfbee" stroke="#1b6b2d" stroke-width="2" stroke-dasharray="4 2" /><text x="${p.xDira}" y="${p.y + 5}" text-anchor="middle" font-size="17" font-weight="bold" fill="#1b6b2d">+</text>`;
		}
		g('pol-castice').innerHTML = html || ' ';
	}

	function popis(s) {
		g('pol-out-t').textContent = teplotaText(s.teplota);
		g('pol-teplota-text').textContent = `Teplota: ${teplotaText(s.teplota)}`;
		g('pol-proud-text').textContent = `Páry: ${s.pocetParu} · proud ${s.proud}`;
		g('pol-vzorec').innerHTML = `Volné elektrony: <strong>${s.pocetParu}</strong> · díry: <strong>${s.pocetParu}</strong> — vždy stejně, protože vznikají v párech.`;
		// sloupec teploměru: −20 °C → 10 px, 100 °C → 130 px, dole vždy u baňky (y 250)
		const vyska = s.teplota + 30;
		g('pol-teplomer-sloupec').setAttribute('y', 250 - vyska);
		g('pol-teplomer-sloupec').setAttribute('height', vyska);
		const svit = svitZarovky(s.pocetParu);
		g('pol-paprsky').setAttribute('opacity', svit.paprsky);
		g('pol-zarovka').setAttribute('fill', svit.banka);
		g('pol-stav').textContent = s.pocetParu === 0
			? '🥶 Nízká teplota: polovodič je spíše izolant — páry skoro nevznikají, proud téměř neteče.'
			: `🔥 Teplo uvolnilo ${s.pocetParu} ${s.pocetParu === 1 ? 'pár' : s.pocetParu < 5 ? 'páry' : 'párů'} elektron + díra — elektrony (modré „−“) jdou k +, díry (zelené čárkované „+“) k −. Proud je ${s.proud}.`;
	}

	let stav = stavPolovodice(+slider.value);
	function snimek(t) {
		vykresliCastice(t, stav);
		requestAnimationFrame(snimek);
	}

	slider.addEventListener('input', () => {
		stav = stavPolovodice(+slider.value);
		popis(stav);
		vykresliCastice(0, stav);
	});

	popis(stav);
	vykresliCastice(0, stav); // vykreslit i bez běžícího requestAnimationFrame (statický náhled)
	requestAnimationFrame(snimek);
</script>

<style>
	#pol-svg { width: 100%; max-width: 560px; display: block; margin: 0 auto; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 560px; display: block; margin-top: 0.3rem; }
	.pol-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.pol-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
