---
// Funkce v tabulkách — průměr, počet, KDYŽ (informatika 8).
//
// Výklad má vlastní sekci „Snadno se popletou". Tady si ji žák může způsobit:
//  1. POČET × SUMA — do sloupce známek se dá zapsat „nehodnocen" nebo buňku vymazat.
//     V tabulce to skoro není vidět, ale POČET klesne a s ním se změní PRŮMĚR,
//     protože ten dělí součet POČTEM ČÍSEL, ne počtem řádků. To je nejčastější
//     důvod, proč „ten průměr v Excelu vychází jinak, než jsem počítal na papíře".
//  2. MIN je u známek ta NEJLEPŠÍ, MAX nejhorší — přesně jak upozorňuje výklad.
//  3. RANK bez třetího údaje řadí od největší, takže by nejhorší známka vyšla jako
//     první místo. Přepínač to ukáže na témž žákovi: 1. místo × 6. místo.
//  4. Prázdná buňka se v porovnání bere jako NULA, takže =KDYŽ(B2<=4;…) napíše
//     „prospěl" i tomu, komu známku nikdo nezapsal. Text se naopak porovnává jako
//     větší než každé číslo, takže „nehodnocen" dá „neprospěl".
//
// Všechny výsledky jsou ČISTÉ FUNKCE seznamu buněk, takže se dají ověřit výpočtem
// bez prohlížeče (testy/simulace/funkce-tabulky.mjs).
//
// Výchozí hodnoty jsou zvolené tak, aby průměr vyšel jako celé číslo (18 / 6 = 3).
// Jakmile žák něco změní, desetinné číslo je v pořádku — průměr je právě to učivo.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Proč Excelu vychází jiný průměr než tobě 🧮</span></h2>
	<p>
		Klikáním na známku ji přepneš na jinou, na <strong>nehodnocen</strong> nebo na
		<strong>prázdnou buňku</strong>. Sleduj přitom dolní panel — hlavně
		<strong>POČET</strong> a <strong>PRŮMĚR</strong>.
	</p>

	<div class="fn-obal">
		<table class="fn-tabulka">
			<thead>
				<tr><th scope="col">Řádek</th><th scope="col">A — jméno</th><th scope="col">B — známka</th><th scope="col">C — =KDYŽ(B2&lt;=4;"prospěl";"neprospěl") <span class="fn-kopie">(kopírováno dolů do všech řádků)</span></th></tr>
			</thead>
			<tbody id="fn-telo">
				<tr><th scope="row">2</th><td>Adam</td><td><button type="button" class="fn-bunka" id="fn-bunka-0" data-radek="0"></button></td><td id="fn-kdyz-0" class="fn-kdyz"></td></tr>
				<tr><th scope="row">3</th><td>Bára</td><td><button type="button" class="fn-bunka" id="fn-bunka-1" data-radek="1"></button></td><td id="fn-kdyz-1" class="fn-kdyz"></td></tr>
				<tr><th scope="row">4</th><td>Cyril</td><td><button type="button" class="fn-bunka" id="fn-bunka-2" data-radek="2"></button></td><td id="fn-kdyz-2" class="fn-kdyz"></td></tr>
				<tr><th scope="row">5</th><td>Dana</td><td><button type="button" class="fn-bunka" id="fn-bunka-3" data-radek="3"></button></td><td id="fn-kdyz-3" class="fn-kdyz"></td></tr>
				<tr><th scope="row">6</th><td>Emil</td><td><button type="button" class="fn-bunka" id="fn-bunka-4" data-radek="4"></button></td><td id="fn-kdyz-4" class="fn-kdyz"></td></tr>
				<tr><th scope="row">7</th><td>Filip</td><td><button type="button" class="fn-bunka" id="fn-bunka-5" data-radek="5"></button></td><td id="fn-kdyz-5" class="fn-kdyz"></td></tr>
			</tbody>
		</table>
	</div>

	<p class="fn-radek">
		<button type="button" class="fn-tl" id="fn-reset">↺ vrátit na začátek</button>
		<span class="fn-napoveda">klik na známku = 1 → 2 → 3 → 4 → 5 → nehodnocen → prázdná → 1</span>
	</p>

	<table class="fn-vysledky">
		<caption class="fn-titulek">Co která funkce z toho sloupce vypíše</caption>
		<tbody>
			<tr><th scope="row">=SUMA(B2:B7)</th><td id="fn-suma"></td><td class="fn-pozn">sečte jen čísla</td></tr>
			<tr><th scope="row">=POČET(B2:B7)</th><td id="fn-pocet"></td><td class="fn-pozn">kolik buněk obsahuje číslo</td></tr>
			<tr class="fn-duraz"><th scope="row">=PRŮMĚR(B2:B7)</th><td id="fn-prumer"></td><td class="fn-pozn" id="fn-podil"></td></tr>
			<tr><th scope="row">=MIN(B2:B7)</th><td id="fn-min"></td><td class="fn-pozn">u známek ta <strong>nejlepší</strong></td></tr>
			<tr><th scope="row">=MAX(B2:B7)</th><td id="fn-max"></td><td class="fn-pozn">u známek ta <strong>nejhorší</strong></td></tr>
			<tr><th scope="row" id="fn-rank-vzorec"></th><td id="fn-rank"></td><td class="fn-pozn">kolikátý je Adam mezi ostatními</td></tr>
		</tbody>
	</table>

	<p class="fn-radek">
		<strong>Pořadí v RANK:</strong>
		<button type="button" class="fn-tl fn-volba fn-aktivni" data-poradi="1" aria-pressed="true">od nejmenší (;1)</button>
		<button type="button" class="fn-tl fn-volba" data-poradi="0" aria-pressed="false">od největší (bez údaje)</button>
	</p>

	<p class="fn-stav" id="fn-stav" aria-live="polite"></p>
</section>

<script>
	const teloEl = document.getElementById('fn-telo');
	const stavEl = document.getElementById('fn-stav');
	const btnReset = document.getElementById('fn-reset');
	const sumaEl = document.getElementById('fn-suma');
	const pocetEl = document.getElementById('fn-pocet');
	const prumerEl = document.getElementById('fn-prumer');
	const podilEl = document.getElementById('fn-podil');
	const minEl = document.getElementById('fn-min');
	const maxEl = document.getElementById('fn-max');
	const rankEl = document.getElementById('fn-rank');
	const rankVzorecEl = document.getElementById('fn-rank-vzorec');

	const JMENA = ['Adam', 'Bára', 'Cyril', 'Dana', 'Emil', 'Filip'];
	// Odečítač čte aria-label jako větu, takže tam patří 2. pád: „známka Adama", ne „známka Adam".
	const GENITIV = ['Adama', 'Báry', 'Cyrila', 'Dany', 'Emila', 'Filipa'];
	// Chybové kódy tak, jak je vypisuje ČESKÝ Excel — jiné dítě na obrazovce neuvidí.
	const KODY = { deleniNulou: '#DĚLENÍ_NULOU!', hodnota: '#HODNOTA!', neniK: '#N/A' };
	// Součet 18 při šesti známkách → průměr rovnou 3 (celé číslo, jak má být na začátku).
	const VYCHOZI = [1, 3, 2, 5, 2, 5];
	const TEXT = 'nehodnocen';
	const PRAZDNO = '';
	// Klikací kolečko: čísla, pak text, pak prázdná buňka — a zase od začátku.
	const KOLECKO = [1, 2, 3, 4, 5, TEXT, PRAZDNO];
	// Ve škole je 4 = dostatečný = PROSPĚL; neprospěl je až pětka. S mezí 3 tvrdila
	// stránka dětem nepravdu o jejich vlastním vysvědčení (nález kontrolora 2. 8. 2026).
	const MEZ_KDYZ = 4;

	/** České číslo: desetinná čárka, nejvýš dvě místa, celá čísla bez nul navíc. */
	function cz(n) {
		if (Number.isInteger(n)) return String(n);
		// Nuly navíc pryč („2,60" → „2,6"), a když nezbyde nic, ani ta čárka („2,00" → „2").
		return n.toFixed(2).replace(/0+$/, '').replace(/\.$/, '').replace('.', ',');
	}

	/** Zaokrouhlil se výsledek? Pak do věty nepatří „=", ale „≐" (přibližně rovno). */
	const presne = (n) => Number(cz(n).replace(',', '.')) === n;
	const rovnitko = (n) => (presne(n) ? '=' : '≐');

	const jeCislo = (h) => typeof h === 'number';
	const cisla = (b) => b.filter(jeCislo);

	// ——— funkce tabulkového procesoru; každá je čistá funkce seznamu buněk ———
	const SUMA = (b) => cisla(b).reduce((s, x) => s + x, 0);
	const POCET = (b) => cisla(b).length;
	// Chybové kódy píšeme tak, jak je vypíše ČESKÝ Excel (#DĚLENÍ_NULOU!, #HODNOTA!).
	// Anglické #DIV/0! dítě na své obrazovce neuvidí — a hláška by tvrdila něco jiného,
	// než co je v tabulce nad ní vidět (nález rozšířeného testu 3. 8. 2026).
	/** PRŮMĚR dělí POČTEM ČÍSEL, ne počtem řádků. Bez čísel hlásí tabulka #DĚLENÍ_NULOU!. */
	const PRUMER = (b) => (POCET(b) === 0 ? null : SUMA(b) / POCET(b));
	const MIN = (b) => (POCET(b) === 0 ? 0 : Math.min(...cisla(b)));
	const MAX = (b) => (POCET(b) === 0 ? 0 : Math.max(...cisla(b)));
	/**
	 * RANK: kolikátá je hodnota mezi ostatními. Třetí údaj 1 = od nejmenší
	 * (u známek správně), bez něj (0) se řadí od největší — a nejhorší známka
	 * by pak vyšla jako první místo.
	 */
	function RANK(hodnota, b, poradi) {
		// Text porovnat nejde — Excel na to hlásí #HODNOTA!.
		if (!jeCislo(hodnota) && hodnota !== PRAZDNO) return KODY.hodnota;
		const c = cisla(b);
		// Prázdná buňka se bere jako nula. Nula ale mezi známkami není, takže RANK
		// hlásí #N/A — „takovou hodnotu jsem v seznamu nenašel". Jiný kód než u textu!
		const h = hodnota === PRAZDNO ? 0 : hodnota;
		if (!c.includes(h)) return KODY.neniK;
		const lepsich = poradi === 1 ? c.filter((x) => x < h) : c.filter((x) => x > h);
		return lepsich.length + 1;
	}
	/**
	 * =KDYŽ(B2<=4;"prospěl";"neprospěl"). Pozor na dvě pravidla tabulek:
	 * prázdná buňka se v porovnání bere jako NULA, a text je větší než každé číslo.
	 */
	const KDYZ = (h) => (jeCislo(h) ? h <= MEZ_KDYZ : h === PRAZDNO) ? 'prospěl' : 'neprospěl';

	let bunky = [...VYCHOZI];
	let poradi = 1;
	let posledni = null;   // hodnota, na kterou se naposledy klikla buňka (null = po ↺)

	const zobraz = (h) => (h === PRAZDNO ? '' : String(h));

	function prekresli() {
		bunky.forEach((h, i) => {
			const b = document.getElementById('fn-bunka-' + i);
			b.textContent = zobraz(h);
			b.className = 'fn-bunka' + (h === TEXT ? ' fn-text' : h === PRAZDNO ? ' fn-prazdna' : '');
			b.setAttribute('aria-label', `známka ${GENITIV[i]}: ${h === PRAZDNO ? 'prázdná buňka' : h}`);
			const k = document.getElementById('fn-kdyz-' + i);
			const vysledek = KDYZ(h);
			k.textContent = vysledek;
			k.className = 'fn-kdyz' + (vysledek === 'prospěl' ? ' fn-ano' : ' fn-ne');
		});

		const pocet = POCET(bunky);
		const prumer = PRUMER(bunky);
		sumaEl.textContent = cz(SUMA(bunky));
		pocetEl.textContent = cz(pocet);
		prumerEl.textContent = prumer === null ? KODY.deleniNulou : cz(prumer);
		podilEl.textContent = prumer === null
			? 'bez jediného čísla se dělit nedá'
			// Dokud mají číslo všechny řádky, je „ne šesti řádky" matoucí — dělí se právě šesti.
			: pocet === bunky.length
				? `dělí se ${cz(SUMA(bunky))} ÷ ${cz(pocet)} — POČTEM ČÍSEL, teď je má každý řádek`
				: `dělí se ${cz(SUMA(bunky))} ÷ ${cz(pocet)} — POČTEM ČÍSEL, ne ${cz(bunky.length)} řádky`;
		minEl.textContent = cz(MIN(bunky));
		maxEl.textContent = cz(MAX(bunky));

		const r = RANK(bunky[0], bunky, poradi);
		rankVzorecEl.textContent = poradi === 1 ? '=RANK(B2;$B$2:$B$7;1)' : '=RANK(B2;$B$2:$B$7)';
		// Ve sloupci stojí to, co by vypsala tabulka: RANK vrací číslo, ne „1." s tečkou.
		rankEl.textContent = typeof r === 'number' ? cz(r) : r;
	}

	function popisStavu() {
		const pocet = POCET(bunky);
		if (pocet === 0) {
			return `Ve sloupci nezůstalo <strong>jediné číslo</strong>, takže PRŮMĚR hlásí <strong>${KODY.deleniNulou}</strong> — `
				+ 'dělit nulou nejde. MIN a MAX přitom klidně vypíšou nulu, i když žádná známka není.';
		}
		if (posledni === TEXT) {
			return `Do buňky je zapsané slovo <strong>„${TEXT}“</strong>. V tabulce to vypadá jako vyplněný řádek, `
				+ `ale <strong>POČET klesl na ${cz(pocet)}</strong> — a PRŮMĚR se proto dělí ${cz(pocet)}, ne šesti. `
				+ `A protože text je v porovnání větší než každé číslo, KDYŽ napsalo <strong>neprospěl</strong>.`;
		}
		if (posledni === PRAZDNO) {
			return `Buňka je <strong>prázdná</strong>, takže do POČTU nejde (${cz(pocet)}). `
				+ 'Ale pozor na sloupec C: v porovnání se prázdná buňka bere jako <strong>nula</strong>, '
				+ `takže =KDYŽ(B&lt;=${MEZ_KDYZ};…) napsalo <strong>prospěl</strong> i tomu, komu známku nikdo nezapsal.`;
		}
		if (pocet < bunky.length) {
			return `Čísla jsou jen v <strong>${cz(pocet)}</strong> buňkách ze ${cz(bunky.length)}, takže PRŮMĚR dělí ${cz(pocet)}. `
				+ 'Právě tohle bývá důvod, proč tabulce vychází jiný průměr než tobě na papíře.';
		}
		// Čísla se do věty POČÍTAJÍ, nepíšou natvrdo: tahle větev platí i po změně známky,
		// a „18 ÷ 6 = 3" by pak tvrdilo něco jiného, než je o dva centimetry výš v panelu.
		return `Číslo má všech <strong>${cz(bunky.length)}</strong> buněk, takže POČET je ${cz(pocet)} `
			+ `a průměr vyjde <strong>${cz(SUMA(bunky))} ÷ ${cz(pocet)} ${rovnitko(PRUMER(bunky))} ${cz(PRUMER(bunky))}</strong>. `
			+ 'Zkus teď některou známku přepnout na <strong>nehodnocen</strong> nebo ji vymazat.';
	}

	function ukazStav() {
		stavEl.innerHTML = popisStavu();
	}

	for (const b of document.querySelectorAll('.fn-bunka')) {
		b.addEventListener('click', () => {
			const i = Number(b.dataset.radek);
			const kde = KOLECKO.indexOf(bunky[i]);
			const nova = KOLECKO[(kde + 1) % KOLECKO.length];
			posledni = nova;
			bunky[i] = nova;
			prekresli();
			ukazStav();
		});
	}

	btnReset.addEventListener('click', () => {
		bunky = [...VYCHOZI];
		posledni = null;
		// Vrací se i přepínač pořadí — jinak tlačítko slibuje „na začátek", ale Adam
		// zůstane šestý podle staré volby (nález kontrolora 3. 8. 2026).
		poradi = 1;
		for (const j of document.querySelectorAll('.fn-volba')) {
			const zvolena = Number(j.dataset.poradi) === poradi;
			j.classList[zvolena ? 'add' : 'remove']('fn-aktivni');
			j.setAttribute('aria-pressed', zvolena ? 'true' : 'false');
		}
		prekresli();
		ukazStav();
	});

	for (const v of document.querySelectorAll('.fn-volba')) {
		v.addEventListener('click', () => {
			for (const j of document.querySelectorAll('.fn-volba')) {
				j.classList.remove('fn-aktivni');
				j.setAttribute('aria-pressed', 'false');
			}
			v.classList.add('fn-aktivni');
			v.setAttribute('aria-pressed', 'true');
			poradi = Number(v.dataset.poradi);
			prekresli();
			// Přepínač nemění data, jen vzorec — hláška o poslední změně buňky by proto
			// zůstala viset u něčeho, co se právě nestalo.
			stavEl.innerHTML = poradi === 1
				? 'S třetím údajem <strong>;1</strong> se pořadí počítá <strong>od nejmenší</strong> hodnoty — '
					+ 'u známek správně, protože nejlepší je jednička.'
				: 'Bez třetího údaje řadí RANK <strong>od největší</strong>, takže by u známek vyšla '
					+ '<strong>nejhorší</strong> jako první místo. Všimni si, jak Adamovi skočilo pořadí.';
		});
	}

	prekresli();
	ukazStav();

	// ——— háčky pro test bez prohlížeče (ukazují na TÝŽ kód, který počítá tabulku) ———
	teloEl.__SUMA = SUMA;
	teloEl.__POCET = POCET;
	teloEl.__PRUMER = PRUMER;
	teloEl.__MIN = MIN;
	teloEl.__MAX = MAX;
	teloEl.__RANK = RANK;
	teloEl.__KDYZ = KDYZ;
	teloEl.__cz = cz;
	teloEl.__bunky = () => bunky;
	teloEl.__poradi = () => poradi;
	teloEl.__meze = { JMENA, GENITIV, VYCHOZI, TEXT, PRAZDNO, KOLECKO, MEZ_KDYZ, KODY };
</script>

<style>
	.fn-obal { overflow-x: auto; }
	.fn-tabulka { border-collapse: collapse; margin: 0.5rem 0; font-size: 0.98rem; }
	.fn-tabulka th, .fn-tabulka td { border: 2px solid #868e96; padding: 0.25rem 0.6rem; text-align: left; }
	.fn-tabulka thead th { background: #e9ecef; font-size: 0.86rem; }
	.fn-tabulka tbody th { background: #e9ecef; text-align: center; font-weight: 700; }
	.fn-bunka { font: inherit; font-weight: 700; min-width: 6.5rem; padding: 0.15rem 0.5rem; border: 2px solid #2b2a26; border-radius: 6px; background: #fff; cursor: pointer; }
	.fn-bunka.fn-text { background: #ffe3e3; font-weight: 400; font-style: italic; }
	/* Prázdná buňka musí být poznat, i když v ní nic není — jinak vypadá jako chyba vykreslení.
	   Šrafa proto musí mít proti bílé kontrast aspoň 3 : 1 (grafický prvek nesoucí informaci);
	   původní #dee2e6 mělo 1,30 : 1 a na promítačce zmizelo úplně. */
	.fn-bunka.fn-prazdna { background: repeating-linear-gradient(45deg, #fff, #fff 5px, #868e96 5px, #868e96 10px); }
	.fn-kdyz.fn-ano { color: #1b7a33; font-weight: 700; }
	.fn-kdyz.fn-ne { color: #a61e1e; font-weight: 700; }
	.fn-vysledky { border-collapse: collapse; margin: 0.6rem 0; }
	.fn-vysledky th { text-align: left; font-family: ui-monospace, monospace; padding: 0.2rem 0.7rem 0.2rem 0; }
	.fn-vysledky td { padding: 0.2rem 0.7rem; font-weight: 700; }
	.fn-vysledky tr.fn-duraz { background: #fff3bf; }
	.fn-vysledky .fn-pozn { font-weight: 400; font-size: 0.9rem; color: #495057; }
	.fn-radek { margin: 0.5rem 0; }
	.fn-tl { font: inherit; font-weight: 700; padding: 0.25rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.35rem 0.35rem 0; }
	.fn-tl.fn-aktivni { background: #ffe8cc; box-shadow: inset 0 0 0 2px #2b2a26; }
	.fn-tl.fn-aktivni::before { content: '✓ '; }
	.fn-napoveda { font-size: 0.9rem; color: #495057; }
	/* Vzorec v hlavičce platí pro celý sloupec, ne jen pro řádek 2 — proto ta poznámka. */
	.fn-kopie { font-weight: 400; font-style: italic; white-space: nowrap; }
	/* Titulek tabulky: odečítač jinak předčítá poznámkový sloupec bez jakékoli hlavičky. */
	.fn-titulek { text-align: left; font-weight: 700; padding-bottom: 0.3rem; }
	.fn-stav { font-size: 1.05rem; font-weight: 700; min-height: 3.4rem; }
</style>
