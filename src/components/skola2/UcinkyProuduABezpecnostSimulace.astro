		<circle id="upb-b-ruka-p" cx="360" cy="85" r="9" fill="#4dabf7" stroke="#2b2a26" stroke-width="3" />
		<line x1="228" y1="205" x2="222" y2="280" stroke="#2b2a26" stroke-width="4" />
		<circle id="upb-b-noha-l" cx="220" cy="283" r="8" fill="#ced4da" stroke="#868e96" stroke-width="2" />
		<line x1="272" y1="205" x2="280" y2="280" stroke="#2b2a26" stroke-width="4" />
