---
// Třecí síla (F7): bedna na podlaze. Posuvníky hmotnosti (10–50 kg po 10)
// a tažné síly (0–400 N po 5), výběr dvojice materiálů. Stejné vzorce jako ve výkladu:
// Fn = Fg = m·10, Ft = Fn·f. Součinitele (v klidu / při pohybu) jsou PŘESNĚ z tabulky
// výkladu (temata.ts, podtéma třecí síla): dřevo na dřevě 0,65 / 0,30, ocel na dřevě
// 0,55 / 0,35 (= řešený příklad 50 kg → Ft = 500 · 0,35 = 175 N), ocel na oceli
// 0,15 / 0,10. Oprava 3. 10. 2026: dřív dřevo 0,5 / 0,4 a led/beton bez opory ve výkladu.
// Fn je násobek 100 → všechny meze vychází v celých newtonech (násobcích 5). Stavový automat drží hysterezi:
// bedna se utrhne až nad mezí klidového tření, ale zastaví se, teprve když
// síla klesne POD smykové tření — přesně jev „utrženou skříň už tlačíš snáz".
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Utrhni bednu — klidové × smykové tření 🕹️</span></h2>
	<p>Táhni za bednu a sleduj <strong>třecí sílu</strong>. Dokud bedna stojí, klidové tření tvou sílu přesně dorovnává. Utrhne se, až zatáhneš víc než mez — a pak už k pohybu stačí síla menší!</p>
	<p id="treni-povrchy">
		<button type="button" class="treni-tl treni-aktivni" data-povrch="drevo">🪵 dřevo na dřevě</button>
		<button type="button" class="treni-tl" data-povrch="ocel-drevo">🔩 ocel na dřevě</button>
		<button type="button" class="treni-tl" data-povrch="ocel">⚙️ ocel na oceli</button>
	</p>
	<svg id="treni-svg" viewBox="0 0 660 300" role="img" aria-label="Bedna tažená po podlaze a síly, které na ni působí">
		<!-- podlaha -->
		<rect id="treni-podlaha" x="0" y="220" width="660" height="80" fill="#deb887" stroke="#2b2a26" stroke-width="3" />
		<text id="treni-podlaha-text" x="330" y="268" text-anchor="middle" font-size="15" font-weight="bold" fill="#2b2a26"></text>
		<!-- bedna -->
		<g id="treni-bedna">
			<rect id="treni-bedna-rect" x="270" y="120" width="120" height="100" fill="#ffd8a8" stroke="#2b2a26" stroke-width="3.5" rx="6" />
			<line x1="270" y1="150" x2="390" y2="150" stroke="#2b2a26" stroke-width="2" />
			<text id="treni-bedna-text" x="330" y="192" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26"></text>
		</g>
		<!-- pohybové čárky -->
		<!-- čárky leží POD šipkou třecí síly (y 190–214), ne přes ni (oprava 3. 10. 2026, kolo 2) -->
		<g id="treni-pohyb" stroke="#868e96" stroke-width="3" opacity="0" stroke-linecap="round">
			<line x1="230" y1="190" x2="255" y2="190" /><line x1="220" y1="202" x2="252" y2="202" /><line x1="232" y1="214" x2="256" y2="214" />
		</g>
		<!-- síly: šipka vychází z hrany bedny; popisek stojí NAD šipkou, celý MIMO obrys bedny
			(F od x 398 doprava, Ft končí na x 262) — dřív ležel v půlce krátké šipky přes obrys -->
		<!-- šipka = jeden tvar (dřík + hrot), její špička leží PŘESNĚ F·k od hrany bedny (oprava 3. 10. 2026, kolo 3) -->
		<!-- šipka začíná VNĚ obrysu bedny (hrana + polovina tloušťky čáry), aby neležela přes černý obrys (oprava 3. 10. 2026, kolo 4) -->
		<path id="treni-sipka-f" d="M391.75,170 Z" fill="#1971c2" visibility="hidden" />
		<path id="treni-sipka-t" d="M268.25,170 Z" fill="#c92a2a" visibility="hidden" />
		<!-- velikost síly stojí číslem přímo u šipky; písmo 32 = na telefonu 375 px (scéna ~263 px, 0,40×) asi 12,7 px,
			takže i u vlásečnicově krátké šipky (5 N) je hodnota čitelná (oprava 3. 10. 2026, kolo 5: kroužek zrušen) -->
		<text id="treni-pop-f" x="398" y="150" font-size="32" font-weight="bold" fill="#1971c2" text-anchor="start"></text>
		<text id="treni-pop-t" x="262" y="150" font-size="32" font-weight="bold" fill="#c92a2a" text-anchor="end"></text>
		<text x="14" y="26" font-size="14" font-weight="bold" fill="#1971c2">→ tažná síla F</text>
		<text x="14" y="46" font-size="14" font-weight="bold" fill="#c92a2a">← třecí síla Ft</text>
	</svg>
	<!-- legenda pro telefon (≤ 600 px): scéna je tam zmenšená ~0,39×, popisky sil by měly ~6 px -->
	<p class="treni-mobil" id="treni-mobil" data-mobil-obraz></p>
	<label class="sim-posuvnik">
		Hmotnost bedny: <output id="treni-out-m"></output>
		<input type="range" id="treni-slider-m" min="10" max="50" step="10" value="20" />
	</label>
	<label class="sim-posuvnik">
		Tažná síla F: <output id="treni-out-f"></output>
		<input type="range" id="treni-slider-f" min="0" max="400" step="5" value="0" />
	</label>
	<p class="treni-vzorec" id="treni-vypocet"></p>
	<p class="treni-stav" id="treni-stav"></p>
</section>

<script>
	const POVRCHY = {
		// hodnoty z tabulky výkladu (v klidu / při pohybu); bedna a podlaha mají barvu materiálu
		drevo: { nazev: 'DŘEVO NA DŘEVĚ', fKlid: 0.65, fSmyk: 0.3, barva: '#deb887', bedna: '#ffd8a8' },
		'ocel-drevo': { nazev: 'OCEL NA DŘEVĚ', fKlid: 0.55, fSmyk: 0.35, barva: '#deb887', bedna: '#ced4da' },
		ocel: { nazev: 'OCEL NA OCELI', fKlid: 0.15, fSmyk: 0.1, barva: '#adb5bd', bedna: '#ced4da' },
	};
	let povrch = 'drevo';
	let pohyb = false;

	const sliderM = document.getElementById('treni-slider-m');
	const sliderF = document.getElementById('treni-slider-f');
	const outM = document.getElementById('treni-out-m');
	const outF = document.getElementById('treni-out-f');
	const vypocetEl = document.getElementById('treni-vypocet');
	const stavEl = document.getElementById('treni-stav');
	const povrchyEl = document.getElementById('treni-povrchy');
	const cz = (n) => n.toFixed(2).replace('.', ','); // jako v tabulce výkladu: 0,30 · 0,65

	function prekresli() {
		const m = +sliderM.value;
		const F = +sliderF.value;
		const p = POVRCHY[povrch];
		const Fn = m * 10;                             // Fn = Fg = m·g, g je 10 N/kg
		const mezKlid = Math.round(p.fKlid * Fn);      // vždy celé (Fn násobek 100)
		const FtSmyk = Math.round(p.fSmyk * Fn);

		// hystereze: utrhne se nad mezí klidu, zastaví až pod smykovým třením
		if (!pohyb && F > mezKlid) pohyb = true;
		if (pohyb && F < FtSmyk) pohyb = false;
		const Ft = pohyb ? FtSmyk : Math.min(F, mezKlid);

		outM.textContent = m + ' kg';
		outF.textContent = F + ' N';
		document.getElementById('treni-bedna-text').textContent = m + ' kg';
		document.getElementById('treni-podlaha').setAttribute('fill', p.barva);
		document.getElementById('treni-bedna-rect').setAttribute('fill', p.bedna);
		const podlahaText = `${p.nazev} (f = ${cz(p.fSmyk)} · v klidu ${cz(p.fKlid)})`;
		document.getElementById('treni-podlaha-text').textContent = podlahaText;
		// šipky (oprava 3. 10. 2026, kolo 3): délka od hrany bedny po špičku je PŘÍMO úměrná síle,
		// 0,65 px na newton, stejné měřítko pro F i Ft (80 N a 50 N dají 52 a 32,5 px, poměr 1,6), bez pevného
		// přídavku. Hrot je dlouhý 16 px; u kratší šipky (malá síla) je hrot zkrácený na celou délku
		// a zůstává 18 px vysoký. Takový klínek je na telefonu jen vlásek — proto u každé šipky stojí
		// její velikost číslem velkým písmem a legenda to řekne slovy (kolo 5: kroužek zrušen, šipku
		// neobkroužil a legenda „šipka v kroužku“ nebyla pravdivá). Nulová síla = šipka skrytá.
		// Nejdelší šipky se vejdou do scény — hlídá test.
		const k = 0.65;
		const HROT = 16;
		const kratka = (delka) => delka > 0 && delka < HROT;
		const VYSVETLENI = 'Malé síly mají krátkou šipku – velikost síly je napsaná u šipky.';
		// hodnota síly v legendě drží pohromadě pevnými mezerami (na úzkém telefonu se jinak láme mezi číslem a N)
		const nb = (t) => t.replaceAll(' ', String.fromCharCode(160));
		// tření nikdy nepřeroste tah (Ft ≤ F), takže nejkratší viditelná šipka je vždy Ft
		const jeKratka = kratka(Ft * k);
		document.getElementById('treni-mobil').textContent = `${F > 0 ? `${nb(`F = ${F} N`)} (modrá šipka, tažná) · ` : ''}${Ft > 0 ? `${nb(`Ft = ${Ft} N`)} (červená šipka, třecí) · ` : ''}bedna ${m} kg · ${podlahaText}${jeKratka ? ' · ' + VYSVETLENI : ''}`;
		document.getElementById('treni-pohyb').setAttribute('opacity', pohyb ? '0.9' : '0');

		const r2 = (x) => Math.round(x * 100) / 100;
		const tvarSipky = (x0, smer, delka) => {
			const h = Math.min(HROT, delka), spicka = r2(x0 + smer * delka), patka = r2(x0 + smer * (delka - h));
			return delka > h
				? `M${x0},166.5 L${patka},166.5 L${patka},161 L${spicka},170 L${patka},179 L${patka},173.5 L${x0},173.5 Z`
				: `M${x0},161 L${spicka},170 L${x0},179 Z`;
		};
		const sipkaF = document.getElementById('treni-sipka-f');
		sipkaF.setAttribute('d', tvarSipky(391.75, 1, F * k));
		sipkaF.setAttribute('visibility', F > 0 ? 'visible' : 'hidden');
		document.getElementById('treni-pop-f').textContent = F > 0 ? 'F = ' + F + ' N' : '';
		const sipkaT = document.getElementById('treni-sipka-t');
		sipkaT.setAttribute('d', tvarSipky(268.25, -1, Ft * k));
		sipkaT.setAttribute('visibility', Ft > 0 ? 'visible' : 'hidden');
		document.getElementById('treni-pop-t').textContent = Ft > 0 ? 'Ft = ' + Ft + ' N' : '';

		vypocetEl.innerHTML = `Fn = Fg = ${m} · 10 = <strong>${Fn} N</strong> &nbsp;·&nbsp; mez klidového tření = ${cz(p.fKlid)} × ${Fn} = <strong>${mezKlid} N</strong> &nbsp;·&nbsp; smykové Ft = ${cz(p.fSmyk)} × ${Fn} = <strong>${FtSmyk} N</strong>`;

		if (!pohyb) {
			if (F === 0) stavEl.textContent = '👉 Zatáhni posuvníkem tažné síly.';
			else stavEl.textContent = `🧍 Bedna STOJÍ — klidové tření tvou sílu přesně dorovnává (Ft = ${Ft} N). Utrhne se, až zatáhneš víc než ${mezKlid} N.`;
		} else if (F > FtSmyk) {
			stavEl.textContent = `🏃 Bedna ZRYCHLUJE — F (${F} N) je větší než smykové tření (${FtSmyk} N). Všimni si: k udržení pohybu stačí míň síly než k utržení!`;
		} else {
			stavEl.textContent = `➡️ Bedna se pohybuje ROVNOMĚRNĚ — síly jsou v rovnováze (F = Ft = ${FtSmyk} N). Klesneš-li pod ${FtSmyk} N, bedna zastaví.`;
		}
	}

	povrchyEl.addEventListener('click', (e) => {
		const tl = e.target.closest('.treni-tl');
		if (!tl) return;
		povrch = tl.dataset.povrch;
		pohyb = false;
		for (const b of povrchyEl.querySelectorAll('.treni-tl')) b.classList.toggle('treni-aktivni', b === tl);
		prekresli();
	});
	sliderM.addEventListener('input', () => { pohyb = false; prekresli(); });
	sliderF.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#treni-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.treni-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.treni-tl.treni-aktivni { background: #ffe8cc; }
	.treni-tl:active { transform: translateY(1px); }
	.treni-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
	.treni-mobil { display: none; }
	@media (max-width: 600px) {
		.treni-mobil { display: block; font-size: 1rem; font-weight: 700; line-height: 1.45; color: #2b2a26; margin: 0.5rem 0; padding: 0.4rem 0.6rem; background: #fff; border: 2px solid #2b2a26; border-radius: 8px; }
	}
	.treni-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
</style>
