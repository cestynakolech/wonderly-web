---
// Vlastnosti střídavého proudu (F9, indukce-a-stridavy-proud). NEDUPLIKUJE
// Alternátor (ten ukazuje VZNIK střídavého napětí otáčením cívky) — tahle
// komponenta učí VLASTNOSTI hotového průběhu ze zásuvky.
//
// Scéna A „Perioda a frekvence": osciloskop se sinusoidou. ČASOVÉ OKNO JE
// PEVNÉ 0–40 ms u všech tří frekvencí (tickové popisky se proto NEMĚNÍ) —
// mění se počet vlnek: 25 Hz → 1 perioda vyplní celé okno, 50 Hz → 2, 100 Hz
// → 4. Právě tahle „hustota" je to, co má simulace ukázat; okno odvozené od
// T (jak to bylo v předchozí verzi) tuhle změnu schovávalo, protože se s ním
// škálovalo i měřítko. Svorka T se podle zvolené frekvence zkracuje/
// prodlužuje (v px = T[ms] × 14, 14 = 560 px / 40 ms).
//
// Scéna B „Efektivní a maximální hodnota": sinusoida napětí sítě s vrcholem
// 325 V a vodorovnou čarou efektivní hodnoty 230 V. Posuvník posouvá bod PO
// KŘIVCE v krocích po 5 ms (0/5/10/15/20 → okamžité napětí vždy vyjde celé:
// 0, 325, 0, −325, 0 V) — žák vidí, jak se okamžitá hodnota mění a dvakrát
// za periodu prochází nulou, zatímco DVĚ ŽÁROVKY (~230 V efektivních a
// =230 V stejnosměrných) svítí/hřejí POŘÁD STEJNĚ — jejich jas je na
// posuvníku záměrně NEZÁVISLÝ, to je ta klíčová pointa.
//
// Obě sinusoidy se POČÍTAJÍ (jemné vzorkování po 0,2 ms), NE ruční výpisy
// bodů — ty se v první verzi spletly a vykreslily plochý „useknutý" vrchol
// místo špičaté sinusoidy. Popisky časových os sedí na BÍLÉ PLAKETĚ
// nakreslené AŽ PO křivce (tedy nad ní v pořadí vykreslování), takže je
// křivka nikdy nepřekryje ani neuseknte — stejný trik jako jinde na webu.
//
// Čísla se drží výkladu (temata.ts, „vlastnosti-stridaveho-proudu"): 230 V,
// 50 Hz, 325 V (≈230·1,4), T = 0,02 s = 20 ms.
//
// Kreslí se staticky (přepočet při každé změně tlačítka/posuvníku), bez
// requestAnimationFrame — stejně jako Dioda/Transformátor/MagnetyOpakovani.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vlastnosti střídavého proudu 🕹️</span></h2>
	<p>
		Proud ze zásuvky se pravidelně <strong>opakuje</strong> — grafem je
		<strong>sinusoida</strong>. Na dvou pokusech si vyzkoušej, co znamená
		<strong>perioda</strong>, <strong>frekvence</strong> a proč přístroje
		měří <strong>efektivní</strong>, ne okamžitou hodnotu.
	</p>

	<h3><span class="podtrh">📈 Scéna A: Perioda a frekvence</span></h3>
	<p>
		<strong>Perioda T</strong> je doba jednoho opakování, <strong>frekvence
		f</strong> je počet opakování za sekundu; platí <strong>T = 1 / f</strong>.
		Okno osciloskopu ukazuje pořád stejných <strong>40 ms</strong> — přepni
		frekvenci a sleduj, jak se do něj vejde jednou tolik, nebo naopak
		čtyřikrát tolik vlnek.
	</p>
	<svg id="sp-a-svg" viewBox="0 0 660 380" role="img" aria-label="Osciloskop se sinusoidou střídavého napětí, pevné okno 0 až 40 milisekund">
		<rect x="0" y="0" width="660" height="380" fill="#f8f9fa" />
		<!-- osy -->
		<g stroke="#495057" stroke-width="2">
			<line x1="70" y1="60" x2="70" y2="310" />
			<line x1="45" y1="195" x2="650" y2="195" />
		</g>
		<polygon points="70,55 65,66 75,66" fill="#495057" />
		<polygon points="650,195 639,190 639,200" fill="#495057" />
		<!-- popisky os v HORNÍM pruhu — sinusoida nikdy nepřesáhne y=95, takže
			je tady (y≈61–79) navždy bez ohledu na frekvenci čisto -->
		<text x="52" y="70" font-size="13" font-weight="bold" fill="#2b2a26">U</text>
		<text id="sp-a-dc-label" x="95" y="70" font-size="12" font-weight="bold" fill="#f08c00" visibility="hidden">U (stejnosměrné — v čase se nemění)</text>
		<text x="560" y="70" font-size="13" font-weight="bold" fill="#2b2a26">t (ms)</text>
		<!-- drobné rysky na časové ose (u nulové linky, kříží se s křivkou jen
			okrajově — to nevadí, jde o tenké orientační rysky, ne popisek) -->
		<g stroke="#adb5bd" stroke-width="2">
			<line x1="70" y1="190" x2="70" y2="200" />
			<line x1="210" y1="190" x2="210" y2="200" />
			<line x1="350" y1="190" x2="350" y2="200" />
			<line x1="490" y1="190" x2="490" y2="200" />
			<line x1="630" y1="190" x2="630" y2="200" />
		</g>
		<!-- volitelná čára stejnosměrného napětí (srovnání tvaru, ne velikosti):
			úroveň ~70 % maxima, uvnitř rozsahu sinusoidy — schválně kříží křivku,
			to je u srovnávací čáry normální (stejně jako Uef v scéně B) -->
		<line id="sp-a-dc" x1="70" y1="125" x2="630" y2="125" stroke="#f08c00" stroke-width="3" stroke-dasharray="8 6" visibility="hidden" />
		<!-- sinusoida střídavého napětí: POČÍTANÁ (bodySinusoidyA), husté
			vzorkování po 0,2 ms — žádné ruční body -->
		<polyline id="sp-a-sinus" fill="none" stroke="#1971c2" stroke-width="4" stroke-linejoin="round" />
		<!-- popisky tiků NA BÍLÉ PLAKETĚ, kreslené AŽ PO křivce (tedy nad ní) -->
		<g>
			<rect x="57" y="206" width="26" height="17" rx="4" fill="#f8f9fa" />
			<rect x="197" y="206" width="26" height="17" rx="4" fill="#f8f9fa" />
			<rect x="337" y="206" width="26" height="17" rx="4" fill="#f8f9fa" />
			<rect x="477" y="206" width="26" height="17" rx="4" fill="#f8f9fa" />
			<rect x="617" y="206" width="26" height="17" rx="4" fill="#f8f9fa" />
		</g>
		<g font-size="12" fill="#495057" text-anchor="middle">
			<text x="70" y="219">0</text>
			<text x="210" y="219">10</text>
			<text x="350" y="219">20</text>
			<text x="490" y="219">30</text>
			<text x="630" y="219">40</text>
		</g>
		<!-- svorka jedné periody — délka se mění podle frekvence (id sp-a-t-*) -->
		<g stroke="#e8590c" stroke-width="2">
			<line x1="70" y1="315" x2="70" y2="325" />
			<line id="sp-a-t-konec" x1="350" y1="315" x2="350" y2="325" />
			<line id="sp-a-t-cara" x1="70" y1="320" x2="350" y2="320" />
		</g>
		<text id="sp-a-t-popisek" x="210" y="343" text-anchor="middle" font-size="15" font-weight="bold" fill="#e8590c">T</text>
	</svg>
	<p class="sp-radek">
		<strong>Frekvence:</strong>
		<button type="button" class="sp-tl sp-a-f-tl sp-aktivni" id="sp-a-f50" data-f="50">50 Hz (síť)</button>
		<button type="button" class="sp-tl sp-a-f-tl" id="sp-a-f25" data-f="25">25 Hz</button>
		<button type="button" class="sp-tl sp-a-f-tl" id="sp-a-f100" data-f="100">100 Hz</button>
	</p>
	<p><button type="button" class="sp-tl" id="sp-a-dc-tl">➕ přidat stejnosměrné napětí pro srovnání</button></p>
	<p class="sp-vzorec" id="sp-a-vzorec"></p>
	<p class="sp-stav" id="sp-a-stav"></p>

	<h3><span class="podtrh">💡 Scéna B: Efektivní a maximální hodnota</span></h3>
	<p>
		Napětí v zásuvce má <strong>maximum U<sub>m</sub> ≈ 325 V</strong>, ale
		přístroje ukazují <strong>efektivní hodnotu 230 V</strong> — tu, která
		hřeje/svítí <strong>stejně</strong> jako stejnosměrných 230 V. Posouvej
		bod po křivce a sleduj, jak se mění OKAMŽITÁ hodnota, zatímco obě
		žárovky svítí pořád stejně.
	</p>
	<svg id="sp-b-svg" viewBox="0 0 760 400" role="img" aria-label="Sinusoida napětí sítě s vyznačeným maximem 325 V a efektivní hodnotou 230 V, vedle dvě srovnávací žárovky">
		<rect x="0" y="0" width="760" height="400" fill="#f8f9fa" />
		<!-- osy grafu -->
		<g stroke="#495057" stroke-width="2">
			<line x1="60" y1="60" x2="60" y2="360" />
			<line x1="40" y1="210" x2="400" y2="210" />
		</g>
		<polygon points="60,55 55,66 65,66" fill="#495057" />
		<polygon points="400,210 389,205 389,215" fill="#495057" />
		<text x="20" y="70" font-size="13" font-weight="bold" fill="#2b2a26">U (V)</text>
		<text x="395" y="230" font-size="12" font-weight="bold" fill="#2b2a26">t (ms)</text>
		<!-- maximum a efektivní hodnota (popisky mimo dosah křivky, x ≥ 390) -->
		<line x1="60" y1="80" x2="380" y2="80" stroke="#e03131" stroke-width="2.5" stroke-dasharray="7 5" />
		<text x="390" y="84" font-size="13" font-weight="bold" fill="#e03131">Uₘ = 325 V (maximum)</text>
		<line x1="60" y1="118" x2="380" y2="118" stroke="#2f9e44" stroke-width="2.5" stroke-dasharray="7 5" />
		<text x="390" y="122" font-size="13" font-weight="bold" fill="#2f9e44">U = 230 V (efektivní)</text>
		<!-- sinusoida napětí sítě: POČÍTANÁ (bodySinusoidyB), T = 20 ms,
			amplituda 325 V, vzorkováno po 0,2 ms — žádné ruční body -->
		<polyline id="sp-b-sinus" fill="none" stroke="#1971c2" stroke-width="4" stroke-linejoin="round" />
		<!-- průchody nulou (2× za periodu), kreslené AŽ PO křivce -->
		<circle cx="60" cy="210" r="5" fill="#495057" />
		<circle cx="220" cy="210" r="5" fill="#495057" />
		<circle cx="380" cy="210" r="5" fill="#495057" />
		<!-- popisky tiků na BÍLÉ PLAKETĚ, AŽ PO křivce -->
		<g>
			<rect x="48" y="219" width="24" height="16" rx="3" fill="#f8f9fa" />
			<rect x="128" y="219" width="24" height="16" rx="3" fill="#f8f9fa" />
			<rect x="208" y="219" width="24" height="16" rx="3" fill="#f8f9fa" />
			<rect x="288" y="219" width="24" height="16" rx="3" fill="#f8f9fa" />
			<rect x="368" y="219" width="24" height="16" rx="3" fill="#f8f9fa" />
		</g>
		<g font-size="12" fill="#495057" text-anchor="middle">
			<text x="60" y="231">0</text>
			<text x="140" y="231">5</text>
			<text x="220" y="231">10</text>
			<text x="300" y="231">15</text>
			<text x="380" y="231">20</text>
		</g>
		<!-- popisek POD prvním úsekem křivky (0–5 ms), kde jde vždy jen nahoru
			od nuly — jinde by ho klesající/stoupající větev křivky překrývala -->
		<text x="68" y="255" text-anchor="start" font-size="11" fill="#495057">u = 0 V — nastává 2× za periodu</text>
		<!-- pohyblivý bod podle posuvníku -->
		<circle id="sp-b-bod" r="8" fill="#f08c00" stroke="#2b2a26" stroke-width="2" />
		<text id="sp-b-u-okamzite" font-size="13" font-weight="bold" fill="#f08c00"></text>
		<!-- dvě STEJNĚ svítící žárovky (stejné paprsky, stejná barva vlákna) -->
		<!-- paprsky TĚSNĚ nad vlastní koulí (kruh má vrchol na y=92) — dřív byly
			daleko nahoře (y=0–30) a překrývaly se s paticí DOLNÍ žárovky -->
		<text x="630" y="42" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">~ 230 V (efektivní)</text>
		<g stroke="#2b2a26" stroke-width="2">
			<line x1="600" y1="85" x2="580" y2="65" />
			<line x1="660" y1="85" x2="680" y2="65" />
			<line x1="630" y1="75" x2="630" y2="55" />
		</g>
		<circle cx="630" cy="130" r="38" fill="#fff3bf" stroke="#f08c00" stroke-width="3" />
		<path d="M 610 130 L 620 115 L 630 130 L 640 115 L 650 130" fill="none" stroke="#e8590c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
		<rect x="618" y="166" width="24" height="16" rx="3" fill="#adb5bd" stroke="#2b2a26" stroke-width="2" />
		<!-- STEJNÉ paprsky (stejný tvar, stejná vzdálenost od koule) i u DOLNÍ
			žárovky — kruh má vrchol na y=252, paprsky proto o 160 px níž -->
		<text x="630" y="202" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">＝ 230 V (stejnosměrné)</text>
		<g stroke="#2b2a26" stroke-width="2">
			<line x1="600" y1="245" x2="580" y2="225" />
			<line x1="660" y1="245" x2="680" y2="225" />
			<line x1="630" y1="235" x2="630" y2="215" />
		</g>
		<circle cx="630" cy="290" r="38" fill="#fff3bf" stroke="#f08c00" stroke-width="3" />
		<path d="M 610 290 L 620 275 L 630 290 L 640 275 L 650 290" fill="none" stroke="#e8590c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
		<rect x="618" y="326" width="24" height="16" rx="3" fill="#adb5bd" stroke="#2b2a26" stroke-width="2" />
		<rect x="560" y="352" width="140" height="42" rx="8" fill="#ffffff" stroke="#2b2a26" stroke-width="1.5" />
		<text x="630" y="368" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26">obě hřejí a svítí</text>
		<text x="630" y="384" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26">STEJNĚ SILNĚ</text>
	</svg>
	<label class="sim-posuvnik">
		Okamžik na křivce: <output id="sp-b-out-t"></output>
		<input type="range" id="sp-b-cas" min="0" max="20" step="5" value="5" />
	</label>
	<p class="sp-vzorec">u = U<sub>m</sub> · sin(úhel) — okamžité napětí se v čase mění, ale žárovky reagují na EFEKTIVNÍ hodnotu 230 V, proto svítí/hřejí pořád stejně, ať posuvník ukazuje cokoli.</p>
	<p class="sp-stav" id="sp-b-stav"></p>
</section>

<script>
	// ═══════════════════════ Scéna A: perioda a frekvence ═══════════════════════
	// ČISTÉ FUNKCE (bez DOM — kontrolovatelné výpočtem)
	const A_X0 = 70, A_SIRKA = 560, A_Y0 = 195, A_AMPL = 100;
	const A_OKNO = 40; // ms — PEVNÉ okno pro všechny frekvence (to je ta názornost)
	const A_PX_NA_MS = A_SIRKA / A_OKNO; // 14 px/ms

	function TmsZFrekvence(f) {
		return 1000 / f; // celé ms pro 50/25/100 Hz: 20 / 40 / 10
	}
	// Sinusoida přes CELÉ pevné okno 0–40 ms — u vyšší frekvence se do stejné
	// šířky vejde víc vlnek (to je přesně to, co má scéna ukázat). Vzorkuje se
	// jemně (0,2 ms), aby vrchol byl špičatý, ne plochý.
	function bodySinusoidyA(f) {
		const T = TmsZFrekvence(f);
		const KROK = 0.2; // ms
		const N = Math.round(A_OKNO / KROK);
		const body = [];
		for (let i = 0; i <= N; i++) {
			const t = i * KROK;
			const x = A_X0 + (t / A_OKNO) * A_SIRKA;
			const y = A_Y0 - A_AMPL * Math.sin((2 * Math.PI * t) / T);
			body.push(`${x.toFixed(1)},${y.toFixed(1)}`);
		}
		return body.join(' ');
	}
	// Délka svorky T v pixelech — u 25 Hz vyplní celou šířku (1 perioda v okně),
	// u 100 Hz jen čtvrtinu (4 periody v okně).
	function periodaPxA(f) {
		return TmsZFrekvence(f) * A_PX_NA_MS;
	}
	// Kolik celých period se do pevného 40ms okna vejde (vždy celé číslo).
	function pocetPeriodA(f) {
		return Math.round(A_OKNO / TmsZFrekvence(f));
	}
	// ═══════════════════════════════════════════════════════════════════════════

	const svgA = document.getElementById('sp-a-svg');
	svgA.__TmsZFrekvence = TmsZFrekvence;
	svgA.__bodySinusoidyA = bodySinusoidyA;
	svgA.__periodaPxA = periodaPxA;
	svgA.__pocetPeriodA = pocetPeriodA;
	const g = (id) => document.getElementById(id);
	const nastav = (id, attrs) => { const el = g(id); for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v); };

	let frekvence = 50;
	let ukazatDc = false;
	const cz = (x, d = 2) => x.toLocaleString('cs-CZ', { minimumFractionDigits: d, maximumFractionDigits: d });

	function prekresliA() {
		const T = TmsZFrekvence(frekvence);
		nastav('sp-a-sinus', { points: bodySinusoidyA(frekvence) });
		const tPx = periodaPxA(frekvence);
		nastav('sp-a-t-konec', { x1: A_X0 + tPx, x2: A_X0 + tPx });
		nastav('sp-a-t-cara', { x2: A_X0 + tPx });
		nastav('sp-a-t-popisek', { x: A_X0 + tPx / 2 });
		nastav('sp-a-dc', { visibility: ukazatDc ? 'visible' : 'hidden' });
		nastav('sp-a-dc-label', { visibility: ukazatDc ? 'visible' : 'hidden' });
		g('sp-a-dc-tl').textContent = ukazatDc ? '➖ skrýt stejnosměrné napětí' : '➕ přidat stejnosměrné napětí pro srovnání';
		g('sp-a-vzorec').innerHTML = `T = 1 : f = 1 : ${frekvence} = <strong>${cz(T / 1000)} s</strong> = <strong>${T} ms</strong>`;
		const n = pocetPeriodA(frekvence);
		const jsou = n === 1 ? 'je' : 'jsou';
		const perioda = n === 1 ? 'perioda' : 'periody';
		g('sp-a-stav').textContent = `👉 Při ${frekvence} Hz ${jsou} v tomhle 40ms okně vidět ${n} ${perioda} — každá trvá T = ${T} ms (oranžová svorka). ${ukazatDc ? 'Stejnosměrná čára se v čase vůbec nemění — proto nemá periodu ani frekvenci, i když se s vlnící se křivkou kříží.' : 'Čím vyšší frekvence, tím kratší perioda — vlnek je do stejného okna „namačkáno" víc.'}`;
	}

	// Vlastní posluchač na KAŽDÉM tlačítku zvlášť (podle id), ne přes
	// querySelectorAll nad třídou — díky tomu jde na každé tlačítko samostatně
	// kliknout i v testovacím náhledu (ten querySelectorAll nepodporuje).
	const F_TLACITKA = [
		{ id: 'sp-a-f50', f: 50 },
		{ id: 'sp-a-f25', f: 25 },
		{ id: 'sp-a-f100', f: 100 },
	];
	F_TLACITKA.forEach(({ id, f }) => {
		g(id).addEventListener('click', () => {
			F_TLACITKA.forEach(({ id: jineId }) => g(jineId).classList.remove('sp-aktivni'));
			g(id).classList.add('sp-aktivni');
			frekvence = f;
			prekresliA();
		});
	});
	g('sp-a-dc-tl').addEventListener('click', () => { ukazatDc = !ukazatDc; prekresliA(); });
	prekresliA();

	// ═══════════════════ Scéna B: efektivní a maximální hodnota ═════════════════
	// ČISTÉ FUNKCE (bez DOM — kontrolovatelné výpočtem)
	const B_X0 = 60, B_SIRKA = 320, B_Y0 = 210, B_AMPL = 130, B_T = 20; // T = 20 ms (síť, 50 Hz)
	const UM = 325, UEF = 230;
	const PXV = B_AMPL / UM; // 0,4 px na 1 V

	// Sinusoida napětí sítě přes celou periodu (0–20 ms) — jemné vzorkování
	// (0,2 ms), aby vrchol i dno byly špičaté, ne plochá „useknutá" plocha.
	function bodySinusoidyB() {
		const KROK = 0.2; // ms
		const N = Math.round(B_T / KROK);
		const body = [];
		for (let i = 0; i <= N; i++) {
			const t = i * KROK;
			const x = B_X0 + (t / B_T) * B_SIRKA;
			const y = B_Y0 - UM * PXV * Math.sin((2 * Math.PI * t) / B_T);
			body.push(`${x.toFixed(1)},${y.toFixed(1)}`);
		}
		return body.join(' ');
	}
	// Posuvník krokuje jen po 5 ms → sin(90°)=1 a sin(270°)=−1 vždy vyjdou
	// přesně, proto se okamžité napětí zaokrouhluje jen kvůli plovoucí čárce.
	function okamziteNapetiB(tMs) {
		return Math.round(UM * Math.sin((2 * Math.PI * tMs) / B_T));
	}
	function poziceBoduB(tMs) {
		const u = okamziteNapetiB(tMs);
		return { x: B_X0 + (tMs / B_T) * B_SIRKA, y: B_Y0 - u * PXV, u };
	}
	// ═══════════════════════════════════════════════════════════════════════════

	const svgB = document.getElementById('sp-b-svg');
	svgB.__bodySinusoidyB = bodySinusoidyB;
	svgB.__okamziteNapetiB = okamziteNapetiB;
	svgB.__poziceBoduB = poziceBoduB;
	nastav('sp-b-sinus', { points: bodySinusoidyB() }); // křivka je statická (T pevné) — stačí spočítat jednou

	const sliderB = document.getElementById('sp-b-cas');
	function prekresliB() {
		const t = +sliderB.value;
		const p = poziceBoduB(t);
		g('sp-b-out-t').textContent = `t = ${t} ms`;
		nastav('sp-b-bod', { cx: p.x, cy: p.y });
		// popisek okamžité hodnoty: u kladného vrcholu jde NAD bod, jinde POD —
		// ať nikdy nevyjede mimo plátno (vrchol je jen 16 px pod horním okrajem).
		const nad = p.y > 40;
		nastav('sp-b-u-okamzite', { x: Math.min(p.x + 10, 330), y: nad ? p.y - 14 : p.y + 24 });
		g('sp-b-u-okamzite').textContent = `u = ${p.u} V`;

		let vysvetleni;
		if (p.u === 0) {
			vysvetleni = `Při t = ${t} ms prochází okamžité napětí NULOU (u = 0 V) — proud právě mění směr. Při 50 Hz se to stane stokrát za sekundu, a přesto žárovky nepohasnou.`;
		} else if (Math.abs(p.u) === UM) {
			vysvetleni = `Při t = ${t} ms je okamžité napětí na svém ${p.u > 0 ? 'MAXIMU' : 'MINIMU (opačná polarita)'}: u = ${p.u} V. Taková špička nastává dvakrát za periodu.`;
		} else {
			vysvetleni = `Při t = ${t} ms je okamžité napětí u = ${p.u} V.`;
		}
		g('sp-b-stav').textContent = `${vysvetleni} Obě žárovky ale svítí a hřejí POŘÁD STEJNĚ — určuje to efektivní hodnota 230 V, ne tahle okamžitá.`;
	}
	sliderB.addEventListener('input', prekresliB);
	prekresliB();
</script>

