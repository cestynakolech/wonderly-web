---
// Statická infografika: Délka — F6 měření
// Délka je fyzikální veličina udávající vzdálenost mezi dvěma body
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Délka — základní fyzikální veličina 📏</span></h2>
	<p><strong>Délka</strong> měří vzdálenost mezi dvěma body. Jednotka v SI soustavě je <strong>metr (m)</strong>.</p>
	<svg viewBox="0 0 750 380" class="infografika-svg">
		<!-- Pozadí -->
		<rect width="750" height="380" fill="#f5f0e8"/>
		
		<!-- Nadpis -->
		<text x="375" y="35" text-anchor="middle" class="transform-title">MĚŘENÍ DÉLKY — SI jednotky</text>
		
		<!-- Přirozené reference -->
		<circle cx="100" cy="100" r="20" fill="#3498db" stroke="#2980b9" stroke-width="2"/>
		<text x="100" y="105" text-anchor="middle" fill="white" font-weight="bold" font-size="14">👤</text>
		<text x="100" y="160" text-anchor="middle" class="energy-label">Lidské tělo</text>
		<text x="100" y="175" text-anchor="middle" class="energy-label">~1,7 m</text>
		
		<!-- Metr -->
		<rect x="170" y="85" width="100" height="30" fill="#2ecc71" stroke="#27ae60" stroke-width="2"/>
		<text x="220" y="108" text-anchor="middle" fill="white" font-weight="bold" font-size="12">1 metr</text>
		<text x="220" y="155" text-anchor="middle" class="energy-label">Základní jednotka</text>
		
		<!-- Střed - tabulka převodů -->
		<rect x="310" y="70" width="430" height="140" fill="#ecf0f1" stroke="#95a5a6" stroke-width="2" rx="8"/>
		
		<text x="325" y="95" class="law-title">Převody SI jednotek</text>
		<line x1="320" y1="105" x2="735" y2="105" stroke="#95a5a6" stroke-width="1"/>
		
		<text x="330" y="125" class="balance-label"><tspan font-weight="bold">Milimetr (mm):</tspan> 1 mm = 0,001 m</text>
		<text x="330" y="145" class="balance-label"><tspan font-weight="bold">Centimetr (cm):</tspan> 1 cm = 0,01 m</text>
		<text x="330" y="165" class="balance-label"><tspan font-weight="bold">Kilometr (km):</tspan> 1 km = 1000 m</text>
		<text x="330" y="185" class="balance-label"><tspan font-weight="bold">Nanometr (nm):</tspan> 1 nm = 10⁻⁹ m</text>
		
		<!-- Měřítko -->
		<text x="375" y="240" text-anchor="middle" class="law-title">Příklady měření</text>
		<line x1="50" y1="255" x2="710" y2="255" stroke="#95a5a6" stroke-width="1"/>
		
		<!-- Příklady -->
		<text x="60" y="280" class="balance-label"><tspan font-weight="bold">Papír:</tspan> tloušťka ~0,1 mm</text>
		<text x="60" y="300" class="balance-label"><tspan font-weight="bold">Tužka:</tspan> délka ~19 cm</text>
		<text x="60" y="320" class="balance-label"><tspan font-weight="bold">Běhací dráha:</tspan> 400 m</text>
		<text x="60" y="340" class="balance-label"><tspan font-weight="bold">Cesta do školy:</tspan> řádově km</text>
		
		<!-- Měřicí přístroje -->
		<text x="520" y="280" class="law-title">Měřicí přístroje</text>
		<text x="520" y="305" class="balance-label">• Metr</text>
		<text x="520" y="325" class="balance-label">• Pásmo (svinovací metr)</text>
		<text x="520" y="345" class="balance-label">• Posuvné měřítko</text>
	</svg>
</section>

