---
// Jaderný reaktor (F9): posuvník zasunutí regulačních tyčí (0–100 % po 25)
// řídí řetězovou reakci. Tyče z bórové oceli pohlcují neutrony: každá pozice
// dává celočíselný násobek další generace štěpení z 8 výchozích — 16/12/8/4/0
// (0 % = neřízený růst, 50 % = KRITICKÝ stav se stálým výkonem, 100 % =
// havarijní odstavení). Vpravo diagram tří generací neutronů. Bez časové
// animace; stav je čistá funkce stavReaktoru(zasunuti) na SVG (__stavReaktoru).
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Řídicí pult reaktoru 🕹️</span></h2>
	<p>V reaktoru probíhá <strong>řízená řetězová reakce</strong>: neutrony štěpí uran 235 a každé štěpení uvolní další neutrony. <strong>Regulační tyče</strong> (bórová ocel) neutrony pohlcují — zasouváním řídíš výkon.</p>
	<svg id="rea-svg" viewBox="0 0 660 340" role="img" aria-label="Reaktor s palivovými a regulačními tyčemi a diagram generací neutronů">
		<!-- kontejnment a tlaková nádoba -->
		<rect x="30" y="35" width="280" height="290" rx="18" fill="#e9ecef" stroke="#2b2a26" stroke-width="3" />
		<rect x="50" y="55" width="240" height="250" rx="12" fill="#fff" stroke="#495057" stroke-width="3" />
		<text x="170" y="26" text-anchor="middle" font-size="11" fill="#868e96">kontejnment (ocel + beton)</text>
		<!-- palivové tyče -->
		<g fill="#ffd43b" stroke="#e8590c" stroke-width="2">
			<rect x="75" y="150" width="18" height="140" /><rect x="123" y="150" width="18" height="140" />
			<rect x="171" y="150" width="18" height="140" /><rect x="219" y="150" width="18" height="140" />
			<rect x="267" y="150" width="18" height="140" /></g>
		<text x="170" y="318" text-anchor="middle" font-size="11" fill="#868e96">palivo: obohacený uran 235 · moderátor: voda</text>
		<!-- regulační tyče (zasouvají se shora) -->
		<g id="rea-tyce" fill="#868e96" stroke="#2b2a26" stroke-width="2">
			<rect x="99" y="55" width="16" height="20" /><rect x="147" y="55" width="16" height="20" />
			<rect x="195" y="55" width="16" height="20" /><rect x="243" y="55" width="16" height="20" />
		</g>
		<!-- letící neutrony -->
		<g id="rea-neutrony" fill="#1971c2"></g>
		<!-- diagram generací -->
		<text x="480" y="50" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">řetězová reakce (počty štěpení)</text>
		<g font-size="11" fill="#868e96" text-anchor="middle">
			<text x="390" y="70">1. generace</text><text x="480" y="70">2. generace</text><text x="570" y="70">3. generace</text>
		</g>
		<g id="rea-gen1" fill="#e8590c"></g>
		<g id="rea-gen2" fill="#e8590c"></g>
		<g id="rea-gen3" fill="#e8590c"></g>
		<g font-size="14" font-weight="bold" fill="#2b2a26" text-anchor="middle">
			<text id="rea-c1" x="390" y="240"></text><text id="rea-c2" x="480" y="240"></text><text id="rea-c3" x="570" y="240"></text>
		</g>
		<text x="435" y="150" text-anchor="middle" font-size="18" fill="#868e96">→</text>
		<text x="525" y="150" text-anchor="middle" font-size="18" fill="#868e96">→</text>
		<text id="rea-vykon" x="480" y="290" text-anchor="middle" font-size="17" font-weight="bold"></text>
		<text id="rea-vykon2" x="480" y="315" text-anchor="middle" font-size="12" fill="#868e96"></text>
	</svg>
	<label class="sim-posuvnik">
		Zasunutí regulačních tyčí: <output id="rea-out"></output>
		<input type="range" id="rea-slider" min="0" max="100" step="25" value="50" />
	</label>
	<p>
		<button type="button" class="rea-tl" id="rea-stop">🚨 havarijní tyče — STOP</button>
		<button type="button" class="rea-tl" id="rea-kriticky">🎯 nastav kritický stav (50 %)</button>
	</p>
	<p class="rea-vzorec" id="rea-vzorec"></p>
	<p class="rea-stav" id="rea-stav">👉 Hýbej tyčemi a najdi stav, kdy výkon ani neroste, ani neklesá.</p>
</section>

<script>
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	const START = 8; // štěpení v 1. generaci
	const NASOBKY = { 0: 2, 25: 1.5, 50: 1, 75: 0.5, 100: 0 }; // kolik štěpení pokračuje
	function stavReaktoru(zasunuti) {
		const k = NASOBKY[zasunuti];
		const gen = [START, START * k, START * k * k]; // 8→16→32 / 12→18 / 8→8 / 4→2 / 0→0
		const rezim = k > 1 ? 'roste' : k === 1 ? 'kriticky' : k === 0 ? 'stop' : 'klesa';
		return { k, gen, rezim };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	const svg = document.getElementById('rea-svg');
	svg.__stavReaktoru = stavReaktoru; // pro nezávislou kontrolu výpočtem
	const g = (id) => document.getElementById(id);

	function tecky(gid, cx, pocet) {
		const el = g(gid);
		el.innerHTML = '';
		for (let i = 0; i < pocet; i++) {
			const x = cx - 27 + (i % 4) * 18;
			const y = 90 + Math.floor(i / 4) * 16;
			el.innerHTML += `<circle cx="${x}" cy="${y}" r="5" />`;
		}
	}

	function kresli() {
		const z = +g('rea-slider').value;
		const s = stavReaktoru(z);
		g('rea-out').textContent = `${z} %`;
		// tyče: hloubka 20 px (vytažené) až 235 px (plně zasunuté)
		for (const t of g('rea-tyce').children) t.setAttribute('height', 20 + (z / 100) * 215);
		// letící neutrony ve zóně = 2. generace (pevné pozice)
		const POZICE = [[110,170],[160,200],[210,180],[255,220],[95,240],[145,265],[200,250],[250,170],[115,205],[175,230],[230,205],[85,185],[135,175],[190,275],[240,255],[105,275]];
		g('rea-neutrony').innerHTML = POZICE.slice(0, Math.min(s.gen[1], 16)).map(([x, y]) => `<circle cx="${x}" cy="${y}" r="4" />`).join('');
		// diagram generací
		tecky('rea-gen1', 390, s.gen[0]); tecky('rea-gen2', 480, Math.min(s.gen[1], 20)); tecky('rea-gen3', 570, Math.min(s.gen[2], 32));
		g('rea-c1').textContent = s.gen[0]; g('rea-c2').textContent = s.gen[1]; g('rea-c3').textContent = s.gen[2];
		const VYKONY = { roste: ['📈 výkon prudce roste!', '#e03131'], kriticky: ['➡️ výkon stálý — KRITICKÝ stav', '#2f9e44'], klesa: ['📉 výkon klesá', '#1971c2'], stop: ['⏹ reakce zastavena', '#495057'] };
		g('rea-vykon').textContent = VYKONY[s.rezim][0];
		g('rea-vykon').setAttribute('fill', VYKONY[s.rezim][1]);
		g('rea-vykon2').textContent = s.rezim === 'kriticky' ? 'z každého štěpení pokračuje přesně 1 neutron' : s.rezim === 'stop' ? 'tyče pohltily všechny neutrony' : `z každého štěpení pokračuje ${s.k} ${s.k === 1.5 || s.k === 0.5 ? 'neutronu' : 'neutrony'}`;
		g('rea-vzorec').innerHTML = `Generace štěpení: <strong>${s.gen[0]} → ${s.gen[1]} → ${s.gen[2]}</strong> (každé štěpení pokračuje ×${s.k}). ${s.rezim === 'kriticky' ? 'Přesně tohle chce elektrárna: teplo vzniká rovnoměrně.' : ''}`;
		const STAVY = {
			roste: `🚨 Tyče jsou moc vytažené — z každého štěpení pokračuje ${s.k === 2 ? 'DVOJNÁSOBEK' : 'víc než jeden neutron'} a počet roste lavinově. Neřízená řetězová reakce je princip jaderné bomby, v elektrárně nesmí nastat. Zasuň tyče!`,
			kriticky: '🎯 KRITICKÝ stav: tyče pohltí přesně tolik neutronů, aby z každého štěpení pokračovalo jedno. Výkon je stálý — takhle běží Temelín i Dukovany. Teplo pak vyrábí páru pro turbínu s generátorem.',
			klesa: '📉 Tyče pohlcují většinu neutronů — reakce slábne a výkon klesá. Takhle se reaktor tlumí.',
			stop: '⏹ Havarijní zastavení: plně zasunuté tyče (bórová ocel, havarijní z kadmia) pohltí všechny neutrony a řetězová reakce se zastaví. Bezpečnostní pojistka každého reaktoru.',
		};
		g('rea-stav').textContent = STAVY[s.rezim];
	}

	g('rea-slider').addEventListener('input', kresli);
	g('rea-stop').addEventListener('click', () => { g('rea-slider').value = 100; kresli(); });
	g('rea-kriticky').addEventListener('click', () => { g('rea-slider').value = 50; kresli(); });
	kresli();
</script>

<style>
	#rea-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.rea-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	#rea-stop { background: #ffe3e3; }
	.rea-tl:active { transform: translateY(1px); }
	.rea-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.rea-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
