---
import SkolaLayout from '../../../layouts/SkolaLayout.astro';
import { STANICE, otazkyProStanice } from '../../../data/hry';

export function getStaticPaths() {
	const sady = otazkyProStanice();
	return STANICE.map((s, i) => ({
		params: { stanice: s.slug },
		props: { stanice: s, poradi: i + 1, otazky: sady[i] },
	}));
}

const { stanice, poradi, otazky } = Astro.props;
---

<SkolaLayout titulek={`Stanoviště ${stanice.nazev}`}>
	<div id="stanoviste" data-otazky={JSON.stringify(otazky)} data-cislice={stanice.cislice} data-poradi={poradi}>
		<h1><span class="podtrh">{stanice.ikona} Stanoviště {stanice.nazev}</span></h1>
		<p class="pokrok">Odpovězte správně na 3 otázky a získáte číslici tajného kódu.</p>
		<div id="kviz">
			<p id="stav"></p>
			<h2 id="text-otazky"></h2>
			<div id="odpovedi" class="odpovedi"></div>
			<p id="zprava" class="zprava" hidden></p>
		</div>
		<div id="vyhra" hidden>
			<p class="gratulace">Výborně! {poradi}. číslice tajného kódu je:</p>
			<div class="cislice">{stanice.cislice}</div>
			<p>Zapište si ji i s pořadím a rychle k dalšímu stanovišti! 🏃</p>
		</div>
	</div>
</SkolaLayout>

<script>
	const koren = document.getElementById('stanoviste');
	const otazky = JSON.parse(koren.dataset.otazky);
	const $ = (id) => document.getElementById(id);
	let aktualni = 0;

	// start stopek celé hry (měří se od prvního navštíveného stanoviště)
	if (!localStorage.getItem('unikovka-start')) {
		localStorage.setItem('unikovka-start', String(Date.now()));
	}

	function zamichej(pole) {
		const p = [...pole];
		for (let i = p.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[p[i], p[j]] = [p[j], p[i]];
		}
		return p;
	}

	function vykresli() {
		if (aktualni >= otazky.length) {
			$('kviz').hidden = true;
			$('vyhra').hidden = false;
			return;
		}
		const otazka = otazky[aktualni];
		$('stav').textContent = `Otázka ${aktualni + 1} ze 3`;
		$('text-otazky').textContent = otazka.text;
		const spravna = otazka.odpovedi[0];
		$('odpovedi').innerHTML = '';
		zamichej(otazka.odpovedi).forEach((odpoved) => {
			const btn = document.createElement('button');
			btn.className = 'odpoved';
			btn.textContent = odpoved;
			btn.addEventListener('click', () => {
				if (odpoved === spravna) {
					$('zprava').hidden = true;
					aktualni++;
					vykresli();
				} else {
					$('zprava').textContent = '❌ Tudy ne — zkuste to znovu!';
					$('zprava').hidden = false;
					koren.classList.remove('trhni');
					void koren.offsetWidth;
					koren.classList.add('trhni');
					vykresli(); // otázka zůstává, odpovědi se zamíchají
				}
			});
			$('odpovedi').appendChild(btn);
		});
	}
	vykresli();
</script>

<style>
	#stanoviste { max-width: 640px; margin: 0 auto; }
	.odpovedi { display: grid; gap: 0.7rem; }
	.odpoved { font-size: 1.2rem; text-align: left; padding: 0.8rem 1rem; border-radius: 12px;
		border: 3px solid #333; background: #fff; cursor: pointer; }
	.odpoved:hover { background: #fff3bf; }
	.zprava { font-size: 1.1rem; font-weight: 700; color: #d9480f; }
	.gratulace { font-size: 1.3rem; font-weight: 700; }
	.cislice { font-size: 6rem; font-weight: 900; text-align: center; border: 4px solid #2f9e44;
		border-radius: 20px; width: 9rem; margin: 0.5rem auto; background: #d3f9d8; }
	.trhni { animation: trhnuti 0.35s; }
	@keyframes trhnuti { 25% { transform: translateX(-8px); } 75% { transform: translateX(8px); } }
</style>
