---
import SkolaLayout from '../../../layouts/SkolaLayout.astro';
import VideoGrid from '../../../components/skola2/VideoGrid.astro';
import { getVideosByRocnik, type Video } from '../../../data/videa';

export function getStaticPaths() {
	return [
		{ params: { rocnik: 'F6' } },
		{ params: { rocnik: 'F7' } },
		{ params: { rocnik: 'F8' } },
		{ params: { rocnik: 'F9' } },
	];
}

interface Props {
	rocnik?: string;
}

const rocnik = (Astro.params.rocnik as 'F6' | 'F7' | 'F8' | 'F9') || 'F6';

// Validace ročníku
if (!['F6', 'F7', 'F8', 'F9'].includes(rocnik)) {
	return Astro.redirect('/skola2/');
}

// Načti videa pro ročník
const videos: Video[] = getVideosByRocnik(rocnik);

// Metadata
const titles: Record<string, string> = {
	F6: '6. ročník',
	F7: '7. ročník',
	F8: '8. ročník',
	F9: '9. ročník',
};

const descriptions: Record<string, string> = {
	F6: 'Videa o látkách, telesech, skupenstvích, teplotě, tlaku a vztlaku.',
	F7: 'Videa o pohybu, silách, jednoduchých strojích, magnetismu a světle.',
	F8: 'Videa o energii, teple, zvuku, elektřině a magnetizmu.',
	F9: 'Videa o gravitaci, elektromagnetismu, atomech a jaderné fyzice.',
};

// Statistika
const shortVideos = videos.filter((v) => v.delka <= 15).length;
const longVideos = videos.filter((v) => v.delka > 15).length;
const totalMinutes = Math.round(videos.reduce((sum, v) => sum + v.delka, 0));
const totalHours = (totalMinutes / 60).toFixed(1);
---

<SkolaLayout title={`Videa fyziky — ${titles[rocnik]}`}>
	<main class="videa-page">
		<header class="videa-header">
			<h1>🎬 Videa fyziky — {titles[rocnik]}</h1>
			<p class="subtitle">{descriptions[rocnik]}</p>

			<div class="progress-bar">
				<div class="progress-stat">
					<strong>{videos.length}</strong> videí
				</div>
				<div class="progress-stat">
					<strong>{shortVideos}</strong> krátkých (≤15 min)
				</div>
				<div class="progress-stat">
					<strong>{longVideos}</strong> dlouhých
				</div>
				<div class="progress-stat">
					<strong>{totalHours}</strong> h obsahu
				</div>
			</div>

			<div class="cil-badge">
				<span class="badge-label">Pokrytí cíle:</span>
				<span class="badge-value">{videos.length}/10 videí na ročník</span>
				<progress value={videos.length} max="10" class="badge-progress"></progress>
			</div>
		</header>

		{
			videos.length > 0 ? (
				<VideoGrid rocnik={rocnik} videa={videos} showFilters={true} />
			) : (
				<div class="no-content">
					<p>Pro tento ročník nejsou zatím k dispozici videa.</p>
				</div>
			)
		}

		<nav class="videa-nav">
			<a href="/skola2/" class="btn btn-secondary">← Zpět na fyziku</a>
			<div class="nav-links">
				{['F6', 'F7', 'F8', 'F9'].map((r) => (
					<a
						href={`/skola2/videa/${r}`}
						class={`btn btn-outline ${rocnik === r ? 'active' : ''}`}
						title={titles[r]}
					>
						{r}
					</a>
				))}
			</div>
		</nav>
	</main>
</SkolaLayout>

<style>
	.videa-page {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.videa-header {
		text-align: center;
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 2px solid #e5e7eb;
	}

	.videa-header h1 {
		font-size: 2.25rem;
		font-weight: 700;
		color: #111827;
		margin: 0 0 0.5rem 0;
	}

	.subtitle {
		font-size: 1.1rem;
		color: #6b7280;
		margin: 0 0 1.5rem 0;
	}

	.progress-bar {
		display: flex;
		justify-content: center;
		gap: 2rem;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
		font-size: 0.95rem;
	}

	.progress-stat {
		background: #f0f9ff;
		border: 1px solid #bfdbfe;
		padding: 0.75rem 1.25rem;
		border-radius: 6px;
		color: #1e40af;
	}

	.progress-stat strong {
		font-weight: 700;
		font-size: 1.15rem;
	}

	.cil-badge {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		background: #ecfdf5;
		border: 2px solid #86efac;
		border-radius: 8px;
		padding: 1rem;
		margin-top: 1rem;
		font-size: 0.95rem;
	}

	.badge-label {
		color: #166534;
		font-weight: 600;
	}

	.badge-value {
		color: #059669;
		font-weight: 600;
	}

	.badge-progress {
		width: 120px;
		height: 8px;
		appearance: none;
		-webkit-appearance: none;
		background: white;
		border-radius: 4px;
		overflow: hidden;
	}

	.badge-progress::-webkit-progress-bar {
		background: #d1fae5;
		border-radius: 4px;
	}

	.badge-progress::-webkit-progress-value {
		background: #10b981;
		border-radius: 4px;
	}

	.badge-progress::-moz-progress-bar {
		background: #10b981;
		border-radius: 4px;
	}

	.no-content {
		text-align: center;
		padding: 3rem 1rem;
		background: #f9fafb;
		border: 2px dashed #d1d5db;
		border-radius: 8px;
		color: #6b7280;
	}

	.videa-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-top: 3rem;
		flex-wrap: wrap;
	}

	.nav-links {
		display: flex;
		gap: 0.5rem;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.25rem;
		border-radius: 6px;
		border: 1px solid #d1d5db;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		transition: all 0.2s ease;
		cursor: pointer;
	}

	.btn-secondary {
		background: #f3f4f6;
		color: #374151;
	}

	.btn-secondary:hover {
		background: #e5e7eb;
		border-color: #9ca3af;
	}

	.btn-outline {
		background: white;
		color: #6b7280;
		font-weight: 600;
	}

	.btn-outline:hover {
		background: #f9fafb;
		border-color: #9ca3af;
	}

	.btn-outline.active {
		background: #3b82f6;
		color: white;
		border-color: #3b82f6;
	}

	@media (max-width: 768px) {
		.videa-header h1 {
			font-size: 1.75rem;
		}

		.progress-bar {
			gap: 1rem;
		}

		.videa-nav {
			flex-direction: column;
		}

		.nav-links {
			width: 100%;
			justify-content: center;
		}
	}
</style>
