---
/**
 * VideoGrid.astro
 * 
 * Kontejner pro zobrazení videí v responzivním gridu
 * - Karty dostávají stejné údaje jako VideoCard (nazev, cesta, tema, podtema, ai, rocnik)
 * - Responsive grid (1-4 sloupce podle velikosti)
 * Pozn.: filtr podle délky a součty minut zrušeny — videa už délku v datech nemají.
 */

import VideoCard from './VideoCard.astro';

interface VideoKarta {
	nazev: string;
	cesta: string;
	tema: string;
	podtema?: string;
	ai?: string;
	rocnik: string;
}

interface Props {
	rocnik: '6-rocnik' | '7-rocnik' | '8-rocnik' | '9-rocnik';
	videa?: VideoKarta[];
	title?: string;
}

const { rocnik, videa = [], title = `Videa fyziky — ${rocnik.charAt(0)}. ročník` } = Astro.props;
---

<section class="video-grid-section">
	<div class="container">
		<h2 class="section-title">{title}</h2>

		<div class="video-grid">
			{
				videa.length > 0 ? (
					videa.map((video) => <VideoCard {...video} />)
				) : (
					<div class="no-videos">
						<p>Zatím nejsou k dispozici videa pro tento ročník.</p>
					</div>
				)
			}
		</div>

		{
			videa.length > 0 && (
				<div class="video-stats">
					<p>
						Počet videí: <strong>{videa.length}</strong>
					</p>
				</div>
			)
		}
	</div>
</section>

<style>
	.video-grid-section {
		padding: 3rem 1rem;
		background: #f9fafb;
		border-radius: 12px;
		margin: 2rem 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 1.75rem;
		font-weight: 700;
		color: #111827;
		margin: 0 0 2rem 0;
		text-align: center;
	}

	/* Filtry */
	.filters {
		margin-bottom: 2rem;
		padding: 1.5rem;
		background: white;
		border-radius: 8px;
		border: 1px solid #e5e7eb;
	}

	.filter-group {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.filter-group label {
		font-weight: 600;
		color: #374151;
		font-size: 0.95rem;
	}

	.filter-buttons {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-btn {
		padding: 0.5rem 1rem;
		background: white;
		border: 1px solid #d1d5db;
		border-radius: 6px;
		cursor: pointer;
		font-size: 0.85rem;
		font-weight: 500;
		color: #6b7280;
		transition: all 0.2s ease;
	}

	.filter-btn:hover {
		background: #f3f4f6;
		border-color: #9ca3af;
	}

	.filter-btn.active {
		background: #3b82f6;
		color: white;
		border-color: #3b82f6;
	}

	/* Grid layoutu */
	.video-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	/* Responsive breakpoints */
	@media (max-width: 1024px) {
		.video-grid {
			grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		}
	}

	@media (max-width: 768px) {
		.video-grid {
			grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
			gap: 1rem;
		}

		.section-title {
			font-size: 1.5rem;
		}

		.filter-group {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (max-width: 480px) {
		.video-grid {
			grid-template-columns: 1fr;
		}

		.filters {
			padding: 1rem;
		}
	}

	/* Žádná videa */
	.no-videos {
		grid-column: 1 / -1;
		padding: 3rem;
		text-align: center;
		color: #6b7280;
		background: white;
		border-radius: 8px;
		border: 2px dashed #d1d5db;
	}

	.no-videos p {
		margin: 0;
		font-size: 1rem;
	}

	/* Statistika */
	.video-stats {
		padding: 1.5rem;
		background: white;
		border-radius: 8px;
		border-left: 4px solid #3b82f6;
		text-align: center;
	}

	.video-stats p {
		margin: 0.5rem 0;
		font-size: 0.95rem;
		color: #4b5563;
	}

	.video-stats strong {
		color: #1e40af;
		font-weight: 600;
	}
</style>

