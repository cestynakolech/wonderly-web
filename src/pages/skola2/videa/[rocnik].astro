---
import SkolaLayout from '../../../layouts/SkolaLayout.astro';
import VideoCard from '../../../components/skola2/VideoCard.astro';
import { temata } from '../../../data/temata';

export function getStaticPaths() {
	return [
		{ params: { rocnik: '6-rocnik' } },
		{ params: { rocnik: '7-rocnik' } },
		{ params: { rocnik: '8-rocnik' } },
		{ params: { rocnik: '9-rocnik' } },
	];
}

interface Props {
	rocnik?: string;
}

const rocnikParam = Astro.params.rocnik || '6-rocnik';
const key = `fyzika/${rocnikParam}` as keyof typeof temata;
const temaList = temata[key];

if (!temaList) {
	return Astro.redirect('/skola2/');
}

// Extrahuj videa
interface Video {
	nazev: string;
	cesta: string;
	tema: string;
	podtema: string;
	ai?: string;
}

const videos: Video[] = [];

for (const tema of temaList) {
	if (tema.podtemata) {
		for (const podtema of tema.podtemata) {
			if (podtema.materialy) {
				for (const material of podtema.materialy) {
					if (material.druh === 'video' && !material.cesta?.endsWith?.('.m4a')) {
						videos.push({
							nazev: material.nazev,
							cesta: material.cesta,
							tema: tema.nazev,
							podtema: podtema.nazev,
							ai: material.ai
						});
					}
				}
			}
		}
	}
}

const limited = videos.slice(0, 40);

// Metadata
const titles: Record<string, string> = {
	'6-rocnik': '6. ročník',
	'7-rocnik': '7. ročník',
	'8-rocnik': '8. ročník',
	'9-rocnik': '9. ročník',
};

const rocnikName = titles[rocnikParam] || rocnikParam;
const pageTitle = `Videa - Fyzika ${rocnikName}`;
const progressPercent = Math.round((limited.length / 40) * 100);
---

<SkolaLayout title={pageTitle}>
	<main class="videos-container">
		<header class="videos-header">
			<h1>🎬 Videa - Fyzika {rocnikName}</h1>
			<p class="subtitle">
				Celkem <strong>{limited.length} videí</strong> z ročníku
				<span class="progress">({progressPercent}% pokrytí cíle 40)</span>
			</p>
		</header>

		{limited.length === 0 ? (
			<div class="no-videos">
				<p>Pro tento ročník nejsou k dispozici videa.</p>
			</div>
		) : (
			<div class="videos-grid">
				{limited.map((video) => (
					<VideoCard
						nazev={video.nazev}
						cesta={video.cesta}
						tema={video.tema}
						podtema={video.podtema}
						ai={video.ai}
					/>
				))}
			</div>
		)}

		<footer class="videos-footer">
			<p>
				ℹ️ Videa delší než 15 minut se otevírají v samostatné záložce.
				Kratší videa si můžete přehrát přímo zde.
			</p>
		</footer>
	</main>
</SkolaLayout>

<style>
	.videos-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 20px;
	}

	.videos-header {
		margin-bottom: 30px;
		text-align: center;
	}

	.videos-header h1 {
		font-size: 28px;
		margin: 0 0 10px 0;
		color: #333;
	}

	.subtitle {
		font-size: 16px;
		color: #666;
		margin: 0;
	}

	.progress {
		font-size: 14px;
		color: #999;
	}

	.no-videos {
		text-align: center;
		padding: 40px 20px;
		color: #999;
	}

	.videos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 20px;
		margin-bottom: 40px;
	}

	.videos-footer {
		text-align: center;
		padding: 20px;
		background: #f9f9f9;
		border-radius: 8px;
		border: 1px solid #e0e0e0;
		color: #666;
		font-size: 14px;
	}

	@media (max-width: 768px) {
		.videos-container {
			padding: 12px;
		}

		.videos-header h1 {
			font-size: 22px;
		}

		.videos-grid {
			grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
			gap: 12px;
		}
	}
</style>
