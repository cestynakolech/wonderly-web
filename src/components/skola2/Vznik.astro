---
// Vznik elektrického proudu — F8 TOP 5 infografika
// Komponenta zobrazuje zdroj napětí, vodiče, elektrostatickou indukci
---

<section class="ramecek infografika">
	<h2><span class="podtrh">Vznik elektrického proudu 🔌</span></h2>
	<p>
		Elektrický proud teče jen když je <strong>elektrické napětí</strong> mezi konci vodiče.
		Napětí vzniká <strong>rozdílem nábojů</strong> — záporná svorka má přebytek elektronů,
		kladná jejich nedostatek. To žene elektrony do pohybu a vzniká <strong>proud</strong>.
	</p>

	<svg viewBox="0 0 600 420" role="img" aria-label="Vznik elektrického proudu, zdroje napětí">
		<!-- Pozadí -->
		<rect x="0" y="0" width="600" height="420" fill="#f8f9fa" />

		<!-- JEDNODUCHÝ OBVOD (nahoře) -->
		<g id="obvod">
			<text x="300" y="30" text-anchor="middle" font-size="16" font-weight="bold" fill="#2b2a26">Jednoduchý elektrický obvod</text>

			<!-- Baterie -->
			<g>
				<!-- Kladná svorka -->
				<rect x="70" y="50" width="8" height="30" fill="#e03131" stroke="#2b2a26" stroke-width="2" />
				<!-- Záporná svorka -->
				<rect x="50" y="50" width="8" height="30" fill="#1971c2" stroke="#2b2a26" stroke-width="2" />

				<text x="60" y="90" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26">Baterie</text>
				<text x="60" y="105" text-anchor="middle" font-size="10" fill="#495057">1,5 V</text>
			</g>

			<!-- Vodiče z baterie -->
			<line x1="78" y1="65" x2="150" y2="65" stroke="#1971c2" stroke-width="3" />
			<line x1="50" y1="65" x2="30" y2="65" stroke="#1971c2" stroke-width="3" />

			<!-- Žárovka -->
			<g>
				<!-- Patice -->
				<rect x="150" y="50" width="30" height="30" fill="#d4d4d8" stroke="#2b2a26" stroke-width="2" rx="2" />
				<!-- Vlákno (spirála) -->
				<path d="M 162 62 Q 158 58 162 54 Q 166 58 162 62" fill="none" stroke="#FFD700" stroke-width="2" />
				<text x="165" y="85" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26">Žárovka</text>
			</g>

			<!-- Vodiče kolem -->
			<line x1="180" y1="65" x2="380" y2="65" stroke="#1971c2" stroke-width="3" />
			<line x1="30" y1="65" x2="30" y2="120" stroke="#1971c2" stroke-width="3" />
			<line x1="380" y1="65" x2="380" y2="120" stroke="#1971c2" stroke-width="3" />
			<line x1="30" y1="120" x2="380" y2="120" stroke="#1971c2" stroke-width="3" />

			<!-- Spínač -->
			<g>
				<rect x="200" y="110" width="30" height="20" fill="#f8f9fa" stroke="#2b2a26" stroke-width="2" rx="2" />
				<circle cx="205" cy="120" r="4" fill="#2b2a26" />
				<text x="215" y="155" text-anchor="middle" font-size="10" fill="#2b2a26">Spínač</text>
			</g>

			<!-- Proud teče (kulaté značky) -->
			<g opacity="0.8">
				<circle cx="120" cy="65" r="3" fill="#FFD700" />
				<circle cx="250" cy="65" r="3" fill="#FFD700" />
				<circle cx="330" cy="65" r="3" fill="#FFD700" />
				<circle cx="205" cy="100" r="3" fill="#FFD700" />
			</g>

			<text x="300" y="155" text-anchor="middle" font-size="11" fill="#2b2a26">Proud teče, když je obvod uzavřený (spínač zapnutý)</text>
		</g>

		<!-- TŘI ZDROJE NAPĚTÍ (uprostřed) -->
		<g id="zdroje">
			<text x="300" y="195" text-anchor="middle" font-size="16" font-weight="bold" fill="#2b2a26">Zdroje napětí (elektrických zdrojů)</text>

			<!-- Baterie -->
			<g>
				<rect x="50" y="220" width="25" height="40" fill="#d4d4d8" stroke="#2b2a26" stroke-width="2" rx="2" />
				<text x="63" y="245" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26">+</text>
				<text x="63" y="255" text-anchor="middle" font-size="10" fill="#2b2a26">−</text>
				<text x="63" y="275" text-anchor="middle" font-size="11" font-weight="bold" fill="#2b2a26">Baterie</text>
				<text x="63" y="290" text-anchor="middle" font-size="10" fill="#495057">1,5–9 V</text>
				<text x="63" y="305" text-anchor="middle" font-size="9" fill="#495057">jednoraz.</text>
			</g>

			<!-- Akumulátor -->
			<g>
				<rect x="200" y="220" width="25" height="40" fill="#d4d4d8" stroke="#2b2a26" stroke-width="2" rx="2" />
				<text x="213" y="245" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26">+</text>
				<text x="213" y="255" text-anchor="middle" font-size="10" fill="#2b2a26">−</text>
				<text x="213" y="275" text-anchor="middle" font-size="11" font-weight="bold" fill="#2b2a26">Akumulátor</text>
				<text x="213" y="290" text-anchor="middle" font-size="10" fill="#495057">1,2–3,7 V</text>
				<text x="213" y="305" text-anchor="middle" font-size="9" fill="#495057">dobíjecí</text>
			</g>

			<!-- Zásuvka -->
			<g>
				<rect x="345" y="220" width="25" height="40" fill="#d4d4d8" stroke="#2b2a26" stroke-width="2" rx="2" />
				<circle cx="353" cy="233" r="2" fill="#2b2a26" />
				<circle cx="361" cy="233" r="2" fill="#2b2a26" />
				<circle cx="353" cy="248" r="2" fill="#2b2a26" />
				<circle cx="361" cy="248" r="2" fill="#2b2a26" />
				<text x="358" y="275" text-anchor="middle" font-size="11" font-weight="bold" fill="#2b2a26">Zásuvka</text>
				<text x="358" y="290" text-anchor="middle" font-size="10" fill="#495057">230 V</text>
				<text x="358" y="305" text-anchor="middle" font-size="9" fill="#495057">střídavý</text>
			</g>

			<!-- Slunečnice (sluneční články) -->
			<g>
				<rect x="495" y="220" width="25" height="40" fill="#FFD700" stroke="#2b2a26" stroke-width="2" rx="2" />
				<circle cx="507" cy="235" r="5" fill="#FF8C00" />
				<text x="507" y="275" text-anchor="middle" font-size="11" font-weight="bold" fill="#2b2a26">Solární</text>
				<text x="507" y="290" text-anchor="middle" font-size="10" fill="#495057">0,5–5 V</text>
				<text x="507" y="305" text-anchor="middle" font-size="9" fill="#495057">v slunku</text>
			</g>
		</g>

		<!-- ELEKTROSTATICKÁ INDUKCE (dole) -->
		<g id="indukce">
			<rect x="40" y="330" width="520" height="75" rx="8" fill="#e7f5ff" stroke="#2b2a26" stroke-width="2" />

			<text x="300" y="355" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">
				Elektrostatická indukce — vysvětlení
			</text>

			<!-- Plechovka bez náboje -->
			<g>
				<rect x="80" y="365" width="35" height="30" fill="#b0b0b0" stroke="#2b2a26" stroke-width="2" rx="2" />
				<line x1="85" y1="367" x2="110" y2="367" stroke="#1971c2" stroke-width="1" stroke-dasharray="2,1" />
				<text x="97" y="410" text-anchor="middle" font-size="10" fill="#2b2a26">Neutrální</text>
			</g>

			<!-- Nabité těleso přiblíženo -->
			<g>
				<circle cx="220" cy="370" r="8" fill="#e03131" stroke="#2b2a26" stroke-width="2" />
				<text x="220" y="376" text-anchor="middle" font-size="10" font-weight="bold" fill="#fff">+</text>
				<text x="220" y="410" text-anchor="middle" font-size="10" fill="#2b2a26">Nabité</text>
			</g>

			<!-- Šipka -->
			<path d="M 115 375 L 200 375" stroke="#2b2a26" stroke-width="2" marker-end="url(#arrowhead)" />

			<!-- Plechovka s indukovaným nábojem -->
			<g>
				<rect x="310" y="365" width="35" height="30" fill="#b0b0b0" stroke="#2b2a26" stroke-width="2" rx="2" />
				<!-- Levá strana má přebytek elektronů (modrá) -->
				<line x1="312" y1="367" x2="325" y2="367" stroke="#1971c2" stroke-width="2" />
				<!-- Pravá strana má nedostatek (červená) -->
				<line x1="325" y1="367" x2="342" y2="367" stroke="#e03131" stroke-width="2" />
				<text x="327" y="410" text-anchor="middle" font-size="10" fill="#2b2a26">Indukce</text>
			</g>

			<!-- Šipka indukce -->
			<path d="M 255 375 L 310 375" stroke="#2b2a26" stroke-width="2" marker-end="url(#arrowhead)" />

			<text x="420" y="372" text-anchor="middle" font-size="9" fill="#2b2a26">Elektrony se přesunou</text>
			<text x="420" y="383" text-anchor="middle" font-size="9" fill="#2b2a26">k jedné straně plechovky</text>

			<defs>
				<marker id="arrowhead" markerWidth="10" markerHeight="10" refX="5" refY="3" orient="auto">
					<polygon points="0 0, 10 3, 0 6" fill="#2b2a26" />
				</marker>
			</defs>
		</g>

		<!-- Informační box -->
		<rect x="20" y="410" width="560" height="18" rx="4" fill="#fff3bf" stroke="#2b2a26" stroke-width="1" />
		<text x="300" y="425" text-anchor="middle" font-size="10" font-weight="bold" fill="#2b2a26">
			Proud = pohyb elektronů skrz vodič; bez uzavřeného obvodu proud neteče
		</text>
	</svg>
</section>

<style>
	.infografika { padding: 1.5rem; }
	.infografika h2 { margin-top: 0; }
	.infografika svg { width: 100%; max-width: 600px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; margin: 1rem 0; display: block; margin-left: auto; margin-right: auto; }
	.podtrh { border-bottom: 3px solid #ffd43b; padding-bottom: 2px; }
</style>
