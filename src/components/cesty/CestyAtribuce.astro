---
// Atribuce mapového podkladu (licence CC BY-SA 3.0 vyžaduje uvedení u každého užití mapy)
import { TEXTY } from '../../data/cesty/preklady';
import type { Jazyk } from '../../data/cesty/typy';

interface Props {
	jazyk: Jazyk;
}

const { jazyk } = Astro.props;
const t = TEXTY[jazyk];
---

<footer class="atribuce">
	{t.podklad}
	<a
		href="https://commons.wikimedia.org/wiki/File:Blank_map_of_Europe_(with_disputed_regions).svg"
		rel="license noopener"
		>Blank map of Europe</a
	>{t.autorLicence}
	<a href="https://creativecommons.org/licenses/by-sa/3.0/" rel="license noopener">CC BY-SA 3.0</a>
	{t.upraveno}
</footer>

<style>
	.atribuce {
		margin-top: 1.5rem;
		font-size: 0.8rem;
		color: var(--ztlumeny, #777);
	}
</style>
