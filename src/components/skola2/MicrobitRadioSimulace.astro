			<rect x="410" y="130" width="100" height="46" rx="8" fill="#fff" stroke="#2b2a26" stroke-width="3" />
			<text x="460" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#2b2a26">💧 čidlo vlhkosti</text>
