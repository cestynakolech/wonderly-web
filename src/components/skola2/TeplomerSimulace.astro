---
// Interaktivní teploměr: posuvníkem měníš teplotu a vidíš, jak fungují DVA druhy
// teploměrů díky teplotní roztažnosti — kapalinový (stoupá sloupec) a bimetalový
// (pásek ze dvou kovů se ohýbá, protože se každý kov roztahuje jinak).
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Jak fungují teploměry? 🕹️</span></h2>
	<p>Posuvníkem měň <strong>teplotu</strong> a sleduj oba teploměry. Fungují díky <strong>teplotní roztažnosti</strong> — látky se teplem roztahují (zvětšují objem) a chladem smršťují.</p>
	<svg id="tepl-svg" viewBox="0 0 480 340" role="img" aria-label="Kapalinový a bimetalový teploměr">
		<!-- KAPALINOVÝ teploměr -->
		<text x="105" y="24" text-anchor="middle" font-size="15" font-weight="bold" fill="#2b2a26">Kapalinový</text>
		<rect x="92" y="40" width="26" height="220" rx="13" fill="#fff" stroke="#2b2a26" stroke-width="3" />
		<circle cx="105" cy="278" r="26" fill="#e03131" stroke="#2b2a26" stroke-width="3" />
		<rect id="tepl-sloupec" x="99" y="120" width="12" height="160" fill="#e03131" />
		<!-- stupnice -->
		<g stroke="#868e96" stroke-width="2">
			<line x1="120" y1="60" x2="132" y2="60" /><line x1="120" y1="110" x2="132" y2="110" />
			<line x1="120" y1="160" x2="132" y2="160" /><line x1="120" y1="210" x2="132" y2="210" />
		</g>
		<text x="138" y="65" font-size="12" fill="#868e96">100°</text>
		<text x="138" y="165" font-size="12" fill="#868e96">50°</text>
		<text x="138" y="215" font-size="12" fill="#868e96">0°</text>

		<!-- BIMETALOVÝ teploměr -->
		<text x="340" y="24" text-anchor="middle" font-size="15" font-weight="bold" fill="#2b2a26">Bimetalový</text>
		<rect x="336" y="40" width="8" height="30" fill="#495057" stroke="#2b2a26" stroke-width="2" />
		<!-- pásek ze dvou kovů (kreslí skript jako dva ohnuté proužky) -->
		<path id="tepl-kov1" fill="none" stroke="#f59f00" stroke-width="7" stroke-linecap="round" />
		<path id="tepl-kov2" fill="none" stroke="#adb5bd" stroke-width="7" stroke-linecap="round" />
		<circle cx="340" cy="70" r="4" fill="#2b2a26" />
		<text x="340" y="320" text-anchor="middle" font-size="12" fill="#868e96">dva kovy nad sebou</text>
	</svg>
	<label class="sim-posuvnik">
		Teplota: <output id="tepl-hodnota"></output>
		<input type="range" id="tepl-slider" min="-10" max="110" step="1" value="20" />
	</label>
	<p class="tepl-stav" id="tepl-stav"></p>
</section>

<script>
	const slider = document.getElementById('tepl-slider');
	const hodnota = document.getElementById('tepl-hodnota');
	const sloupec = document.getElementById('tepl-sloupec');
	const kov1 = document.getElementById('tepl-kov1');
	const kov2 = document.getElementById('tepl-kov2');
	const stavEl = document.getElementById('tepl-stav');

	function prekresli() {
		const t = +slider.value; // -10..110
		hodnota.textContent = t + ' °C';

		// kapalinový: výška sloupce (0 °C = y210, 100 °C = y60)
		const yVrch = 210 - (t / 100) * 150;
		const yOmez = Math.max(50, Math.min(255, yVrch));
		sloupec.setAttribute('y', yOmez);
		sloupec.setAttribute('height', 280 - yOmez);

		// bimetalový: pásek visí z bodu (340,70) dolů; teplem se ohýbá do strany.
		// ohyb = f(teplota): za studena rovně dolů, za tepla se stáčí doprava.
		const ohyb = (t - 20) * 1.6; // px vychýlení konce
		const x0 = 340, y0 = 70, delka = 150;
		const xk = x0 + ohyb, yk = y0 + delka - Math.abs(ohyb) * 0.25;
		const cx = x0 + ohyb * 0.4, cy = y0 + delka * 0.6;
		kov1.setAttribute('d', `M${x0 - 4} ${y0} Q${cx - 4} ${cy} ${xk - 4} ${yk}`);
		kov2.setAttribute('d', `M${x0 + 4} ${y0} Q${cx + 4} ${cy} ${xk + 4} ${yk}`);

		let popis;
		if (t <= 0) popis = '❄️ Chlad: látky se smršťují — sloupec je nízko, pásek skoro rovně.';
		else if (t < 40) popis = '🌡️ Běžná teplota. Kapalina i kovy mají „základní" objem.';
		else popis = '🔥 Teplo: látky se roztahují — sloupec stoupá a bimetalový pásek se ohýbá (spodní kov se roztáhl víc).';
		stavEl.textContent = popis;
	}
	slider.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#tepl-svg { width: 100%; max-width: 480px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 480px; display: block; margin-top: 0.3rem; }
	.tepl-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
