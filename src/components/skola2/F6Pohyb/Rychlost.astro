---
// F6 Pohyb — Rychlost (definice, jednotky, výpočet)
// SVG diagram ukazuje rychlost jako přímku a její složky
---

<section class="ramecek f6-diagram">
	<h3>⚡ Rychlost — jak rychle se těleso pohybuje</h3>
	<svg viewBox="0 0 450 380" class="diagram-svg rychlost-diagram">
		<!-- Pozadí -->
		<rect width="450" height="380" fill="#f7f9fc" />

		<!-- Název oddílu -->
		<text x="225" y="25" text-anchor="middle" font-size="16" font-weight="bold" fill="#1565c0">Rychlost (v)</text>

		<!-- Definice -->
		<rect x="20" y="40" width="410" height="50" fill="#e1f5fe" stroke="#0277bd" stroke-width="1.5" rx="4" />
		<text x="30" y="60" font-size="11" font-weight="600" fill="#01579b">DEFINICE: Rychlost = Dráha ÷ Čas</text>
		<text x="30" y="75" font-size="10" fill="#333">v = s / t</text>
		<text x="30" y="88" font-size="9" fill="#0277bd">kde: v = rychlost (m/s), s = dráha (m), t = čas (s)</text>

		<!-- Diagram: Graf dráhy vs. času -->
		<g>
			<!-- Box pro graf -->
			<rect x="35" y="110" width="390" height="150" fill="#f3e5f5" stroke="#7b1fa2" stroke-width="1.5" rx="4" />
			<text x="45" y="130" font-size="11" font-weight="600" fill="#4a148c">Graf dráhy a času</text>

			<!-- Osy souřadnic -->
			<line x1="60" y1="230" x2="380" y2="230" stroke="#333" stroke-width="2" />
			<line x1="60" y1="40" x2="60" y2="230" stroke="#333" stroke-width="2" />

			<!-- Popisky os -->
			<text x="385" y="235" font-size="10" fill="#333">čas t (s)</text>
			<text x="20" y="140" font-size="10" fill="#333">s (m)</text>

			<!-- Tabulka údajů -->
			<rect x="115" y="105" width="270" height="45" fill="#fff9c4" stroke="#fbc02d" stroke-width="1" rx="2" />
			<text x="125" y="120" font-size="9" font-weight="600" fill="#f57f17">Čas (s)</text>
			<text x="165" y="120" font-size="9" font-weight="600" fill="#f57f17">Dráha (m)</text>
			<text x="220" y="120" font-size="9" font-weight="600" fill="#f57f17">Rychlost</text>

			<text x="125" y="135" font-size="9" fill="#333">0</text>
			<text x="165" y="135" font-size="9" fill="#333">0</text>
			<text x="125" y="148" font-size="9" fill="#333">1</text>
			<text x="165" y="148" font-size="9" fill="#333">5</text>
			<text x="220" y="148" font-size="9" fill="#f57f17">5 m/s</text>
			<text x="125" y="161" font-size="9" fill="#333">2</text>
			<text x="165" y="161" font-size="9" fill="#333">10</text>
			<text x="220" y="161" font-size="9" fill="#f57f17">5 m/s</text>

			<!-- Přímka na grafu (rovnoměrný pohyb) -->
			<polyline points="80,210 130,185 180,160 230,135 280,110" stroke="#c41e3a" stroke-width="2.5" fill="none" />

			<!-- Body na přímce -->
			<circle cx="80" cy="210" r="3" fill="#c41e3a" />
			<circle cx="130" cy="185" r="3" fill="#c41e3a" />
			<circle cx="180" cy="160" r="3" fill="#c41e3a" />
			<circle cx="230" cy="135" r="3" fill="#c41e3a" />
			<circle cx="280" cy="110" r="3" fill="#c41e3a" />

			<!-- Měřítko na osách -->
			<line x1="60" y1="225" x2="60" y2="235" stroke="#333" stroke-width="1" />
			<line x1="110" y1="225" x2="110" y2="235" stroke="#333" stroke-width="1" />
			<line x1="160" y1="225" x2="160" y2="235" stroke="#333" stroke-width="1" />
			<text x="108" y="250" font-size="8" fill="#333">1s</text>
			<text x="158" y="250" font-size="8" fill="#333">2s</text>

			<line x1="55" y1="230" x2="65" y2="230" stroke="#333" stroke-width="1" />
			<line x1="55" y1="160" x2="65" y2="160" stroke="#333" stroke-width="1" />
			<line x1="55" y1="110" x2="65" y2="110" stroke="#333" stroke-width="1" />
			<text x="30" y="233" font-size="8" fill="#333">0m</text>
			<text x="30" y="163" font-size="8" fill="#333">10m</text>
			<text x="30" y="113" font-size="8" fill="#333">20m</text>
		</g>

		<!-- Druhy pohybu: Rovnoměrný x Nerovnoměrný -->
		<g>
			<!-- Rovnoměrný pohyb -->
			<rect x="20" y="280" width="200" height="80" fill="#c8e6c9" stroke="#2e7d32" stroke-width="1.5" rx="4" />
			<text x="30" y="300" font-size="11" font-weight="600" fill="#1b5e20">Rovnoměrný pohyb</text>
			<text x="30" y="318" font-size="9" fill="#333">• Rychlost se NEMĚNÍ</text>
			<text x="30" y="331" font-size="9" fill="#333">• Za stejné časy</text>
			<text x="30" y="344" font-size="9" fill="#333">  prochází stejné dráhy</text>
			<text x="30" y="357" font-size="9" fill="#333">• Příklad: auto na dálnici</text>
		</g>

		<!-- Nerovnoměrný pohyb -->
		<g>
			<rect x="230" y="280" width="200" height="80" fill="#ffccbc" stroke="#d84315" stroke-width="1.5" rx="4" />
			<text x="240" y="300" font-size="11" font-weight="600" fill="#bf360c">Nerovnoměrný pohyb</text>
			<text x="240" y="318" font-size="9" fill="#333">• Rychlost se MĚNÍ</text>
			<text x="240" y="331" font-size="9" fill="#333">• Používáme PRŮMĚRNOU</text>
			<text x="240" y="344" font-size="9" fill="#333">  rychlost (v̄)</text>
			<text x="240" y="357" font-size="9" fill="#333">• Příklad: auto ve městě</text>
		</g>

		<!-- Jednotky -->
		<rect x="20" y="370" width="410" height="40" fill="#e0f2f1" stroke="#00695c" stroke-width="1" rx="2" />
		<text x="30" y="387" font-size="9" fill="#00695c" font-weight="600">Jednotky: m/s (metr za sekundu) = základní jednotka | km/h (kilometr za hodinu) — v praxi</text>
	</svg>

	<div class="poznamka">
		<strong>Zapamatuj si:</strong> Rychlost nám řekne, jak daleko se těleso pohne za jednotku času.
		Základní jednotka je m/s. Přepočet: 1 m/s = 3.6 km/h
	</div>
</section>

<style>
	.f6-diagram {
		margin: 1.5rem 0;
		padding: 1.5rem;
		border: 2px solid #1976d2;
		border-radius: 8px;
		background: #f9fafc;
	}

	.f6-diagram h3 {
		margin: 0 0 1rem 0;
		color: #1565c0;
		font-size: 1.25rem;
	}

	.diagram-svg {
		width: 100%;
		max-width: 500px;
		margin: 1rem auto;
		display: block;
		border-radius: 6px;
		background: white;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.poznamka {
		margin-top: 1rem;
		padding: 0.8rem;
		background: #fff3cd;
		border-left: 4px solid #ffc107;
		border-radius: 4px;
		font-size: 0.95rem;
		color: #856404;
	}
</style>
