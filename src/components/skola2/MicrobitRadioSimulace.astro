	<p class="mr-radek">
		<button type="button" class="mr-tl mr-zar-tl mr-aktivni" data-zarizeni="led">💡 LED pásek → P0</button>
		<button type="button" class="mr-tl mr-zar-tl" data-zarizeni="motor">⚙️ motorek → P1</button>
		<button type="button" class="mr-tl mr-zar-tl" data-zarizeni="cidlo">💧 čidlo vlhkosti → P2</button>
	</p>
