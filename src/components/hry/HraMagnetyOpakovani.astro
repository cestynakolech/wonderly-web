---
/**
 * Týmová hra „Magnetická výzva“ — Magnety a magnetické pole (fyzika 9).
 * Každá karta zkouší JINÝ fakt: její opora je doslovný úryvek výkladu (temata.ts) z jiného
 * odstavce či odrážky než opora kterékoli jiné karty, a stránka zdrojového PDF je uvedena.
 * Scény jsou vlastní inline SVG se SMIL animacemi, bez vnějších souborů; před odhalením
 * ukazují jen zadání, odpověď (nápis) se zobrazí až po odhalení.
 */
type Odpoved = 'A' | 'B';
type Moznost = { popis: string; doplnek: string };
type Karta = {
	id: string;
	scena: string;
	otazka: string;
	spravne: Odpoved;
	napis: string;
	proc: string;
	opora: string;
	zdroj: string;
};
type Kolo = {
	cislo: number; nazev: string; pravidlo: string;
	moznosti: Record<Odpoved, Moznost>; body: number; karty: Karta[];
};

const ANO_NE: Record<Odpoved, Moznost> = {
	A: { popis: 'ANO', doplnek: 'výrok platí' },
	B: { popis: 'NE', doplnek: 'výrok neplatí' },
};

const KOLA: Kolo[] = [
	{
		cislo: 1,
		nazev: 'Látky a magnety',
		pravidlo: 'Rozhodni, zda výrok o látkách, o magnetech nebo o jejich využití platí.',
		moznosti: ANO_NE,
		body: 1,
		karty: [
			{ id: 'k1-zelezo', scena: 'zelezo', otazka: 'Přitáhne magnet silně železný hřebík?', spravne: 'A',
				napis: 'ANO · feromagnetická látka',
				proc: 'Ano. Železo je feromagnetická látka, magnet ji silně přitahuje.',
				opora: 'Patří sem železo, ocel (slitina železa)', zdroj: 's. 2' },
			{ id: 'k1-hlinik', scena: 'hlinik', otazka: 'Přitáhne magnet silně hliníkovou destičku?', spravne: 'B',
				napis: 'NE · nemagnetická látka',
				proc: 'Ne. Hliník je nemagnetická látka, na magnetické pole téměř nereaguje.',
				opora: 'z kovů hliník, nerezová ocel, měď, zinek a stříbro.', zdroj: 's. 4' },
			{ id: 'k1-magnetit', scena: 'magnetit', otazka: 'Je magnetit (magnetovec) umělý magnet?', spravne: 'B',
				napis: 'NE · je to přírodní magnet',
				proc: 'Ne. Magnetit (magnetovec) je přírodní magnet – nerost s obsahem železa.',
				opora: 'Přírodní magnety jsou nerosty s obsahem železa, například magnetit (magnetovec).', zdroj: 's. 4' },
			{ id: 'k1-tuha', scena: 'tuha', otazka: 'Může tuha z tužky levitovat nad silnými magnety?', spravne: 'A',
				napis: 'ANO · vznáší se nad nimi',
				proc: 'Ano. Tuha z tužky může levitovat (vznášet se) nad silnými magnety.',
				opora: 'Tuha z tužky může levitovat (vznášet se) nad silnými magnety.', zdroj: 's. 4' },
			{ id: 'k1-reproduktor', scena: 'reproduktor', otazka: 'Využívají se magnety v reproduktorech?', spravne: 'A',
				napis: 'ANO · jsou v reproduktorech',
				proc: 'Ano. Magnety se využívají v reproduktorech.',
				opora: 'reproduktory', zdroj: 's. 17' },
		],
	},
	{
		cislo: 2,
		nazev: 'Póly a magnetické pole',
		pravidlo: 'Rozhodni, zda výrok o pólech magnetu, o jeho síle nebo o jeho poli platí.',
		moznosti: ANO_NE,
		body: 1,
		karty: [
			{ id: 'k2-okoli', scena: 'okoli-magnetu', otazka: 'Vzniká magnetické pole jen uvnitř magnetu?', spravne: 'B',
				napis: 'NE · vzniká kolem magnetu',
				proc: 'Ne. Kolem magnetů vzniká magnetické pole.',
				opora: 'Kolem magnetů vzniká magnetické pole.', zdroj: 's. 7' },
			{ id: 'k2-stejne', scena: 'stejne', otazka: 'Je pole mezi dvěma stejnými póly nejsilnější?', spravne: 'B',
				napis: 'NE · je tam nejslabší',
				proc: 'Ne. U magnetů natočených stejnými póly k sobě je pole mezi nimi nejslabší.',
				opora: 'U magnetů natočených stejnými póly k sobě je pole mezi nimi nejslabší a magnety se odpuzují.', zdroj: 's. 16' },
			{ id: 'k2-rozdel', scena: 'rozdel', otazka: 'Budou mít obě části rozděleného magnetu znovu oba póly?', spravne: 'A',
				napis: 'ANO · každá část má oba',
				proc: 'Ano. Každá část rozděleného magnetu bude mít znovu oba póly.',
				opora: 'Když magnet rozdělíš na části, každá část bude mít znovu oba póly — severní i jižní.', zdroj: 's. 6' },
			{ id: 'k2-netecne', scena: 'netecne', otazka: 'Přitahuje netečné pásmo magnetu nějaká tělesa?', spravne: 'B',
				napis: 'NE · nepřitahuje žádná tělesa',
				proc: 'Ne. Netečné pásmo nepřitahuje žádná tělesa, ani magnety.',
				opora: 'které nepřitahuje žádná tělesa, ani magnety', zdroj: 's. 7' },
			{ id: 'k2-blizko', scena: 'blizko', otazka: 'Je magnetická síla blízko magnetu větší než daleko od něj?', spravne: 'A',
				napis: 'ANO · blízko je větší',
				proc: 'Ano. S rostoucí vzdáleností se magnetická síla zmenšuje.',
				opora: 'S rostoucí vzdáleností se magnetická síla zmenšuje.', zdroj: 's. 7' },
		],
	},
	{
		cislo: 3,
		nazev: 'FINÁLE: Pole, čáry a Země',
		pravidlo: 'Rozhodni, zda výrok o zviditelnění pole, o indukčních čarách nebo o magnetickém poli Země platí.',
		moznosti: ANO_NE,
		body: 2,
		karty: [
			{ id: 'k3-piliny', scena: 'piliny', otazka: 'Uspořádají se železné piliny nasypané na karton nad magnetem do obrazce?', spravne: 'A',
				napis: 'ANO · pilinový obrazec',
				proc: 'Ano. Piliny se zmagnetují a uspořádají do pilinového obrazce.',
				opora: 'Piliny se zmagnetují a uspořádají do pilinového obrazce', zdroj: 's. 10' },
			{ id: 'k3-otevrene', scena: 'otevrene', otazka: 'Jsou magnetické indukční čáry otevřené křivky?', spravne: 'B',
				napis: 'NE · jsou to uzavřené křivky',
				proc: 'Ne. Magnetické indukční čáry jsou uzavřené křivky.',
				opora: 'Jsou to uzavřené křivky', zdroj: 's. 13' },
			{ id: 'k3-smer', scena: 'smer', otazka: 'Vedou indukční čáry vně magnetu od pólu N k pólu S?', spravne: 'A',
				napis: 'ANO · vně magnetu od N k S',
				proc: 'Ano. Vně magnetu vedou indukční čáry vždy od pólu N k pólu S.',
				opora: 'Vždy ale vně magnetu vedou od severního pólu (N) k jižnímu (S).', zdroj: 's. 13' },
			{ id: 'k3-zeme-ochrana', scena: 'zeme-ochrana', otazka: 'Chrání magnetické pole Země před slunečním větrem?', spravne: 'A',
				napis: 'ANO · pole vítr odkloní',
				proc: 'Ano. Magnetické pole Země sluneční vítr odkloní, takže Zemi ve velké míře obejde.',
				opora: 'Magnetické pole Země nás chrání před slunečním větrem a kosmickým zářením', zdroj: 's. 19' },
			{ id: 'k3-zeme-sever', scena: 'zeme-sever', otazka: 'Leží na severním zeměpisném pólu Země severní magnetický pól?', spravne: 'B',
				napis: 'NE · jižní magnetický pól',
				proc: 'Ne. Na severním zeměpisném pólu Země leží jižní magnetický pól.',
				opora: 'Střelka kompasu ukazuje svým severním magnetickým pólem k severu, proto na severním zeměpisném pólu Země leží jižní magnetický pól.', zdroj: 's. 18' },
		],
	},
];

const karty = KOLA.flatMap((k) => k.karty);

const MODRA = '#1864ab';
const CERVENA = '#c92a2a';
const magnet = (x = 220, y = 164, levy = 'S', pravy = 'N') =>
	`<g><rect x="${x}" y="${y}" width="100" height="72" rx="8" fill="${MODRA}" stroke="#212529" stroke-width="4"/><rect x="${x + 100}" y="${y}" width="100" height="72" rx="8" fill="${CERVENA}" stroke="#212529" stroke-width="4"/><text x="${x + 50}" y="${y + 48}" text-anchor="middle" font-size="34" font-weight="800" fill="#fff">${levy}</text><text x="${x + 150}" y="${y + 48}" text-anchor="middle" font-size="34" font-weight="800" fill="#fff">${pravy}</text></g>`;
// Pulzující značka „?“ – pulzuje jen obrys kruhu, otazník má stále plné krytí. Patří do vrstvy zadání,
// po odhalení zmizí.
const puls = (cx = 320, cy = 92, r = 24) => pred(
	`<circle cx="${cx}" cy="${cy}" r="${r}" fill="#fff" stroke="#6741d9" stroke-width="4"><animate attributeName="stroke-opacity" values="1;.4;1" dur="2s" repeatCount="indefinite"/></circle><text x="${cx}" y="${cy + Math.round(r * .42)}" text-anchor="middle" font-size="${Math.round(r * 1.15)}" font-weight="800" fill="#6741d9">?</text>`);
const pozadi = (barva: string) => `<rect width="640" height="400" fill="${barva}"/>`;
const titulek = (text: string, y: number, barva = '#343a40', velikost = 24) =>
	`<text x="320" y="${y}" text-anchor="middle" font-size="${velikost}" font-weight="800" fill="${barva}">${text}</text>`;
const material = (nazev: string, tvar: string) =>
	`${pozadi('#e7f5ff')}${puls()}<g>${magnet(45, 164)}</g><g>${tvar}</g><text x="470" y="315" text-anchor="middle" font-size="26" font-weight="800" fill="#343a40">${nazev}</text><text x="320" y="365" text-anchor="middle" font-size="22" fill="#495057">Co udělá magnet?</text>`;
const dvaMagnety = (leveP: string, praveP: string, popis: string) =>
	`${pozadi('#fff9db')}${puls()}<g><rect x="60" y="160" width="190" height="80" rx="10" fill="#495057" stroke="#212529" stroke-width="4"/><text x="215" y="213" text-anchor="middle" font-size="38" font-weight="800" fill="#fff">${leveP}</text></g><g><rect x="390" y="160" width="190" height="80" rx="10" fill="#495057" stroke="#212529" stroke-width="4"/><text x="425" y="213" text-anchor="middle" font-size="38" font-weight="800" fill="#fff">${praveP}</text></g>${titulek(popis, 320, '#343a40', 25)}`;

// Železné piliny rozsypané NÁHODNĚ (pevné semínko) – před odhalením netvoří žádný obrazec.
function piliny(): string {
	let s = 7;
	const nahoda = () => { s = (s * 16807) % 2147483647; return s / 2147483647; };
	const pismena = [[245, 170, 295, 236], [345, 170, 395, 236]];
	const body: string[] = [];
	while (body.length < 70) {
		const x = Math.round(150 + nahoda() * 340); const y = Math.round(142 + nahoda() * 116);
		if (pismena.some(([x1, y1, x2, y2]) => x > x1 - 6 && x < x2 + 6 && y > y1 - 6 && y < y2 + 6)) continue;
		body.push(`<circle cx="${x}" cy="${y}" r="3" fill="#343a40"/>`);
	}
	return `<g>${body.join('')}<animate attributeName="opacity" values="1;.6;1" dur="2.5s" repeatCount="indefinite"/></g>`;
}

// Vrstva „před“ je vidět jen do odhalení, vrstva „po“ (děj = výsledek) až po odhalení.
// Obě přepíná skript; počáteční snímek animací ve vrstvě „po“ je její konečný stav (reduced-motion).
const pred = (obsah: string) => `<g data-pred="1" opacity="1">${obsah}</g>`;
const po = (obsah: string) => `<g data-odhal="1" opacity="0" aria-hidden="true">${obsah}</g>`;
const hrebik = (x: number) => `<path d="M${x} 200 H${x + 110} L${x + 130} 216 L${x + 110} 232 H${x}Z" fill="#868e96" stroke="#212529" stroke-width="4"/>`;
// Pilinový obrazec po odhalení: piliny podél oblouků od pólu N k pólu S a paprsky u pólů.
const obrazecPilin = () => {
	const oblouky = [20, 34].flatMap((k) => [`M400 164 C400 ${164 - k} 240 ${164 - k} 240 164`, `M400 236 C400 ${236 + k} 240 ${236 + k} 240 236`]);
	const paprsky = ['M212 200 H152', 'M212 182 L156 160', 'M212 218 L156 240', 'M428 200 H488', 'M428 182 L484 160', 'M428 218 L484 240'];
	return `<path d="${[...oblouky, ...paprsky].join(' ')}" fill="none" stroke="#343a40" stroke-width="4" stroke-dasharray="3 5" stroke-linecap="round"/>`;
};

function scenaSvg(s: string): string {
	switch (s) {
		case 'zelezo': return material('železný hřebík', `${pred(hrebik(435))}${po(hrebik(249))}`);
		case 'hlinik': return material('hliníková destička', `<rect x="425" y="155" width="130" height="100" rx="8" fill="#ced4da" stroke="#495057" stroke-width="4"/><path d="M445 178 H535 M445 202 H535 M445 226 H535" stroke="#fff" stroke-width="5"/>${po(`<text x="490" y="138" text-anchor="middle" font-size="20" font-weight="800" fill="#343a40">téměř nereaguje</text><path d="M415 205 H282 M296 193 L282 205 L296 217" fill="none" stroke="#495057" stroke-width="5" stroke-dasharray="10 7" stroke-linecap="round"/><path d="M336 191 L362 219 M362 191 L336 219" fill="none" stroke="${CERVENA}" stroke-width="6" stroke-linecap="round"/>`)}`);
		case 'tuha': return `${pozadi('#e7f5ff')}${puls()}<g><rect x="80" y="240" width="60" height="44" rx="6" fill="${MODRA}" stroke="#212529" stroke-width="3"/><rect x="140" y="240" width="60" height="44" rx="6" fill="${CERVENA}" stroke="#212529" stroke-width="3"/><rect x="200" y="240" width="60" height="44" rx="6" fill="${MODRA}" stroke="#212529" stroke-width="3"/><rect x="260" y="240" width="60" height="44" rx="6" fill="${CERVENA}" stroke="#212529" stroke-width="3"/></g>${pred('<rect x="430" y="270" width="110" height="14" rx="4" fill="#343a40"/>')}${po('<rect x="145" y="212" width="110" height="14" rx="4" fill="#343a40"><animateTransform attributeName="transform" type="translate" values="0 0;0 -6;0 0" dur="2.4s" repeatCount="indefinite"/></rect>')}<line x1="50" y1="288" x2="590" y2="288" stroke="#868e96" stroke-width="4"/><text x="200" y="330" text-anchor="middle" font-size="22" font-weight="800" fill="#343a40">silné magnety</text>${pred('<text x="485" y="330" text-anchor="middle" font-size="22" font-weight="800" fill="#343a40">tuha z tužky</text>')}${po('<text x="200" y="190" text-anchor="middle" font-size="22" font-weight="800" fill="#343a40">tuha z tužky</text>')}`;
		case 'netecne': return `${pozadi('#e7f5ff')}${puls()}${magnet()}<rect x="306" y="168" width="28" height="64" fill="#ffd43b"><animate attributeName="fill-opacity" values="1;.5;1" dur="2s" repeatCount="indefinite"/></rect>${titulek('netečné pásmo', 330)}${po([226, 242, 392, 408].map((x) => `<rect x="${x}" y="240" width="6" height="44" rx="2" fill="#868e96" stroke="#212529" stroke-width="2"/>`).join(''))}`;
		case 'magnetit': return `${pozadi('#e7f5ff')}${puls()}<path d="M250 250 L268 182 L330 158 L392 184 L402 240 L340 268Z" fill="#5c5f66" stroke="#212529" stroke-width="4"/><path d="M290 200 L320 186 M350 230 L372 214" stroke="#adb5bd" stroke-width="4" stroke-linecap="round"><animate attributeName="stroke-opacity" values="1;.3;1" dur="2.4s" repeatCount="indefinite"/></path>${titulek('magnetit (magnetovec)', 320, '#343a40', 26)}${po([[296, 258], [346, 262], [376, 250]].map(([x, y]) => `<rect x="${x}" y="${y}" width="10" height="22" rx="4" fill="none" stroke="#495057" stroke-width="3"/>`).join('') + '<text x="320" y="140" text-anchor="middle" font-size="20" font-weight="800" fill="#343a40">přírodní nerost</text>')}`;
		case 'okoli-magnetu': return `${pozadi('#fff9db')}${puls()}${magnet()}${titulek('Kde vzniká magnetické pole?', 330)}${po('<path d="M400 164 C400 138 240 138 240 164 M400 236 C400 266 240 266 240 236 M410 236 C420 290 220 290 230 236 M212 200 H160 M428 200 H480" fill="none" stroke="#5f3dc4" stroke-width="4" stroke-dasharray="10 7"/>')}`;
		case 'rozdel': return `${pozadi('#fff9db')}${puls()}<rect x="150" y="165" width="150" height="70" rx="8" fill="#495057" stroke="#333" stroke-width="4"/><rect x="340" y="165" width="150" height="70" rx="8" fill="#495057" stroke="#333" stroke-width="4"/>${pred('<text x="225" y="213" text-anchor="middle" font-size="38" fill="#fff">?</text><text x="415" y="213" text-anchor="middle" font-size="38" fill="#fff">?</text>')}${po([150, 340].map((x) => `<rect x="${x}" y="165" width="75" height="70" rx="8" fill="${MODRA}" stroke="#212529" stroke-width="4"/><rect x="${x + 75}" y="165" width="75" height="70" rx="8" fill="${CERVENA}" stroke="#212529" stroke-width="4"/><text x="${x + 37}" y="212" text-anchor="middle" font-size="34" font-weight="800" fill="#fff">S</text><text x="${x + 112}" y="212" text-anchor="middle" font-size="34" font-weight="800" fill="#fff">N</text>`).join(''))}${titulek('rozdělený magnet', 310, '#343a40', 25)}`;
		case 'stejne': return `${dvaMagnety('N', 'N', 'stejné póly proti sobě')}${po(`<path d="M200 272 H90 M104 260 L90 272 L104 284 M440 272 H550 M536 260 L550 272 L536 284" fill="none" stroke="${CERVENA}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>`)}`;
		case 'blizko': return`${pozadi('#e7f5ff')}${puls()}${magnet(75, 164)}<g><circle cx="390" cy="200" r="15" fill="#fab005" stroke="#333" stroke-width="3"/><circle cx="555" cy="200" r="15" fill="#fab005" stroke="#333" stroke-width="3"/></g><text x="390" y="255" text-anchor="middle" font-size="22" fill="#343a40">blízko</text><text x="555" y="255" text-anchor="middle" font-size="22" fill="#343a40">daleko</text>${po(`<path d="M405 160 H300 M314 148 L300 160 L314 172 M570 160 H532 M546 148 L532 160 L546 172" fill="none" stroke="${CERVENA}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>`)}`;
		case 'piliny': return `${pozadi('#fff9db')}${puls()}${magnet()}<rect x="140" y="134" width="360" height="132" rx="6" fill="none" stroke="#868e96" stroke-width="3"/>${pred(piliny())}${titulek('karton s pilinami nad magnetem', 330)}${po(obrazecPilin())}`;
		case 'otevrene': return `${pozadi('#e7f5ff')}${puls()}${magnet()}${titulek('Jaký tvar mají indukční čáry?', 315)}${po('<path d="M420 200 C480 200 480 134 320 134 C160 134 160 200 220 200 M420 200 C480 200 480 266 320 266 C160 266 160 200 220 200" fill="none" stroke="#5f3dc4" stroke-width="4"/>')}`;
		case 'smer': return `${pozadi('#fff9db')}${puls()}${magnet()}<path d="M415 240 C430 335 210 335 225 240" fill="none" stroke="#495057" stroke-width="5"><animate attributeName="stroke-opacity" values="1;.45;1" dur="2s" repeatCount="indefinite"/></path>${titulek('Kterým směrem vedou čáry vně magnetu?', 375)}${po('<path d="M332 299 L312 311 L332 323" fill="none" stroke="#495057" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>')}`;
		case 'zeme-ochrana': return `${pozadi('#212529')}<circle cx="-20" cy="205" r="80" fill="#ffd43b"/>${puls(130, 80, 22)}${pred('<g stroke="#ffd43b" stroke-width="6" stroke-linecap="round" stroke-dasharray="14 10"><line x1="75" y1="150" x2="290" y2="165"/><line x1="75" y1="205" x2="285" y2="205"/><line x1="75" y1="260" x2="290" y2="245"/><animate attributeName="stroke-dashoffset" values="48;0" dur="1.6s" repeatCount="indefinite"/></g>')}<circle cx="420" cy="205" r="105" fill="#4dabf7" stroke="#fff" stroke-width="4"/><path d="M365 145 q45 -38 82 2 q28 32 -8 58 q-52 18 -80 -12z" fill="#51cf66"/>${titulek('Slunce, sluneční vítr a Země', 370, '#ffffff')}${po(['M75 150 L250 162 C310 90 420 56 590 56', 'M75 205 L245 205 C250 150 290 100 380 82', 'M75 260 L250 248 C300 320 430 335 590 335'].map((d) => `<path d="${d}" fill="none" stroke="#ffd43b" stroke-width="6" stroke-linecap="round" stroke-dasharray="14 10"><animate attributeName="stroke-dashoffset" values="48;0" dur="1.6s" repeatCount="indefinite"/></path>`).join(''))}`;
		case 'zeme-sever': return `${pozadi('#212529')}<defs><clipPath id="zeme-kruh"><circle cx="320" cy="215" r="96"/></clipPath></defs><circle cx="320" cy="215" r="100" fill="#4dabf7" stroke="#fff" stroke-width="4"/><g clip-path="url(#zeme-kruh)"><path d="M270 165 q55 -45 85 5 q30 35 -5 62 q-45 18 -75 -10z" fill="#51cf66"><animate attributeName="fill-opacity" values="1;.75;1" dur="3s" repeatCount="indefinite"/></path></g><line x1="320" y1="100" x2="320" y2="330" stroke="#fff" stroke-width="3" stroke-dasharray="9 8"/><circle cx="320" cy="100" r="6" fill="#fff"/><circle cx="320" cy="330" r="6" fill="#fff"/>${pred('<line x1="330" y1="103" x2="422" y2="123" stroke="#fff" stroke-width="2"/>')}${puls(440, 128, 16)}${titulek('severní zeměpisný pól', 80, '#ffffff', 22)}${titulek('jižní zeměpisný pól', 372, '#ffffff', 22)}${po(`<rect x="302" y="128" width="36" height="86" rx="6" fill="${MODRA}" stroke="#fff" stroke-width="3"/><rect x="302" y="214" width="36" height="86" rx="6" fill="${CERVENA}" stroke="#fff" stroke-width="3"/><text x="320" y="180" text-anchor="middle" font-size="26" font-weight="800" fill="#fff">S</text><text x="320" y="266" text-anchor="middle" font-size="26" font-weight="800" fill="#fff">N</text>`)}`;
		case 'reproduktor': return `${pozadi('#e7f5ff')}${puls()}<rect x="230" y="175" width="60" height="80" rx="6" fill="#495057" stroke="#212529" stroke-width="4"/><path d="M290 175 L370 140 L370 290 L290 255Z" fill="#868e96" stroke="#212529" stroke-width="4"/><path d="M395 185 q18 30 0 60 M420 170 q30 45 0 90" fill="none" stroke="#495057" stroke-width="5" stroke-linecap="round"><animate attributeName="stroke-opacity" values="1;.3;1" dur="1.4s" repeatCount="indefinite"/></path>${titulek('reproduktor', 335, '#343a40', 26)}${po(`<rect x="240" y="195" width="20" height="40" fill="${MODRA}" stroke="#fff" stroke-width="2"/><rect x="260" y="195" width="20" height="40" fill="${CERVENA}" stroke="#fff" stroke-width="2"/>`)}`;
		default: return '';
	}
}

const scenyHtml: Record<string, string> = {};
for (const c of karty) {
	scenyHtml[c.id] = `<svg viewBox="0 0 640 400" role="img" aria-label="${c.otazka}" xmlns="http://www.w3.org/2000/svg" font-family="sans-serif">
${scenaSvg(c.scena)}
<g data-odhal="1" opacity="0" aria-hidden="true"><rect x="90" y="2" width="460" height="40" rx="12" fill="#fff" stroke="#2b8a3e" stroke-width="4"/><text x="320" y="30" text-anchor="middle" font-size="23" font-weight="800" fill="#1b4d2a">${c.napis}</text></g></svg>`;
}
const maxBodu = KOLA.reduce((s, k) => s + k.karty.length * k.body, 0);
---

<div id="hra-magnety" data-kola={JSON.stringify(KOLA)}>
	<section id="nastaveni">
		<h1><span class="podtrh">🧲 Magnetická výzva</span></h1>
		<p class="podnadpis">Hra pro třídu · Magnety a magnetické pole · 9. ročník · asi 12 minut</p>
		<ol class="pravidla">
			<li><b>3 kola (5 + 5 + 5 karet):</b> látky, magnety a jejich využití · póly a magnetické pole · zviditelnění pole, indukční čáry a magnetické pole Země.</li>
			<li>Na každé kartě je animovaná scéna a otázka. Týmy se poradí a po odpočtu <b>zvednou kartu A, nebo B</b>.</li>
			<li>Za správnou odpověď 1 bod, ve <b>FINÁLE 2 body</b>.</li>
		</ol>
		<p class="pozn">Karty A/B: <a href="/hry/karty" target="_blank">vytisknout</a> (C se nepoužije), nebo stačí papír s velkým A a B. Maximum je {maxBodu} bodů.</p>
		<div class="volby">
			<label>Počet týmů <select id="pocet-tymu">{[2, 3, 4, 5, 6].map((n) => <option value={n} selected={n === 4}>{n}</option>)}</select></label>
			<label>Čas na kartu <select id="cas-karty"><option value="10">10 s</option><option value="15" selected>15 s</option><option value="20">20 s</option></select></label>
		</div>
		<div id="jmena-tymu"></div>
		<button id="start" class="velke-tlacitko">Začít hru ▶</button>
	</section>

	<section id="uvod-kola" hidden>
		<p class="cislo-kola" id="uvod-cislo"></p><h1 id="uvod-nazev"></h1><p class="pravidlo" id="uvod-pravidlo"></p>
		<div class="moznosti uvod-moznosti">
			<div class="moznost moznost-A"><b>A</b><span><span class="m-popis" id="uvod-A"></span><small id="uvod-A2"></small></span></div>
			<div class="moznost moznost-B"><b>B</b><span><span class="m-popis" id="uvod-B"></span><small id="uvod-B2"></small></span></div>
		</div>
		<p class="za-body" id="uvod-body"></p><button id="hrajeme" class="velke-tlacitko">Hrajeme ▶</button>
	</section>

	<section id="karta" hidden>
		<header class="lista"><span id="lista-kolo"></span><span id="lista-body" class="lista-body"></span><span id="odpocet-cislo" class="odpocet-cislo"></span><button id="cela-obrazovka" class="male-tlacitko" title="Celá obrazovka (na projektor)">⛶</button></header>
		<div id="odpocet-pruh"><div id="odpocet-vypln"></div></div>
		<div class="plocha">
			<div class="leva">
				<div class="scena-obal">{karty.map((k) => <div class="scena skryta" data-karta={k.id} set:html={scenyHtml[k.id]} />)}</div>
				<div id="odhaleni" hidden><p id="proc" class="proc"></p><p id="citace" class="citace"></p><p class="pokyn">Klepni na týmy, které zvedly správnou kartu ↓</p></div>
			</div>
			<div class="prava">
				<h2 id="otazka"></h2>
				<div class="moznosti"><div class="moznost moznost-A" data-m="A"><b>A</b><span><span class="m-popis"></span><small></small></span></div><div class="moznost moznost-B" data-m="B"><b>B</b><span><span class="m-popis"></span><small></small></span></div></div>
				<div class="ovladani"><button id="odhalit" class="velke-tlacitko">Odhalit odpověď ✔</button><button id="dalsi" class="velke-tlacitko" hidden>Další karta ▶</button></div>
			</div>
		</div>
		<div id="tymy" class="tymy"></div>
	</section>

	<section id="vysledky" hidden>
		<h1><span class="podtrh">🎉 Konečné pořadí</span></h1><ol id="podium"></ol>
		<p class="shrnuti">Pamatuj: <b>magnet působí na feromagnetické látky, má vždy oba póly a jeho indukční čáry jsou uzavřené.</b> Stejné póly se odpuzují a opačné se přitahují.</p>
		<button id="znovu" class="velke-tlacitko">Nová hra 🔄</button>
	</section>
</div>

<script>
	type Odp = 'A' | 'B';
	type Mozn = { popis: string; doplnek: string };
	type K = { id: string; otazka: string; spravne: Odp; proc: string; zdroj: string };
	type Kolo = { cislo: number; nazev: string; pravidlo: string; moznosti: Record<Odp, Mozn>; body: number; karty: K[] };
	type Tym = { jmeno: string; body: number };
	const $ = (id: string) => document.getElementById(id)!;
	const KOLA: Kolo[] = JSON.parse($('hra-magnety').dataset.kola!);
	const omezenyPohyb = window.matchMedia('(prefers-reduced-motion: reduce)');
	let tymy: Tym[] = []; let iKolo = 0; let iKarta = 0; let casNaKartu = 15; let odpocetId: ReturnType<typeof setInterval> | undefined; let odhaleno = false;
	const kolo = () => KOLA[iKolo]; const karta = () => kolo().karty[iKarta];
	function poradi(t: Tym[]) { const s = t.map((x, i) => ({ ...x, i })).sort((a, b) => b.body - a.body || a.i - b.i); return s.map((x) => ({ jmeno: x.jmeno, body: x.body, misto: s.findIndex((u) => u.body === x.body) + 1 })); }
	function ukaz(sekce: string) { for (const id of ['nastaveni', 'uvod-kola', 'karta', 'vysledky']) $(id).hidden = id !== sekce; $('hra-magnety').scrollIntoView({ block: 'start' }); }
	function vykresliJmena() { const n = +($('pocet-tymu') as HTMLSelectElement).value; const barvy = ['Červení', 'Modří', 'Zelení', 'Žlutí', 'Fialoví', 'Oranžoví']; $('jmena-tymu').innerHTML = Array.from({ length: n }, (_, i) => `<input class="jmeno-tymu" value="${barvy[i]}" maxlength="16">`).join(''); }
	$('pocet-tymu').addEventListener('change', vykresliJmena); vykresliJmena();
	$('start').addEventListener('click', () => { tymy = [...document.querySelectorAll<HTMLInputElement>('.jmeno-tymu')].map((el, i) => ({ jmeno: el.value.trim() || `Tým ${i + 1}`, body: 0 })); casNaKartu = +($('cas-karty') as HTMLSelectElement).value; iKolo = 0; uvodKola(); });
	function uvodKola() { const k = kolo(); $('uvod-cislo').textContent = `Kolo ${k.cislo} ze ${KOLA.length}`; $('uvod-nazev').textContent = k.nazev; $('uvod-pravidlo').textContent = k.pravidlo; $('uvod-A').textContent = k.moznosti.A.popis; $('uvod-A2').textContent = k.moznosti.A.doplnek; $('uvod-B').textContent = k.moznosti.B.popis; $('uvod-B2').textContent = k.moznosti.B.doplnek; $('uvod-body').textContent = k.body === 1 ? 'Za každou správnou kartu 1 bod.' : `Za každou správnou kartu ${k.body} body!`; ukaz('uvod-kola'); }
	$('hrajeme').addEventListener('click', () => { iKarta = 0; ukaz('karta'); zobrazKartu(); });
	function nastavPohyb(svg: SVGSVGElement, aktivni: boolean) { svg.setCurrentTime?.(0); if (!aktivni || omezenyPohyb.matches) svg.pauseAnimations?.(); else svg.unpauseAnimations?.(); }
	function zobrazKartu() { const k = kolo(); const c = karta(); odhaleno = false; $('lista-kolo').textContent = `Kolo ${k.cislo}/${KOLA.length} · karta ${iKarta + 1}/${k.karty.length}`; $('lista-body').textContent = k.body === 1 ? 'za 1 bod' : `⭐ FINÁLE · za ${k.body} body`; document.querySelectorAll<HTMLElement>('.scena').forEach((s) => { const aktivni = s.dataset.karta === c.id; s.classList.toggle('skryta', !aktivni); const svg = s.querySelector<SVGSVGElement>('svg'); if (svg) nastavPohyb(svg, aktivni); }); document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-odhal]`).forEach((el) => { el.setAttribute('opacity', '0'); el.setAttribute('aria-hidden', 'true'); }); document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-pred]`).forEach((el) => el.setAttribute('opacity', '1')); $('otazka').textContent = c.otazka; document.querySelectorAll<HTMLElement>('#karta .moznost').forEach((el) => { const m = el.dataset.m as Odp; el.querySelector('.m-popis')!.textContent = k.moznosti[m].popis; el.querySelector('small')!.textContent = k.moznosti[m].doplnek; el.classList.remove('spravna', 'spatna'); }); $('odhaleni').hidden = true; $('odhalit').hidden = false; $('dalsi').hidden = true; vykresliTymy(); spustOdpocet(); }
	function spustOdpocet() { let zbyva = casNaKartu; const vypln = $('odpocet-vypln'); $('odpocet-cislo').textContent = `${zbyva} s`; vypln.style.transition = 'none'; vypln.style.width = '100%'; requestAnimationFrame(() => requestAnimationFrame(() => { vypln.style.transition = `width ${casNaKartu}s linear`; vypln.style.width = '0%'; })); clearInterval(odpocetId); odpocetId = setInterval(() => { zbyva--; $('odpocet-cislo').textContent = `${Math.max(zbyva, 0)} s`; if (zbyva <= 3 && zbyva > 0) pipni(600); if (zbyva <= 0) { clearInterval(odpocetId); pipni(880, .4); $('odpocet-cislo').textContent = 'Zvedněte karty!'; } }, 1000); }
	function pipni(frekvence: number, delka = .12) { try { const w = window as unknown as { _ctxHry?: AudioContext }; const ctx = (w._ctxHry ??= new AudioContext()); const osc = ctx.createOscillator(); const gain = ctx.createGain(); osc.frequency.value = frekvence; gain.gain.value = .15; osc.connect(gain).connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime + delka); } catch { /* bez zvuku */ } }
	$('odhalit').addEventListener('click', () => { clearInterval(odpocetId); const c = karta(); odhaleno = true; $('odpocet-cislo').textContent = ''; $('odpocet-vypln').style.transition = 'none'; $('odpocet-vypln').style.width = '0%'; document.querySelectorAll<HTMLElement>('#karta .moznost').forEach((el) => { el.classList.toggle('spravna', el.dataset.m === c.spravne); el.classList.toggle('spatna', el.dataset.m !== c.spravne); }); document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-odhal]`).forEach((el) => { el.setAttribute('opacity', '1'); el.setAttribute('aria-hidden', 'false'); }); document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-pred]`).forEach((el) => el.setAttribute('opacity', '0')); $('proc').textContent = `✔ ${c.proc}`; $('citace').textContent = `Zdroj: PDF Magnety, magnetické pole – opakování, ${c.zdroj}`; $('odhaleni').hidden = false; $('odhalit').hidden = true; $('dalsi').hidden = false; vykresliTymy(); });
	function vykresliTymy() { $('tymy').innerHTML = tymy.map((t, i) => `<div class="tym-obal"><button class="tym" data-i="${i}" ${odhaleno ? '' : 'disabled'}><span class="tym-jmeno">${t.jmeno}</span><b class="tym-body">${t.body}</b></button></div>`).join(''); document.querySelectorAll<HTMLButtonElement>('.tym').forEach((b) => b.addEventListener('click', () => b.classList.toggle('oznaceny'))); }
	$('dalsi').addEventListener('click', () => { const body = kolo().body; document.querySelectorAll<HTMLElement>('.tym.oznaceny').forEach((b) => (tymy[+b.dataset.i!].body += body)); iKarta++; if (iKarta < kolo().karty.length) return zobrazKartu(); iKolo++; if (iKolo < KOLA.length) return uvodKola(); konec(); });
	function konec() { clearInterval(odpocetId); ukaz('vysledky'); const medaile = ['🥇', '🥈', '🥉']; $('podium').innerHTML = poradi(tymy).map((t) => `<li class="podium-radek">${medaile[t.misto - 1] ?? '🏅'} ${t.misto}. <b>${t.jmeno}</b> — ${t.body} b.</li>`).join(''); if (!omezenyPohyb.matches) for (let i = 0; i < 40; i++) { const k = document.createElement('span'); k.className = 'konfeta'; k.textContent = ['🎉', '⭐', '🎊', '🧲'][i % 4]; k.style.left = Math.random() * 100 + 'vw'; k.style.animationDelay = Math.random() * 2 + 's'; document.body.appendChild(k); } }
	omezenyPohyb.addEventListener('change', () => document.querySelectorAll<SVGSVGElement>('.scena svg').forEach((svg) => { if (omezenyPohyb.matches) svg.pauseAnimations?.(); }));
	$('znovu').addEventListener('click', () => location.reload()); $('cela-obrazovka').addEventListener('click', () => { if (document.fullscreenElement) document.exitFullscreen(); else $('hra-magnety').requestFullscreen?.(); });
</script>

<style>
	#hra-magnety { max-width: 1200px; margin: 0 auto; background: var(--papir); }
	#hra-magnety:fullscreen { max-width: none; padding: 1rem 2rem; overflow: auto; }
	.podnadpis { font-size: 1.3rem; color: #495057; margin-top: -.6rem; }
	.pravidla li { margin: .3rem 0; } .pozn { color: #5c5f66; font-size: 1.1rem; }
	.volby { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 1rem 0; } .volby label { display: flex; flex-direction: column; font-weight: 700; gap: .3rem; } .volby select { font-size: 1.2rem; padding: .3rem; }
	#jmena-tymu { display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 1rem; } #jmena-tymu :global(.jmeno-tymu) { font-size: 1.3rem; padding: .4rem; border: 2px solid #333; border-radius: 8px; width: 9rem; font-family: inherit; }
	.velke-tlacitko { font-size: 1.5rem; padding: .6rem 2rem; border-radius: 12px; border: 3px solid #333; background: #ffe066; cursor: pointer; font-weight: 800; font-family: inherit; } .velke-tlacitko:hover { transform: scale(1.04); }
	.male-tlacitko { font-size: 1rem; padding: .4rem .8rem; border-radius: 10px; border: 2px solid #888; background: #fff; cursor: pointer; font-family: inherit; margin-left: auto; }
	#uvod-kola { text-align: center; padding-top: 1rem; } .cislo-kola { font-size: 1.6rem; font-weight: 800; color: #9a3412; margin: 0; } #uvod-nazev { font-size: 2.9rem; margin: .1rem 0 .4rem; line-height: 1.15; } .pravidlo { font-size: 1.6rem; line-height: 1.35; max-width: 46rem; margin: 0 auto 1rem; }
	.uvod-moznosti { max-width: 46rem; margin: 0 auto; text-align: left; } .za-body { font-size: 1.6rem; font-weight: 800; }
	.lista { display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 1.4rem; font-weight: 800; line-height: 1.2; } .lista-body { color: #9a3412; flex: 1; text-align: center; } .odpocet-cislo { min-width: 5rem; text-align: right; color: #c92a2a; }
	#odpocet-pruh { height: 12px; background: #e9ecef; border-radius: 6px; overflow: hidden; margin: .3rem 0 .6rem; } #odpocet-vypln { height: 100%; width: 100%; background: linear-gradient(90deg, #40c057, #ffd43b, #fa5252); }
	.plocha { display: grid; grid-template-columns: 3fr 2fr; gap: 1.2rem; align-items: start; } .scena-obal { position: relative; } .scena.skryta { visibility: hidden; position: absolute; top: 0; left: 0; width: 100%; pointer-events: none; } .scena-obal :global(svg) { display: block; width: 100%; height: auto; border: 3px solid #333; border-radius: 14px; background: #fff; }
	#otazka { font-size: 1.85rem; line-height: 1.2; margin: 0 0 .8rem; } .moznosti { display: grid; gap: .7rem; } .moznost { display: flex; align-items: center; gap: .9rem; padding: .45rem 1rem; border: 4px solid #333; border-radius: 14px; background: #fff; transition: opacity .3s; } .moznost > b { flex: none; width: 3rem; height: 3rem; border-radius: 50%; color: #fff; font-size: 2rem; display: flex; align-items: center; justify-content: center; } .moznost-A > b { background: #c92a2a; } .moznost-B > b { background: #1864ab; } .m-popis { display: block; font-size: 2rem; font-weight: 800; line-height: 1.1; } .moznost small { display: block; font-size: 1.1rem; color: #495057; line-height: 1.2; } .moznost.spravna { background: #d3f9d8; border-color: #2b8a3e; box-shadow: 0 0 0 5px #8ce99a; } .moznost.spatna { background: #f1f3f5; border-color: #adb5bd; }
	.proc { font-size: 1.5rem; font-weight: 700; color: #1b4d2a; margin: .5rem 0 .1rem; line-height: 1.25; } .citace { margin: .15rem 0; color: #5c5f66; font-size: 1rem; } .pokyn { font-weight: 700; margin: .2rem 0 0; font-size: 1.15rem; color: #495057; }
	.tymy { display: flex; flex-wrap: wrap; gap: .6rem; align-items: flex-start; margin-top: .7rem; } .tymy :global(.tym-obal) { display: flex; gap: .25rem; align-items: stretch; } .tymy :global(.tym) { display: flex; align-items: center; gap: .6rem; font-size: 1.3rem; font-family: inherit; padding: .3rem .8rem; border-radius: 12px; border: 3px solid #333; background: #fff; cursor: pointer; color: inherit; } .tymy :global(.tym:disabled) { cursor: default; opacity: 1; } .tymy :global(.tym-body) { font-size: 1.8rem; min-width: 2rem; text-align: center; } .tymy :global(.tym.oznaceny) { background: #d3f9d8; border-color: #2b8a3e; } .tymy :global(.tym.oznaceny .tym-body::after) { content: ' ✔'; color: #1b4d2a; }
	.ovladani { display: flex; justify-content: flex-end; margin-top: .9rem; } #podium { padding: 0; list-style: none; } #podium :global(.podium-radek) { font-size: 2rem; margin: .5rem 0; } .shrnuti { font-size: 1.4rem; } :global(.konfeta) { position: fixed; top: -3rem; font-size: 1.8rem; animation: pad 3.2s linear infinite; z-index: 99; } @keyframes pad { to { transform: translateY(110vh) rotate(360deg); } }
	@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } .velke-tlacitko:hover { transform: none; } :global(.konfeta) { display: none; } }
	@media (max-width: 900px) { .plocha { grid-template-columns: 1fr; } #otazka { font-size: 1.5rem; } .lista { font-size: 1.05rem; flex-wrap: wrap; gap: .3rem .6rem; } .lista-body { white-space: nowrap; flex: none; } .m-popis { font-size: 1.6rem; } }
</style>
