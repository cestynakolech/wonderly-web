---
// Statická infografika: Tání
// Fázová přeměna: led → voda bez změny teploty
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Tání: přeměna ledu na vodu 🧊❄️</span></h2>
	<p><strong>Tání</strong> je přeměna pevné látky na kapalinu. Během tání se <strong>teplota nemění</strong>, všechna dodaná energie jde na přerušení pevné mřížky ledu.</p>
	<svg viewBox="0 0 700 420" class="infografika-svg">
		<!-- Pozadí -->
		<rect width="700" height="420" fill="#f5f0e8"/>
		
		<!-- Nadpis -->
		<text x="350" y="35" text-anchor="middle" class="diagram-title">PROCES TÁNÍ LEDU</text>
		
		<!-- DOBA 1: Studený led -->
		<g id="doba-1">
			<text x="120" y="80" text-anchor="middle" class="stage-label">LED (−5 °C)</text>
			
			<!-- Kryštaly ledu -->
			<rect x="80" y="100" width="20" height="40" fill="#b3e5fc" stroke="#0277bd" stroke-width="2" rx="2"/>
			<rect x="110" y="100" width="20" height="40" fill="#b3e5fc" stroke="#0277bd" stroke-width="2" rx="2"/>
			<rect x="140" y="100" width="20" height="40" fill="#b3e5fc" stroke="#0277bd" stroke-width="2" rx="2"/>
			
			<!-- Molekuly vibřují - staticky -->
			<circle cx="90" cy="125" r="3" fill="#01579b"/>
			<circle cx="120" cy="125" r="3" fill="#01579b"/>
			<circle cx="150" cy="125" r="3" fill="#01579b"/>
			
			<!-- Info -->
			<text x="120" y="170" text-anchor="middle" class="info-text">Molekuly</text>
			<text x="120" y="185" text-anchor="middle" class="info-text">pevně svázány</text>
			<text x="120" y="210" text-anchor="middle" class="temp-label">T = −5 °C</text>
		</g>
		
		<!-- ŠIPKA: Přidáme teplo -->
		<path d="M 200 140 L 260 140" stroke="#e74c3c" stroke-width="3"/>
		<path d="M 255 135 L 270 140 L 255 145" fill="#e74c3c"/>
		<text x="230" y="130" text-anchor="middle" class="action-text">+ TEPLO</text>
		
		<!-- DOBA 2: Tání - teplota se NEMĚNÍ -->
		<g id="doba-2">
			<text x="380" y="80" text-anchor="middle" class="stage-label">TÁNÍ (0 °C) ⚠️</text>
			
			<!-- Částečně roztavený led + voda -->
			<rect x="340" y="100" width="20" height="40" fill="#81d4fa" stroke="#01579b" stroke-width="2" rx="2"/>
			<rect x="370" y="100" width="20" height="40" fill="#4fc3f7" stroke="#0277bd" stroke-width="1" rx="1"/>
			<ellipse cx="400" cy="125" rx="12" ry="15" fill="#4fc3f7" stroke="#01579b" stroke-width="1"/>
			
			<!-- Molekuly se uvolňují -->
			<circle cx="355" cy="125" r="3" fill="#01579b"/>
			<circle cx="385" cy="125" r="3" fill="#01579b"/>
			<circle cx="405" cy="130" r="3" fill="#01579b"/>
			<circle cx="405" cy="115" r="3" fill="#01579b"/>
			
			<!-- Termometr -->
			<rect x="430" y="100" width="8" height="40" fill="white" stroke="#333" stroke-width="1"/>
			<circle cx="434" cy="145" r="5" fill="#e74c3c"/>
			<text x="460" y="125" class="temp-label">T = 0 °C</text>
			
			<!-- Info -->
			<text x="380" y="170" text-anchor="middle" class="info-text">Mřížka se</text>
			<text x="380" y="185" text-anchor="middle" class="info-text">rozpadá</text>
			<text x="380" y="210" text-anchor="middle" class="key-point">Teplota se NEMĚNÍ!</text>
		</g>
		
		<!-- ŠIPKA: Pokračujeme v přidávání tepla -->
		<path d="M 480 140 L 540 140" stroke="#e74c3c" stroke-width="3"/>
		<path d="M 535 135 L 550 140 L 535 145" fill="#e74c3c"/>
		<text x="510" y="130" text-anchor="middle" class="action-text">+ VÍCE TEPLA</text>
		
		<!-- DOBA 3: Voda -->
		<g id="doba-3">
			<text x="630" y="80" text-anchor="middle" class="stage-label">VODA (20 °C)</text>
			
			<!-- Kapalina - roztékající se -->
			<ellipse cx="620" cy="125" rx="40" ry="20" fill="#4fc3f7" stroke="#01579b" stroke-width="2"/>
			<line x1="580" y1="145" x2="660" y2="145" stroke="#01579b" stroke-width="1"/>
			
			<!-- Molekuly se pohybují -->
			<circle cx="600" cy="115" r="3" fill="#01579b"/>
			<circle cx="630" cy="120" r="3" fill="#01579b"/>
			<circle cx="650" cy="130" r="3" fill="#01579b"/>
			<circle cx="610" cy="135" r="3" fill="#01579b"/>
			
			<!-- Termometr -->
			<rect x="670" y="100" width="8" height="50" fill="white" stroke="#333" stroke-width="1"/>
			<circle cx="674" cy="120" r="5" fill="#e74c3c"/>
			<text x="700" y="130" class="temp-label">T = 20 °C</text>
			
			<!-- Info -->
			<text x="630" y="170" text-anchor="middle" class="info-text">Kapalina</text>
			<text x="630" y="185" text-anchor="middle" class="info-text">- molekuly volné</text>
			<text x="630" y="210" text-anchor="middle" class="key-point">Nyní roste teplota!</text>
		</g>
		
		<!-- Dolní část: Graf tání -->
		<text x="50" y="280" class="graph-title">GRAF TÁNÍ (teplota vs. čas):</text>
		
		<!-- Osy grafu -->
		<line x1="80" y1="320" x2="80" y2="380" stroke="#2b2a26" stroke-width="2"/>
		<line x1="80" y1="380" x2="650" y2="380" stroke="#2b2a26" stroke-width="2"/>
		
		<!-- Označení os -->
		<text x="40" y="350" text-anchor="middle" class="axis-label">Teplota</text>
		<text x="350" y="405" text-anchor="middle" class="axis-label">Čas</text>
		
		<!-- Křivka tání: stoupá → plató → stoupá -->
		<polyline points="90,350 150,290 250,290 350,250" stroke="#e74c3c" stroke-width="3" fill="none"/>
		
		<!-- Značka na plató -->
		<circle cx="200" cy="290" r="4" fill="#e74c3c"/>
		<text x="200" y="275" text-anchor="middle" class="info-text" font-weight="bold">TÁNÍ</text>
		<text x="200" y="315" text-anchor="middle" class="info-text">(T = konst.)</text>
	</svg>
</section>

<style>
	.infografika-svg {
		width: 100%;
		max-width: 700px;
		height: auto;
		border: 2px solid #ddd;
		border-radius: 8px;
	}
	.diagram-title {
		font-size: 16px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.stage-label {
		font-size: 14px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.info-text {
		font-size: 11px;
		fill: #555;
	}
	.temp-label {
		font-size: 12px;
		fill: #e74c3c;
		font-weight: bold;
	}
	.action-text {
		font-size: 11px;
		fill: #e74c3c;
		font-weight: bold;
	}
	.key-point {
		font-size: 12px;
		fill: #e74c3c;
		font-weight: bold;
	}
	.graph-title {
		font-size: 13px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.axis-label {
		font-size: 12px;
		fill: #2c3e50;
	}
</style>
