---
// Magnetické materiály — F9 pokročilé
// Rozdělení látek podle magnetických vlastností: feromagnetika, paramagnetika, diamagnetika
---

<section class="ramecek infografika">
	<h2><span class="podtrh">Magnetické materiály 🧲</span></h2>
	<p>
		Látky se dělí na tři skupiny podle jejich chování v magnetickém poli:
		<strong>feromagnetika</strong> (silně přitahuje magnet), <strong>paramagnetika</strong> (slabě přitahuje)
		a <strong>diamagnetika</strong> (slabě odpuzuje).
	</p>

	<svg viewBox="0 0 800 450" role="img" aria-label="Dělení magnetických materiálů">
		<!-- Pozadí -->
		<rect x="0" y="0" width="800" height="450" fill="#f8f9fa" />

		<!-- Nadpis -->
		<text x="400" y="35" text-anchor="middle" font-size="20" font-weight="bold" fill="#2b2a26">
			Rozdělení magnetických materiálů
		</text>

		<!-- 1. FEROMAGNETIKA (vlevo) -->
		<g id="feromagnetika">
			<!-- Hlavní box -->
			<rect x="30" y="70" width="220" height="350" rx="8" fill="#ffe0e0" stroke="#c92a2a" stroke-width="2" />

			<!-- Nadpis -->
			<text x="140" y="100" text-anchor="middle" font-size="16" font-weight="bold" fill="#c92a2a">
				Feromagnetika
			</text>

			<!-- Příklady -->
			<text x="45" y="135" font-size="12" font-weight="bold" fill="#2b2a26">Příklady:</text>
			<text x="45" y="155" font-size="11" fill="#2b2a26">• Železo (Fe)</text>
			<text x="45" y="175" font-size="11" fill="#2b2a26">• Kobalt (Co)</text>
			<text x="45" y="195" font-size="11" fill="#2b2a26">• Nikl (Ni)</text>
			<text x="45" y="215" font-size="11" fill="#2b2a26">• Neodymové magnety</text>

			<!-- Vlastnosti -->
			<text x="45" y="245" font-size="12" font-weight="bold" fill="#2b2a26">Vlastnosti:</text>
			<text x="45" y="265" font-size="11" fill="#2b2a26">→ Silně přitahuje magnet</text>
			<text x="45" y="285" font-size="11" fill="#2b2a26">→ Lze magnetizovat</text>
			<text x="45" y="305" font-size="11" fill="#2b2a26">→ Sám se chová jako magnet</text>
			<text x="45" y="325" font-size="11" fill="#2b2a26">→ Vysoká permeabilita</text>

			<!-- Ikon magnetu -->
			<rect x="80" y="345" width="120" height="40" rx="5" fill="#e03131" stroke="#2b2a26" stroke-width="2" />
			<text x="140" y="372" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">MAGNET</text>
		</g>

		<!-- 2. PARAMAGNETIKA (uprostřed) -->
		<g id="paramagnetika">
			<!-- Hlavní box -->
			<rect x="290" y="70" width="220" height="350" rx="8" fill="#fff3e0" stroke="#f76707" stroke-width="2" />

			<!-- Nadpis -->
			<text x="400" y="100" text-anchor="middle" font-size="16" font-weight="bold" fill="#f76707">
				Paramagnetika
			</text>

			<!-- Příklady -->
			<text x="305" y="135" font-size="12" font-weight="bold" fill="#2b2a26">Příklady:</text>
			<text x="305" y="155" font-size="11" fill="#2b2a26">• Hliník (Al)</text>
			<text x="305" y="175" font-size="11" fill="#2b2a26">• Volfram (W)</text>
			<text x="305" y="195" font-size="11" fill="#2b2a26">• Platina (Pt)</text>
			<text x="305" y="215" font-size="11" fill="#2b2a26">• Kyslík (O₂)</text>

			<!-- Vlastnosti -->
			<text x="305" y="245" font-size="12" font-weight="bold" fill="#2b2a26">Vlastnosti:</text>
			<text x="305" y="265" font-size="11" fill="#2b2a26">→ Slabě přitahuje magnet</text>
			<text x="305" y="285" font-size="11" fill="#2b2a26">→ Magnetizace zanikne</text>
			<text x="305" y="305" font-size="11" fill="#2b2a26">→ Bez vnějšího pole: nemagnetické</text>
			<text x="305" y="325" font-size="11" fill="#2b2a26">→ Nízká permeabilita</text>

			<!-- Ikon slabého magnetu -->
			<rect x="340" y="345" width="120" height="40" rx="5" fill="#f76707" stroke="#2b2a26" stroke-width="2" opacity="0.6" />
			<text x="400" y="372" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">slabý vliv</text>
		</g>

		<!-- 3. DIAMAGNETIKA (vpravo) -->
		<g id="diamagnetika">
			<!-- Hlavní box -->
			<rect x="550" y="70" width="220" height="350" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="2" />

			<!-- Nadpis -->
			<text x="660" y="100" text-anchor="middle" font-size="16" font-weight="bold" fill="#0284c7">
				Diamagnetika
			</text>

			<!-- Příklady -->
			<text x="565" y="135" font-size="12" font-weight="bold" fill="#2b2a26">Příklady:</text>
			<text x="565" y="155" font-size="11" fill="#2b2a26">• Měď (Cu)</text>
			<text x="565" y="175" font-size="11" fill="#2b2a26">• Voda (H₂O)</text>
			<text x="565" y="195" font-size="11" fill="#2b2a26">• Uhlík (C)</text>
			<text x="565" y="215" font-size="11" fill="#2b2a26">• Grafit</text>

			<!-- Vlastnosti -->
			<text x="565" y="245" font-size="12" font-weight="bold" fill="#2b2a26">Vlastnosti:</text>
			<text x="565" y="265" font-size="11" fill="#2b2a26">→ Slabě se odpuzuje</text>
			<text x="565" y="285" font-size="11" fill="#2b2a26">→ Bez vnějšího pole: nemagnetické</text>
			<text x="565" y="305" font-size="11" fill="#2b2a26">→ V poli se orientuje proti</text>
			<text x="565" y="325" font-size="11" fill="#2b2a26">→ Všechny látky mají prvky</text>

			<!-- Ikon odpuzování -->
			<rect x="600" y="345" width="120" height="40" rx="5" fill="#0284c7" stroke="#2b2a26" stroke-width="2" opacity="0.5" />
			<text x="660" y="372" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">Odpuzuje se!</text>
		</g>
	</svg>
</section>

<style>
	.infografika { padding: 1.5rem; }
	.infografika h2 { margin-top: 0; }
	.infografika svg { width: 100%; max-width: 800px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; margin: 1rem 0; display: block; margin-left: auto; margin-right: auto; }
	.podtrh { border-bottom: 3px solid #ffd43b; padding-bottom: 2px; }
</style>
