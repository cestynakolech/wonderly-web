---
// Statická infografika: Objem — F6 měření
// Objem je fyzikální veličina udávající prostor, který těleso zaujímá
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Objem — prostor tělesa 📦</span></h2>
	<p><strong>Objem</strong> je fyzikální veličina, která charakterizuje prostor, který těleso zaujímá. Jednotka v SI soustavě je <strong>kubický metr (m³)</strong>.</p>
	<svg viewBox="0 0 750 380" class="infografika-svg">
		<!-- Pozadí -->
		<rect width="750" height="380" fill="#f5f0e8"/>
		
		<!-- Nadpis -->
		<text x="375" y="35" text-anchor="middle" class="transform-title">OBJEM — SI jednotky</text>
		
		<!-- Krychle 1 litr -->
		<rect x="60" y="80" width="50" height="50" fill="#3498db" stroke="#2980b9" stroke-width="2"/>
		<text x="85" y="110" text-anchor="middle" fill="white" font-weight="bold" font-size="12">1 L</text>
		<text x="85" y="160" text-anchor="middle" class="energy-label">1 litr (L)</text>
		<text x="85" y="175" text-anchor="middle" class="energy-label">1 dm³</text>
		
		<!-- Krychle 1 m³ -->
		<rect x="165" y="85" width="40" height="40" fill="#2ecc71" stroke="#27ae60" stroke-width="2"/>
		<text x="185" y="110" text-anchor="middle" fill="white" font-weight="bold" font-size="10">1 m³</text>
		<text x="185" y="160" text-anchor="middle" class="energy-label">1 kubický metr</text>
		<text x="185" y="175" text-anchor="middle" class="energy-label">1000 L</text>
		
		<!-- Střed - tabulka převodů -->
		<rect x="310" y="70" width="430" height="140" fill="#ecf0f1" stroke="#95a5a6" stroke-width="2" rx="8"/>
		
		<text x="325" y="95" class="law-title">Převody SI jednotek</text>
		<line x1="320" y1="105" x2="735" y2="105" stroke="#95a5a6" stroke-width="1"/>
		
		<text x="330" y="125" class="balance-label"><tspan font-weight="bold">Mililitr (ml):</tspan> 1 ml = 0,001 L = 1 cm³</text>
		<text x="330" y="145" class="balance-label"><tspan font-weight="bold">Litr (L):</tspan> 1 L = 1 dm³ = 1000 cm³</text>
		<text x="330" y="165" class="balance-label"><tspan font-weight="bold">Metr krychlový (m³):</tspan> 1 m³ = 1000 L</text>
		<text x="330" y="185" class="balance-label"><tspan font-weight="bold">Poznámka:</tspan> V = délka × šířka × výška</text>
		
		<!-- Měření -->
		<text x="375" y="240" text-anchor="middle" class="law-title">Příklady objemů</text>
		<line x1="50" y1="255" x2="710" y2="255" stroke="#95a5a6" stroke-width="1"/>
		
		<!-- Příklady -->
		<text x="60" y="280" class="balance-label"><tspan font-weight="bold">Kapka vody:</tspan> ~0,05 ml</text>
		<text x="60" y="300" class="balance-label"><tspan font-weight="bold">Sklenice vody:</tspan> ~250 ml</text>
		<text x="60" y="320" class="balance-label"><tspan font-weight="bold">Kbelík:</tspan> ~10 L</text>
		<text x="60" y="340" class="balance-label"><tspan font-weight="bold">Bazén:</tspan> ~1000 m³</text>
		
		<!-- Měřicí přístroje -->
		<text x="520" y="280" class="law-title">Měřicí přístroje</text>
		<text x="520" y="305" class="balance-label">• Odměrný válec</text>
		<text x="520" y="325" class="balance-label">• Odměrka (mililitry)</text>
		<text x="520" y="345" class="balance-label">• Měrka (litry)</text>
	</svg>
</section>

<style>
	.infografika-svg {
		width: 100%;
		max-width: 750px;
		height: auto;
		border: 2px solid #ddd;
		border-radius: 8px;
	}
	.transform-title {
		font-size: 16px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.energy-type {
		font-size: 13px;
		font-weight: bold;
		fill: #333;
	}
	.energy-label {
		font-size: 11px;
		fill: #555;
	}
	.law-title {
		font-size: 14px;
		font-weight: bold;
		fill: #2c3e50;
	}
	.balance-label {
		font-size: 12px;
		fill: #2c3e50;
	}
	.balance-note {
		font-size: 11px;
		fill: #7f8c8d;
		font-style: italic;
	}
</style>
