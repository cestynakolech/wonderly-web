---
// Účinky síly na těleso (F7, jednoduché stroje): posuvný × otáčivý × deformační účinek.
// Dítě volí BOD PŮSOBENÍ síly (těžiště / okraj) a velikost síly posuvníkem 0-120 N.
// Do 50 N: síla v těžišti → těleso se POSOUVÁ, síla na okraji → těleso se OTÁČÍ (moment síly).
// Od 50 N: síla je tak velká, že těleso mění TVAR (deformace), bez ohledu na bod působení.
//   50-80 N = pružná deformace (jako gumový míček - po snížení síly se vrátí),
//   90+ N   = trvalá deformace (jako plechový plát - tvar zůstane, i když sílu snížíš;
//   reset jen tlačítkem "Nové těleso"). Prahy jsou vidět předem na barevné stupnici.
// Rotace i posun běží přes requestAnimationFrame kalibrovaný SKUTEČNÝM časem (dt z
// performance timestampu), ne počtem snímků - funguje správně i když je náhled zpomalený.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Účinky síly na těleso 🕹️</span></h2>
	<p>Síla může s tělesem udělat tři různé věci. Působí-li v <strong>těžišti</strong>, těleso se <strong>posune</strong> (posuvný účinek). Působí-li <strong>mimo těžiště</strong>, těleso se <strong>otočí</strong> (otáčivý účinek - vzniká moment síly). A je-li síla <strong>hodně velká</strong>, změní tělesu <strong>tvar</strong> (deformační účinek) - ať už mimo těžiště, nebo v něm.</p>

	<p class="ucs-skala-popis">Stupnice síly (vidíš předem, kdy co nastane):</p>
	<div class="ucs-skala">
		<div class="ucs-skala-znacky">
			<span style="left:0%">0</span>
			<span style="left:41.7%">50</span>
			<span style="left:75%">90</span>
			<span style="left:100%">120 N</span>
		</div>
	</div>
	<p class="ucs-skala-legenda">
		<span class="ucs-lg ucs-lg-zel">0-40 N: posun / otočení</span>
		<span class="ucs-lg ucs-lg-ora">50-80 N: pružná deformace</span>
		<span class="ucs-lg ucs-lg-cer">90-120 N: trvalá deformace</span>
	</p>

	<p id="ucs-body">
		Bod působení síly:
		<button type="button" class="ucs-tl ucs-aktivni" data-bod="teziste">🎯 v těžišti</button>
		<button type="button" class="ucs-tl" data-bod="okraj">📍 mimo těžiště (na okraji)</button>
	</p>

	<svg id="ucs-svg" viewBox="0 0 660 300" role="img" aria-label="Těleso na podložce a síla, která na něj působí v různých bodech">
		<!-- podlaha -->
		<rect x="0" y="220" width="660" height="80" fill="#deb887" stroke="#2b2a26" stroke-width="3" />
		<!-- stín pod tělesem -->
		<ellipse id="ucs-stin" cx="330" cy="222" rx="42" ry="8" fill="#2b2a26" opacity="0.18" />
		<!-- šipka síly -->
		<line id="ucs-sipka" x1="150" y1="170" x2="150" y2="170" stroke="#e03131" stroke-width="7" marker-end="url(#ucs-sm)" />
		<text id="ucs-sipka-text" font-size="15" font-weight="bold" fill="#e03131" text-anchor="middle" y="150"></text>
		<defs>
			<marker id="ucs-sm" markerUnits="userSpaceOnUse" markerWidth="18" markerHeight="18" refX="14" refY="9" orient="auto"><path d="M0,0 L16,9 L0,18 z" fill="#e03131" /></marker>
		</defs>
		<!-- těleso -->
		<g id="ucs-telo">
			<rect id="ucs-rect" x="295" y="135" width="70" height="70" fill="#ffd8a8" stroke="#2b2a26" stroke-width="3.5" rx="6" />
			<circle id="ucs-bod-teziste" cx="330" cy="170" r="7" fill="#1971c2" stroke="#2b2a26" stroke-width="2" />
			<circle id="ucs-bod-okraj" cx="330" cy="145" r="7" fill="#adb5bd" stroke="#2b2a26" stroke-width="2" />
			<text id="ucs-telo-text" x="330" y="270" text-anchor="middle" font-size="15" font-weight="bold" fill="#2b2a26"></text>
		</g>
	</svg>

	<label class="sim-posuvnik">
		Síla F: <output id="ucs-out-f"></output>
		<input type="range" id="ucs-slider-f" min="0" max="120" step="10" value="20" />
	</label>

	<p class="ucs-vzorec" id="ucs-vypocet"></p>
	<p class="ucs-stav" id="ucs-stav"></p>
	<button id="ucs-reset" class="ucs-btn-reset">Nové těleso 🔄</button>
</section>

<script>
	const MEZ_PRUZNA = 50;
	const MEZ_TRVALA = 90;
	const CX = 330, CY = 170;         // těžiště tělesa (fixní bod ve scéně)
	const ZAKLAD_STRANA = 70;         // rozměr nedeformovaného tělesa (čtverec)
	const SPODEK = 205;               // y spodní hrany tělesa (na podlaze), 205+15px mezera do 220

	const sliderF = document.getElementById('ucs-slider-f');
	const outF = document.getElementById('ucs-out-f');
	const vypocetEl = document.getElementById('ucs-vypocet');
	const stavEl = document.getElementById('ucs-stav');
	const bodyEl = document.getElementById('ucs-body');
	const rect = document.getElementById('ucs-rect');
	const teloText = document.getElementById('ucs-telo-text');
	const stin = document.getElementById('ucs-stin');
	const bodTeziste = document.getElementById('ucs-bod-teziste');
	const bodOkraj = document.getElementById('ucs-bod-okraj');
	const telo = document.getElementById('ucs-telo');
	const sipka = document.getElementById('ucs-sipka');
	const sipkaText = document.getElementById('ucs-sipka-text');

	let bod = 'teziste';   // 'teziste' | 'okraj'
	let trvale = false;    // jednou dosažená trvalá deformace už nejde vrátit posuvníkem
	let uhel = 0;          // aktuální úhel otočení (stupně)
	let rafId = null;
	let posledniCas = null;

	function polohaX() {
		// bod, kam vstupuje síla podle zvoleného bodu působení (výška v ose y)
		return bod === 'teziste' ? CY : CY - 25;
	}

	function nastavRozmery(w, h) {
		rect.setAttribute('width', w);
		rect.setAttribute('height', h);
		rect.setAttribute('x', CX - w / 2);
		rect.setAttribute('y', SPODEK - h);
	}

	function prekresli() {
		const F = +sliderF.value;
		if (F >= MEZ_TRVALA) trvale = true;
		const deformace = trvale || F >= MEZ_PRUZNA;
		const rotuje = !deformace && bod === 'okraj' && F > 0;

		if (rotuje && rafId === null) spustitOtaceni();
		if (!rotuje && rafId !== null) zastavitOtaceni();
		if (!rotuje) uhel = 0;

		let posunX = 0;
		let stupenDeformace = 0;

		if (deformace) {
			const t = trvale ? 1 : Math.min(1, (F - MEZ_PRUZNA) / (MEZ_TRVALA - MEZ_PRUZNA));
			stupenDeformace = Math.round(t * 100);
			const w = ZAKLAD_STRANA - 30 * t;   // 70 -> 40 (síla stlačuje ve svém směru)
			const h = ZAKLAD_STRANA + 30 * t;   // 70 -> 100 (vybouluje se kolmo)
			nastavRozmery(w, h);
			rect.setAttribute('fill', trvale ? '#adb5bd' : '#a5d8ff');
			rect.setAttribute('stroke', trvale ? '#495057' : '#1971c2');
			rect.setAttribute('stroke-dasharray', trvale ? '0' : '5 4');
			telo.setAttribute('transform', 'translate(0 0) rotate(0 ' + CX + ' ' + CY + ')');
			teloText.textContent = trvale ? 'TRVALÁ deformace' : 'PRUŽNÁ deformace (' + stupenDeformace + ' %)';
			bodTeziste.setAttribute('opacity', '0');
			bodOkraj.setAttribute('opacity', '0');
		} else {
			nastavRozmery(ZAKLAD_STRANA, ZAKLAD_STRANA);
			rect.setAttribute('fill', '#ffd8a8');
			rect.setAttribute('stroke', '#2b2a26');
			rect.setAttribute('stroke-dasharray', '0');
			bodTeziste.setAttribute('opacity', '1');
			bodOkraj.setAttribute('opacity', '1');
			bodTeziste.setAttribute('fill', bod === 'teziste' ? '#1971c2' : '#adb5bd');
			bodOkraj.setAttribute('fill', bod === 'okraj' ? '#e8590c' : '#adb5bd');
			if (bod === 'teziste') {
				posunX = F;   // 1 px/N, max 40 px při F=40 (pod prahem deformace)
				telo.setAttribute('transform', `translate(${posunX} 0) rotate(0 ${CX} ${CY})`);
				teloText.textContent = F > 0 ? 'POSUVNÝ účinek' : '';
			} else {
				telo.setAttribute('transform', `translate(0 0) rotate(${uhel} ${CX} ${CY})`);
				teloText.textContent = F > 0 ? 'OTÁČIVÝ účinek' : '';
			}
		}

		stin.setAttribute('cx', CX + posunX);

		// šipka síly - délka úměrná F, hrot se opírá o levý okraj tělesa
		const polovinaSirky = +rect.getAttribute('width') / 2;
		const hrotX = (CX + posunX) - polovinaSirky;
		const y = polohaX();
		const k = 1.1;
		sipka.setAttribute('x1', hrotX - F * k);
		sipka.setAttribute('y1', y);
		sipka.setAttribute('x2', hrotX);
		sipka.setAttribute('y2', y);
		sipka.setAttribute('visibility', F > 0 ? 'visible' : 'hidden');
		sipkaText.setAttribute('x', hrotX - (F * k) / 2);
		sipkaText.setAttribute('y', y - 14);
		sipkaText.textContent = F > 0 ? 'F = ' + F + ' N' : '';

		outF.textContent = F + ' N';
		vypocetEl.innerHTML = `Síla F = <strong>${F} N</strong> &nbsp;·&nbsp; pružná mez = <strong>${MEZ_PRUZNA} N</strong> &nbsp;·&nbsp; trvalá mez = <strong>${MEZ_TRVALA} N</strong>` +
			(deformace ? ` &nbsp;·&nbsp; stupeň deformace = <strong>${stupenDeformace} %</strong>` : '');

		if (deformace) {
			if (trvale) {
				stavEl.textContent = F >= MEZ_TRVALA
					? `🔨 F = ${F} N ≥ ${MEZ_TRVALA} N → TRVALÁ deformace, jako u plechového plátu: tvar zůstane změněný natrvalo, i když sílu teď snížíš. Stiskni „Nové těleso" pro reset.`
					: `🔨 TRVALÁ deformace zůstává i při F = ${F} N — jako pomačkaný plech se těleso samo nenarovná. Stiskni „Nové těleso" pro reset.`;
			} else {
				stavEl.textContent = `🟦 F = ${F} N ≥ ${MEZ_PRUZNA} N → PRUŽNÁ deformace, jako u gumového míčku: těleso mění tvar, ale jakmile síla klesne pod ${MEZ_PRUZNA} N, vrátí se zpět.`;
			}
		} else if (F === 0) {
			stavEl.textContent = '👉 Zatáhni posuvníkem síly nebo vyber jiný bod působení.';
		} else if (bod === 'teziste') {
			stavEl.textContent = `➡️ F = ${F} N v TĚŽIŠTI (< ${MEZ_PRUZNA} N) → POSUVNÝ účinek: celé těleso se posouvá rovně, protože nevzniká moment síly.`;
		} else {
			stavEl.textContent = `🔄 F = ${F} N MIMO TĚŽIŠTĚ (< ${MEZ_PRUZNA} N) → OTÁČIVÝ účinek: síla má rameno k těžišti, vzniká moment síly a těleso se otáčí. Čím větší F, tím rychlejší otáčení.`;
		}
	}

	function spustitOtaceni() {
		posledniCas = null;
		rafId = requestAnimationFrame(krok);
	}
	function krok(cas) {
		if (posledniCas === null) posledniCas = cas;
		const dt = (cas - posledniCas) / 1000; // sekundy - kalibrace na SKUTEČNÝ čas, ne na počet snímků
		posledniCas = cas;
		const F = +sliderF.value;
		const rychlostDegPerS = F * 3;
		uhel = (uhel + rychlostDegPerS * dt) % 360;
		telo.setAttribute('transform', `translate(0 0) rotate(${uhel} ${CX} ${CY})`);
		rafId = requestAnimationFrame(krok);
	}
	function zastavitOtaceni() {
		if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
	}

	bodyEl.addEventListener('click', (e) => {
		const tl = e.target.closest('.ucs-tl');
		if (!tl) return;
		bod = tl.dataset.bod;
		for (const b of bodyEl.querySelectorAll('.ucs-tl')) b.classList.toggle('ucs-aktivni', b === tl);
		prekresli();
	});
	sliderF.addEventListener('input', prekresli);
	document.getElementById('ucs-reset').addEventListener('click', () => {
		trvale = false;
		bod = 'teziste';
		sliderF.value = '20';
		for (const b of bodyEl.querySelectorAll('.ucs-tl')) b.classList.toggle('ucs-aktivni', b.dataset.bod === 'teziste');
		prekresli();
	});
	prekresli();
</script>

<style>
	#ucs-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.ucs-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.ucs-tl.ucs-aktivni { background: #ffe8cc; }
	.ucs-tl:active { transform: translateY(1px); }
	.ucs-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
	.ucs-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.ucs-btn-reset { font-size: 1rem; font-weight: 800; padding: 0.45rem 1rem; border: 3px solid #2b2a26; border-radius: 10px; background: #ffe066; cursor: pointer; margin-top: 0.5rem; }
	.ucs-skala-popis { font-weight: 700; margin-bottom: 0.2rem; }
	.ucs-skala { height: 14px; border-radius: 7px; border: 2px solid #2b2a26;
		background: linear-gradient(to right, #40c057 0%, #40c057 41.7%, #f08c00 41.7%, #f08c00 75%, #e03131 75%, #e03131 100%); position: relative; }
	.ucs-skala-znacky { position: relative; height: 1.2rem; font-size: 0.8rem; font-weight: 700; }
	.ucs-skala-znacky span { position: absolute; transform: translateX(-50%); }
	.ucs-skala-legenda { display: flex; gap: 0.6rem; flex-wrap: wrap; font-size: 0.85rem; font-weight: 700; margin: 0.4rem 0 0.8rem; }
	.ucs-lg { padding: 0.15rem 0.5rem; border-radius: 6px; border: 2px solid #2b2a26; }
	.ucs-lg-zel { background: #d3f9d8; }
	.ucs-lg-ora { background: #ffe8cc; }
	.ucs-lg-cer { background: #ffc9c9; }
</style>
</content>
