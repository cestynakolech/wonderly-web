		background: #ffd43b;
	}
	/* telefon (≤ 640 px): scéna přes celou šířku displeje, stav plaket čitelně pod ní */
	.st-mobil {
		display: none;
	}
	@media (max-width: 640px) {
		#st-svg {
			width: calc(100vw - 16px);
			max-width: none;
			margin-left: calc(50% - 50vw + 8px);
		}
		.st-mobil {
			display: block;
			font-size: 1rem;
			line-height: 1.45;
			margin: 0.5rem 0;
			padding: 0.4rem 0.6rem;
			background: #ffffff;
			color: #2b2a26;
			border: 2px solid #2b2a26;
			border-radius: 8px;
		}
	}
	.st-vysledek {
		font-weight: 600;
		padding: 0.6rem;
		border-radius: 10px;
		background: #fff3bf;
		color: #2b2a26;
		text-align: center;
	}
</style>
