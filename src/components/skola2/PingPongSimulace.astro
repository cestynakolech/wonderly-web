---
// Hra Ping-pong (informatika 8. ročník, hry-ve-scratchi/hra-ping-pong).
//
// Tři pointy z výkladu, VŠECHNY VIDĚT, ne jen napsané:
//  1. HERNÍ SMYČKA — celá scéna běží v jednom „opakuj stále“: míček se pořád dokola
//     pohne a rozhlédne se. Bez toho opakování by se nic nedělo po jednom kroku.
//  2. ODRAZ OD OKRAJE JE AUTOMATICKÝ — blok „když narazíš na okraj, odraz se“ funguje
//     u všech stěn i STROPU sám od sebe, bez jediného řádku navíc od programátora.
//  3. NEJDŮLEŽITĚJŠÍ: odraz od PÁLKY automatický NENÍ. Potřebuje podmínku
//     „když ⟨dotýkáš se (Pálka)?⟩ tak“, kterou musí napsat programátor sám. Přepínač
//     „podmínka je v programu / chybí“ to dokazuje: i když je pálka přesně pod míčkem,
//     bez podmínky ho nic nezastaví a míček propadne do červeného pruhu — ztráta života.
//     Přesně to varuje i výklad podtématu.
//
// Souřadnice jsou celočíselné ve scratchovské soustavě (x −240…240, y −180…180),
// kreslí se 1:1 do viewBoxu 480×360 (px = 240+x, py = 180−y — žádné další měřítko).
// POHYB JE PODLE SMĚRU, přesně jako ve Scratchi (blok „nastav směr (…)“): 0° = nahoru,
// 90° = doprava, 180° = dolů, 270° = doleva. Míček startuje se směrem přesně 45° (=
// šikmo NAHORU-doprava, jak píše výklad i kvíz), rychlost (velikost pohybu) je
// samostatné celé číslo 60/90/120 jednotek/s. Směr se v kódu vždy počítá jako celé
// stupně:
//  • odraz od svislého okraje (leva/pravá stěna): směr = 360 − směr
//  • odraz od stropu: směr = 180 − směr
//  • odraz od pálky = SKUTEČNÝCH „otoč se ↻ o 180 stupňů“ (směr = směr + 180) PLUS
//    náhodná odchylka −20 až +20° (celé stupně, deterministicky odvozená z polohy
//    zásahu, aby šlo ověřit bez prohlížeče) — přesně jako ve scénáři z výkladu — a
//    hned po otočce „dopředu o 15 kroků“, aby se míček od pálky odlepil (jinak by se
//    přes stále platnou podmínku „dotýkáš se (Pálka)?“ hned zase otočil zpátky).
// Časování: setInterval po 100 ms = 10 kroků/s (TICK_S = 0,1 s), žádný
// requestAnimationFrame → žádné zpomalení v náhledu. Pauza po ztrátě života je přesně
// 10 kroků = 1 sekunda, jak píše scénář ve výkladu („čekej 1 sekund“).
// Stav je čistá funkce předchozího stavu, voleb a polohy pálky — testovatelné bez prohlížeče.
//
// Názvy bloků podle české palety Scratche 3 (scratch-l10n/editor/blocks/cs.json), ověřeno
// i proti sesterským simulacím (KlonovaniSimulace.astro, UdalostiSimulace.astro):
// „po kliknutí na 🏁“, „opakuj stále“, „dopředu o … kroků“,
// „když narazíš na okraj, odraz se“, „když … tak“ (CONTROL_IF), „dotýkáš se (…)?“,
// „dotýkáš se barvy (…)?“, „změň … o …“, „nastav … na …“, „skoč na x: … y: …“,
// „čekej … sekund“, „zastav (všechno)“.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Kdo zastaví míček? 🏓</span></h2>
	<p>
		Míček létá po scéně v jedné velké smyčce <strong>opakuj stále</strong>. Od stěn i stropu
		se odráží <strong>sám</strong> — to umí Scratch bez pomoci. Od <strong>pálky</strong> ale
		jen tehdy, když v programu opravdu je podmínka <code>dotýkáš se (Pálka)?</code>.
		Vypni ji tlačítkem a sleduj, co se stane, i když pálku trefíš přesně.
	</p>

	<svg id="pin-svg" viewBox="0 0 480 360" tabindex="0" role="img"
		aria-label="Scéna hry ping-pong: míček létá mezi okraji, dole je pálka a pod ní červený pruh. Pálka se ovládá myší nebo šipkami vlevo/vpravo.">
		<rect x="1" y="1" width="478" height="358" fill="#eaf4ff" stroke="#2b2a26" stroke-width="3" rx="8" />
		<rect id="pin-cervena" x="1" y="350" width="478" height="9" fill="#e03131" stroke="#2b2a26" stroke-width="1" />
		<text x="240" y="345" text-anchor="middle" font-size="10" font-weight="bold" fill="#c92a2a">červený pruh (propadliště)</text>
		<rect id="pin-palka" x="190" y="320" width="100" height="20" fill="#2b8a3e" stroke="#2b2a26" stroke-width="3" rx="4" />
		<circle id="pin-micek" cx="240" cy="180" r="10" fill="#ffd43b" stroke="#2b2a26" stroke-width="2" />
		<text id="pin-hlaska" x="240" y="40" text-anchor="middle" font-size="14" font-weight="bold" fill="#c92a2a"></text>
		<text x="240" y="352" text-anchor="middle" font-size="10" font-weight="bold" fill="#495057" opacity="0"></text>
	</svg>

	<p class="pin-stats" id="pin-stats" aria-live="polite"></p>

	<p class="pin-radek">
		<strong>Podmínka „dotýkáš se (Pálka)?“ v programu:</strong>
		<button type="button" class="pin-tl pin-podminka pin-aktivni" data-podminka="ano">ANO — je tam</button>
		<button type="button" class="pin-tl pin-podminka" data-podminka="ne">NE — chybí</button>
	</p>
	<p class="pin-radek">
		<strong>Rychlost míčku:</strong>
		<button type="button" class="pin-tl pin-rychlost pin-aktivni" data-rychlost="pomalu">pomalu (60/s)</button>
		<button type="button" class="pin-tl pin-rychlost" data-rychlost="stredni">normálně (90/s)</button>
		<button type="button" class="pin-tl pin-rychlost" data-rychlost="rychle">rychle (120/s)</button>
	</p>
	<p class="pin-radek">
		<strong>Pálka:</strong> jezdí za myší nad scénou, nebo
		<button type="button" class="pin-tl" id="pin-vlevo">⬅ pálka</button>
		<button type="button" class="pin-tl" id="pin-vpravo">➡ pálka</button>
	</p>
	<p class="pin-radek">
		<button type="button" class="pin-tl pin-hraj" id="pin-krok">▶️ jeden krok</button>
		<button type="button" class="pin-tl pin-hraj" id="pin-bezet">⏩ spustit</button>
		<button type="button" class="pin-tl" id="pin-reset">↺ na začátek</button>
	</p>

	<div id="pin-program" class="pin-program"></div>
	<p class="pin-vysvetleni" id="pin-vysvetleni" aria-live="polite">
		Klikni na <strong>⏩ spustit</strong>, hýbej pálkou a sleduj, jestli míček zůstane nahoře.
	</p>
</section>

<script>
	const svg = document.getElementById('pin-svg');
	const micekEl = document.getElementById('pin-micek');
	const palkaEl = document.getElementById('pin-palka');
	const cervenaEl = document.getElementById('pin-cervena');
	const hlaskaEl = document.getElementById('pin-hlaska');
	const statsEl = document.getElementById('pin-stats');
	const programEl = document.getElementById('pin-program');
	const vysvetleniEl = document.getElementById('pin-vysvetleni');
	const btnKrok = document.getElementById('pin-krok');
	const btnBezet = document.getElementById('pin-bezet');
	const btnReset = document.getElementById('pin-reset');
	const btnVlevo = document.getElementById('pin-vlevo');
	const btnVpravo = document.getElementById('pin-vpravo');

	const R = 10;                 // poloměr míčku
	const STENA = 240;             // levý/pravý okraj scény (x −240…240)
	const STROP = 180;             // horní okraj scény
	const PALKA_Y = -150;          // střed pálky
	const PALKA_POLOVYSKA = 10;    // pálka je 20 jednotek vysoká
	const PALKA_POLOSIRKA = 50;    // pálka je 100 jednotek široká
	const PALKA_TOP = PALKA_Y + PALKA_POLOVYSKA; // horní hrana pálky (−140)
	const CERVENY_TOP = -170;      // horní hrana červeného pruhu
	const TICK_MS = 100;
	const TICK_S = TICK_MS / 1000; // 0,1 s
	const ZIVOTY_START = 3;
	const PAUZA_TICKS = 10;        // 10 × 0,1 s = 1 s, jako „čekej 1 sekund“ ve výkladu
	const PALKA_MEZ = STENA - PALKA_POLOSIRKA; // −190…190, ať pálka nevyjede ze scény

	// Rychlost = velikost pohybu (celé jednotky/s), směr (celé stupně) je NEZÁVISLÝ —
	// stejně jako ve Scratchi „rychlost“ a „směr“ nejsou provázané.
	const RYCHLOSTI = { pomalu: 60, stredni: 90, rychle: 120 };
	const SMER_START = 45; // „nastav směr (45)“ — 0=nahoru, 90=doprava → 45° je šikmo NAHORU-doprava

	function pxX(x) { return 240 + x; }
	function pxY(y) { return 180 - y; }

	/** Celé stupně vždy v rozsahu 0..359 — ať se s nimi počítá jako se Scratchovým směrem. */
	function mod360(deg) { return ((deg % 360) + 360) % 360; }

	/** Celočíselná „náhodná“ odchylka −20..20° odvozená z místa zásahu — deterministické, testovatelné. */
	function odchylkaZPolohy(x) {
		const n = Math.round(x);
		return (((n % 41) + 41) % 41) - 20;
	}

	/** Pohyb ve směru `smer` (0=nahoru) o `velikost` jednotek: dx = v·sin, dy = v·cos. */
	function posunVeSmeru(smer, velikost) {
		const rad = (smer * Math.PI) / 180;
		return { dx: velikost * Math.sin(rad), dy: velikost * Math.cos(rad) };
	}

	function pocatecniStav(rychlostKlic) {
		return { bx: 0, by: 0, smer: SMER_START, rychlost: RYCHLOSTI[rychlostKlic], skore: 0, zivoty: ZIVOTY_START, pauza: 0, konec: false, tick: 0, posledniUdalost: null };
	}

	/**
	 * JEDEN KROK simulace (100 ms). Čistá funkce stavu, voleb (podmínka ANO/NE)
	 * a polohy pálky — testovatelná bez prohlížeče.
	 */
	function jedenKrok(stav, volby) {
		if (stav.konec) return stav;
		if (stav.pauza > 0) return { ...stav, pauza: stav.pauza - 1, posledniUdalost: null, tick: stav.tick + 1 };

		let { skore, zivoty } = stav;
		let smer = stav.smer;
		const predBy = stav.by;
		const posun = posunVeSmeru(smer, stav.rychlost * TICK_S); // „dopředu o … kroků“
		let bx = stav.bx + posun.dx;
		let by = stav.by + posun.dy;
		let posledniUdalost = null;

		// „když narazíš na okraj, odraz se“ — funguje sám, u VŠECH stěn i stropu.
		if (bx - R <= -STENA) { bx = -STENA + R; smer = mod360(360 - smer); posledniUdalost = 'okraj'; }
		else if (bx + R >= STENA) { bx = STENA - R; smer = mod360(360 - smer); posledniUdalost = 'okraj'; }
		if (by + R >= STROP) { by = STROP - R; smer = mod360(180 - smer); posledniUdalost = 'okraj'; }

		// Pálka NENÍ okraj scény — tohle musí ohlídat podmínka „dotýkáš se (Pálka)?“.
		// „Míří dolů“ pozná se ze znaménka svislé složky aktuálního (po odrazu od okraje) směru.
		let zasahPalky = false;
		const miriDolu = Math.cos((smer * Math.PI) / 180) < 0;
		if (miriDolu && predBy - R > PALKA_TOP && by - R <= PALKA_TOP) {
			const zarovnano = Math.abs(bx - volby.palkaX) <= PALKA_POLOSIRKA + R;
			if (zarovnano && volby.podminka === 'ano') {
				by = PALKA_TOP + R;
				// „otoč se ↻ o 180 stupňů“ + náhodná odchylka −20..20° (celé stupně,
				// deterministicky odvozená od místa zásahu — testovatelné bez prohlížeče).
				const odchylka = odchylkaZPolohy(bx);
				smer = mod360(smer + 180 + odchylka);
				// „dopředu o 15 kroků“ — odlepí míček od pálky, ať se hned zase neotočí.
				const doskok = posunVeSmeru(smer, 15);
				bx += doskok.dx;
				by += doskok.dy;
				skore += 1;
				posledniUdalost = 'palka';
				zasahPalky = true;
			}
		}

		// „dotýkáš se barvy (červená)?“ — dno scény, sem odraz od okraje NEDOSÁHNE (chytí to dřív pálka).
		if (!zasahPalky && by - R <= CERVENY_TOP) {
			const byloBySeTrefilo = Math.abs(bx - volby.palkaX) <= PALKA_POLOSIRKA + R;
			posledniUdalost = byloBySeTrefilo && volby.podminka === 'ne' ? 'propadlo-bez-podminky' : 'minulo-palku';
			zivoty -= 1;
			if (zivoty <= 0) {
				return { ...stav, bx, by, smer, skore, zivoty: 0, konec: true, posledniUdalost, tick: stav.tick + 1 };
			}
			// „skoč na x: 0 y: 0“ — scénář ve výkladu tu směr znovu nenastavuje, necháváme ho beze změny.
			return { ...stav, bx: 0, by: 0, smer, skore, zivoty, pauza: PAUZA_TICKS, konec: false, posledniUdalost, tick: stav.tick + 1 };
		}

		return { ...stav, bx, by, smer, skore, zivoty, posledniUdalost, tick: stav.tick + 1 };
	}

	function omezPalku(x) {
		return Math.min(PALKA_MEZ, Math.max(-PALKA_MEZ, Math.round(x)));
	}

	let volby = { podminka: 'ano', rychlost: 'pomalu', palkaX: 0 };
	let stav = pocatecniStav(volby.rychlost);
	let zobrazenaUdalost = null; // poslední hláška zůstává vidět, dokud ji nepřebije další událost
	let casovac = null;

	function programRadky() {
		const palkaRadek1 = { text: 'když ⟨dotýkáš se (Pálka)?⟩ tak', uroven: 2, vypnuto: volby.podminka === 'ne' };
		const palkaRadek2 = { text: 'otoč se ↻ o ⟨(180) + ⟨náhodné číslo od (−20) do (20)⟩⟩ stupňů, dopředu o 15 kroků, změň skóre o 1', uroven: 3, vypnuto: volby.podminka === 'ne' };
		return [
			{ text: 'po kliknutí na 🏁', uroven: 0, hlava: true },
			{ text: 'nastav skóre na 0', uroven: 1 },
			{ text: 'nastav životy na 3', uroven: 1 },
			{ text: 'skoč na x: 0 y: 0', uroven: 1 },
			{ text: 'nastav směr (45)', uroven: 1 },
			{ text: 'opakuj stále', uroven: 1 },
			{ text: 'dopředu o 10 kroků', uroven: 2 },
			{ text: 'když narazíš na okraj, odraz se', uroven: 2 },
			palkaRadek1,
			palkaRadek2,
			{ text: 'když ⟨dotýkáš se barvy (červená)?⟩ tak', uroven: 2 },
			{ text: 'změň životy o −1, skoč na x: 0 y: 0, čekej 1 sekund', uroven: 3 },
			{ text: 'když ⟨životy = 0⟩ tak', uroven: 2 },
			{ text: 'zastav (všechno)', uroven: 3 },
		];
	}

	function vypisProgram() {
		programEl.textContent = '';
		for (const r of programRadky()) {
			const p = document.createElement('p');
			p.className = 'pin-blok' + (r.hlava ? ' pin-hlava' : '') + (r.vypnuto ? ' pin-vypnuto' : '');
			p.textContent = r.vypnuto ? `${r.text}  ← chybí!` : r.text;
			p.style.marginLeft = `${r.uroven * 1.1}rem`;
			programEl.appendChild(p);
		}
	}

	function prekresli() {
		micekEl.setAttribute('cx', String(pxX(stav.bx)));
		micekEl.setAttribute('cy', String(pxY(stav.by)));

		palkaEl.setAttribute('x', String(pxX(volby.palkaX - PALKA_POLOSIRKA)));
		palkaEl.setAttribute('y', String(pxY(PALKA_TOP)));

		const propadlo = zobrazenaUdalost === 'propadlo-bez-podminky';
		cervenaEl.setAttribute('fill', propadlo ? '#ff8787' : '#e03131');

		hlaskaEl.textContent = stav.konec ? `💀 KONEC HRY — skóre ${stav.skore}` : '';

		const zivotySrdce = '❤️'.repeat(stav.zivoty) + '🖤'.repeat(ZIVOTY_START - stav.zivoty);
		statsEl.innerHTML = `skóre: <strong>${stav.skore}</strong> &nbsp;·&nbsp; životy: ${zivotySrdce}`;

		vypisProgram();
	}

	function popisStavu() {
		switch (zobrazenaUdalost) {
			case 'okraj':
				return 'Míček narazil na okraj (nebo strop) a <strong>sám se odrazil</strong> — blok <code>když narazíš na okraj, odraz se</code> to zvládne bez jediného řádku navíc.';
			case 'palka':
				return `Zásah! Podmínka <code>dotýkáš se (Pálka)?</code> byla splněná, program míček <strong>otočil o 180° (+ náhodná odchylka)</strong> a poslal ho pryč od pálky — <strong>skóre ${stav.skore}</strong>.`;
			case 'propadlo-bez-podminky':
				return '⚠️ Míček byl <strong>přesně u pálky</strong>, ale podmínka <code>dotýkáš se (Pálka)?</code> v programu chybí — nic ho nezastavilo a propadl do červeného pruhu. <strong>Ztráta života!</strong> Pálka totiž není okraj scény, tohle si musí ohlídat programátor sám.';
			case 'minulo-palku':
				return 'Míček minul pálku a dopadl do červeného pruhu. <strong>Ztráta života!</strong>';
			default:
				return 'Sleduj míček: od stěn a stropu se odrazí <strong>sám</strong>, ale u pálky rozhoduje podmínka <code>dotýkáš se (Pálka)?</code>.';
		}
	}

	function ukazStav() {
		if (stav.konec) {
			vysvetleniEl.innerHTML = `💀 <strong>Konec hry!</strong> Došly životy. Konečné skóre: <strong>${stav.skore}</strong>. Zkus ↺ na začátek.`;
			return;
		}
		if (stav.pauza > 0) {
			vysvetleniEl.innerHTML = 'Ztratil jsi život — míček čeká na startu (<code>čekej 1 sekund</code>) a hned zase letí.';
			return;
		}
		vysvetleniEl.innerHTML = popisStavu();
	}

	function zastav() {
		if (casovac) clearInterval(casovac);
		casovac = null;
		btnBezet.textContent = '⏩ spustit';
		btnBezet.classList.remove('pin-aktivni');
	}

	function krokVpred() {
		stav = jedenKrok(stav, volby);
		if (stav.posledniUdalost !== null) zobrazenaUdalost = stav.posledniUdalost;
		prekresli();
		ukazStav();
		if (stav.konec) zastav();
	}

	function reset() {
		zastav();
		stav = pocatecniStav(volby.rychlost);
		zobrazenaUdalost = null;
		prekresli();
		ukazStav();
	}

	btnKrok.addEventListener('click', () => { zastav(); krokVpred(); });
	btnBezet.addEventListener('click', () => {
		if (casovac) { zastav(); return; }
		btnBezet.textContent = '⏸ zastavit';
		btnBezet.classList.add('pin-aktivni');
		casovac = setInterval(krokVpred, TICK_MS);
	});
	btnReset.addEventListener('click', reset);

	function posunPalky(o) {
		volby = { ...volby, palkaX: omezPalku(volby.palkaX + o) };
		prekresli();
	}
	btnVlevo.addEventListener('click', () => posunPalky(-20));
	btnVpravo.addEventListener('click', () => posunPalky(20));

	// Pálka jezdí za myší — přesně jako blok „nastav x na (x myši)“ ve výkladu.
	svg.addEventListener('pointermove', (e) => {
		const r = svg.getBoundingClientRect();
		if (!r.width) return;
		const scenePx = ((e.clientX - r.left) / r.width) * 480;
		volby = { ...volby, palkaX: omezPalku(scenePx - 240) };
		prekresli();
	});

	svg.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') { e.preventDefault(); posunPalky(-20); }
		else if (e.key === 'ArrowRight') { e.preventDefault(); posunPalky(20); }
	});

	for (const tl of document.querySelectorAll('.pin-podminka')) {
		tl.addEventListener('click', () => {
			for (const j of document.querySelectorAll('.pin-podminka')) j.classList.remove('pin-aktivni');
			tl.classList.add('pin-aktivni');
			volby = { ...volby, podminka: tl.dataset.podminka };
			zobrazenaUdalost = null;
			prekresli();
			ukazStav();
		});
	}
	for (const tl of document.querySelectorAll('.pin-rychlost')) {
		tl.addEventListener('click', () => {
			for (const j of document.querySelectorAll('.pin-rychlost')) j.classList.remove('pin-aktivni');
			tl.classList.add('pin-aktivni');
			volby = { ...volby, rychlost: tl.dataset.rychlost };
			reset();
		});
	}

	prekresli();
	ukazStav();

	// ——— háčky pro test bez prohlížeče (ukazují na TÝŽ kód, který kreslí scénu) ———
	svg.__jedenKrok = jedenKrok;
