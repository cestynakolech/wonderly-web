---
/** Týmová hra k podtématu Mechanická práce (fyzika 8). */
type Odpoved = 'A' | 'B';
type Moznost = { popis: string; doplnek: string };
type Karta = {
	id: string;
	scena: string;
	otazka: string;
	spravne: Odpoved;
	proc: string;
	opora: string;
	zdroj: string;
};
type Kolo = {
	cislo: number; nazev: string; pravidlo: string; opora: string;
	moznosti: Record<Odpoved, Moznost>; body: number; karty: Karta[];
};

const KOLA: Kolo[] = [
	{
		cislo: 1,
		nazev: 'Koná se mechanická práce?',
		pravidlo: 'Práce se koná, když síla posune těleso ve směru síly. Síla bez posunutí nestačí.',
		opora: 'Musí platit obě podmínky zároveň — síla i posunutí.',
		moznosti: {
			A: { popis: 'PRÁCE SE KONÁ', doplnek: 'síla způsobí posunutí' },
			B: { popis: 'PRÁCE SE NEKONÁ', doplnek: 'chybí posunutí nebo síla' },
		},
		body: 1,
		karty: [
			{ id: 'k1-auto', scena: 'auto', otazka: 'Tlačíš porouchané auto a auto se rozjede. Konáš mechanickou práci?', spravne: 'A', proc: 'Ano. Působíš silou a auto se ve směru síly posune.', opora: 'tlačíš auto, které nechce nastartovat', zdroj: 's. 1' },
			{ id: 'k1-nakup', scena: 'nakup', otazka: 'Stojíš ve frontě a jen držíš těžký nákup. Konáš na nákupu mechanickou práci?', spravne: 'B', proc: 'Ne. Na nákup působíš silou, ale nákup se neposouvá.', opora: 'Paní ve frontě, která jen drží těžký nákup, práci nekoná', zdroj: 's. 1' },
			{ id: 'k1-tyc', scena: 'tyc', otazka: 'Tlačíš na pevnou tyč, ale tyč se ani nehne. Konáš na tyči mechanickou práci?', spravne: 'B', proc: 'Ne. Působíš silou, ale dráha tyče je nulová.', opora: 'Michal tlačí na tyč, ale tyč se nehne', zdroj: 'výklad podtématu' },
			{ id: 'k1-jerab', scena: 'jerab', otazka: 'Jeřáb zvedá náklad vzhůru. Koná na nákladu mechanickou práci?', spravne: 'A', proc: 'Ano. Síla jeřábu zvedne náklad, takže způsobí jeho posunutí.', opora: 'práci koná jeřáb, když zvedá náklad', zdroj: 's. 1' },
			{ id: 'k1-jablko', scena: 'jablko', otazka: 'Jablko padá ze stromu působením gravitační síly. Koná silové pole práci?', spravne: 'A', proc: 'Ano. Gravitační síla posune jablko směrem k zemi.', opora: 'gravitační síla, když jablko spadne ze stromu', zdroj: 's. 1' },
		],
	},
	{
		cislo: 2,
		nazev: 'Veličiny, jednotky a vztahy',
		pravidlo: 'Rozhodni, zda je fyzikální tvrzení správně. Dávej pozor na značky a jednotky.',
		opora: 'Práce vyjadřuje množství energie, kterou těleso vydá na posunutí jiného tělesa.',
		moznosti: {
			A: { popis: 'SPRÁVNĚ', doplnek: 'tvrzení souhlasí s výkladem' },
			B: { popis: 'ŠPATNĚ', doplnek: 'tvrzení je potřeba opravit' },
		},
			body: 1,
			karty: [
				{ id: 'k2-watt', scena: 'watt', otazka: 'Tvrzení: Jednotkou mechanické práce je watt.', spravne: 'B', proc: 'Špatně. Jednotkou práce je joule se značkou J.', opora: 'jednotka joule (J) (čti „džaul“)', zdroj: 's. 2' },
				{ id: 'k2-vzorec', scena: 'vzorec', otazka: 'Tvrzení: Mechanickou práci vypočítáme podle vztahu W = F · s.', spravne: 'A', proc: 'Správně. Práce je součin síly působící ve směru posunutí a dráhy.', opora: 'Vypočítáme ji jako součin síly působící ve směru posunutí a dráhy', zdroj: 's. 2' },
				{ id: 'k2-jednotky', scena: 'jednotky', otazka: 'Tvrzení: Do vzorce dosazujeme sílu v newtonech a dráhu v metrech.', spravne: 'A', proc: 'Správně. Sílu F dosazujeme v newtonech a dráhu s v metrech.', opora: 'Sílu dosazujeme v newtonech, dráhu v metrech.', zdroj: 's. 2' },
				{ id: 'k2-megajoule', scena: 'megajoule', otazka: 'Tvrzení: 1 MJ = 1 000 J.', spravne: 'B', proc: 'Špatně. 1 MJ = 1 000 000 J.', opora: '1 MJ = 1 000 000 J', zdroj: 's. 2' },
				{ id: 'k2-joule', scena: 'joule', otazka: 'Tvrzení: Práce 1 J se vykoná, když síla 1 N posune těleso po dráze 1 m.', spravne: 'A', proc: 'Správně. W = 1 N · 1 m = 1 J.', opora: 'Těleso vykoná práci 1 J, když ho síla 1 N posune po dráze 1 m.', zdroj: 's. 2' },
		],
	},
	{
		cislo: 3,
		nazev: 'FINÁLE: Výpočty práce, síly a dráhy',
		pravidlo: 'Překontroluj uvedené tvrzení. Všechny výsledky jsou v základních jednotkách.',
		opora: 'Ze vzorce W = F · s plyne s = W : F a F = W : s.',
		moznosti: {
			A: { popis: 'TVRZENÍ SEDÍ', doplnek: 'uvedený vztah nebo výsledek je správný' },
			B: { popis: 'TVRZENÍ NESEDÍ', doplnek: 'uvedený vztah nebo výsledek je chybný' },
		},
		body: 2,
		karty: [
			{ id: 'k3-zavazi', scena: 'zavazi', otazka: 'Závaží: m = 5 kg, g = 10 N/kg, s = 1 m. Tvrzení: W = 5 J.', spravne: 'B', proc: 'Tvrzení nesedí. F = 5 · 10 = 50 N a W = 50 · 1 = 50 J.', opora: 'Chlapec zvedá závaží o hmotnosti 5 kg do výšky 1 m.', zdroj: 'výklad podtématu' },
			{ id: 'k3-vozik', scena: 'vozik', otazka: 'Vozík: F = 20 N, s = 10 m. Tvrzení: W = 200 J.', spravne: 'A', proc: 'Tvrzení sedí: W = F · s = 20 · 10 = 200 J.', opora: 'Michal postrčí vozík: F = 20 N, s = 10 m → W = 200 J', zdroj: 'výklad podtématu' },
			{ id: 'k3-bedna', scena: 'bedna', otazka: 'Bedna: m = 300 kg, g = 10 N/kg, s = 5 m. Tvrzení: W = 15 000 J.', spravne: 'A', proc: 'Tvrzení sedí. F = 300 · 10 = 3 000 N a W = 3 000 · 5 = 15 000 J.', opora: 'Jeřáb zvedá bednu o hmotnosti 300 kg do výšky 5 m.', zdroj: 'výklad podtématu' },
			{ id: 'k3-draha', scena: 'draha', otazka: 'Tvrzení: Ze vztahu W = F · s vyjádříme dráhu jako s = F : W.', spravne: 'B', proc: 'Tvrzení nesedí. Dráhu správně vyjádříme s = W : F.', opora: 's = W : F a F = W : s', zdroj: 'výklad podtématu' },
			{ id: 'k3-lokomotiva', scena: 'lokomotiva', otazka: 'Lokomotiva: W = 900 000 000 J, s = 4 500 m. Tvrzení: F = 200 000 N.', spravne: 'A', proc: 'Tvrzení sedí: F = W : s = 900 000 000 : 4 500 = 200 000 N.', opora: 'F = W : s = 900 000 000 : 4 500 = 200 000 N', zdroj: 'výklad podtématu' },
		],
	},
];

const karty = KOLA.flatMap((k) => k.karty);
const NAPIS: Record<string, string> = {
	'k1-auto': 'ANO — práce se koná', 'k1-nakup': 'NE — bez posunutí',
	'k1-jerab': 'ANO — náklad se zvedá', 'k1-jablko': 'ANO — práci koná pole',
	'k1-tyc': 'NE — nulová dráha', 'k2-vzorec': 'SPRÁVNĚ: W = F · s',
	'k2-jednotky': 'SPRÁVNĚ: N a m', 'k2-watt': 'ŠPATNĚ: jednotka je J',
	'k2-joule': 'SPRÁVNĚ: 1 J', 'k2-megajoule': 'ŠPATNĚ: 1 000 000 J',
	'k3-vozik': 'SEDÍ: 200 J', 'k3-zavazi': 'NESEDÍ: 50 J',
	'k3-bedna': 'SEDÍ: 15 000 J', 'k3-lokomotiva': 'SEDÍ: 200 000 N',
	'k3-draha': 'NESEDÍ: s = W : F',
};

function scenaSvg(s: string): string {
	switch (s) {
		case 'auto': return `<rect width="640" height="400" fill="#e7f5ff"/><rect y="310" width="640" height="90" fill="#dee2e6"/><g><circle cx="65" cy="215" r="24" fill="#ffd8a8" stroke="#333" stroke-width="3"/><path d="M65 239v55M65 255l52 18M65 292l-22 38M65 292l28 38" stroke="#333" stroke-width="9" stroke-linecap="round"/><path d="M102 273h35" stroke="#1971c2" stroke-width="9"/><path d="m142 273-18-13v26z" fill="#1971c2"/><rect x="130" y="245" width="150" height="55" rx="15" fill="#e03131" stroke="#333" stroke-width="4"/><circle cx="165" cy="305" r="18" fill="#343a40"/><circle cx="250" cy="305" r="18" fill="#343a40"/><animateTransform attributeName="transform" type="translate" from="0 0" to="250 0" dur="4s" calcMode="linear" repeatCount="indefinite"/></g>`;
		case 'nakup': return `<rect width="640" height="400" fill="#fff9db"/><circle cx="320" cy="92" r="34" fill="#ffd8a8" stroke="#333" stroke-width="3"/><path d="M320 126v115M320 160l-70 80M320 160l70 80M320 241l-55 110M320 241l55 110" stroke="#333" stroke-width="12" stroke-linecap="round"/><rect x="205" y="230" width="90" height="75" rx="8" fill="#c2410c" stroke="#333" stroke-width="4"/><path d="M225 230q25-45 50 0" fill="none" stroke="#333" stroke-width="5"/><path d="M205 245V175" stroke="#1971c2" stroke-width="8"><animate attributeName="stroke-width" values="7;12;7" dur="1.2s" repeatCount="indefinite"/></path><path d="m205 160-15 22h30z" fill="#1971c2"/>`;
		case 'jerab': return `<rect width="640" height="400" fill="#e7f5ff"/><path d="M80 350V45h330M150 45l-70 80M250 45v55" stroke="#495057" stroke-width="12" fill="none"/><line x1="250" y1="95" x2="250" y2="260" stroke="#333" stroke-width="5"><animate attributeName="y2" values="260;120;260" dur="3s" calcMode="linear" repeatCount="indefinite"/></line><g><rect x="185" y="190" width="130" height="90" fill="#d9480f" stroke="#333" stroke-width="4"/><animateTransform attributeName="transform" type="translate" values="0 70;0 -70;0 70" dur="3s" calcMode="linear" repeatCount="indefinite"/></g>`;
		case 'jablko': return `<rect width="640" height="400" fill="#e7f5ff"/><path d="M0 315h640v85H0z" fill="#8ce99a"/><path d="M420 330V95M420 120c-100-80-190-5-170 65M420 135c80-65 160-5 135 65" stroke="#8d5524" stroke-width="25" fill="none"/><g><circle cx="330" cy="145" r="24" fill="#e03131" stroke="#333" stroke-width="3"/><path d="M330 122q10-18 22-20" stroke="#2b8a3e" stroke-width="5"/><animateTransform attributeName="transform" type="translate" from="0 0" to="0 150" dur="2.5s" calcMode="linear" repeatCount="indefinite"/></g>`;
		case 'tyc': return `<rect width="640" height="400" fill="#f8f9fa"/><rect x="400" y="70" width="75" height="280" fill="#adb5bd" stroke="#333" stroke-width="5"/><circle cx="185" cy="110" r="32" fill="#ffd8a8" stroke="#333" stroke-width="3"/><path d="M185 143v105M185 175l150 45M185 248l-50 105M185 248l55 105" stroke="#333" stroke-width="12" stroke-linecap="round"/><path d="M320 220h72" stroke="#e03131" stroke-width="10"><animate attributeName="stroke-dasharray" values="8 5;22 5;8 5" dur="1s" repeatCount="indefinite"/></path><path d="m395 220-20-14v28z" fill="#e03131"/>`;
		case 'vzorec': return `<rect width="640" height="400" fill="#fff4e6"/><rect x="75" y="145" width="115" height="115" rx="15" fill="#ff8787" stroke="#333" stroke-width="4"/><rect x="450" y="145" width="115" height="115" rx="15" fill="#74c0fc" stroke="#333" stroke-width="4"/><path d="M205 202h225" stroke="#333" stroke-width="8" stroke-dasharray="18 12"><animate attributeName="stroke-dashoffset" from="0" to="-60" dur="1.4s" repeatCount="indefinite"/></path><circle cx="320" cy="202" r="32" fill="#ffd43b" stroke="#333" stroke-width="4"/>`;
		case 'jednotky': return `<rect width="640" height="400" fill="#e7f5ff"/><rect x="70" y="90" width="210" height="220" rx="18" fill="#fff" stroke="#333" stroke-width="5"/><path d="M175 235V130" stroke="#e03131" stroke-width="8" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" values="-28 175 235;28 175 235;-28 175 235" dur="3s" repeatCount="indefinite"/></path><rect x="355" y="120" width="210" height="65" fill="#ffe066" stroke="#333" stroke-width="4"/><g stroke="#333" stroke-width="3"><line x1="365" y1="120" x2="365" y2="160"/><line x1="403" y1="120" x2="403" y2="145"/><line x1="441" y1="120" x2="441" y2="145"/><line x1="479" y1="120" x2="479" y2="160"/><line x1="517" y1="120" x2="517" y2="145"/><line x1="555" y1="120" x2="555" y2="160"/></g>`;
		case 'watt': return `<rect width="640" height="400" fill="#fff9db"/><circle cx="320" cy="190" r="115" fill="#fff" stroke="#333" stroke-width="5"/><path d="M285 145q35-45 70 0l-15 55h-40z" fill="#ffd43b" stroke="#333" stroke-width="4"><animate attributeName="fill" values="#ffd43b;#fff3bf;#ffd43b" dur="1.3s" repeatCount="indefinite"/></path><path d="M300 210h40M305 225h30" stroke="#333" stroke-width="7"/>`;
		case 'joule': return `<rect width="640" height="400" fill="#e7f5ff"/><rect y="310" width="640" height="90" fill="#dee2e6"/><g><path d="M55 265h55" stroke="#1971c2" stroke-width="9"/><path d="m115 265-18-13v26z" fill="#1971c2"/><rect x="95" y="225" width="110" height="80" fill="#d9480f" stroke="#333" stroke-width="4"/><animateTransform attributeName="transform" type="translate" from="0 0" to="260 0" dur="3s" calcMode="linear" repeatCount="indefinite"/></g>`;
		case 'megajoule': return `<rect width="640" height="400" fill="#f3f0ff"/><g fill="#845ef7" stroke="#333" stroke-width="2"><rect x="125" y="125" width="90" height="90" rx="10"/><rect x="275" y="125" width="90" height="90" rx="10"/><rect x="425" y="125" width="90" height="90" rx="10"/><rect x="200" y="250" width="90" height="90" rx="10"/><rect x="350" y="250" width="90" height="90" rx="10"/><animateTransform attributeName="transform" type="translate" values="0 0;0 -10;0 0" dur="1.5s" calcMode="linear" repeatCount="indefinite"/></g>`;
		case 'vozik': return `<rect width="640" height="400" fill="#e7f5ff"/><rect y="320" width="640" height="80" fill="#dee2e6"/><g><path d="M25 268h45" stroke="#1971c2" stroke-width="9"/><path d="m78 268-18-13v26z" fill="#1971c2"/><text x="28" y="225" font-size="27" font-weight="700">20 N</text><rect x="80" y="235" width="145" height="65" rx="10" fill="#51cf66" stroke="#333" stroke-width="4"/><circle cx="110" cy="310" r="17" fill="#343a40"/><circle cx="195" cy="310" r="17" fill="#343a40"/><animateTransform attributeName="transform" type="translate" from="0 0" to="315 0" dur="4s" calcMode="linear" repeatCount="indefinite"/></g><text x="455" y="365" font-size="27" font-weight="700">10 m</text>`;
		case 'zavazi': return `<rect width="640" height="400" fill="#fff4e6"/><path d="M170 330h300" stroke="#333" stroke-width="7"/><circle cx="320" cy="135" r="35" fill="#ffd8a8" stroke="#333" stroke-width="3"/><path d="M320 170v105M320 275l-45 55M320 275l45 55" stroke="#333" stroke-width="12" stroke-linecap="round"/><g><path d="M320 200l-85 50M320 200l85 50" stroke="#333" stroke-width="12" stroke-linecap="round"/><rect x="220" y="240" width="70" height="55" rx="8" fill="#495057"/><rect x="370" y="240" width="70" height="55" rx="8" fill="#495057"/><animateTransform attributeName="transform" type="translate" values="0 20;0 -20;0 20" dur="3s" calcMode="linear" repeatCount="indefinite"/></g><text x="260" y="370" font-size="26">5 kg · 1 m</text>`;
		case 'bedna': return `<rect width="640" height="400" fill="#e7f5ff"/><path d="M75 350V45h320M150 45l-75 80M270 45v65" stroke="#495057" stroke-width="12" fill="none"/><line x1="270" y1="100" x2="270" y2="245" stroke="#333" stroke-width="5"><animate attributeName="y2" values="245;135;245" dur="3.5s" calcMode="linear" repeatCount="indefinite"/></line><g><rect x="190" y="190" width="160" height="105" fill="#c68642" stroke="#333" stroke-width="4"/><animateTransform attributeName="transform" type="translate" values="0 55;0 -55;0 55" dur="3.5s" calcMode="linear" repeatCount="indefinite"/></g><text x="405" y="185" font-size="28" font-weight="700">300 kg</text><text x="430" y="230" font-size="28" font-weight="700">5 m</text>`;
		case 'lokomotiva': return `<rect width="640" height="400" fill="#e7f5ff"/><rect y="320" width="640" height="80" fill="#dee2e6"/><line x1="0" y1="315" x2="640" y2="315" stroke="#333" stroke-width="8"/><g><rect x="55" y="205" width="175" height="95" rx="8" fill="#c2410c" stroke="#333" stroke-width="4"/><rect x="165" y="155" width="65" height="55" fill="#c2410c" stroke="#333" stroke-width="4"/><circle cx="95" cy="305" r="22" fill="#343a40"/><circle cx="195" cy="305" r="22" fill="#343a40"/><animateTransform attributeName="transform" type="translate" from="0 0" to="345 0" dur="4.5s" calcMode="linear" repeatCount="indefinite"/></g><text x="320" y="80" text-anchor="middle" font-size="25">900 000 000 J · 4 500 m</text>`;
		case 'draha': return `<rect width="640" height="400" fill="#fff9db"/><path d="M80 300H560" stroke="#495057" stroke-width="8" stroke-dasharray="20 12"><animate attributeName="stroke-dashoffset" from="0" to="-64" dur="1.3s" repeatCount="indefinite"/></path><rect x="90" y="210" width="115" height="80" fill="#ff922b" stroke="#333" stroke-width="4"/><path d="M55 250h45" stroke="#1971c2" stroke-width="9"/><path d="m105 250-18-13v26z" fill="#1971c2"/><text x="320" y="105" text-anchor="middle" font-size="30" font-weight="700">W = F · s</text>`;
		default: return '';
	}
}

const scenyHtml: Record<string, string> = {};
for (const c of karty) {
	scenyHtml[c.id] = `<svg viewBox="0 0 640 400" role="img" aria-label="${c.otazka}" xmlns="http://www.w3.org/2000/svg" font-family="sans-serif">
${scenaSvg(c.scena)}
<g data-odhal="1" opacity="0"><rect x="70" y="8" width="500" height="42" rx="12" fill="#fff" stroke="#2b8a3e" stroke-width="4"/>
<text x="320" y="38" text-anchor="middle" font-size="25" font-weight="800" fill="#1b4d2a">${NAPIS[c.id]}</text></g></svg>`;
}
const maxBodu = KOLA.reduce((s, k) => s + k.karty.length * k.body, 0);
---

<div id="hra-prace" data-kola={JSON.stringify(KOLA)}>
	<section id="nastaveni">
		<h1><span class="podtrh">🏋️ Mechanická práce</span></h1>
		<p class="podnadpis">Hra pro třídu · Fyzika · 8. ročník · asi 12 minut</p>
		<ol class="pravidla">
			<li><b>3 kola po 5 kartách:</b> kdy se práce koná · veličiny a jednotky · výpočtové finále.</li>
			<li>Týmy se poradí a po odpočtu <b>zvednou kartu A, nebo B</b>.</li>
			<li>Za správnou odpověď 1 bod, ve <b>FINÁLE 2 body</b>.</li>
		</ol>
		<p class="pozn">Karty A/B: <a href="/hry/karty" target="_blank">vytisknout</a>. Maximum je {maxBodu} bodů.</p>
		<div class="volby">
			<label>Počet týmů<select id="pocet-tymu">{[2, 3, 4, 5, 6].map((n) => <option value={n} selected={n === 4}>{n}</option>)}</select></label>
			<label>Čas na kartu<select id="cas-karty"><option value="10">10 s</option><option value="15" selected>15 s</option><option value="20">20 s</option></select></label>
		</div>
		<div id="jmena-tymu"></div>
		<button id="start" class="velke-tlacitko">Začít hru ▶</button>
	</section>

	<section id="uvod-kola" hidden>
		<p class="cislo-kola" id="uvod-cislo"></p><h1 id="uvod-nazev"></h1><p class="pravidlo" id="uvod-pravidlo"></p>
		<div class="moznosti uvod-moznosti">
			<div class="moznost moznost-A"><b>A</b><span><span class="m-popis" id="uvod-A"></span><small id="uvod-A2"></small></span></div>
			<div class="moznost moznost-B"><b>B</b><span><span class="m-popis" id="uvod-B"></span><small id="uvod-B2"></small></span></div>
		</div>
		<p class="za-body" id="uvod-body"></p><button id="hrajeme" class="velke-tlacitko">Hrajeme ▶</button>
	</section>

	<section id="karta" hidden>
		<header class="lista"><span id="lista-kolo"></span><span id="lista-body" class="lista-body"></span><span id="odpocet-cislo" class="odpocet-cislo"></span><button id="cela-obrazovka" class="male-tlacitko" title="Celá obrazovka">⛶</button></header>
		<div id="odpocet-pruh"><div id="odpocet-vypln"></div></div>
		<div class="plocha">
			<div class="leva"><div class="scena-obal">{karty.map((k) => <div class="scena skryta" data-karta={k.id} set:html={scenyHtml[k.id]} />)}</div>
				<div id="odhaleni" hidden><p id="proc" class="proc"></p><p id="citace" class="citace"></p><p class="pokyn">Klepni na týmy, které odpověděly správně ↓</p></div></div>
			<div class="prava"><h2 id="otazka"></h2><div class="moznosti">
				<div class="moznost moznost-A" data-m="A"><b>A</b><span><span class="m-popis"></span><small></small></span></div>
				<div class="moznost moznost-B" data-m="B"><b>B</b><span><span class="m-popis"></span><small></small></span></div>
			</div><div class="ovladani"><button id="odhalit" class="velke-tlacitko">Odhalit odpověď ✔</button><button id="dalsi" class="velke-tlacitko" hidden>Další karta ▶</button></div></div>
		</div>
		<div id="tymy" class="tymy"></div>
	</section>

	<section id="vysledky" hidden><h1><span class="podtrh">🎉 Konečné pořadí</span></h1><ol id="podium"></ol>
		<p class="shrnuti">Pamatuj: <b>mechanická práce se koná, když síla posune těleso ve směru síly. Platí W = F · s.</b></p>
		<button id="znovu" class="velke-tlacitko">Nová hra 🔄</button></section>
</div>

<script>
	type Odp = 'A' | 'B'; type Mozn = { popis: string; doplnek: string };
	type K = { id: string; otazka: string; spravne: Odp; proc: string; zdroj: string };
	type Kolo = { cislo: number; nazev: string; pravidlo: string; moznosti: Record<Odp, Mozn>; body: number; karty: K[] };
	type Tym = { jmeno: string; body: number };
	const $ = (id: string) => document.getElementById(id)!;
	const KOLA: Kolo[] = JSON.parse($('hra-prace').dataset.kola!);
	const omezeniPohybu = window.matchMedia('(prefers-reduced-motion: reduce)');
	let tymy: Tym[] = []; let iKolo = 0; let iKarta = 0; let casNaKartu = 15;
	let odpocetId: ReturnType<typeof setInterval> | undefined; let odhaleno = false;
	const kolo = () => KOLA[iKolo]; const karta = () => kolo().karty[iKarta];
	function poradi(t: Tym[]) { const s = t.map((x, i) => ({ ...x, i })).sort((a, b) => b.body - a.body || a.i - b.i); return s.map((x) => ({ jmeno: x.jmeno, body: x.body, misto: s.findIndex((u) => u.body === x.body) + 1 })); }
	function ukaz(sekce: string) { for (const id of ['nastaveni', 'uvod-kola', 'karta', 'vysledky']) $(id).hidden = id !== sekce; $('hra-prace').scrollIntoView({ block: 'start' }); }
	function vykresliJmena() { const n = +($('pocet-tymu') as HTMLSelectElement).value; const barvy = ['Červení', 'Modří', 'Zelení', 'Žlutí', 'Fialoví', 'Oranžoví']; $('jmena-tymu').innerHTML = Array.from({ length: n }, (_, i) => `<input class="jmeno-tymu" value="${barvy[i]}" maxlength="16">`).join(''); }
	$('pocet-tymu').addEventListener('change', vykresliJmena); vykresliJmena();
	$('start').addEventListener('click', () => { tymy = [...document.querySelectorAll<HTMLInputElement>('.jmeno-tymu')].map((el, i) => ({ jmeno: el.value.trim() || `Tým ${i + 1}`, body: 0 })); casNaKartu = +($('cas-karty') as HTMLSelectElement).value; iKolo = 0; uvodKola(); });
	function uvodKola() { const k = kolo(); $('uvod-cislo').textContent = `Kolo ${k.cislo} ze ${KOLA.length}`; $('uvod-nazev').textContent = k.nazev; $('uvod-pravidlo').textContent = k.pravidlo; $('uvod-A').textContent = k.moznosti.A.popis; $('uvod-A2').textContent = k.moznosti.A.doplnek; $('uvod-B').textContent = k.moznosti.B.popis; $('uvod-B2').textContent = k.moznosti.B.doplnek; $('uvod-body').textContent = k.body === 1 ? 'Za každou správnou kartu 1 bod.' : `Za každou správnou kartu ${k.body} body!`; ukaz('uvod-kola'); }
	$('hrajeme').addEventListener('click', () => { iKarta = 0; ukaz('karta'); zobrazKartu(); });
	function zobrazKartu() {
		const k = kolo(); const c = karta(); odhaleno = false;
		$('lista-kolo').textContent = `Kolo ${k.cislo}/${KOLA.length} · karta ${iKarta + 1}/${k.karty.length}`; $('lista-body').textContent = k.body === 1 ? 'za 1 bod' : `⭐ FINÁLE · za ${k.body} body`;
		document.querySelectorAll<HTMLElement>('.scena').forEach((s) => s.classList.toggle('skryta', s.dataset.karta !== c.id));
		const sv = document.querySelector<SVGSVGElement>('.scena[data-karta="' + c.id + '"] svg'); if (sv) { sv.setCurrentTime?.(0); if (omezeniPohybu.matches) sv.pauseAnimations?.(); else sv.unpauseAnimations?.(); }
		document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-odhal]`).forEach((el) => el.setAttribute('opacity', '0'));
		$('otazka').textContent = c.otazka;
		document.querySelectorAll<HTMLElement>('#karta .moznost').forEach((el) => { const m = el.dataset.m as Odp; el.querySelector('.m-popis')!.textContent = k.moznosti[m].popis; el.querySelector('small')!.textContent = k.moznosti[m].doplnek; el.classList.remove('spravna', 'spatna'); });
		$('odhaleni').hidden = true; $('odhalit').hidden = false; $('dalsi').hidden = true; vykresliTymy(); spustOdpocet();
	}
	function spustOdpocet() { let zbyva = casNaKartu; const vypln = $('odpocet-vypln'); $('odpocet-cislo').textContent = `${zbyva} s`; vypln.style.transition = 'none'; vypln.style.width = '100%'; if (!omezeniPohybu.matches) requestAnimationFrame(() => requestAnimationFrame(() => { vypln.style.transition = `width ${casNaKartu}s linear`; vypln.style.width = '0%'; })); clearInterval(odpocetId); odpocetId = setInterval(() => { zbyva--; $('odpocet-cislo').textContent = `${Math.max(zbyva, 0)} s`; if (zbyva <= 3 && zbyva > 0) pipni(600); if (zbyva <= 0) { clearInterval(odpocetId); vypln.style.width = '0%'; pipni(880, 0.4); $('odpocet-cislo').textContent = 'Zvedněte karty!'; } }, 1000); }
	function pipni(frekvence: number, delka = 0.12) { try { const w = window as unknown as { _ctxHry?: AudioContext }; const ctx = (w._ctxHry ??= new AudioContext()); const osc = ctx.createOscillator(); const gain = ctx.createGain(); osc.frequency.value = frekvence; gain.gain.value = 0.15; osc.connect(gain).connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime + delka); } catch { /* bez zvuku */ } }
	$('odhalit').addEventListener('click', () => { clearInterval(odpocetId); const c = karta(); odhaleno = true; $('odpocet-cislo').textContent = ''; $('odpocet-vypln').style.transition = 'none'; $('odpocet-vypln').style.width = '0%'; document.querySelectorAll<HTMLElement>('#karta .moznost').forEach((el) => { el.classList.toggle('spravna', el.dataset.m === c.spravne); el.classList.toggle('spatna', el.dataset.m !== c.spravne); }); document.querySelectorAll(`.scena[data-karta="${c.id}"] [data-odhal]`).forEach((el) => el.setAttribute('opacity', '1')); $('proc').textContent = `✔ ${c.proc}`; $('citace').textContent = `Zdroj: Mechanická práce, ${c.zdroj}`; $('odhaleni').hidden = false; $('odhalit').hidden = true; $('dalsi').hidden = false; vykresliTymy(); });
	function vykresliTymy() { $('tymy').innerHTML = tymy.map((t, i) => `<div class="tym-obal"><button class="tym" data-i="${i}" ${odhaleno ? '' : 'disabled'}><span>${t.jmeno}</span><b class="tym-body">${t.body}</b></button></div>`).join(''); document.querySelectorAll<HTMLButtonElement>('.tym').forEach((b) => b.addEventListener('click', () => b.classList.toggle('oznaceny'))); }
	$('dalsi').addEventListener('click', () => { const body = kolo().body; document.querySelectorAll<HTMLElement>('.tym.oznaceny').forEach((b) => (tymy[+b.dataset.i!].body += body)); iKarta++; if (iKarta < kolo().karty.length) return zobrazKartu(); iKolo++; if (iKolo < KOLA.length) return uvodKola(); konec(); });
	function konec() { clearInterval(odpocetId); ukaz('vysledky'); const medaile = ['🥇', '🥈', '🥉']; $('podium').innerHTML = poradi(tymy).map((t) => `<li class="podium-radek">${medaile[t.misto - 1] ?? '🏅'} ${t.misto}. <b>${t.jmeno}</b> — ${t.body} b.</li>`).join(''); }
	$('znovu').addEventListener('click', () => location.reload()); $('cela-obrazovka').addEventListener('click', () => { if (document.fullscreenElement) document.exitFullscreen(); else $('hra-prace').requestFullscreen?.(); });
	omezeniPohybu.addEventListener?.('change', () => document.querySelectorAll<SVGSVGElement>('.scena svg').forEach((svg) => { svg.setCurrentTime?.(0); if (omezeniPohybu.matches) svg.pauseAnimations?.(); else svg.unpauseAnimations?.(); }));
</script>

<style>
	#hra-prace { max-width: 1200px; margin: 0 auto; background: var(--papir); }
	#hra-prace:fullscreen { max-width: none; padding: 1rem 2rem; overflow: auto; }
	.podnadpis { font-size: 1.3rem; color: #495057; margin-top: -.6rem; } .pravidla li { margin: .3rem 0; } .pozn { color: #5c5f66; font-size: 1.1rem; }
	.volby, #jmena-tymu { display: flex; gap: .8rem; flex-wrap: wrap; margin: 1rem 0; } .volby label { display: flex; flex-direction: column; font-weight: 700; gap: .3rem; } .volby select, #jmena-tymu :global(.jmeno-tymu) { font-size: 1.2rem; padding: .4rem; }
	.velke-tlacitko { font: 800 1.4rem inherit; padding: .6rem 1.6rem; border-radius: 12px; border: 3px solid #333; background: #ffe066; cursor: pointer; } .male-tlacitko { margin-left: auto; font-size: 1.1rem; padding: .35rem .8rem; border: 2px solid #888; border-radius: 10px; background: #fff; }
	#uvod-kola { text-align: center; padding-top: 1rem; } .cislo-kola { font-size: 1.6rem; font-weight: 800; color: #c2410c; margin: 0; } #uvod-nazev { font-size: 2.7rem; margin: .1rem 0 .4rem; } .pravidlo { font-size: 1.5rem; max-width: 48rem; margin: 0 auto 1rem; } .za-body { font-size: 1.5rem; font-weight: 800; }
	.lista { display: flex; align-items: center; gap: 1rem; font-size: 1.3rem; font-weight: 800; } .lista-body { color: #c2410c; flex: 1; text-align: center; } .odpocet-cislo { min-width: 5rem; color: #c92a2a; text-align: right; }
	#odpocet-pruh { height: 12px; background: #e9ecef; border-radius: 6px; overflow: hidden; margin: .3rem 0 .6rem; } #odpocet-vypln { height: 100%; background: linear-gradient(90deg,#40c057,#ffd43b,#fa5252); }
	.plocha { display: grid; grid-template-columns: 3fr 2fr; gap: 1.2rem; align-items: start; } .scena-obal { position: relative; } .scena.skryta { visibility: hidden; position: absolute; inset: 0; pointer-events: none; } .scena-obal :global(svg) { display: block; width: 100%; border: 3px solid #333; border-radius: 14px; background: #fff; }
	#otazka { font-size: 1.75rem; line-height: 1.25; margin: 0 0 .8rem; } .moznosti { display: grid; gap: .7rem; } .moznost { display: flex; align-items: center; gap: .9rem; padding: .55rem 1rem; border: 4px solid #333; border-radius: 14px; background: #fff; } .moznost > b { width: 3rem; height: 3rem; border-radius: 50%; color: #fff; font-size: 2rem; display: grid; place-items: center; flex: none; } .moznost-A > b { background: #e03131; } .moznost-B > b { background: #1971c2; } .m-popis { display: block; font-size: 1.75rem; font-weight: 800; } .moznost small { display: block; font-size: 1rem; color: #495057; } .moznost.spravna { background: #d3f9d8; border-color: #2b8a3e; } .moznost.spatna { background: #f1f3f5; border-color: #6c757d; color: #343a40; }
	.ovladani { display: flex; justify-content: flex-end; margin-top: .9rem; } .proc { font-size: 1.35rem; font-weight: 700; color: #1b4d2a; margin: .5rem 0 .1rem; } .citace { margin: .15rem 0; color: #5c5f66; font-style: italic; } .pokyn { font-weight: 700; color: #495057; }
	.tymy { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .7rem; } .tymy :global(.tym) { display: flex; gap: .7rem; align-items: center; font-size: 1.2rem; padding: .4rem .8rem; border: 3px solid #333; border-radius: 12px; background: #fff; color: inherit; } .tymy :global(.tym.oznaceny) { background: #d3f9d8; border-color: #2b8a3e; } .tymy :global(.tym-body) { font-size: 1.7rem; } #podium { list-style: none; padding: 0; } #podium :global(.podium-radek) { font-size: 2rem; margin: .5rem 0; } .shrnuti { font-size: 1.35rem; }
	@media (max-width: 900px) { .plocha { grid-template-columns: 1fr; } #otazka { font-size: 1.5rem; } .m-popis { font-size: 1.45rem; } .lista { flex-wrap: wrap; font-size: 1rem; } }
	@media (prefers-reduced-motion: reduce) {
		#odpocet-vypln { transition: none !important; }
		.scena-obal :global(svg *) { animation: none !important; }
	}
</style>
