---
// Interaktivní kladka (F7): přepínání mezi pevnou a volnou kladkou, čísla přesně
// podle výkladu a obrázků kladka-obr-01/02: závaží 2 kg, tíha 20 N (g = 10 N/kg),
// zdvih 1 m.
//   · PEVNÁ kladka u stropu: ruka táhne DOLŮ silou 20 N, vytáhne 1 m lana.
//   · VOLNÁ kladka visí na laně s břemenem: jeden konec lana je upevněný ke stropu,
//     lano vede POD kladkou a druhý konec táhne ruka NAHORU silou 10 N (20 : 2).
//     Když se břemeno zvedne o 1 m, ruka vytáhne 2 m lana — kóty „1 m“ a „2 m“
//     a čárkovaná výchozí poloha to ukazují přímo v obraze.
// Geometrie je čistá funkce geometrie(volna, zvednuto) na SVG (__geometrieKladky),
// kontrolovatelná výpočtem bez prohlížeče. Animace běží podle času (1,5 s), ne
// podle počtu snímků, takže nezávisí na rychlosti requestAnimationFrame.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vyzkoušej: pevná a volná kladka 🕹️</span></h2>
	<p>
		Zvedáme závaží <strong>2 kg</strong> s tíhou <strong>20 N</strong> o <strong>1 m</strong>.
		<strong>Pevná kladka</strong> jen mění směr síly — táhneš dolů stejnou silou 20 N a vytáhneš 1 m lana.
		<strong>Volná kladka</strong> zvedá závaží <strong>poloviční silou</strong> 10 N, ale lano musíš vytáhnout
		<strong>dvakrát delší</strong> — 2 m. Vyber druh kladky a táhni za lano.
	</p>
	<div class="kl-prepinac">
		<button id="kl-pevna" class="kl-akt" type="button" aria-pressed="true">Pevná kladka</button>
		<button id="kl-volna" type="button" aria-pressed="false">Volná kladka</button>
	</div>
	<svg id="kl-svg" viewBox="0 0 420 390" role="img" aria-label="Pevná kladka se závažím 2 kg, závaží dole">
		<!-- strop -->
		<rect x="0" y="0" width="420" height="18" fill="#868e96" />
		<line x1="0" y1="18" x2="420" y2="18" stroke="#2b2a26" stroke-width="2" />
		<g id="kl-obsah"></g>
	</svg>
	<div class="kl-ovladani">
		<button id="kl-tahni" type="button">🖐️ Táhni za lano</button>
		<button id="kl-reset" type="button">↺ Zpět</button>
	</div>
	<p id="kl-info" class="kl-info" aria-live="polite"></p>
</section>

<script>
	const $ = (id) => document.getElementById(id);
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	const HMOTNOST = 2; // kg (výklad: závaží 2 kg)
	const G = 10; // N/kg
	const TIHA = HMOTNOST * G; // 20 N
	const ZDVIH = 1; // m (výklad: závaží se zvedne o 1 m)
	const PX_NA_M = 60; // měřítko scény: jeden metr odpovídá 60 px
	const DOBA = 1500; // ms, jak dlouho trvá zvednutí
	const LANO = '#8a4b1f', KOTA = '#f59f00', SIPKA = '#e03131';

	// Poloha všeho, co se hýbe. zvednuto 0…1 (0 = dole, 1 = zvednuto o 1 m).
	function geometrie(jeVolna, zvednuto) {
		const posun = zvednuto * PX_NA_M; // o kolik px se zvedlo břemeno
		if (!jeVolna) {
			// pevná: kladka stojí, břemeno jede nahoru, ruka stejně daleko dolů
			return { sila: TIHA, drahaLana: ZDVIH, ky: 60, bremenoY: 250 - posun, rukaY: 120 + posun };
		}
		// volná: kladka jede s břemenem; lano = pravá část (strop→kladka) + levá (kladka→ruka),
		// délka 2·ky − rukaY je stálá, proto ruka jede dvakrát dál než kladka
		// start: kladka 260, ruka 155 — obrys výchozí polohy ruky zůstane i po zvednutí NAD kladkou
		const ky = 260 - posun;
		return { sila: TIHA / 2, drahaLana: ZDVIH + ZDVIH, ky, bremenoY: ky + 40, rukaY: 155 - posun - posun };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	$('kl-svg').__geometrieKladky = geometrie;
	let volna = false;
	let zvednuto = 0; // 0..1

	const cara = (x1, y1, x2, y2, barva, sirka, extra = '') =>
		`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${barva}" stroke-width="${sirka}"${extra} />`;
	function bremeno(x, y, duch) {
		if (duch) return `<rect x="${x - 24}" y="${y}" width="48" height="44" rx="5" fill="none" stroke="#adb5bd" stroke-width="2" stroke-dasharray="5 4" />`;
		return `<rect x="${x - 24}" y="${y}" width="48" height="44" rx="5" fill="#495057" stroke="#2b2a26" stroke-width="3" />` +
			`<text x="${x}" y="${y + 28}" text-anchor="middle" font-size="14" font-weight="bold" fill="#fff">${HMOTNOST} kg</text>`;
	}
	function ruka(x, y, duch) {
		if (duch) return `<rect x="${x - 10}" y="${y - 11}" width="20" height="22" rx="6" fill="none" stroke="#adb5bd" stroke-width="2" stroke-dasharray="4 3" />`;
		return `<rect x="${x - 10}" y="${y - 11}" width="20" height="22" rx="6" fill="#f4c7a1" stroke="#b86b3c" stroke-width="2" />`;
	}
	// svislá šipka síly: od y1 k hrotu y2 (hrot výš než začátek → šipka nahoru, jinak dolů)
	function sipka(x, y1, y2, text, tx, ty, zarovnani) {
		const smer = y2 < y1 ? -1 : 1;
		return cara(x, y1, x, y2 - smer * 6, SIPKA, 4) +
			`<polygon points="${x - 6},${y2 - smer * 8} ${x + 6},${y2 - smer * 8} ${x},${y2}" fill="${SIPKA}" />` +
			`<text x="${tx}" y="${ty}" text-anchor="${zarovnani}" font-size="14" font-weight="bold" fill="${SIPKA}">${text}</text>`;
	}
	// kóta: svislá oranžová čára s příčkami od y1 do y2, popisek jen po dokončení (celé metry)
	// odX = kde leží měřený předmět: od něj vedou ke kótě čárkované vodicí linky (jako v obr-02)
	function kota(x, y1, y2, popisek, tx, zarovnani, odX) {
		const vodici = ` stroke-dasharray="4 4"`;
		let s = cara(odX, y1, x, y1, '#adb5bd', 2, vodici) + cara(odX, y2, x, y2, '#adb5bd', 2, vodici);
		s += cara(x, y1, x, y2, KOTA, 3) + cara(x - 7, y1, x + 7, y1, KOTA, 3) + cara(x - 7, y2, x + 7, y2, KOTA, 3);
		if (popisek) s += `<text x="${tx}" y="${(y1 + y2) / 2 + 5}" text-anchor="${zarovnani}" font-size="15" font-weight="bold" fill="#2b2a26">${popisek}</text>`;
		return s;
	}

	function prekresli() {
		const g = geometrie(volna, zvednuto);
		const g0 = geometrie(volna, 0);
		const hotovo = zvednuto >= 1;
		let svg = '';
		if (!volna) {
			// PEVNÁ kladka u stropu, závaží vlevo, ruka vpravo táhne dolů
			svg += cara(210, 18, 210, 32, '#2b2a26', 3);
			svg += `<circle cx="210" cy="${g.ky}" r="28" fill="#c9a227" stroke="#2b2a26" stroke-width="3" />`;
			svg += `<circle cx="210" cy="${g.ky}" r="5" fill="#2b2a26" />`;
			svg += `<path d="M182 ${g.ky} A28 28 0 0 1 238 ${g.ky}" fill="none" stroke="${LANO}" stroke-width="3" />`;
			svg += cara(182, g.ky, 182, g.bremenoY, LANO, 3);
			svg += cara(238, g.ky, 238, g.rukaY, LANO, 3);
			if (zvednuto > 0) {
				svg += bremeno(182, g0.bremenoY, true) + ruka(238, g0.rukaY, true);
				svg += kota(120, g0.bremenoY, g.bremenoY, hotovo ? `${ZDVIH} m` : '', 112, 'end', 158);
				svg += kota(360, g0.rukaY, g.rukaY, hotovo ? `${g.drahaLana} m` : '', 368, 'start', 248);
			}
			svg += bremeno(182, g.bremenoY, false);
			svg += sipka(182, g.bremenoY + 44, g.bremenoY + 74, `tíha ${TIHA} N`, 214, g.bremenoY + 66, 'start');
			svg += ruka(238, g.rukaY, false);
			svg += sipka(238, g.rukaY + 11, g.rukaY + 51, `táhneš ${g.sila} N`, 246, g.rukaY + 40, 'start');
		} else {
			// VOLNÁ kladka: pravý konec lana u stropu, lano pod kladkou, levý konec drží ruka a táhne nahoru
			svg += `<circle cx="236" cy="18" r="4" fill="#2b2a26" />`;
			svg += cara(236, 18, 236, g.ky, LANO, 3);
			svg += `<text x="244" y="${g.ky - 50}" font-size="14" font-weight="bold" fill="#1971c2">strop drží ${g.sila} N</text>`;
			if (zvednuto > 0) {
				svg += bremeno(210, g0.bremenoY, true) + ruka(184, g0.rukaY, true);
				svg += kota(110, g0.bremenoY, g.bremenoY, hotovo ? `${ZDVIH} m` : '', 102, 'end', 186);
				svg += kota(44, g0.rukaY, g.rukaY, hotovo ? `${g.drahaLana} m` : '', 36, 'end', 174);
			}
			svg += `<circle cx="210" cy="${g.ky}" r="26" fill="#c9a227" stroke="#2b2a26" stroke-width="3" />`;
			svg += `<circle cx="210" cy="${g.ky}" r="5" fill="#2b2a26" />`;
			svg += `<path d="M184 ${g.ky} A26 26 0 0 0 236 ${g.ky}" fill="none" stroke="${LANO}" stroke-width="3" />`;
			svg += cara(184, g.ky, 184, g.rukaY, LANO, 3);
			svg += cara(210, g.ky, 210, g.bremenoY, '#2b2a26', 3);
			svg += bremeno(210, g.bremenoY, false);
			svg += sipka(210, g.bremenoY + 44, g.bremenoY + 74, `tíha ${TIHA} N`, 242, g.bremenoY + 66, 'start');
			svg += ruka(184, g.rukaY, false);
			// šipka vpravo od ruky (mezi rukou a upevněnou částí lana) — vodicí linky kót vedou doleva, šipku nekříží
			svg += sipka(212, g.rukaY + 20, g.rukaY - 8, `táhneš ${g.sila} N`, 166, g.rukaY + 30, 'end');
		}
		$('kl-obsah').innerHTML = svg;
		$('kl-svg').setAttribute('aria-label', `${volna ? 'Volná' : 'Pevná'} kladka se závažím ${HMOTNOST} kg, ${hotovo ? `závaží zvednuto o ${ZDVIH} m` : zvednuto > 0 ? 'závaží se zvedá' : 'závaží dole'}`);

		if (!volna) {
			$('kl-info').innerHTML = hotovo
				? `✅ Zvednuto o ${ZDVIH} m! Táhl jsi silou <strong>${g.sila} N</strong> a vytáhl <strong>${g.drahaLana} m</strong> lana — stejně, jako se zvedlo závaží. Pevná kladka jen otočila směr.`
				: `Závaží ${HMOTNOST} kg má tíhu <strong>${TIHA} N</strong>. Pevná kladka mění jen směr — táhneš dolů silou <strong>${g.sila} N</strong>. Klikni „Táhni“.`;
		} else {
			$('kl-info').innerHTML = hotovo
				? `✅ Zvednuto o ${ZDVIH} m poloviční silou! Závaží ${TIHA} N nesou <strong>dvě</strong> části lana: <strong>${g.sila} N drží strop</strong> a <strong>${g.sila} N táhneš ty</strong> (${g.sila} + ${g.sila} = ${TIHA} N). Zato jsi vytáhl <strong>${g.drahaLana} m</strong> lana — co ušetříš na síle, doplatíš na dráze.`
				: `Závaží ${HMOTNOST} kg s tíhou ${TIHA} N visí na <strong>dvou</strong> částech lana: <strong>strop drží ${g.sila} N</strong>, <strong>ty táhneš nahoru ${g.sila} N</strong> (${g.sila} + ${g.sila} = ${TIHA} N). Klikni „Táhni“.`;
		}
	}

	// číslo běhu animace: „Zpět“ i přepnutí kladky ho změní → rozběhnutá animace se sama zastaví
	// (na počáteční hodnotě nezáleží, důležité je jen, že se při zastavení změní)
	const animace = { beh: 0 };
	function zastavAVrat() {
		animace.beh++;
		zvednuto = 0;
	}
	function zvolKladku(jeVolna) {
		zastavAVrat();
		volna = jeVolna;
		const [zvolene, druhe] = jeVolna ? ['kl-volna', 'kl-pevna'] : ['kl-pevna', 'kl-volna'];
		$(zvolene).classList.add('kl-akt'); $(druhe).classList.remove('kl-akt');
		$('kl-pevna').setAttribute('aria-pressed', String(!jeVolna)); $('kl-volna').setAttribute('aria-pressed', String(jeVolna));
		prekresli();
	}
	$('kl-pevna').addEventListener('click', () => zvolKladku(false));
	$('kl-volna').addEventListener('click', () => zvolKladku(true));
	$('kl-tahni').addEventListener('click', () => {
		if (zvednuto > 0) return; // už se zvedá nebo je zvednuto — nejdřív „Zpět“
		const start = performance.now();
		const mujBeh = animace.beh;
		const animuj = () => {
			if (mujBeh !== animace.beh) return; // mezitím „Zpět“ nebo přepnutí kladky
			zvednuto = Math.min(1, (performance.now() - start) / DOBA);
			prekresli();
			if (zvednuto < 1) requestAnimationFrame(animuj);
		};
		animuj();
	});
	$('kl-reset').addEventListener('click', () => { zastavAVrat(); prekresli(); });
	prekresli();
</script>

<style>
	.kl-prepinac {
		display: flex;
		gap: 0.6rem;
		margin: 0.6rem 0;
	}
	.kl-prepinac button {
		font-weight: 700;
		padding: 0.4rem 1.1rem;
		border: 3px solid #2b2a26;
		border-radius: 10px;
		background: #fff;
		cursor: pointer;
	}
	.kl-prepinac button.kl-akt {
		background: #ffd43b;
	}
	#kl-svg {
		width: 100%;
		max-width: 420px;
		display: block;
		margin: 0 auto;
		background: #f8f9fa;
		border: 3px solid #2b2a26;
		border-radius: 12px;
	}
	.kl-ovladani {
		display: flex;
		gap: 0.8rem;
		margin: 0.6rem 0;
	}
	.kl-ovladani button {
		font-weight: 700;
		padding: 0.4rem 1.1rem;
		border: 3px solid #2b2a26;
		border-radius: 10px;
		background: #ffd43b;
		cursor: pointer;
	}
	.kl-info {
		font-weight: 600;
		padding: 0.6rem;
		border-radius: 10px;
		background: #fff3bf;
	}
</style>
