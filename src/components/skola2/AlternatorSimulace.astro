---
// Alternátor (F9): rotor-magnet se točí ve statoru s cívkou, voltmetr ukazuje
// indukované napětí a na grafu běží sinusovka. Klíčové jevy: U = 0, když pole
// cívkou prochází nejvíc, ale nemění se (0° a 180°); U největší, když se pole
// mění nejrychleji (90° a 270°, s opačným znaménkem → STŘÍDAVÝ proud);
// rychlejší otáčení = vyšší napětí (amplituda 2 dílky × otáčky). Krok ¼ otáčky
// projde učebnicové polohy. Pohyb je ČISTÁ funkce času stavAlternatoru(t, rychlost)
// na SVG (__stavAlternatoru) — animace projeta vzorkováním po 16 ms.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Alternátor — výroba střídavého proudu 🕹️</span></h2>
	<p><strong>Rotor</strong> (magnet) se točí, ve <strong>statoru</strong> (cívce) se indukuje napětí. Protože se směr pohybu pole pravidelně obrací, proud <strong>střídá směr</strong> — přesně takový teče v zásuvce.</p>
	<svg id="alt-svg" viewBox="0 0 660 360" role="img" aria-label="Rotor s magnetem ve statoru, voltmetr a graf střídavého napětí">
		<!-- stator s cívkou -->
		<circle cx="170" cy="210" r="92" fill="none" stroke="#868e96" stroke-width="10" />
		<g fill="none" stroke="#e8590c" stroke-width="4">
			<circle cx="130" cy="126" r="9" /><circle cx="156" cy="118" r="9" /><circle cx="184" cy="118" r="9" /><circle cx="210" cy="126" r="9" />
		</g>
		<text x="60" y="115" font-size="11" fill="#868e96">cívka statoru</text>
		<text x="170" y="330" text-anchor="middle" font-size="11" fill="#868e96">stator (pevný) + rotor (točí se)</text>
		<!-- rotor: tyčový magnet -->
		<g id="alt-rotor">
			<rect x="105" y="196" width="65" height="28" rx="4" fill="#ff8787" stroke="#2b2a26" stroke-width="3" />
			<rect x="170" y="196" width="65" height="28" rx="4" fill="#74c0fc" stroke="#2b2a26" stroke-width="3" />
			<text x="122" y="216" font-size="15" font-weight="bold" fill="#2b2a26">N</text>
			<text x="222" y="216" font-size="15" font-weight="bold" fill="#2b2a26">S</text>
		</g>
		<circle cx="170" cy="210" r="6" fill="#2b2a26" />
		<!-- vodiče k voltmetru -->
		<path d="M143 118 L143 60 L330 60 M197 118 L197 84 L360 84" fill="none" stroke="#2b2a26" stroke-width="3" />
		<!-- voltmetr -->
		<path d="M285 160 A70 70 0 0 1 425 160" fill="#fff" stroke="#2b2a26" stroke-width="3" />
		<line x1="285" y1="160" x2="425" y2="160" stroke="#2b2a26" stroke-width="3" />
		<g font-size="10" fill="#868e96" text-anchor="middle">
			<text x="295" y="130">−6</text><text x="355" y="98">0</text><text x="417" y="130">+6</text>
		</g>
		<line id="alt-rucicka" x1="355" y1="160" x2="355" y2="104" stroke="#e03131" stroke-width="4" stroke-linecap="round" />
		<circle cx="355" cy="160" r="5" fill="#2b2a26" />
		<text id="alt-u" x="355" y="182" text-anchor="middle" font-size="14" font-weight="bold" fill="#e03131"></text>
		<text x="355" y="200" text-anchor="middle" font-size="11" fill="#868e96">voltmetr (dílky)</text>
		<!-- graf: jedna otáčka -->
		<g stroke="#adb5bd" stroke-width="2">
			<line x1="440" y1="250" x2="648" y2="250" />
			<line x1="440" y1="160" x2="440" y2="340" />
		</g>
		<text x="648" y="300" text-anchor="end" font-size="11" fill="#2b2a26" font-weight="bold">otáčka</text>
		<text x="452" y="170" font-size="11" fill="#2b2a26" font-weight="bold">U</text>
		<g font-size="10" fill="#868e96" text-anchor="middle">
			<text x="490" y="264">¼</text><text x="540" y="264">½</text><text x="590" y="264">¾</text><text x="640" y="264">1</text>
		</g>
		<polyline id="alt-sinus" fill="none" stroke="#1971c2" stroke-width="3" stroke-linejoin="round" />
		<circle id="alt-bod" r="7" fill="#e03131" stroke="#2b2a26" stroke-width="2" />
		<text id="alt-smer" x="544" y="336" text-anchor="middle" font-size="12" font-weight="bold" fill="#1971c2"></text>
	</svg>
	<p id="alt-ovladani">
		<button type="button" class="alt-tl" id="alt-play">▶ roztoč rotor</button>
		<button type="button" class="alt-tl" id="alt-krok">↻ pootoč o ¼ otáčky</button>
	</p>
	<label class="sim-posuvnik">
		Rychlost otáčení: <output id="alt-out-r"></output>
		<input type="range" id="alt-slider" min="1" max="3" step="1" value="1" />
	</label>
	<p class="alt-vzorec" id="alt-vzorec"></p>
	<p class="alt-stav" id="alt-stav">👉 Roztoč rotor tlačítkem ▶, nebo ho krokuj po ¼ otáčky a sleduj čtyři učebnicové polohy.</p>
</section>

<script>
	// === ČISTÁ ČÁST (kinematika bez DOM — kontrolovatelná výpočtem) ===
	const T0 = 3000; // ms na jednu otáčku při rychlosti 1
	function stavAlternatoru(tMs, rychlost) {
		const T = T0 / rychlost;
		const theta = (((tMs % T) + T) % T) / T * 2 * Math.PI; // úhel rotoru 0..2π
		const U = 2 * rychlost * Math.sin(theta); // dílky: amplituda 2 × rychlost (max ±6)
		return { theta, U, ctvrt: Math.round(theta / (Math.PI / 2)) % 4 };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	let rychlost = 1;
	let thetaPauza = 0;
	let jede = false, animId = null, t0 = null;
	const svg = document.getElementById('alt-svg');
	svg.__stavAlternatoru = stavAlternatoru; // pro nezávislou kontrolu výpočtem
	const g = (id) => document.getElementById(id);
	const nastav = (id, attrs) => { const el = g(id); for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v); };

	function kresli(s) {
		const deg = s.theta * 180 / Math.PI;
		g('alt-rotor').setAttribute('transform', `rotate(${deg} 170 210)`);
		// voltmetr: ±6 dílků = ±60°
		nastav('alt-rucicka', { transform: `rotate(${(s.U / 6) * 60} 355 160)` });
		const uCele = Math.round(s.U);
		g('alt-u').textContent = `U = ${uCele > 0 ? '+' : ''}${uCele}`;
		// sinusovka jedné otáčky (amplituda dle rychlosti) + běžící bod
		const body = [];
		for (let i = 0; i <= 48; i++) {
			const th = (i / 48) * 2 * Math.PI;
			body.push(`${440 + (i / 48) * 200},${250 - 2 * rychlost * 12 * Math.sin(th)}`);
		}
		nastav('alt-sinus', { points: body.join(' ') });
		nastav('alt-bod', { cx: 440 + (s.theta / (2 * Math.PI)) * 200, cy: 250 - s.U * 12 });
		g('alt-smer').textContent = s.U > 0.2 ? '→ proud teče jedním směrem' : s.U < -0.2 ? '← proud teče OPAČNÝM směrem' : 'proud právě mění směr (U ≈ 0)';
		g('alt-out-r').textContent = `${rychlost}× (max ±${2 * rychlost} dílky)`;
		g('alt-vzorec').innerHTML = `Amplituda napětí = 2 dílky × rychlost ${rychlost} = <strong>±${2 * rychlost} dílky</strong> — čím rychleji se pole mění, tím větší napětí se indukuje. Za 1 otáčku proud <strong>2×</strong> změní směr.`;
	}

	const POLOHY = [
		'🧲 Poloha 0°: pole prochází cívkou NEJVÍC, ale právě se NEMĚNÍ → napětí je 0.',
		'⚡ Poloha 90°: pole se mění NEJRYCHLEJI → napětí je největší.',
		'🧲 Poloha 180°: magnet je obráceně, pole se zase právě nemění → napětí je 0.',
		'⚡ Poloha 270°: pole se mění nejrychleji, ale OPAČNĚ → napětí je největší se záporným znaménkem. Proto je proud STŘÍDAVÝ.',
	];

	function snimek(cas) {
		if (!jede) return;
		const T = T0 / rychlost;
		if (t0 === null) t0 = cas - (thetaPauza / (2 * Math.PI)) * T;
		const s = stavAlternatoru(cas - t0, rychlost);
		thetaPauza = s.theta;
		kresli(s);
		animId = requestAnimationFrame(snimek);
	}
	function zastav() {
		jede = false;
		if (animId) cancelAnimationFrame(animId);
		g('alt-play').textContent = '▶ roztoč rotor';
	}
	g('alt-play').addEventListener('click', () => {
		if (jede) { zastav(); g('alt-stav').textContent = '⏸ Rotor stojí — prohlédni si polohu, krokuj po ¼ otáčky, nebo ho zase roztoč.'; return; }
		jede = true; t0 = null;
		g('alt-play').textContent = '⏸ zastav rotor';
		g('alt-stav').textContent = '🔄 Rotor se točí — sleduj ručičku voltmetru a bod na sinusovce. Zkus zrychlit posuvníkem!';
		requestAnimationFrame(snimek);
	});
	g('alt-krok').addEventListener('click', () => {
		zastav();
		// dorovnat na násobek ¼ otáčky a posunout o jednu
		const ctvrtiny = (Math.round(thetaPauza / (Math.PI / 2)) + 1) % 4;
		thetaPauza = ctvrtiny * Math.PI / 2;
		kresli(stavAlternatoru((thetaPauza / (2 * Math.PI)) * (T0 / rychlost), rychlost));
		g('alt-stav').textContent = POLOHY[ctvrtiny];
	});
	g('alt-slider').addEventListener('input', () => {
		rychlost = +g('alt-slider').value;
		if (!jede) kresli(stavAlternatoru((thetaPauza / (2 * Math.PI)) * (T0 / rychlost), rychlost));
		else t0 = null; // plynule navázat s novou periodou od aktuálního úhlu
	});
	kresli(stavAlternatoru(0, rychlost)); // statická poloha 0° i bez animace
</script>

<style>
	#alt-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.alt-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	#alt-play { background: #d3f9d8; }
	.alt-tl:active { transform: translateY(1px); }
	.alt-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.alt-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
