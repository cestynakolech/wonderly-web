---
// Statická infografika: Vznik elektrického proudu (Proud)
// Ukazuje rozdíl mezi chaotickým pohybem a usměrněným proudem
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vznik elektrického proudu 🔌</span></h2>
	<p>Elektrický proud je <strong>usměrněný pohyb volných elektronů</strong> v kovu. Bez napětí se pohybují chaoticky, s napětím se pohybují jedním směrem.</p>
	<svg viewBox="0 0 800 500" class="infografika-svg">
		<!-- Pozadí -->
		<rect width="800" height="500" fill="#f5f0e8"/>
		
		<!-- Nadpis -->
		<text x="400" y="35" text-anchor="middle" class="main-title">KDY VZNIKÁ ELEKTRICKÝ PROUD?</text>
		
		<!-- ČÁST 1: BEZ NAPĚTÍ -->
		<g id="no-voltage">
			<text x="140" y="70" text-anchor="middle" class="section-title">1. BEZ NAPĚTÍ</text>
			
			<!-- Kovový vodič (bez napětí) -->
			<rect x="60" y="90" width="160" height="50" fill="#c0c0c0" stroke="#999" stroke-width="2" rx="3"/>
			
			<!-- Jádra atomů -->
			<circle cx="90" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="120" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="150" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="180" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="210" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			
			<!-- Chaotické elektrony (náhodně) -->
			<circle cx="85" cy="130" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="125" cy="105" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="155" cy="140" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="190" cy="110" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="210" cy="130" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="100" cy="135" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="175" cy="125" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			
			<!-- Šipky náhodného pohybu -->
			<path d="M 85 128 L 80 125" stroke="#3498db" stroke-width="1" marker-end="url(#arrowSmallBlue)" opacity="0.5"/>
			<path d="M 125 107 L 130 110" stroke="#3498db" stroke-width="1" marker-end="url(#arrowSmallBlue)" opacity="0.5"/>
			<path d="M 155 138 L 150 135" stroke="#3498db" stroke-width="1" marker-end="url(#arrowSmallBlue)" opacity="0.5"/>
			<path d="M 190 112 L 195 115" stroke="#3498db" stroke-width="1" marker-end="url(#arrowSmallBlue)" opacity="0.5"/>
			<path d="M 210 128 L 215 125" stroke="#3498db" stroke-width="1" marker-end="url(#arrowSmallBlue)" opacity="0.5"/>
			
			<!-- Text pod -->
			<text x="140" y="165" text-anchor="middle" class="description">Elektrony se pohybují</text>
			<text x="140" y="185" text-anchor="middle" class="description">chaoticky všemi směry</text>
			<text x="140" y="205" text-anchor="middle" class="description" font-size="11">(tepelný pohyb)</text>
		</g>
		
		<!-- ČÁST 2: S NAPĚTÍM -->
		<g id="with-voltage">
			<text x="580" y="70" text-anchor="middle" class="section-title">2. S NAPĚTÍM</text>
			
			<!-- Zdroj napětí vlevo -->
			<rect x="420" y="100" width="20" height="50" fill="#fff" stroke="#333" stroke-width="2" rx="2"/>
			<text x="430" y="115" text-anchor="middle" class="terminal-label" font-size="10">−</text>
			<text x="430" y="138" text-anchor="middle" class="terminal-label" font-size="10">+</text>
			
			<!-- Vodič mezi svorkami -->
			<rect x="445" y="90" width="155" height="50" fill="#c0c0c0" stroke="#999" stroke-width="2" rx="3"/>
			
			<!-- Jádra atomů -->
			<circle cx="475" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="505" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="535" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="565" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			<circle cx="595" cy="115" r="4" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
			
			<!-- Usměrněné elektrony (k + svorce) -->
			<circle cx="460" cy="115" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="490" cy="115" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="520" cy="115" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="550" cy="115" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			<circle cx="580" cy="115" r="2" fill="#3498db" stroke="#2980b9" stroke-width="1"/>
			
			<!-- Usměrněné šipky (zprava doleva = ke + svorce) -->
			<path d="M 580 120 L 560 120" stroke="#3498db" stroke-width="2" marker-end="url(#arrowBlue)"/>
			<path d="M 520 120 L 500 120" stroke="#3498db" stroke-width="2" marker-end="url(#arrowBlue)"/>
			<path d="M 460 120 L 440 120" stroke="#3498db" stroke-width="2" marker-end="url(#arrowBlue)"/>
			
			<!-- Termín "proud" -->
			<text x="522" y="160" text-anchor="middle" class="description">Elektrony se pohybují</text>
			<text x="522" y="180" text-anchor="middle" class="description">usměrněně — ELEKTRICKÝ PROUD</text>
		</g>
		
		<!-- SEKCE 3: PODMÍNKY PROUDU -->
		<rect x="40" y="230" width="720" height="240" fill="#ecf0f1" stroke="#95a5a6" stroke-width="2" rx="8"/>
		
		<text x="400" y="265" text-anchor="middle" class="section-title">CO JE ZAPOTŘEBÍ PRO ELEKTRICKÝ PROUD?</text>
		
		<!-- Podmínka 1: Napětí -->
		<g id="condition-1">
			<circle cx="130" cy="340" r="50" fill="#fff" stroke="#f39c12" stroke-width="3" rx="50"/>
			
			<!-- Ikonka -->
			<rect x="110" y="320" width="40" height="40" fill="#f39c12" rx="3"/>
			<text x="130" y="350" text-anchor="middle" class="number-icon" fill="white" font-size="20">V</text>
			
			<text x="130" y="410" text-anchor="middle" class="condition-title">NAPĚTÍ</text>
			<text x="130" y="432" text-anchor="middle" class="condition-text" font-size="11">rozdíl nábojů</text>
			<text x="130" y="447" text-anchor="middle" class="condition-text" font-size="11">mezi svorkami</text>
		</g>
		
		<!-- Podmínka 2: Vodič -->
		<g id="condition-2">
			<circle cx="350" cy="340" r="50" fill="#fff" stroke="#27ae60" stroke-width="3" rx="50"/>
			
			<!-- Ikonka -->
			<rect x="330" y="320" width="40" height="40" fill="#27ae60" rx="3"/>
			<line x1="340" y1="330" x2="360" y2="330" stroke="white" stroke-width="3"/>
			<line x1="340" y1="340" x2="360" y2="340" stroke="white" stroke-width="3"/>
			<line x1="340" y1="350" x2="360" y2="350" stroke="white" stroke-width="3"/>
			
			<text x="350" y="410" text-anchor="middle" class="condition-title">VODIČ</text>
			<text x="350" y="432" text-anchor="middle" class="condition-text" font-size="11">kovy, roztoky solí</text>
			<text x="350" y="447" text-anchor="middle" class="condition-text" font-size="11">volné částice</text>
		</g>
		
		<!-- Podmínka 3: Uzavřený obvod -->
		<g id="condition-3">
			<circle cx="570" cy="340" r="50" fill="#fff" stroke="#c0392b" stroke-width="3" rx="50"/>
			
			<!-- Ikonka -->
			<circle cx="570" cy="330" r="12" fill="none" stroke="white" stroke-width="2"/>
			<line x1="582" y1="330" x2="560" y2="330" stroke="white" stroke-width="2"/>
			<line x1="570" y1="342" x2="570" y2="355" stroke="white" stroke-width="2"/>
			<line x1="560" y1="355" x2="580" y2="355" stroke="white" stroke-width="2"/>
			
			<text x="570" y="410" text-anchor="middle" class="condition-title">OBVOD</text>
			<text x="570" y="432" text-anchor="middle" class="condition-text" font-size="11">uzavřené spojení</text>
			<text x="570" y="447" text-anchor="middle" class="condition-text" font-size="11">bez přerušení</text>
		</g>
		
		<!-- Plus -->
		<text x="250" y="355" text-anchor="middle" class="plus-sign">+</text>
		<text x="470" y="355" text-anchor="middle" class="plus-sign">+</text>
		
		<!-- Výsledek -->
		<rect x="140" y="475" width="520" height="50" fill="#fff" stroke="#2c3e50" stroke-width="2" rx="5"/>
		<text x="400" y="495" text-anchor="middle" class="result-title">VÝSLEDEK:</text>
		<text x="400" y="515" text-anchor="middle" class="result-text">Usměrněný pohyb volných částic = <strong>ELEKTRICKÝ PROUD</strong></text>
	</svg>
	
	<!-- SVG značky -->
	<svg style="display: none;">
		<defs>
			<marker id="arrowBlue" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
				<path d="M0,0 L0,6 L9,3 z" fill="#3498db"/>
			</marker>
			<marker id="arrowSmallBlue" markerWidth="5" markerHeight="5" refX="4" refY="1.5" orient="auto" markerUnits="strokeWidth">
				<path d="M0,0 L0,3 L4,1.5 z" fill="#3498db"/>
			</marker>
		</defs>
	</svg>
</section>

<style>
	.infografika-svg {
		width: 100%;
		max-width: 800px;
		height: auto;
		border: 2px solid #ddd;
		border-radius: 8px;
	}
	
	.main-title {
		font-size: 18px;
		font-weight: bold;
		fill: #2c3e50;
	}
	
	.section-title {
		font-size: 15px;
		font-weight: bold;
		fill: #2c3e50;
	}
	
	.terminal-label {
		font-weight: bold;
		fill: #333;
	}
	
	.description {
		font-size: 12px;
		fill: #555;
		font-weight: bold;
	}
	
	.condition-title {
		font-size: 14px;
		fill: #2c3e50;
		font-weight: bold;
	}
	
	.condition-text {
		font-size: 11px;
		fill: #555;
	}
	
	.number-icon {
		font-weight: bold;
	}
	
	.plus-sign {
		font-size: 32px;
		fill: #7f8c8d;
		font-weight: bold;
	}
	
	.result-title {
		font-size: 13px;
		fill: #2c3e50;
		font-weight: bold;
	}
	
	.result-text {
		font-size: 12px;
		fill: #2c3e50;
		font-weight: bold;
	}
</style>
