---
import type { Otazka } from '../../data/kvizy';

interface Props {
	otazky: Otazka[];
}

const { otazky } = Astro.props;
---

<section class="ramecek kviz" id="kviz">
	<h2><span class="podtrh">Procvič si to! ✏️</span></h2>
	<p class="kviz-uvod">
		Kvíz má {otazky.length} otázek, u každé jsou tři odpovědi a právě jedna je správná. Klikni na tu,
		kterou považuješ za správnou — hned uvidíš výsledek.
	</p>
	<button class="kviz-tlacitko" id="kviz-start">Spustit kvíz 🚀</button>
	<div id="kviz-telo" hidden>
		<p class="kviz-postup"><span id="kviz-cislo"></span> <span id="kviz-skore-prubezne"></span></p>
		<p class="kviz-otazka" id="kviz-otazka"></p>
		<div class="kviz-odpovedi" id="kviz-odpovedi"></div>
		<div class="kviz-vedec" id="kviz-vedec" hidden>
			<svg viewBox="0 0 220 150" role="img" aria-label="Profesor">
				<!-- zeď (jen při špatné odpovědi) -->
				<g class="zed">
					<rect x="168" y="15" width="16" height="125" fill="#e0d8c8" stroke="#2b2a26" stroke-width="2.5" />
					<line x1="168" y1="45" x2="184" y2="45" stroke="#2b2a26" stroke-width="1.5" />
					<line x1="168" y1="75" x2="184" y2="75" stroke="#2b2a26" stroke-width="1.5" />
					<line x1="168" y1="105" x2="184" y2="105" stroke="#2b2a26" stroke-width="1.5" />
					<g class="hvezdy" fill="#e8590c" font-size="16" font-weight="bold">
						<text x="150" y="30">✦</text>
						<text x="185" y="50" font-size="12">✧</text>
						<text x="148" y="62" font-size="11">✦</text>
					</g>
				</g>
				<g class="profesor">
					<!-- nohy -->
					<g class="nohy" stroke="#2b2a26" stroke-width="3" stroke-linecap="round">
						<line x1="98" y1="118" x2="94" y2="140" />
						<line x1="112" y1="118" x2="116" y2="140" />
						<line x1="94" y1="140" x2="86" y2="140" />
						<line x1="116" y1="140" x2="124" y2="140" />
					</g>
					<!-- tělo (plášť) -->
					<g class="telo">
						<path d="M92 86 L118 86 L124 120 L86 120 Z" fill="#ffffff" stroke="#2b2a26" stroke-width="2.5" />
						<line x1="105" y1="88" x2="105" y2="118" stroke="#2b2a26" stroke-width="1.5" />
						<!-- ruce -->
						<g class="ruka ruka-l" stroke="#2b2a26" stroke-width="3" stroke-linecap="round">
							<line x1="93" y1="90" x2="76" y2="106" />
							<circle cx="74" cy="108" r="3.5" fill="#f4c9a3" stroke-width="2" />
						</g>
						<g class="ruka ruka-p" stroke="#2b2a26" stroke-width="3" stroke-linecap="round">
							<line x1="117" y1="90" x2="134" y2="106" />
							<circle cx="136" cy="108" r="3.5" fill="#f4c9a3" stroke-width="2" />
						</g>
						<!-- hlava -->
						<g class="hlava">
							<!-- divoké vlasy -->
							<g fill="#f2f2f2" stroke="#2b2a26" stroke-width="2">
								<path d="M92 58 Q84 50 88 42 Q94 48 96 44 Q96 52 92 58" />
								<path d="M96 42 Q94 32 102 30 Q103 38 108 34 Q106 42 100 44" />
								<path d="M108 34 Q112 26 120 30 Q116 36 122 40 Q114 42 110 40" />
								<path d="M120 40 Q130 38 130 48 Q122 46 124 54 Q118 50 118 44" />
							</g>
							<circle cx="105" cy="62" r="17" fill="#f4c9a3" stroke="#2b2a26" stroke-width="2.5" />
							<!-- oči -->
							<circle class="oko" cx="99" cy="58" r="2" fill="#2b2a26" />
							<circle class="oko" cx="111" cy="58" r="2" fill="#2b2a26" />
							<!-- knír -->
							<path d="M97 69 Q105 64 113 69 Q109 73 105 70 Q101 73 97 69" fill="#f2f2f2" stroke="#2b2a26" stroke-width="1.5" />
							<!-- pusa -->
							<path class="pusa-vesela" d="M100 75 Q105 80 110 75" fill="none" stroke="#2b2a26" stroke-width="2" stroke-linecap="round" />
							<path class="pusa-smutna" d="M100 78 Q105 74 110 78" fill="none" stroke="#2b2a26" stroke-width="2" stroke-linecap="round" />
						</g>
					</g>
					<!-- noty (jen při tanci) -->
					<g class="noty" fill="#e8590c" font-size="15" font-weight="bold">
						<text x="62" y="50">♪</text>
						<text x="140" y="42" font-size="12">♫</text>
					</g>
				</g>
			</svg>
		</div>
		<p class="kviz-vysvetleni" id="kviz-vysvetleni" hidden></p>
		<button class="kviz-tlacitko" id="kviz-dalsi" hidden>Další otázka →</button>
	</div>
	<div id="kviz-konec" hidden>
		<p class="kviz-vysledek" id="kviz-vysledek"></p>
		<p class="kviz-motivace" id="kviz-motivace"></p>
		<button class="kviz-tlacitko" id="kviz-znovu">Zkusit znovu 🔄</button>
	</div>
</section>

<script is:inline define:vars={{ otazky }}>
	const zamichej = (pole) => {
		const kopie = [...pole];
		for (let i = kopie.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[kopie[i], kopie[j]] = [kopie[j], kopie[i]];
		}
		return kopie;
	};

	let poradi = [];
	let aktualni = 0;
	let spravne = 0;

	const el = (id) => document.getElementById(id);

	function ukazOtazku() {
		const otazka = poradi[aktualni];
		el('kviz-cislo').textContent = `Otázka ${aktualni + 1} z ${poradi.length}`;
		el('kviz-skore-prubezne').textContent = aktualni > 0 ? `· zatím ${spravne} správně` : '';
		el('kviz-otazka').textContent = otazka.text;
		const spravnaOdpoved = otazka.odpovedi[0];
		const odpovedi = zamichej(otazka.odpovedi);
		const kontejner = el('kviz-odpovedi');
		kontejner.innerHTML = '';
		odpovedi.forEach((odpoved) => {
			const tlacitko = document.createElement('button');
			tlacitko.className = 'kviz-odpoved';
			tlacitko.textContent = odpoved;
			tlacitko.addEventListener('click', () => {
				if (kontejner.dataset.zodpovezeno) return;
				kontejner.dataset.zodpovezeno = '1';
				const jeSpravne = odpoved === spravnaOdpoved;
				if (jeSpravne) spravne++;
				for (const t of kontejner.children) {
					t.disabled = true;
					if (t.textContent === spravnaOdpoved) t.classList.add('spravna');
					else if (t === tlacitko) t.classList.add('spatna');
				}
				tlacitko.insertAdjacentText('beforeend', jeSpravne ? '  ✔' : '  ✘');
				if (!jeSpravne && otazka.vysvetleni) {
					el('kviz-vysvetleni').textContent = '💡 ' + otazka.vysvetleni;
					el('kviz-vysvetleni').hidden = false;
				}
				const vedec = el('kviz-vedec');
				vedec.classList.remove('spravne', 'spatne');
				vedec.classList.add(jeSpravne ? 'spravne' : 'spatne');
				vedec.hidden = false;
				el('kviz-dalsi').hidden = false;
				el('kviz-dalsi').textContent = aktualni + 1 < poradi.length ? 'Další otázka →' : 'Vyhodnotit 🏁';
			});
			kontejner.appendChild(tlacitko);
		});
		delete kontejner.dataset.zodpovezeno;
		el('kviz-vysvetleni').hidden = true;
		el('kviz-vedec').hidden = true;
		el('kviz-vedec').classList.remove('spravne', 'spatne');
		el('kviz-dalsi').hidden = true;
	}

	function vyhodnot() {
		el('kviz-telo').hidden = true;
		el('kviz-konec').hidden = false;
		const procenta = Math.round((spravne / poradi.length) * 100);
		el('kviz-vysledek').textContent = `Máš ${spravne} z ${poradi.length} správně (${procenta} %).`;
		let motivace;
		if (procenta === 100) motivace = '🏆 Paráda! Máš to v malíku — jsi připraven(a) na test!';
		else if (procenta >= 80) motivace = '🎉 Skvělá práce! Ještě jednou si projdi, co ti uteklo, a bude to na jedničku.';
		else if (procenta >= 60) motivace = '👍 Dobrá práce! Základ umíš, zkus si kvíz ještě jednou.';
		else if (procenta >= 40) motivace = '💪 Nevzdávej to! Mrkni znovu na výklad nahoře a zkus to znovu — příště to bude lepší.';
		else motivace = '🌱 Začátky bývají těžké. Projdi si materiály na této stránce a pak to zkus znovu — zvládneš to!';
		el('kviz-motivace').textContent = motivace;
	}

	function start() {
		poradi = zamichej(otazky);
		aktualni = 0;
		spravne = 0;
		el('kviz-start').hidden = true;
		el('kviz-konec').hidden = true;
		el('kviz-telo').hidden = false;
		ukazOtazku();
	}

	el('kviz-start').addEventListener('click', start);
	el('kviz-znovu').addEventListener('click', start);
	el('kviz-dalsi').addEventListener('click', () => {
		aktualni++;
		if (aktualni < poradi.length) ukazOtazku();
		else vyhodnot();
	});
</script>

<style is:global>
	.kviz-uvod {
		margin-top: 0;
	}
	.kviz-tlacitko {
		font-family: inherit;
		font-size: 1.15rem;
		padding: 0.55rem 1.4rem;
		background: var(--oranzova);
		color: #fff;
		border: 2.5px solid var(--inkoust);
		border-radius: 255px 18px 225px 18px / 18px 225px 18px 255px;
		box-shadow: 2px 3px 0 rgba(43, 42, 38, 0.18);
		cursor: pointer;
	}
	.kviz-tlacitko:hover {
		transform: rotate(-0.6deg);
	}
	.kviz-postup {
		color: var(--ztlumena);
		margin-bottom: 0.3rem;
	}
	.kviz-otazka {
		font-size: 1.35rem;
		font-weight: 700;
		margin-top: 0;
	}
	.kviz-odpovedi {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		margin: 1rem 0;
	}
	.kviz-odpoved {
		font-family: inherit;
		font-size: 1.1rem;
		text-align: left;
		padding: 0.6rem 1rem;
		background: rgba(255, 255, 255, 0.75);
		color: var(--inkoust);
		border: 2px solid var(--inkoust);
		border-radius: 18px 255px 18px 225px / 225px 18px 255px 18px;
		cursor: pointer;
	}
	.kviz-odpoved:hover:not(:disabled) {
		border-color: var(--oranzova);
		transform: translateX(3px);
	}
	.kviz-odpoved.spravna {
		background: #d3f2d3;
		border-color: #2f9e44;
	}
	.kviz-odpoved.spatna {
		background: #ffe0dd;
		border-color: #d33;
	}
	/* --- profesor: tančí při správné, mlátí hlavou o zeď při špatné --- */
	.kviz-vedec {
		width: 200px;
		margin: 0.4rem auto;
	}
	.kviz-vedec svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}
	.kviz-vedec .zed,
	.kviz-vedec .noty,
	.kviz-vedec .pusa-smutna {
		display: none;
	}
	.kviz-vedec .ruka,
	.kviz-vedec .hlava,
	.kviz-vedec .telo,
	.kviz-vedec .profesor {
		transform-box: fill-box;
	}
	/* SPRÁVNĚ = tanec */
	.kviz-vedec.spravne .noty {
		display: block;
		animation: kviz-blikani 0.8s infinite;
	}
	.kviz-vedec.spravne .profesor {
		transform-origin: center bottom;
		animation: kviz-hopsani 0.45s infinite alternate ease-in-out;
	}
	.kviz-vedec.spravne .ruka-l {
		transform-origin: top right;
		animation: kviz-mavani-l 0.45s infinite alternate ease-in-out;
	}
	.kviz-vedec.spravne .ruka-p {
		transform-origin: top left;
		animation: kviz-mavani-p 0.45s infinite alternate-reverse ease-in-out;
	}
	.kviz-vedec.spravne .hlava {
		transform-origin: center bottom;
		animation: kviz-kyvani 0.9s infinite alternate ease-in-out;
	}
	@keyframes kviz-hopsani {
		from { transform: translateY(0); }
		to { transform: translateY(-9px); }
	}
	@keyframes kviz-mavani-l {
		from { transform: rotate(0deg); }
		to { transform: rotate(-70deg); }
	}
	@keyframes kviz-mavani-p {
		from { transform: rotate(0deg); }
		to { transform: rotate(70deg); }
	}
	@keyframes kviz-kyvani {
		from { transform: rotate(-8deg); }
		to { transform: rotate(8deg); }
	}
	@keyframes kviz-blikani {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.15; }
	}
	/* ŠPATNĚ = hlavou o zeď */
	.kviz-vedec.spatne .zed {
		display: block;
	}
	.kviz-vedec.spatne .pusa-vesela {
		display: none;
	}
	.kviz-vedec.spatne .pusa-smutna {
		display: block;
	}
	.kviz-vedec.spatne .profesor {
		transform: translateX(38px);
	}
	.kviz-vedec.spatne .hlava {
		transform-origin: center bottom;
		animation: kviz-bum 0.7s infinite ease-in;
	}
	.kviz-vedec.spatne .hvezdy {
		animation: kviz-bum-hvezdy 0.7s infinite;
	}
	@keyframes kviz-bum {
		0%, 100% { transform: rotate(0deg) translateX(0); }
		55% { transform: rotate(14deg) translateX(9px); }
		65% { transform: rotate(16deg) translateX(11px); }
	}
	@keyframes kviz-bum-hvezdy {
		0%, 50%, 100% { opacity: 0; }
		60%, 80% { opacity: 1; }
	}
	.kviz-vysvetleni {
		background: #fff7e6;
		border: 2px dashed var(--oranzova);
		border-radius: 12px;
		padding: 0.7rem 1rem;
		margin: 0 0 1rem;
		font-size: 1.05rem;
	}
	.kviz-vysledek {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 0.3rem;
	}
	.kviz-motivace {
		font-size: 1.2rem;
	}
</style>
