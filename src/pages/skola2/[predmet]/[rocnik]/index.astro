---
import SkolaLayout from '../../../../layouts/SkolaLayout.astro';
import { predmety, rocniky } from '../../../../data/predmety';
import { temata } from '../../../../data/temata';

export function getStaticPaths() {
	const paths = [];
	for (const p of predmety) {
		for (const r of rocniky) {
			paths.push({ params: { predmet: p.slug, rocnik: r.slug }, props: { predmet: p, rocnik: r } });
		}
	}
	return paths;
}

const { predmet, rocnik } = Astro.props;
const seznamTemat = temata[`${predmet.slug}/${rocnik.slug}`] ?? [];
---

<SkolaLayout
	titulek={`${predmet.nazev} – ${rocnik.nazev} – Wonderly`}
	drobky={[
		{ text: '2. stupeň', href: '/skola2/' },
		{ text: predmet.nazev, href: `/${predmet.slug}/` },
	]}
>
	<h1><span class="podtrh">{predmet.nazev} – {rocnik.nazev}</span></h1>
	{
		seznamTemat.length > 0 ? (
			<>
				<p class="uvodni-text">Vyber si téma.</p>
				<ul class="karty">
					{seznamTemat.map((t, i) => (
						<li>
							<a class="karta" href={`/${predmet.slug}/${rocnik.slug}/${t.slug}/`}>
								<span class="cislo">{i + 1}</span>
								<span class="nazev">{t.nazev}</span>
							</a>
						</li>
					))}
				</ul>
			</>
		) : (
			<p class="uvodni-text">Témata připravujeme.</p>
		)
	}
</SkolaLayout>
