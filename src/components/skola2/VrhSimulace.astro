---
// Interaktivní vrh kamene = skládání sil za letu.
// Na kámen působí GRAVITAČNÍ síla (dolů) a ODPOR VZDUCHU (proti pohybu).
// Jejich složení zakřivuje dráhu do balistické křivky. Mění se úhel i rychlost,
// jde hodit i kolmo vzhůru. Přepínač odporu vzduchu ukáže rozdíl (parabola × balistická křivka).
//
// POČÍTÁ SE VE SKUTEČNÝCH JEDNOTKÁCH (metry, sekundy, m/s), do pixelů se převádí
// až při kreslení konstantou PX_NA_M. Gravitační konstanta je 10 N/kg jako ve výkladu.
// Dřív běžela simulace ve „vnitřních" pixelových jednotkách a metry se dopočítávaly
// dělením šesti — číslo pro dítě vypadalo věrohodně, ale s fyzikou nesouviselo.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Proč kámen neletí rovně? 🕹️</span></h2>
	<p>Hoď kámen z <strong>5 m vysoké skály</strong> a sleduj šipky sil: <strong style="color:#1971c2">gravitační síla</strong> ho táhne k zemi (g = 10 N/kg jako ve výkladu), <strong style="color:#e8590c">odpor vzduchu</strong> ho brzdí proti směru letu. Jejich <strong>složení</strong> zakřiví dráhu — vznikne <strong>balistická křivka</strong>. Vzdálenosti odečteš z dílků na obrázku (dílky po 10 m).</p>
	<canvas id="vrh-platno" width="600" height="360" role="img" aria-label="Vrh kamene ze skály s šipkami sil a měřítkem v metrech"></canvas>
	<div class="vrh-ovladace">
		<label>Úhel: <output id="vrh-uhel-h">45°</output>
			<input type="range" id="vrh-uhel" min="0" max="90" step="5" value="45" /></label>
		<label>Rychlost: <output id="vrh-rychlost-h">20 m/s (velká)</output>
			<input type="range" id="vrh-rychlost" min="10" max="20" step="1" value="20" /></label>
		<label class="vrh-check"><input type="checkbox" id="vrh-gravitace" checked /> gravitace</label>
		<label class="vrh-check"><input type="checkbox" id="vrh-odpor" checked /> odpor vzduchu</label>
		<button id="vrh-hod" class="vrh-btn">Hoď kámen 🪨</button>
	</div>
	<p class="vrh-stav" id="vrh-stav">Nastav úhel a rychlost a klikni „Hoď kámen".</p>
	<p class="vrh-tip">💡 Zkus <strong>úhel 0°</strong> a <strong>20 m/s</strong> bez odporu vzduchu: z 5 m padá kámen právě <strong>1 sekundu</strong> (5 m = ½ · 10 · 1²) a za tu sekundu uletí <strong>20 m</strong>.</p>
</section>

<script>
	const platno = document.getElementById('vrh-platno');
	const ctx = platno.getContext('2d');
	const W = platno.width, H = platno.height, ZEM = H - 50; // pod zemí musí zbýt místo na šipku gravitace

	// ===== VŠECHNO SE POČÍTÁ VE SKUTEČNÝCH JEDNOTKÁCH =====
	const PX_NA_M = 10;      // měřítko obrázku: 1 metr = 10 px
	const G = 10;            // gravitační konstanta 10 N/kg (= 10 m/s²) — jako ve výkladu
	const K_ODPOR = 0.012;   // odpor vzduchu: zpomalení = K · v² [1/m], mezní rychlost ≈ 29 m/s
	const H0 = 5;            // výška odhodu (skála) [m]
	const X0 = 2;            // vodorovná poloha odhodu [m]
	const DT = 1 / 240;      // krok výpočtu [s]
	const SUBKROKY = 4;      // 4 kroky na snímek → 1/60 s na snímek, běží tedy ve skutečném čase
	const PX_NA_MS2 = 3.4;   // šipky sil: obě ve stejném měřítku (10 m/s² → 34 px)

	const doX = (m) => m * PX_NA_M;          // metry → pixely (vodorovně)
	const doY = (m) => ZEM - m * PX_NA_M;    // metry nad zemí → pixely (svisle)

	const uhelEl = document.getElementById('vrh-uhel');
	const rychEl = document.getElementById('vrh-rychlost');
	const odporEl = document.getElementById('vrh-odpor');
	const gravEl = document.getElementById('vrh-gravitace');
	const stavEl = document.getElementById('vrh-stav');
	let kamen = null, drahaBody = [], anim = null;

	function pozadi() {
		ctx.clearRect(0, 0, W, H);
		ctx.fillStyle = '#e9f5e9'; ctx.fillRect(0, 0, W, ZEM);
		ctx.fillStyle = '#d3b98c'; ctx.fillRect(0, ZEM, W, H - ZEM);
		// měřítko: dílky po 10 metrech, aby šly vzdálenosti odečíst okem
		ctx.strokeStyle = '#c3d8c3'; ctx.lineWidth = 1;
		ctx.font = '12px sans-serif';
		for (let m = 10; m <= 50; m += 10) {
			ctx.beginPath(); ctx.moveTo(doX(m), 0); ctx.lineTo(doX(m), ZEM); ctx.stroke();
			ctx.fillStyle = '#5c6b5c'; ctx.fillText(m + ' m', doX(m) + 3, ZEM - 5);
		}
		for (let m = 10; m <= 20; m += 10) {
			ctx.beginPath(); ctx.moveTo(0, doY(m)); ctx.lineTo(W, doY(m)); ctx.stroke();
			ctx.fillStyle = '#5c6b5c'; ctx.fillText(m + ' m', W - 42, doY(m) - 4);
		}
		// zem
		ctx.strokeStyle = '#8a867c'; ctx.lineWidth = 2; ctx.beginPath();
		ctx.moveTo(0, ZEM); ctx.lineTo(W, ZEM); ctx.stroke();
		// skála, ze které se hází (vysoká H0 metrů)
		ctx.fillStyle = '#9c8f7a'; ctx.strokeStyle = '#2b2a26'; ctx.lineWidth = 2;
		ctx.beginPath(); ctx.rect(0, doY(H0), doX(X0), ZEM - doY(H0)); ctx.fill(); ctx.stroke();
		ctx.fillStyle = '#2b2a26'; ctx.font = 'bold 12px sans-serif';
		ctx.fillText(H0 + ' m', doX(X0) + 14, doY(H0) + 20); // vedle skály, ne do místa odhodu
	}

	function sipka(x, y, dx, dy, barva, popis) {
		const d = Math.hypot(dx, dy); if (d < 2) return;
		// šipka začíná až na okraji kamene, jinak ji kámen (r = 9 px) překryje
		const zx = x + dx / d * 10, zy = y + dy / d * 10;
		const ex = zx + dx, ey = zy + dy;
		x = zx; y = zy;
		ctx.strokeStyle = barva; ctx.fillStyle = barva; ctx.lineWidth = 4;
		ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(ex, ey); ctx.stroke();
		const uh = Math.atan2(dy, dx);
		ctx.beginPath(); ctx.moveTo(ex, ey);
		ctx.lineTo(ex - 10 * Math.cos(uh - 0.4), ey - 10 * Math.sin(uh - 0.4));
		ctx.lineTo(ex - 10 * Math.cos(uh + 0.4), ey - 10 * Math.sin(uh + 0.4));
		ctx.closePath(); ctx.fill();
		if (popis) { ctx.font = 'bold 13px sans-serif'; ctx.fillText(popis, Math.min(ex + 4, W - 70), Math.min(ey, H - 6)); }
	}

	// Úroveň, na kterou kámen dopadne: nad skálou je to její vrchol, jinde zem.
	const uroven = (x) => (x <= X0 ? H0 : 0);

	function hod() {
		cancelAnimationFrame(anim);
		const uhel = +uhelEl.value * Math.PI / 180;
		const v = +rychEl.value;                       // skutečná počáteční rychlost [m/s]
		// x, y v METRECH (y = výška nad zemí), vx, vy v m/s (vy kladné = vzhůru)
		kamen = { x: X0, y: H0, vx: v * Math.cos(uhel), vy: v * Math.sin(uhel) };
		drahaBody = [[doX(X0), doY(H0)]];
		let maxV = H0, dopad = false;

		function fyzika() {
			for (let i = 0; i < SUBKROKY && !dopad; i++) {
				if (gravEl.checked) kamen.vy -= G * DT;
				if (odporEl.checked) {
					// zpomalení a = K · v², míří proti pohybu → od každé složky ubere K·v·DT jejího dílu
					const rychlost = Math.hypot(kamen.vx, kamen.vy);
					const ubytek = K_ODPOR * rychlost * DT;
					kamen.vx -= ubytek * kamen.vx;
					kamen.vy -= ubytek * kamen.vy;
				}
				const noveX = kamen.x + kamen.vx * DT;
				const noveY = kamen.y + kamen.vy * DT;
				const cil = uroven(noveX);
				if (noveY <= cil && kamen.vy < 0) {
					// dopočítej přesné místo dopadu — jinak by ho „usekl" krok výpočtu
					const dil = (kamen.y - cil) / ((kamen.y - noveY) || 1);
					kamen.x += (noveX - kamen.x) * dil;
					kamen.y = cil;
					dopad = true;
				} else { kamen.x = noveX; kamen.y = noveY; }
				if (kamen.y > maxV) maxV = kamen.y;
				drahaBody.push([doX(kamen.x), doY(kamen.y)]);
			}
		}

		function krok() {
			fyzika();
			pozadi();
			// dráha
			ctx.strokeStyle = '#adb5bd'; ctx.lineWidth = 2; ctx.setLineDash([4, 4]); ctx.beginPath();
			drahaBody.forEach(([x, y], i) => i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)); ctx.stroke(); ctx.setLineDash([]);
			// kámen
			const kx = doX(kamen.x), ky = doY(kamen.y);
			ctx.fillStyle = '#6b4f2a'; ctx.strokeStyle = '#2b2a26'; ctx.lineWidth = 2;
			ctx.beginPath(); ctx.arc(kx, ky, 9, 0, 7); ctx.fill(); ctx.stroke();
			// šipky sil — obě ve stejném měřítku, délka odpovídá zrychlení
			if (gravEl.checked) sipka(kx, ky, 0, G * PX_NA_MS2, '#1971c2', 'gravitace');
			if (odporEl.checked) {
				const rychlost = Math.hypot(kamen.vx, kamen.vy) || 1;
				const m = K_ODPOR * rychlost * rychlost * PX_NA_MS2;
				sipka(kx, ky, -kamen.vx / rychlost * m, kamen.vy / rychlost * m, '#e8590c', 'odpor');
			}
			const zaOkrajem = kx > W - 10 || kx < 4 || ky < 4;
			if (!dopad && !zaOkrajem) { anim = requestAnimationFrame(krok); }
			else {
				const dalka = Math.round(kamen.x - X0);
				const vyska = Math.round(maxV);
				if (!gravEl.checked) {
					stavEl.textContent = '➡️ Bez gravitace letí kámen rovně pořád dál — nic ho nestahuje k zemi. '
						+ 'Právě gravitační síla dělá z přímé dráhy křivku!';
				} else {
					stavEl.textContent = `🪨 Dopad! Kámen doletěl ${dalka} m daleko a vystoupal do výšky ${vyska} m nad zemí. `
						+ (+uhelEl.value === 90 ? 'Kolmo vzhůru = spadne zpět skoro na místo.' :
						   odporEl.checked ? 'S odporem vzduchu klesá strměji — balistická křivka.' : 'Bez odporu je dráha souměrná parabola.');
				}
			}
		}
		stavEl.textContent = 'Kámen letí…';
		krok();
	}

	uhelEl.addEventListener('input', () => { document.getElementById('vrh-uhel-h').textContent = uhelEl.value + '°'; });
	rychEl.addEventListener('input', () => document.getElementById('vrh-rychlost-h').textContent =
		rychEl.value + ' m/s (' + (+rychEl.value < 14 ? 'malá' : +rychEl.value > 17 ? 'velká' : 'střední') + ')');
	document.getElementById('vrh-hod').addEventListener('click', hod);
	pozadi();
</script>

<style>
	#vrh-platno { width: 100%; max-width: 600px; border: 3px solid #2b2a26; border-radius: 12px; }
	.vrh-ovladace { display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: center; margin: 0.7rem 0; }
	.vrh-ovladace label { font-weight: 700; }
	.vrh-check { display: flex; align-items: center; gap: 0.35rem; }
	.vrh-btn { font-size: 1.15rem; font-weight: 800; padding: 0.5rem 1.3rem; border: 3px solid #2b2a26;
		border-radius: 12px; background: #ffe066; cursor: pointer; }
	.vrh-stav { font-size: 1.05rem; font-weight: 700; min-height: 3rem; }
	.vrh-tip { font-size: 0.95rem; }
</style>
