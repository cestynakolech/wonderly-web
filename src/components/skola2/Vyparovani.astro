---
// Vypařování: pomalá skupenská změna z kapaliny na plyn (z povrchu)
// Interaktivní: draž molekuly teplem, vidíš jak se uvolňují
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Vypařování 💨</span></h2>
	<p>Vypařování je pomalá skupenská změna, kdy se kapalina mění na plyn <strong>jen z povrchu</strong>. Např. mokré šaty schnou na zemi.</p>
	
	<svg id="vypar-svg" viewBox="0 0 500 320" role="img" aria-label="Vypařování kapaliny">
		<!-- Teplota ikona a slider info -->
		<text x="250" y="25" text-anchor="middle" font-size="16" font-weight="bold" fill="#2b2a26">Zvýšení teploty → Vyzařování molekul z povrchu</text>
		
		<!-- Nádoba s vodou -->
		<rect x="80" y="90" width="340" height="180" fill="none" stroke="#2b2a26" stroke-width="3" />
		
		<!-- Kapalina (modrá) -->
		<rect id="vypar-kapalina" x="85" y="200" width="330" height="65" fill="#a5d8ff" opacity="0.7" rx="4" />
		
		<!-- Molekuly kapaliny (dole, těsně u sebe) -->
		<g id="vypar-molekuly-kap">
			<circle cx="100" cy="225" r="4" fill="#1971c2" class="molekula" />
			<circle cx="120" cy="235" r="4" fill="#1971c2" class="molekula" />
			<circle cx="140" cy="220" r="4" fill="#1971c2" class="molekula" />
			<circle cx="160" cy="240" r="4" fill="#1971c2" class="molekula" />
			<circle cx="180" cy="215" r="4" fill="#1971c2" class="molekula" />
			<circle cx="200" cy="235" r="4" fill="#1971c2" class="molekula" />
			<circle cx="220" cy="225" r="4" fill="#1971c2" class="molekula" />
			<circle cx="240" cy="238" r="4" fill="#1971c2" class="molekula" />
			<circle cx="260" cy="218" r="4" fill="#1971c2" class="molekula" />
			<circle cx="280" cy="232" r="4" fill="#1971c2" class="molekula" />
			<circle cx="300" cy="225" r="4" fill="#1971c2" class="molekula" />
			<circle cx="320" cy="237" r="4" fill="#1971c2" class="molekula" />
			<circle cx="340" cy="220" r="4" fill="#1971c2" class="molekula" />
			<circle cx="360" cy="233" r="4" fill="#1971c2" class="molekula" />
			<circle cx="380" cy="228" r="4" fill="#1971c2" class="molekula" />
		</g>
		
		<!-- Molekuly páry (nahoře, rozprašují se) -->
		<g id="vypar-molekuly-plyn">
			<circle cx="150" cy="140" r="3" fill="#74c0fc" opacity="0.6" class="molekula-plyn" />
			<circle cx="200" cy="120" r="3" fill="#74c0fc" opacity="0.6" class="molekula-plyn" />
			<circle cx="280" cy="150" r="3" fill="#74c0fc" opacity="0.6" class="molekula-plyn" />
			<circle cx="350" cy="130" r="3" fill="#74c0fc" opacity="0.6" class="molekula-plyn" />
		</g>
		
		<!-- Šipky ukazující pohyb (difúze nahoru) -->
		<defs>
			<marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
				<polygon points="0 0, 10 3, 0 6" fill="#e03131" />
			</marker>
		</defs>
		<line x1="250" y1="180" x2="250" y2="120" stroke="#e03131" stroke-width="2" marker-end="url(#arrowhead)" />
		<line x1="220" y1="185" x2="200" y2="130" stroke="#e03131" stroke-width="2" marker-end="url(#arrowhead)" />
		<line x1="280" y1="185" x2="310" y2="140" stroke="#e03131" stroke-width="2" marker-end="url(#arrowhead)" />
		
		<!-- Teplota indikátor -->
		<text x="20" y="310" font-size="13" font-weight="bold" fill="#2b2a26">Teplota:</text>
		<rect x="90" y="295" width="200" height="20" fill="none" stroke="#868e96" stroke-width="1" rx="3" />
		<rect id="vypar-tepl-ukazatel" x="90" y="295" width="50" height="20" fill="#e03131" rx="3" />
		<text id="vypar-tepl-text" x="310" y="310" font-size="13" fill="#2b2a26">20 °C</text>
	</svg>
	
	<label class="sim-posuvnik">
		Teplota: <output id="vypar-hodnota"></output>
		<input type="range" id="vypar-slider" min="20" max="100" step="5" value="20" />
	</label>
	
	<p class="tepl-stav" id="vypar-stav">Při nízké teplotě: jen pár molekul z povrchu má dost energie, aby odletělo → pomalé vypařování.</p>
</section>

<script>
	const slider = document.getElementById('vypar-slider');
	const hodnota = document.getElementById('vypar-hodnota');
	const stavEl = document.getElementById('vypar-stav');
	const kapalina = document.getElementById('vypar-kapalina');
	const teplText = document.getElementById('vypar-tepl-text');
	const teplUkazatel = document.getElementById('vypar-tepl-ukazatel');
	
	function prekresli() {
		const t = +slider.value; // 20..100
		hodnota.textContent = t + ' °C';
		teplText.textContent = t + ' °C';
		
		// Úbytek kapaliny (výška klesá s teplotou)
		const vyskaAlt = Math.max(20, 65 - ((t - 20) / 80) * 50);
		kapalina.setAttribute('height', vyskaAlt);
		
		// Teplota ukazatel (procentuální výplň)
		const procenta = ((t - 20) / 80) * 100;
		const sirkaTeploty = 200 * procenta / 100;
		teplUkazatel.setAttribute('width', Math.max(0, sirkaTeploty));
		
		// Více molekul páry se objevuje
		const molekulyPlyn = document.querySelectorAll('#vypar-molekuly-plyn circle');
		const viditelnych = Math.ceil((t - 20) / 80 * molekulyPlyn.length);
		molekulyPlyn.forEach((mol, i) => {
			if (i < viditelnych) {
				mol.style.opacity = 0.3 + (t - 20) / 80 * 0.6;
				mol.setAttribute('r', 3 + (t - 20) / 80 * 2);
			} else {
				mol.style.opacity = 0;
			}
		});
		
		// Popisy
		if (t <= 30) {
			stavEl.textContent = '🌫️ Při pokojové teplotě: vypařování je velmi pomalé. Molekuly jen zřídka mají dost energie na útěk.';
		} else if (t < 60) {
			stavEl.textContent = '💧 Zvýšená teplota: více molekul opouští povrch kapaliny. Mokrý kabát rychleji schne.';
		} else {
			stavEl.textContent = '🔥 Vysoká teplota: intenzivní vypařování. Skoro všechny molekuly z povrchu mají energii na útěk.';
		}
	}
	
	slider.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#vypar-svg { width: 100%; max-width: 500px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 500px; display: block; margin-top: 0.3rem; }
	.tepl-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
