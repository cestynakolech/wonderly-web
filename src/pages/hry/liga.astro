---
import SkolaLayout from '../../layouts/SkolaLayout.astro';
import QrKod from '../../components/skola2/QrKod.astro';
import { bankaProLigu } from '../../data/hry';

// Úplná banka fyziky 6–9 po celcích — hra si vybírá podle ročníku a učiva
const banka = bankaProLigu();
---

<SkolaLayout titulek="Fyzikální liga — tabule">
	<div id="liga" data-banka={JSON.stringify(banka)}>
		<!-- NASTAVENÍ -->
		<section id="nastaveni">
			<h1><span class="podtrh">🏆 Fyzikální liga</span></h1>
			<p class="popis">
				Živá týmová soutěž: <b>tuto stránku promítejte</b>, týmy odpovídají na tabletech.
				Body se počítají samy — nejrychlejší správný tým má bod k dobru.
			</p>
			<div class="volby">
				<label>Ročník
					<select id="rocnik">
						<option value="">Všechny (mix 6–9)</option>
						<option value="6">6. ročník</option>
						<option value="7">7. ročník</option>
						<option value="8">8. ročník</option>
						<option value="9">9. ročník</option>
					</select>
				</label>
				<label>Učivo
					<select id="celek" disabled><option value="">Celý ročník</option></select>
				</label>
				<label>Počet otázek
					<select id="pocet-otazek"><option>10</option><option selected>15</option><option>20</option></select>
				</label>
				<label>Čas na otázku
					<select id="cas-otazky"><option value="15">15 s</option><option value="20" selected>20 s</option><option value="30">30 s</option></select>
				</label>
			</div>
			<p id="v-bance" class="pozn"></p>
			<button id="vytvorit" class="velke-tlacitko">Vytvořit hru ▶</button>
			<p class="pozn">Bez tabletů? <a href="/hry/liga-karty">Verze s tištěnými kartami</a>.</p>
		</section>

		<!-- ČEKÁRNA -->
		<section id="cekarna" hidden>
			<h1><span class="podtrh">Připojte se!</span></h1>
			<div class="pripojeni">
				<div>
					<p class="krok">1️⃣ Na tabletu otevřete:</p>
					<p class="adresa">lab.wonderly.cz/hry/liga/tym</p>
					<QrKod url="https://lab.wonderly.cz/hry/liga/tym" velikost={190} popis="nebo naskenujte" />
				</div>
				<div>
					<p class="krok">2️⃣ Zadejte kód místnosti:</p>
					<div id="kod-mistnosti" class="kod-mistnosti">····</div>
				</div>
			</div>
			<h2>Přihlášené týmy: <span id="pocet-tymu-text">0</span></h2>
			<div id="seznam-tymu" class="seznam-tymu"></div>
			<button id="start" class="velke-tlacitko" disabled>Spustit hru ▶</button>
		</section>

		<!-- HRA -->
		<section id="hra" hidden>
			<header class="hlavicka-hry">
				<span id="poradi-otazky"></span>
				<span id="riskove" class="riskove" hidden>⭐ RISKOVACÍ KOLO — za 2 body!</span>
				<span id="odpocet-cislo"></span>
			</header>
			<div id="odpocet-pruh"><div id="odpocet-vypln"></div></div>
			<h2 id="text-otazky"></h2>
			<ol id="odpovedi" class="odpovedi"></ol>
			<p id="odpovedelo" class="odpovedelo"></p>
			<div id="mezivysledek" hidden>
				<div id="kdo-jak" class="kdo-jak"></div>
				<button id="dalsi" class="velke-tlacitko">Další otázka ▶</button>
			</div>
			<aside id="tabulka"></aside>
		</section>

		<!-- VÝSLEDKY -->
		<section id="vysledky" hidden>
			<h1><span class="podtrh">🎉 Konečné pořadí</span></h1>
			<ol id="podium"></ol>
			<button id="znovu" class="velke-tlacitko">Nová hra 🔄</button>
		</section>
	</div>
</SkolaLayout>

<script>
	const koren = document.getElementById('liga');
	const banka = JSON.parse(koren.dataset.banka);
	const $ = (id) => document.getElementById(id);

	let ws = null;
	let tymy = {}; // jmeno -> { body: number }
	let otazky = [];
	let cisloOtazky = 0;
	let casNaOtazku = 20;
	let odpocetId = null;
	let prodlevaId = null;
	let odpovedi = {}; // jmeno -> { volba, cas }
	let faze = 'cekarna';

	function zamichej(pole) {
		const p = [...pole];
		for (let i = p.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[p[i], p[j]] = [p[j], p[i]];
		}
		return p;
	}

	function posli(zprava) {
		if (ws?.readyState === 1) ws.send(JSON.stringify(zprava));
	}

	// Výběr otázek podle ročníku a učiva; při mixu bere rovnoměrně z každého ročníku
	function vyberOtazky(pocet) {
		const rocnik = $('rocnik').value;
		const celek = $('celek').value;
		const poRocniku = {};
		for (const b of banka) {
			if (rocnik && b.rocnik !== rocnik) continue;
			if (celek && b.celek !== celek) continue;
			(poRocniku[b.rocnik] ??= []).push(...b.otazky);
		}
		const fronty = Object.values(poRocniku).map(zamichej);
		const vybrane = [];
		while (vybrane.length < pocet && fronty.some((f) => f.length)) {
			for (const f of fronty) {
				if (f.length && vybrane.length < pocet) vybrane.push(f.pop());
			}
		}
		return zamichej(vybrane);
	}

	function obnovCelky() {
		const rocnik = $('rocnik').value;
		$('celek').disabled = !rocnik;
		$('celek').innerHTML =
			'<option value="">Celý ročník</option>' +
			banka
				.filter((b) => b.rocnik === rocnik)
				.map((b) => `<option value="${b.celek}">${b.nazev} (${b.otazky.length})</option>`)
				.join('');
		spocitejBanku();
	}

	function spocitejBanku() {
		const rocnik = $('rocnik').value;
		const celek = $('celek').value;
		const n = banka
			.filter((b) => (!rocnik || b.rocnik === rocnik) && (!celek || b.celek === celek))
			.reduce((s, b) => s + b.otazky.length, 0);
		$('v-bance').textContent = `V bance je ${n} otázek.`;
	}

	$('rocnik').addEventListener('change', obnovCelky);
	$('celek').addEventListener('change', spocitejBanku);
	spocitejBanku();

	$('vytvorit').addEventListener('click', async () => {
		const odpoved = await fetch('/api/liga/nova');
		const { mistnost } = await odpoved.json();
		$('kod-mistnosti').textContent = mistnost;
		const protokol = location.protocol === 'https:' ? 'wss' : 'ws';
		ws = new WebSocket(`${protokol}://${location.host}/api/liga/ws?mistnost=${mistnost}&role=tabule`);
		ws.addEventListener('message', (u) => zpracuj(JSON.parse(u.data)));
		otazky = vyberOtazky(+$('pocet-otazek').value);
		casNaOtazku = +$('cas-otazky').value;
		$('nastaveni').hidden = true;
		$('cekarna').hidden = false;
	});

	function zpracuj(zprava) {
		if (zprava.typ === 'prihlaseni') {
			tymy[zprava.jmeno] ??= { body: 0 };
			vykresliCekarnu();
		} else if (zprava.typ === 'odpojeni') {
			// tým se může vrátit se stejným jménem — body mu držíme
		} else if (zprava.typ === 'odpoved' && faze === 'otazka') {
			if (zprava.otazka !== cisloOtazky) return;
			if (odpovedi[zprava.jmeno]) return; // počítá se první odpověď
			odpovedi[zprava.jmeno] = { volba: zprava.volba, cas: zprava.cas };
			$('odpovedelo').textContent = `Odpovědělo ${Object.keys(odpovedi).length} z ${Object.keys(tymy).length} týmů`;
			if (Object.keys(odpovedi).length >= Object.keys(tymy).length) odhal();
		}
	}

	function vykresliCekarnu() {
		const jmena = Object.keys(tymy);
		$('pocet-tymu-text').textContent = jmena.length;
		$('seznam-tymu').innerHTML = jmena.map((j) => `<span class="tym-stitek">${j}</span>`).join('');
		$('start').disabled = jmena.length === 0;
	}

	$('start').addEventListener('click', () => {
		$('cekarna').hidden = true;
		$('hra').hidden = false;
		cisloOtazky = 0;
		polozOtazku();
	});

	const jeRiskova = () => (cisloOtazky + 1) % 5 === 0;

	function polozOtazku() {
		if (cisloOtazky >= otazky.length) return konec();
		const otazka = otazky[cisloOtazky];
		odpovedi = {};
		faze = 'otazka';
		$('poradi-otazky').textContent = `Otázka ${cisloOtazky + 1} / ${otazky.length}`;
		$('riskove').hidden = !jeRiskova();
		$('text-otazky').textContent = otazka.text;
		const spravna = otazka.odpovedi[0];
		const zamichane = zamichej(otazka.odpovedi);
		otazka._spravnyIndex = zamichane.indexOf(spravna);
		$('odpovedi').innerHTML = zamichane
			.map((o, i) => `<li class="odpoved odpoved-${i}"><b>${'ABC'[i]}</b> ${o}</li>`)
			.join('');
		$('odpovedelo').textContent = `Odpovědělo 0 z ${Object.keys(tymy).length} týmů`;
		$('mezivysledek').hidden = true;
		vykresliTabulku();
		posli({ typ: 'faze', faze: 'otazka', otazka: cisloOtazky, riskova: jeRiskova() });
		// Krátká prodleva, než se rozběhne odpočet — ať otázka doletí i na tablety s pomalou wifi
		$('odpocet-cislo').textContent = 'Připravte se…';
		$('odpocet-vypln').style.transition = 'none';
		$('odpocet-vypln').style.width = '100%';
		clearInterval(odpocetId);
		clearTimeout(prodlevaId);
		prodlevaId = setTimeout(spustOdpocet, 2000);
	}

	function spustOdpocet() {
		let zbyva = casNaOtazku;
		$('odpocet-cislo').textContent = zbyva + ' s';
		$('odpocet-vypln').style.transition = 'none';
		$('odpocet-vypln').style.width = '100%';
		requestAnimationFrame(() => {
			$('odpocet-vypln').style.transition = `width ${casNaOtazku}s linear`;
			$('odpocet-vypln').style.width = '0%';
		});
		clearInterval(odpocetId);
		odpocetId = setInterval(() => {
			zbyva--;
			$('odpocet-cislo').textContent = zbyva + ' s';
			if (zbyva <= 3 && zbyva > 0) pipni(600);
			if (zbyva <= 0) odhal();
		}, 1000);
	}

	function pipni(frekvence, delka = 0.12) {
		try {
			const ctx = (pipni._ctx ??= new AudioContext());
			const osc = ctx.createOscillator();
			const gain = ctx.createGain();
			osc.frequency.value = frekvence;
			gain.gain.value = 0.15;
			osc.connect(gain).connect(ctx.destination);
			osc.start();
			osc.stop(ctx.currentTime + delka);
		} catch {}
	}

	function odhal() {
		if (faze !== 'otazka') return;
		faze = 'vysledek';
		clearInterval(odpocetId);
		pipni(880, 0.4);
		const otazka = otazky[cisloOtazky];
		const spravny = otazka._spravnyIndex;
		document.querySelectorAll('.odpoved').forEach((el, i) => {
			el.classList.toggle('spravna', i === spravny);
			el.classList.toggle('spatna', i !== spravny);
		});

		const body = jeRiskova() ? 2 : 1;
		const spravneTymy = Object.entries(odpovedi)
			.filter(([, o]) => o.volba === spravny)
			.sort((a, b) => a[1].cas - b[1].cas);
		const vysledky = {};
		for (const jmeno of Object.keys(tymy)) {
			const odpovedel = odpovedi[jmeno];
			vysledky[jmeno] = { spravne: odpovedel?.volba === spravny, volba: odpovedel?.volba ?? null };
		}
		spravneTymy.forEach(([jmeno], poradi) => {
			tymy[jmeno].body += body + (poradi === 0 ? 1 : 0); // nejrychlejší správný +1
		});

		$('kdo-jak').innerHTML = Object.entries(vysledky)
			.map(([jmeno, v]) =>
				`<span class="tym-stitek ${v.spravne ? 'ok' : 'ne'}">${v.spravne ? '✅' : v.volba === null ? '💤' : '❌'} ${jmeno}${spravneTymy[0]?.[0] === jmeno ? ' ⚡' : ''}</span>`
			)
			.join('');
		$('mezivysledek').hidden = false;
		vykresliTabulku();
		posli({ typ: 'faze', faze: 'vysledek', spravny, vysledky, tabulka: tabulkaPole() });
	}

	$('dalsi').addEventListener('click', () => {
		cisloOtazky++;
		polozOtazku();
	});

	const tabulkaPole = () =>
		Object.entries(tymy).map(([jmeno, t]) => ({ jmeno, body: t.body })).sort((a, b) => b.body - a.body);

	function vykresliTabulku() {
		$('tabulka').innerHTML =
			'<h3>Průběžné pořadí</h3>' +
			tabulkaPole().map((t) => `<div class="radek-tabulky"><span>${t.jmeno}</span><b>${t.body}</b></div>`).join('');
	}

	function konec() {
		faze = 'konec';
		$('hra').hidden = true;
		$('vysledky').hidden = false;
		const medaile = ['🥇', '🥈', '🥉'];
		$('podium').innerHTML = tabulkaPole()
			.map((t, i) => `<li class="podium-radek">${medaile[i] ?? '🏅'} <b>${t.jmeno}</b> — ${t.body} b.</li>`)
			.join('');
		posli({ typ: 'faze', faze: 'konec', tabulka: tabulkaPole() });
		for (let i = 0; i < 40; i++) {
			const k = document.createElement('span');
			k.className = 'konfeta';
			k.textContent = ['🎉', '⭐', '🎊', '⚡'][i % 4];
			k.style.left = Math.random() * 100 + 'vw';
			k.style.animationDelay = Math.random() * 2 + 's';
			document.body.appendChild(k);
		}
	}

	$('znovu').addEventListener('click', () => location.reload());
</script>

<style>
	#liga { max-width: 960px; margin: 0 auto; }
	.popis { font-size: 1.05rem; }
	.volby { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 1rem 0; }
	.volby label { display: flex; flex-direction: column; font-weight: 700; gap: 0.3rem; }
	.volby select { font-size: 1.1rem; padding: 0.3rem; }
	.velke-tlacitko { font-size: 1.4rem; padding: 0.7rem 2rem; border-radius: 12px; border: 3px solid #333;
		background: #ffe066; cursor: pointer; font-weight: 800; }
	.velke-tlacitko:disabled { opacity: 0.4; cursor: default; }
	.velke-tlacitko:not(:disabled):hover { transform: scale(1.04); }
	.pozn { color: #666; }
	.pripojeni { display: flex; gap: 3rem; flex-wrap: wrap; align-items: start; }
	.krok { font-size: 1.3rem; font-weight: 700; }
	.adresa { font-size: 1.5rem; font-weight: 800; background: #fff3bf; padding: 0.3rem 0.7rem;
		border-radius: 10px; display: inline-block; }
	.kod-mistnosti { font-size: 6rem; font-weight: 900; letter-spacing: 1rem; border: 4px solid #333;
		border-radius: 20px; padding: 0.4rem 1.4rem; display: inline-block; background: #d0ebff; }
	.seznam-tymu { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0.8rem 0 1.4rem; min-height: 2.4rem; }
	.tym-stitek { font-size: 1.2rem; font-weight: 700; border: 3px solid #333; border-radius: 999px;
		padding: 0.25rem 1rem; background: #fff; }
	.tym-stitek.ok { background: #d3f9d8; border-color: #2f9e44; }
	.tym-stitek.ne { background: #ffe3e3; border-color: #e03131; }
	.hlavicka-hry { display: flex; justify-content: space-between; align-items: center; font-size: 1.3rem; font-weight: 800; }
	.riskove { color: #d9480f; animation: blik 0.8s infinite alternate; }
	@keyframes blik { from { opacity: 1; } to { opacity: 0.4; } }
	#odpocet-pruh { height: 14px; background: #eee; border-radius: 7px; overflow: hidden; margin: 0.6rem 0 1rem; }
	#odpocet-vypln { height: 100%; width: 100%; background: linear-gradient(90deg, #40c057, #ffd43b, #fa5252); }
	#text-otazky { font-size: 2rem; min-height: 5rem; }
	.odpovedi { list-style: none; padding: 0; display: grid; gap: 0.8rem; }
	.odpoved { font-size: 1.5rem; padding: 0.8rem 1rem; border-radius: 12px; border: 3px solid #333; }
	.odpoved b { display: inline-block; width: 2.2rem; height: 2.2rem; text-align: center; border-radius: 50%;
		color: #fff; margin-right: 0.7rem; }
	.odpoved-0 b { background: #e03131; }
	.odpoved-1 b { background: #1971c2; }
	.odpoved-2 b { background: #2f9e44; }
	.odpoved.spravna { background: #d3f9d8; border-color: #2f9e44; }
	.odpoved.spatna { opacity: 0.45; }
	.odpovedelo { font-size: 1.15rem; font-weight: 700; color: #1971c2; }
	.kdo-jak { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.8rem; }
	#tabulka { margin-top: 1.5rem; padding: 0.8rem 1rem; border: 3px dashed #999; border-radius: 12px; }
	.radek-tabulky { display: flex; justify-content: space-between; font-size: 1.15rem; padding: 0.15rem 0; }
	.podium-radek { font-size: 1.7rem; margin: 0.5rem 0; }
	:global(.konfeta) { position: fixed; top: -3rem; font-size: 1.8rem; animation: pad 3.2s linear infinite; z-index: 99; }
	@keyframes pad { to { transform: translateY(110vh) rotate(360deg); } }
</style>
