---
// Živé sledování českých jezdkyň na Tour de France Femmes 2026 — mobilní mini-aplikace.
// Data: /api/tour (worker čte veřejné tabulky letourfemmes.fr, obnovuje se každou minutu).
// Jediná Češka na startu 2026: Nikola Nosková (startovní číslo 147, Cofidis).
// Klíč 'NOSKOV' je bez koncovky schválně — tabulky ji píšou jako „N. NOSKOVÁ".
const JEZDKYNE = [
	{ klic: 'NOSKOV', jmeno: 'Nikola Nosková', tym: 'Cofidis Women', emoji: '🚴‍♀️', cislo: 147 },
];
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="theme-color" content="#ffd43b" />
		<title>🇨🇿 Češka na Tour Femmes</title>
	</head>
	<body>
		<main>
			<h1>🇨🇿 Češka na Tour de France Femmes</h1>
			<p class="podtitul">1.–9. srpna 2026 · Lausanne → Nice · 9 etap</p>
			<p id="zive" class="zive">Načítám…</p>
			<div id="ziva-tabulka" hidden>
				<div class="ziva-hlava">🔴 ŽIVĚ NA TRATI <span id="do-cile"></span></div>
				<div id="ziva-jezdci"></div>
				<div id="skupiny"></div>
				<p id="komentar" class="komentar"></p>
			</div>
			<div id="karty">
				{JEZDKYNE.map((j) => (
					<article class="karta" id={`karta-${j.klic}`}>
						<header><span class="emoji">{j.emoji}</span> <b>{j.jmeno}</b> <span class="tym">{j.tym}</span>
							<span class="cislo-odznak">č. {j.cislo}</span></header>
						<div class="udaje">
							<div class="udaj"><span class="popisek">CELKOVĚ</span><span class="hodnota" data-pole="gc-pozice">–</span><span class="detail" data-pole="gc-ztrata"></span></div>
							<div class="udaj"><span class="popisek" data-pole="etapa-popisek">POSLEDNÍ ETAPA</span><span class="hodnota" data-pole="et-pozice">–</span><span class="detail" data-pole="et-ztrata"></span></div>
						</div>
					</article>
				))}
			</div>
			<section class="poznavacka">
				<h2>👀 Jak ji poznáte v televizi</h2>
				<div class="poznavacka-radek">
					<figure>
						<svg viewBox="0 0 100 100" role="img" aria-label="Dres Cofidis: žluté rukávy, tmavě červená ramena, světle červený trup s bílým pruhem">
							<!-- rukávy -->
							<path d="M34 20 L8 38 L17 56 L36 46 Z" fill="#ffd400" stroke="#222" stroke-width="2.5" stroke-linejoin="round" />
							<path d="M66 20 L92 38 L83 56 L64 46 Z" fill="#ffd400" stroke="#222" stroke-width="2.5" stroke-linejoin="round" />
							<!-- trup -->
							<path d="M27 24 L38 18 L50 24 L62 18 L73 24 L73 88 L27 88 Z" fill="#e63329" stroke="#222" stroke-width="2.5" stroke-linejoin="round" />
							<!-- bílý pruh a svislý nápis -->
							<rect x="44" y="30" width="12" height="58" fill="#fff" />
							<text x="50" y="62" class="dres-napis" text-anchor="middle" transform="rotate(-90 50 62)">COFIDIS</text>
							<!-- tmavě červená ramena -->
							<path d="M27 24 L38 18 L50 24 L62 18 L73 24 L73 34 L27 34 Z" fill="#9e1b1b" stroke="#222" stroke-width="2.5" stroke-linejoin="round" />
							<!-- límec -->
							<path d="M38 18 L50 24 L62 18" fill="none" stroke="#222" stroke-width="2.5" stroke-linejoin="round" />
						</svg>
						<figcaption><b>Dres</b> — žluté rukávy, tmavě červená ramena, červeno-bílý trup</figcaption>
					</figure>
					<figure>
						<svg viewBox="0 0 100 100" role="img" aria-label="Bílá matná přilba Uvex">
							<!-- skořepina: vpředu nižší, vzadu protažená do aero špičky -->
							<path d="M16 60 C16 30 36 20 54 20 C76 20 90 34 92 52 C93 60 88 64 80 65 L30 66 C22 66 16 64 16 60 Z"
								fill="#f7f7f7" stroke="#222" stroke-width="2.5" stroke-linejoin="round" />
							<!-- větrací otvory -->
							<path d="M32 32 L40 27 L38 48 L30 50 Z" fill="#c9c9c9" stroke="#222" stroke-width="1.6" stroke-linejoin="round" />
							<path d="M50 25 L60 26 L58 47 L48 47 Z" fill="#c9c9c9" stroke="#222" stroke-width="1.6" stroke-linejoin="round" />
							<path d="M70 30 L79 37 L77 50 L68 47 Z" fill="#c9c9c9" stroke="#222" stroke-width="1.6" stroke-linejoin="round" />
							<!-- červený proužek týmu podél spodní hrany -->
							<path d="M17 59 C34 54 66 54 91 57" fill="none" stroke="#e63329" stroke-width="3.5" stroke-linecap="round" />
							<!-- řemínek -->
							<path d="M27 65 L35 82 M73 64 L65 82 M35 82 L65 82" fill="none" stroke="#444" stroke-width="2.2" stroke-linecap="round" />
						</svg>
						<figcaption><b>Přilba</b> — bílá matná Uvex s červeným proužkem</figcaption>
					</figure>
					<figure>
						<svg viewBox="0 0 100 100" role="img" aria-label="Startovní číslo 147">
							<rect x="12" y="22" width="76" height="58" rx="4" fill="#fff" stroke="#222" stroke-width="3" />
							<text x="50" y="66" class="cislo-svg" text-anchor="middle">147</text>
						</svg>
						<figcaption><b>Startovní číslo 147</b> — na zádech a na boku kalhot</figcaption>
					</figure>
				</div>
				<p class="poznavacka-pozn">Kresba podle oficiálního popisu dresu (Etxe Ondo) a přileb Uvex pro sezonu 2026.</p>
			</section>
			<a class="zive-tlacitko" href="https://www.letourfemmes.fr/en/rankings" target="_blank" rel="noopener">
				📊 Oficiální výsledky všech etap (letourfemmes.fr)
			</a>
			<p id="lidr" class="pata"></p>
			<p id="cas" class="pata"></p>
			<p class="pata tip">📱 Tip: v Safari klepněte na <b>Sdílet → Přidat na plochu</b> a máte nás jako aplikaci.</p>
		</main>

		<script>
			const $ = (v) => document.querySelector(v);
			async function obnov() {
				try {
					const data = await (await fetch('/api/tour?t=' + Date.now(), { cache: 'no-store' })).json();
					const dokoncena = data.vysledkyPoEtape ?? data.etapa;
					const JMENA = { NOSKOV: 'Nosková' };

					// ŽIVÁ tabulka na trati (jede-li se)
					if (data.zavodSeJede) {
						$('#ziva-tabulka').hidden = false;
						$('#do-cile').textContent = data.doCileKm != null ? `· ${data.doCileKm} km do cíle` : '';
						const poradi = { NOSKOV: 1 };
						const radky = Object.entries(data.jezdci)
							.sort((a, b) => {
								const pa = a[1].zive?.poziceNaTrati ?? 9999, pb = b[1].zive?.poziceNaTrati ?? 9999;
								return pa - pb || (poradi[a[0]] ?? 9) - (poradi[b[0]] ?? 9);
							})
							.map(([k, j]) => {
								const z = j.zive;
								const vskupine = j.skupina ? ` · ${j.skupina.nazev}` : '';
								if (!z) {
									return `<div class="ziva-radek mimo"><b>–</b> ${JMENA[k] ?? k}
										<span class="ziva-odstup">mimo živé měření${vskupine}</span></div>`;
								}
								const odstup = z.odstupVterin === 0 ? 've vedení'
									: `+${Math.floor(z.odstupVterin / 60)}:${String(z.odstupVterin % 60).padStart(2, '0')}`;
								return `<div class="ziva-radek"><b>${z.poziceNaTrati}.</b> ${JMENA[k] ?? k}
									<span class="ziva-odstup">${odstup}</span> <span class="ziva-kmh">${z.rychlost ?? '–'} km/h</span>
									<div class="ziva-skupina">${j.skupina ? j.skupina.nazev : ''}</div></div>`;
							}).join('');
						$('#ziva-jezdci').innerHTML = radky;

						// přehled skupin (únik → peloton → …)
						const skupiny = (data.skupiny ?? []).map((s) => {
							const odstup = s.odstupVterin === 0 ? 've vedení'
								: `+${Math.floor(s.odstupVterin / 60)}:${String(s.odstupVterin % 60).padStart(2, '0')}`;
							const pocet = s.pocet != null ? `${s.pocet} j.` : 'velká skupina';
							const nasi = s.nasi?.length ? ` 🇨🇿 ${s.nasi.map((n) => JMENA[n] ?? n).join(', ')}` : '';
							return `<div class="skup-radek${nasi ? ' s-nasimi' : ''}"><span class="skup-nazev">${s.nazev}</span>
								<span class="skup-odstup">${odstup}</span> <span class="skup-pocet">${pocet}</span>${nasi}</div>`;
						}).join('');
						$('#skupiny').innerHTML = skupiny ? `<div class="skup-nadpis">Skupiny na trati (odstup od čela):</div>${skupiny}` : '';
						$('#komentar').textContent = data.komentar?.[0]?.text ?? '';
						$('#zive').textContent = `🔴 Právě se jede ${data.etapa}. etapa!`;
					} else {
						$('#ziva-tabulka').hidden = true;
						$('#zive').textContent = `Stav po ${dokoncena ?? '?'}. etapě`;
					}
					for (const [klic, j] of Object.entries(data.jezdci ?? {})) {
						const karta = document.getElementById('karta-' + klic);
						if (!karta) continue;
						const nastav = (pole, text) => (karta.querySelector(`[data-pole="${pole}"]`).textContent = text);
						nastav('gc-pozice', j.celkove ? `${j.celkove.pozice}.` : '–');
						nastav('gc-ztrata', j.celkove ? j.celkove.ztrata : '');
						nastav('etapa-popisek', `${dokoncena ?? ''}. ETAPA`);
						nastav('et-pozice', j.etapa ? `${j.etapa.pozice}.` : '–');
						nastav('et-ztrata', j.etapa ? j.etapa.ztrata : '');
					}
					$('#lidr').textContent = data.lidr ? `Ve žlutém dresu: ${data.lidr}` : '';
					$('#cas').textContent = 'Aktualizováno ' + new Date().toLocaleTimeString('cs-CZ');
				} catch {
					$('#cas').textContent = 'Bez spojení — zkusím to za minutu znovu.';
				}
			}
			obnov();
			setInterval(obnov, 30_000);
		</script>

		<style>
			* { box-sizing: border-box; margin: 0; }
			body { font-family: -apple-system, system-ui, sans-serif; background: #fff8e1; color: #222; }
			main { max-width: 480px; margin: 0 auto; padding: 1rem; }
			h1 { font-size: 1.5rem; margin: 0.4rem 0; }
			.podtitul { color: #777; font-size: 0.88rem; margin-bottom: 0.5rem; }
			.cislo-odznak { margin-left: auto; background: #222; color: #fff; font-weight: 800; font-size: 0.8rem;
				border-radius: 999px; padding: 0.15rem 0.6rem; letter-spacing: 0.03em; }
			.poznavacka { background: #fff; border: 3px solid #222; border-radius: 16px; padding: 0.9rem 1rem; margin: 0.9rem 0;
				box-shadow: 3px 3px 0 #22222233; }
			.poznavacka h2 { font-size: 1.05rem; margin-bottom: 0.6rem; }
			.poznavacka-radek { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
			.poznavacka figure { margin: 0; text-align: center; }
			.poznavacka svg { width: 100%; max-width: 110px; height: auto; }
			.poznavacka figcaption { font-size: 0.72rem; color: #555; line-height: 1.25; margin-top: 0.2rem; }
			.poznavacka figcaption b { display: block; color: #222; font-size: 0.8rem; }
			.dres-napis { font: 800 9px -apple-system, system-ui, sans-serif; fill: #9e1b1b; letter-spacing: 0.06em; }
			.cislo-svg { font: 900 34px -apple-system, system-ui, sans-serif; fill: #111; letter-spacing: 0.02em; }
			.poznavacka-pozn { font-size: 0.68rem; color: #999; margin-top: 0.5rem; }
			.zive { font-weight: 700; color: #c92a2a; margin-bottom: 0.8rem; }
			.karta { background: #fff; border: 3px solid #222; border-radius: 16px; padding: 0.9rem 1rem; margin: 0.7rem 0;
				box-shadow: 3px 3px 0 #22222233; }
			.karta header { font-size: 1.15rem; display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
			.emoji { font-size: 1.3rem; }
			.tym { color: #777; font-size: 0.9rem; }
			.udaje { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.7rem; }
			.udaj { display: flex; flex-direction: column; background: #fff3bf; border-radius: 12px; padding: 0.5rem 0.7rem; }
			.popisek { font-size: 0.72rem; font-weight: 700; color: #866; letter-spacing: 0.05em; }
			.hodnota { font-size: 1.9rem; font-weight: 900; }
			.detail { font-size: 0.9rem; color: #555; }
			#ziva-tabulka { background: #fff; border: 3px solid #c92a2a; border-radius: 16px; padding: 0.8rem 1rem; margin-bottom: 0.9rem; }
			.ziva-hlava { font-weight: 900; color: #c92a2a; font-size: 1.05rem; margin-bottom: 0.5rem; }
			.ziva-radek { display: flex; align-items: baseline; gap: 0.5rem; font-size: 1.2rem; padding: 0.25rem 0; border-top: 1px solid #f1dede; }
			.ziva-radek b { font-size: 1.4rem; min-width: 2.4rem; }
			.ziva-odstup { font-weight: 700; color: #1971c2; }
			.ziva-kmh { margin-left: auto; color: #777; font-size: 0.95rem; }
			.ziva-radek.mimo { opacity: 0.55; }
			.ziva-radek.mimo .ziva-odstup { color: #999; font-weight: 400; font-size: 0.85rem; }
			.ziva-skupina { flex-basis: 100%; font-size: 0.8rem; color: #888; padding-left: 2.9rem; }
			#skupiny { margin-top: 0.8rem; }
			.skup-nadpis { font-size: 0.85rem; font-weight: 700; color: #866; margin-bottom: 0.3rem; }
			.skup-radek { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; font-size: 0.98rem; padding: 0.25rem 0; border-top: 1px solid #f1dede; }
			.skup-radek.s-nasimi { background: #fff3bf; border-radius: 8px; padding: 0.3rem 0.5rem; font-weight: 700; }
			.skup-nazev { font-weight: 700; }
			.skup-odstup { color: #1971c2; font-weight: 700; }
			.skup-pocet { color: #888; font-size: 0.85rem; }
			.komentar { font-style: italic; color: #444; margin-top: 0.6rem; border-top: 1px dashed #ccc; padding-top: 0.5rem; }
			.zive-tlacitko { display: block; text-align: center; background: #c92a2a; color: #fff; font-weight: 800;
				text-decoration: none; border-radius: 14px; padding: 0.8rem; margin: 0.9rem 0; border: 3px solid #222; }
			.pata { color: #666; font-size: 0.9rem; margin-top: 0.5rem; }
			.tip { border-top: 2px dashed #ccc; padding-top: 0.6rem; margin-top: 1rem; }
		</style>
	</body>
</html>
