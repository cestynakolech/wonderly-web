<script>
	const svg = document.getElementById('idc-svg');
	const CIVKY = [
		{ zavity: 2, cx: 110, ampermetr: 260 },
		{ zavity: 4, cx: 430, ampermetr: 580 },
	];
	// doba přejezdu celé dráhy v ms — rychlosti v poměru 1 : 2 : 3
	const RYCHLOSTI = {
		1: { nazev: 'pomalu', doba: 3000 },
		2: { nazev: 'středně', doba: 1500 },
		3: { nazev: 'rychle', doba: 1000 },
	};
	const SILY = {
		1: { nazev: 'slabý', sirka: 30 },
		2: { nazev: 'silný', sirka: 44 },
	};
	const CERVENA = '#e03131';
	const MODRA = '#1971c2';
	const HORNI = 80; // horní okraj magnetu, když je venku
	const DRAHA = 110; // px mezi polohou venku a uvnitř cívky
	const PULKA = 55; // výška jedné půlky magnetu
	const STUPNE_NA_DILEK = 5; // 12 dílků = 60°

	let rychlost = 2;
	let sila = 1;
	let dole = 'N';
	let smer = 0; // 0 stojí, 1 zasouvá, −1 vysouvá
	let poloha = 0; // 0 venku, 1 uvnitř cívky
	let p0, t0, idAnim;
	let posledni = null;
	let zmena = '';

	const vychylka = (smerPohybu, rychl, sil, zavity, pol) =>
		smerPohybu * rychl * sil * (zavity / 2) * (pol === 'N' ? 1 : -1);
	const yMagnetu = (p) => HORNI + DRAHA * p;
	const uhel = (d) => d * STUPNE_NA_DILEK;
	const barva = (pol) => (pol === 'N' ? CERVENA : MODRA);
	const jmenoPolu = (pol) => (pol === 'N' ? 'severní pól (N)' : 'jižní pól (S)');
	function dilky(n) {
		const a = Math.abs(n);
		const slovo = a === 1 ? 'dílek' : a >= 2 && a < 5 ? 'dílky' : 'dílků';
		return `${a} ${slovo}`;
	}
	const strana = (n) => (n < 0 ? 'doleva' : 'doprava');
	const odecet = (n) => (n === 0 ? '0 — ručička na nule' : `${dilky(n)} ${strana(n)}`);
	const nastav = (id, attrs) => {
		const el = document.getElementById(id);
		for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
	};

	function aktualniPoloha(ted) {
		if (smer === 0) return poloha;
		const posun = (ted - t0) / RYCHLOSTI[rychlost].doba;
		return Math.min(1, Math.max(0, p0 + smer * posun));
	}

	function prekresli() {
		const horni = yMagnetu(poloha);
		const sirka = SILY[sila].sirka;
		const horniPol = dole === 'N' ? 'S' : 'N';
		const hodnoty = {};
		for (const c of CIVKY) {
			const z = c.zavity;
			const d = vychylka(smer, rychlost, sila, z, dole);
			hodnoty[z] = d;
			nastav(`idc-m${z}-h`, { x: c.cx - sirka / 2, y: horni, width: sirka, fill: barva(horniPol) });
			nastav(`idc-m${z}-d`, { x: c.cx - sirka / 2, y: horni + PULKA, width: sirka, fill: barva(dole) });
			nastav(`idc-m${z}-ht`, { y: horni + 34 });
			nastav(`idc-m${z}-dt`, { y: horni + 89 });
			document.getElementById(`idc-m${z}-ht`).textContent = horniPol;
			document.getElementById(`idc-m${z}-dt`).textContent = dole;
			nastav(`idc-r${z}`, { transform: `rotate(${uhel(d)} ${c.ampermetr} 235)` });
			document.getElementById(`idc-s${z}`).textContent = smer === 0 ? '' : smer < 0 ? '↑' : '↓';
			document.getElementById(`idc-o${z}`).textContent = `ampérmetr: ${odecet(d)}`;
		}
		const kde = poloha === 0 ? ' venku' : poloha === 1 ? ' uvnitř' : '';
		const stav = smer === 0 ? `magnety stojí${kde}` : smer < 0 ? 'vysouvají se' : 'zasouvají se';
		document.getElementById('idc-nastaveni').textContent =
			`rychlost: ${RYCHLOSTI[rychlost].nazev} · magnet: ${SILY[sila].nazev} · dolů: ${jmenoPolu(dole)} · ${stav}`;

		let r1;
		let r2;
		if (smer !== 0) {
			r1 = zmena || `${smer < 0 ? 'Vysouváš' : 'Zasouváš'} magnety — pole v cívkách se mění, cívkami teče indukovaný proud.`;
			r2 = `2 závity: ${odecet(hodnoty[2])} · 4 závity: ${odecet(hodnoty[4])}`;
		} else if (posledni) {
			r1 = zmena || 'Magnety se zastavily — pole se nemění, obě ručičky jsou na 0.';
			r2 = `Při pohybu bylo: 2 závity ${odecet(posledni[2])} · 4 závity ${odecet(posledni[4])}`;
		} else {
			r1 = zmena || 'Magnety stojí — pole v cívkách se nemění, obě ručičky ukazují 0.';
			r2 = 'Zasuň magnety do cívek a porovnej oba ampérmetry.';
		}
		document.getElementById('idc-zaver1').textContent = r1;
		document.getElementById('idc-zasun').disabled = smer === 0 && poloha === 1;
		document.getElementById('idc-vysun').disabled = smer === 0 && poloha === 0;
		document.getElementById('idc-zaver2').textContent = r2;
	}

	function zastav() {
		if (smer !== 0) {
			posledni = {
				2: vychylka(smer, rychlost, sila, 2, dole),
				4: vychylka(smer, rychlost, sila, 4, dole),
			};
		}
		smer = 0;
		zmena = '';
		if (idAnim) cancelAnimationFrame(idAnim);
		idAnim = null;
	}

	function krok(ted) {
		poloha = aktualniPoloha(ted);
		const cil = smer < 0 ? 0 : 1;
		if (poloha === cil) zastav();
		prekresli();
		if (smer !== 0) idAnim = requestAnimationFrame(krok);
	}

	function pohni(novySmer) {
		const ted = performance.now();
		poloha = aktualniPoloha(ted);
		// magnet už je na konci dráhy v tomhle směru → žádný skok; jel-li, zastaví se
		const cil = novySmer < 0 ? 0 : 1;
		if (poloha === cil) {
			if (smer !== 0) {
				zastav();
				prekresli();
			}
			return;
		}
		if (idAnim) cancelAnimationFrame(idAnim);
		smer = novySmer;
		p0 = poloha;
		t0 = ted;
		zmena = '';
		prekresli();
		idAnim = requestAnimationFrame(krok);
	}

	function dusledek(pred, po) {
		if (smer === 0) return ' — magnety stojí, ručičky zůstávají na 0.';
		if (Math.sign(pred) !== Math.sign(po)) return ' — ručičky ukazují na opačnou stranu.';
		if (Math.abs(po) > Math.abs(pred)) return ` — výchylka u 4 závitů vzrostla z ${Math.abs(pred)} na ${Math.abs(po)}.`;
		if (Math.abs(po) < Math.abs(pred)) return ` — výchylka u 4 závitů klesla z ${Math.abs(pred)} na ${Math.abs(po)}.`;
		return ' — výchylka se nezměnila.';
	}

	function zmenNastaveni(uprav, popis) {
		const ted = performance.now();
		const pred = vychylka(smer, rychlost, sila, 4, dole);
		poloha = aktualniPoloha(ted);
		p0 = poloha;
		t0 = ted;
		uprav();
		const po = vychylka(smer, rychlost, sila, 4, dole);
		zmena = `Změna: ${popis()}${dusledek(pred, po)}`;
		prekresli();
	}

	const klik = (id, fn) => document.getElementById(id).addEventListener('click', fn);
	klik('idc-zasun', () => pohni(1));
	klik('idc-vysun', () => pohni(-1));
	klik('idc-stop', () => {
		poloha = aktualniPoloha(performance.now());
		zastav();
		prekresli();
	});
	for (const r of [1, 2, 3]) {
		klik(`idc-rychlost${r}`, () => {
			for (const q of [1, 2, 3]) document.getElementById(`idc-rychlost${q}`).classList.toggle('idc-aktivni', q === r);
			zmenNastaveni(() => { rychlost = r; }, () => `rychlost ${RYCHLOSTI[r].nazev}`);
		});
	}
	for (const s of [1, 2]) {
		klik(`idc-sila${s}`, () => {
			for (const q of [1, 2]) document.getElementById(`idc-sila${q}`).classList.toggle('idc-aktivni', q === s);
			zmenNastaveni(() => { sila = s; }, () => `${SILY[s].nazev} magnet`);
		});
	}
	klik('idc-otoc', () => zmenNastaveni(() => { dole = dole === 'N' ? 'S' : 'N'; }, () => `magnet otočen, dolů je ${jmenoPolu(dole)}`));

	svg.__vychylka = vychylka;
	svg.__yMagnetu = yMagnetu;
	svg.__dilky = dilky;
	svg.__RYCHLOSTI = RYCHLOSTI;
	svg.__stav = () => ({ smer, poloha, rychlost, sila, dole });
	prekresli();
</script>

<style>
	#idc-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.idc-radek { margin: 0.3rem 0; }
	.idc-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.idc-tl.idc-aktivni { background: #ffe8cc; }
	.idc-tl:active { transform: translateY(1px); }
	.idc-tl:disabled { opacity: 0.4; cursor: not-allowed; }
</style>
