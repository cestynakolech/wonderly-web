	{podtema.interakce2 === 'prumer' && <PrumerSimulace />}
	{otazky && <Kviz otazky={otazky} />}
</SkolaLayout>

<style is:global>
	.odkazy-pokyn {
		margin-top: 0;
		color: #555;
	}
	.odkazy-mrizka {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem;
	}
	.odkaz-karta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		width: 10rem;
		text-align: center;
		text-decoration: none;
		font-weight: 700;
	}
	.odkaz-karta:hover {
		transform: scale(1.04);
	}
	.vyklad h2 {
		margin-top: 0;
	}
	.qr-podtema {
		margin: 0 0 1.2rem;
		font-size: 0.95rem;
		color: var(--ztlumena);
	}
	.qr-podtema summary {
		cursor: pointer;
		font-weight: 600;
	}
	.qr-podtema p {
		margin: 0.5rem 0;
	}
	.infografika,
	.video {
		margin: 1.5rem 0;
		text-align: center;
	}
	.infografika img {
		max-width: min(100%, 34rem);
		height: auto;
		border: 2.5px solid var(--inkoust);
		border-radius: 12px;
		box-shadow: 2px 3px 0 rgba(43, 42, 38, 0.14);
	}
	.video video {
		max-width: min(100%, 34rem);
		border: 2.5px solid var(--inkoust);
		border-radius: 12px;
		box-shadow: 2px 3px 0 rgba(43, 42, 38, 0.14);
	}
	.youtube-obal {
		max-width: min(100%, 34rem);
		margin: 0 auto;
		aspect-ratio: 16 / 9;
		border: 2.5px solid var(--inkoust);
		border-radius: 12px;
		box-shadow: 2px 3px 0 rgba(43, 42, 38, 0.14);
		overflow: hidden;
	}
	.youtube-obal iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
	.audio {
		margin: 1.5rem 0;
		text-align: center;
	}
	.audio audio {
		width: min(100%, 34rem);
	}
	.infografika figcaption,
	.audio figcaption,
	.video figcaption {
		color: var(--ztlumena);
		font-size: 1rem;
		margin-top: 0.4rem;
	}
</style>
