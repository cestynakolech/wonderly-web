---
import CestyLayout from '../../layouts/CestyLayout.astro';
import CestyAtribuce from './CestyAtribuce.astro';
import cenyAutomat from '../../data/cesty/stellplatz-ceny.json';
import type { Jazyk, Rok } from '../../data/cesty/typy';
import { MAPA_SIRKA, MAPA_VYSKA, MAX_POLOZEK, pripravPohledy, spocitejVyrez } from '../../data/cesty/mapa';
import { TEXTY, cestaCesty, formatujDatum, pocetMist, prelozPopis, prelozZemi, vlajkyZemi } from '../../data/cesty/preklady';

interface Props {
	data: Rok;
	jazyk: Jazyk;
}

const { data, jazyk } = Astro.props;
const t = TEXTY[jazyk];

const videaPodleId = new Map(data.videa.map((v) => [v.id, v]));

// ceny stání z automatu (stellplatz_ceny.py) — veřejně dohledané, jen orientační;
// čerstvější údaj z automatu má přednost před ručním zápisem v datech
const cenyKlic = new Map(cenyAutomat.map((c) => [`${c.rok}|${c.slug}|${c.stellplatz}`, c]));
function sCenami(slugMesta: string, s: (typeof data.mesta)[number]['stellplatze'] extends (infer T)[] | undefined ? T : never) {
	const auto = cenyKlic.get(`${data.rok}|${slugMesta}|${s.nazev}`);
	if (!auto) return { ...s, zAutomatu: false };
	return {
		...s,
		cenaNoc: auto.cenaNoc ?? s.cenaNoc,
		elektrina: auto.elektrina ?? s.elektrina,
		voda: auto.voda ?? s.voda,
		rokCen: `${auto.aktualizovano} · ${auto.zdroj}`,
		zAutomatu: true,
	};
}

// počítadlo dnů na cestě
// POZOR (oprava 30. 7. 2026 po auditu): dřív se počítalo rozpětí od prvního do
// posledního data v roce, takže rok s víc výjezdy hlásil i dny strávené doma mezi
// nimi — u roku 2024 vycházelo „336 dnů na cestě" místo 72. Když jsou v datech
// výjezdy, sečtou se jejich délky; jinak se použije staré rozpětí (jedna cesta).
const naDatum = (s: string) => {
	const c = s.split('.').map((x) => parseInt(x.trim(), 10));
	return c.length === 3 && !c.some(Number.isNaN) ? Date.UTC(c[2], c[1] - 1, c[0]) : null;
};
const dnyMist = data.mesta.map((m) => naDatum(m.datum)).filter((d): d is number => d !== null);
const dnyVyjezdu = (data.vyjezdy ?? [])
	.map((v) => {
		const od = naDatum(v.od);
		const doo = naDatum(v.do);
		// přelom roku (23. 12. → 2. 1.) by dal záporný rozdíl — přičte se rok
		if (od === null || doo === null) return null;
		const delka = Math.round((doo - od) / 86_400_000) + 1;
		return delka > 0 ? delka : delka + 365;
	})
	.filter((d): d is number => d !== null);
const pocetDnu = dnyVyjezdu.length
	? dnyVyjezdu.reduce((a, b) => a + b, 0)
	: dnyMist.length
		? Math.round((Math.max(...dnyMist) - Math.min(...dnyMist)) / 86_400_000) + 1
		: 0;

// Rozbalovací mapa: celková mapa se všemi místy + přiblížené pohledy po nejvýš
// třech položkách (přání učitele 28. 7. 2026 — shluky měst byly nepřehledné).
// Domov (přání učitele 29. 7. 2026): celková mapa má začínat doma, ne u prvního
// cizího města — proto se do výřezu i do trasy přidá výchozí bod cesty.
const domov = data.domov;
// Domov jde i do rozmisťovače popisků: jeho jméno se dřív kreslilo napevno pod
// domeček a v sedmi letech z osmi leželo na cizím kroužku (měřidlo testy/mapa-popisky.mjs).
const pohledy = pripravPohledy(
	data.mesta,
	data.vyrez ?? spocitejVyrez(domov ? [domov, ...data.mesta] : data.mesta),
	domov,
);
// vlaječky k položkám rozcestníku (přání učitele 29. 7. 2026) — spočítají se tady,
// aby je měl i skript, který rozcestník překresluje při přiblížení mapy
for (const pohled of pohledy) {
	for (const p of pohled.polozky) {
		(p as typeof p & { vlajky?: string }).vlajky = p.zeme ? vlajkyZemi(p.zeme) : '';
	}
}
const koren = pohledy[0];
// trasa v pořadí návštěvy + šipky směru; body bez vlastního pinu (proti dvojitým kolečkům)
const korenMistaSPinem = new Set(koren.polozky.filter((p) => p.typ === 'misto').map((p) => p.id));
const korenPoradi = new Map(koren.body.map((b) => [b.slug, b.poradi]));
const korenVsechnyMisto = koren.polozky.length > 0 && koren.polozky.every((p) => p.typ === 'misto');
const korenUzly = korenVsechnyMisto
	? [...koren.polozky].sort((a, b) => (korenPoradi.get(a.id) ?? 0) - (korenPoradi.get(b.id) ?? 0))
	: koren.body;
// Trasa vede z domova do prvního místa a dál v pořadí návštěvy. Má-li rok víc
// výjezdů (starší roky: hodně prodloužených víkendů + jedna dlouhá prázdninová
// cesta), kreslí se každý výjezd zvlášť a vrací se domů — tak se opravdu jezdilo.
const domovBod = domov ? { x: domov.x, y: domov.y } : null;
const vyjezdMista = new Map(data.mesta.map((m) => [m.slug, m.vyjezd ?? 1]));
const uzelSlug = (b: { slug?: string; id?: string }) => b.slug ?? b.id ?? '';
let korenTrasy: { x: number; y: number }[][];
if (data.vyjezdy?.length) {
	const skupiny = new Map<number, { x: number; y: number }[]>();
	for (const b of korenUzly) {
		const cislo = vyjezdMista.get(uzelSlug(b)) ?? 1;
		if (!skupiny.has(cislo)) skupiny.set(cislo, []);
		skupiny.get(cislo)!.push({ x: b.x, y: b.y });
	}
	korenTrasy = [...skupiny.entries()]
		.sort((a, b) => a[0] - b[0])
		.map(([, body]) => (domovBod ? [domovBod, ...body, domovBod] : body));
} else {
	korenTrasy = [[...(domovBod ? [domovBod] : []), ...korenUzly.map((b) => ({ x: b.x, y: b.y }))]];
}
const korenTrasaUzly = korenTrasy.flat();
const korenTrasaBody = korenTrasy.map((uzly) => uzly.map((b) => `${b.x},${b.y}`).join(' '));
const korenSipky = [];
for (const uzly of korenTrasy) {
	for (let i = 0; i < uzly.length - 1; i++) {
		const a = uzly[i];
		const b = uzly[i + 1];
		if (Math.hypot(b.x - a.x, b.y - a.y) < koren.pinR * 2) continue;
		korenSipky.push({
			mx: (a.x + b.x) / 2,
			my: (a.y + b.y) / 2,
			uhel: (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI,
		});
	}
}
const sipkaTvar = (s: number) => `${s},0 ${-s * 0.6},${s * 0.7} ${-s * 0.6},${-s * 0.7}`;
// pod celkovou mapou se vypisují místa jen tehdy, když jich není moc; jinak rozcestník
const korenUkazujeMista = data.mesta.length <= MAX_POLOZEK;
// JEDNO MÍSTO = JEDEN POPIS (přání učitele 9. 8. 2026: „někdy jedeme do jednoho
// místa víckrát za rok — nech je víckrát, ale udělej jeden popis"). Návštěvy
// zůstávají samostatné (mají svá data, videa i galerie), ale text o místě se
// nepíše dvakrát: druhá návštěva si ho vezme od té první. Kdyby se popis
// kopíroval, oprava by dojela jen do jedné kopie — přesně ten vzorec, kvůli
// kterému se na webu už jednou rozešly dvě podoby téhož pravidla.
const popisPodleJmena = new Map<string, (typeof data.mesta)[number]['popis']>();
for (const m of data.mesta) {
	if (m.popis?.cs && !popisPodleJmena.has(m.nazev)) popisPodleJmena.set(m.nazev, m.popis);
}
const popisMista = (m: (typeof data.mesta)[number]) =>
	m.popis?.cs ? m.popis : popisPodleJmena.get(m.nazev);

const texty = {
	celaCesta: t.celaCesta,
	otevrit: t.otevrit,
	zpetNaMapu: t.zpetNaMapu,
	tvaryMist: t.tvaryMist,
	max: MAX_POLOZEK,
	domov: domov ?? null,
	// slug místa → číslo výjezdu; když rok výjezdy nemá, je to null a trasa je jedna
	vyjezdMista: data.vyjezdy?.length ? Object.fromEntries(vyjezdMista) : null,
};
---

<CestyLayout titulek={`${t.nadpis} ${data.rok} – Wonderly`} jazyk={jazyk} podcesta={String(data.rok)}>
	<p><a href={cestaCesty(jazyk)}>&larr; {t.vsechnyRoky}</a></p>
	<h1>{vlajkyZemi(data.zeme)} {data.rok} – {prelozZemi(data.zeme, jazyk)}</h1>
	{pocetDnu > 1 && (
		<p class="rok-statistika">
			{pocetMist(pocetDnu, t.tvaryDnu)} {t.naCeste} · {pocetMist(data.mesta.length, t.tvaryMist)}
		</p>
	)}
	<nav class="mapa-drobecky" id="mapa-drobecky" aria-label={t.celaCesta}>
		<button type="button" class="drobecek" data-cil="vse" disabled>{t.celaCesta}</button>
	</nav>
	<svg
		class="mapa"
		id="mapa"
		viewBox={`${koren.vyrez.x} ${koren.vyrez.y} ${koren.vyrez.sirka} ${koren.vyrez.vyska}`}
		role="img"
		aria-label={`${t.mapaRoku} ${data.rok}`}
	>
		<image href="/cesty/mapa-evropa.svg" width={MAPA_SIRKA} height={MAPA_VYSKA} />
		<g id="mapa-vrstva">
			{korenTrasaBody.map((body) => (
				body.split(' ').length >= 2 && <polyline class="trasa-cara" points={body} pathLength="1000" stroke-width={koren.pinR / 1.5} />
			))}
			{korenSipky.map((s) => (
				<polygon class="trasa-sipka" points={sipkaTvar(koren.pinR * 0.75)} transform={`translate(${s.mx} ${s.my}) rotate(${s.uhel})`} />
			))}
			{koren.body
				.filter((b) => !korenMistaSPinem.has(b.slug))
				.map((b) => <circle class="pin pin-bod" cx={b.x} cy={b.y} r={koren.pinR} stroke-width={koren.pinR / 3.5} />)}
			{koren.polozky
				.filter((p) => p.typ === 'misto')
				.map((p) => (
					<>
						{Math.hypot(p.x - p.px, p.y - p.py) > koren.pinR * 0.15 && (
							<line class="pin-spojnice" x1={p.px} y1={p.py} x2={p.x} y2={p.y} stroke-width={koren.pinR / 6} />
						)}
						<a href={`#${p.id}`} class="mapa-odkaz">
							<title>{p.nazev}</title>
							<circle class="pin-dotyk" cx={p.x} cy={p.y} r={koren.pinR * 2.4} />
							<circle class="pin pin-hlavni" cx={p.x} cy={p.y} r={koren.pinR} stroke-width={koren.pinR / 3.5} />
						</a>
					</>
				))}
			{
				koren.polozky
					.filter((p) => p.typ === 'skupina')
					.map((p) => (
						<a href={`#${p.id}`} class="mapa-odkaz">
							<title>{p.nazev} – {pocetMist(p.pocet, t.tvaryMist)}</title>
							<circle class="shluk-kruh" cx={p.x} cy={p.y} r={p.r} stroke-width={koren.pinR / 3} />
							<circle class="shluk-odznak" cx={p.x + p.r * 0.72} cy={p.y - p.r * 0.72} r={koren.pinR * 0.95} />
							<text
								class="shluk-pocet"
								x={p.x + p.r * 0.72}
								y={p.y - p.r * 0.72 + koren.pinR * 0.35}
								text-anchor="middle"
								font-size={koren.pinR * 1.2}
							>
								{p.pocet}
							</text>
						</a>
					))
			}
			{domov && (
				<g class="domov-znacka">
					<title>{domov.nazev}</title>
					<polygon
						class="domov-strecha"
						points={`${domov.x},${domov.y - koren.pinR * 1.5} ${domov.x - koren.pinR * 1.4},${domov.y - koren.pinR * 0.2} ${domov.x + koren.pinR * 1.4},${domov.y - koren.pinR * 0.2}`}
						stroke-width={koren.pinR / 4}
					/>
					<rect
						class="domov-zed"
						x={domov.x - koren.pinR}
						y={domov.y - koren.pinR * 0.3}
						width={koren.pinR * 2}
						height={koren.pinR * 1.5}
						stroke-width={koren.pinR / 4}
					/>
					<text
						class="pin-popisek domov-popisek"
						x={koren.domovPopisek?.x ?? domov.x}
						y={koren.domovPopisek?.y ?? domov.y + koren.pinR * 3}
						text-anchor={koren.domovPopisek?.kotva ?? 'middle'}
						font-size={koren.domovPopisek?.fs ?? koren.pismo}
						stroke-width={koren.pismo / 5}
					>
						{domov.nazev}
					</text>
				</g>
			)}
			{
				koren.popisky.map((p) => (
					<a href={`#${p.cil}`} class="mapa-odkaz">
						<text
							class="pin-popisek"
							x={p.x}
							y={p.y}
							text-anchor={p.kotva}
							font-size={p.fs}
							stroke-width={koren.pismo / 5}
						>
							{p.text}
						</text>
					</a>
				))
			}
		</g>
	</svg>
	<p class="mapa-napoveda" id="mapa-napoveda">{koren.polozky.some((p) => p.typ === 'skupina') ? t.napovedaMapa : ''}</p>
	<ul id="mapa-rozcestnik" class:list={['mapa-rozcestnik', { 'je-skryte': korenUkazujeMista }]}>
		{
			koren.polozky.map((p) => (
				<li>
					<a href={`#${p.id}`}>
						<strong>
							{p.vlajky && <span class="rozcestnik-vlajky">{p.vlajky}</span>}
							{p.nazev}
						</strong>
						{p.typ === 'skupina' && <span class="rozcestnik-pocet">{pocetMist(p.pocet, t.tvaryMist)}</span>}
					</a>
				</li>
			))
		}
	</ul>
	<script type="application/json" id="mapa-pohledy" set:html={JSON.stringify(pohledy)}></script>
	<script type="application/json" id="mapa-texty" set:html={JSON.stringify(texty)}></script>
	<section class="mesta">
		{
			data.mesta.map((m) => {
				const video = m.videoId ? videaPodleId.get(m.videoId) : undefined;
				const stellplatzy = (m.stellplatze ?? []).map((s) => sCenami(m.slug, s));
				// u cen se vždy říká, odkud jsou a že mohou být jinde: dohledané z aplikací
				// = „jen orientační", zaplacené na místě = „platily k datu naší návštěvy"
				const sCenou = stellplatzy.filter((s) => s.cenaNoc || s.elektrina || s.voda);
				const maCenyDohledane = sCenou.some((s) => !s.overenoNaMiste);
				const maCenyVlastni = sCenou.some((s) => s.overenoNaMiste);
				return (
					<article id={m.slug} class="mesto-karta" data-slug={m.slug}>
						<h2>{m.nazev}</h2>
						<p class="meta">
							{prelozZemi(m.zeme, jazyk)} · {formatujDatum(m.datum, jazyk)}
						</p>
						<p>{prelozPopis(popisMista(m), jazyk)}</p>
						{video && (
							<div class="videa-mrizka mesto-video">
								<a href={video.odkaz} rel="noopener" class="video-karta">
									<img src={`https://img.youtube.com/vi/${video.id}/mqdefault.jpg`} alt={video.nazev} loading="lazy" />
									<span>🎬 {video.nazev}</span>
								</a>
							</div>
						)}
						{m.report && (
							<details class="bertik-report">
								<summary>{t.bertikReport}</summary>
								{m.report
									.split('\n')
									.map((odstavec) => odstavec.trim())
									.filter(Boolean)
									.map((odstavec) => (
										<p>{odstavec}</p>
									))}
							</details>
						)}
						{m.galerie && (
							<div class="galerie" data-slozka={m.galerie}>
								<p class="galerie-nacitani">Načítám fotky…</p>
							</div>
						)}
						{stellplatzy.length > 0 && (
							<>
								<h3>Stellplatz</h3>
								<ul>
									{stellplatzy.map((s) => (
										<li>
											{s.odkaz ? <a href={s.odkaz} rel="noopener">{s.nazev}</a> : s.nazev}
											{(s.cenaNoc || s.elektrina || s.voda || s.gps) && (
												<span class="stellplatz-udaje">
													{s.cenaNoc && <span title="cena za noc">🅿️ {s.cenaNoc}</span>}
													{s.elektrina && <span title="elektřina">🔌 {s.elektrina}</span>}
													{s.voda && <span title="voda">🚰 {s.voda}</span>}
													{s.gps && (
														<a href={`https://mapy.cz/?q=${s.gps}`} rel="noopener" title="otevřít v mapě">
															📍 mapa
														</a>
													)}
													{s.rokCen && <span class="stellplatz-rok">(ceny: {s.rokCen})</span>}
												</span>
											)}
											{s.poznamka && ` – ${s.poznamka}`}
										</li>
									))}
								</ul>
								{maCenyDohledane && <p class="ceny-upozorneni">ℹ️ {t.cenyUpozorneni}</p>}
								{maCenyVlastni && <p class="ceny-upozorneni">ℹ️ {t.cenyUpozorneniVlastni}</p>}
							</>
						)}
					</article>
				);
			})
		}
	</section>
	{data.videa.length > 0 && (
		<section class="videa-mrizka-blok" id="videa-mrizka-blok">
			<h2>{t.videaNadpis}</h2>
			<div class="videa-mrizka">
				{data.videa.map((v) => (
					<a href={v.odkaz} rel="noopener" class="video-karta">
						<img src={`https://img.youtube.com/vi/${v.id}/mqdefault.jpg`} alt={v.nazev} loading="lazy" />
						<span>🎬 {v.nazev}</span>
					</a>
				))}
			</div>
		</section>
	)}
	<CestyAtribuce jazyk={jazyk} />
</CestyLayout>

<script is:inline>
	// ROZBALOVACÍ MAPA (přání učitele 28. 7. 2026)
	// Všechny úrovně mapy jsou spočítané předem; tady se mezi nimi jen přepíná:
	// kliknutí na kroužek s číslem mapu přiblíží a pod mapou nechá jen ta místa.
	(function () {
		const svg = document.getElementById('mapa');
		const vrstva = document.getElementById('mapa-vrstva');
		const drobecky = document.getElementById('mapa-drobecky');
		const rozcestnik = document.getElementById('mapa-rozcestnik');
		const napoveda = document.getElementById('mapa-napoveda');
		const dataEl = document.getElementById('mapa-pohledy');
		const textyEl = document.getElementById('mapa-texty');
		// mřížka VŠECH videí roku patří jen k celkové mapě; u jednoho místa by
		// vypadala jako jeho videa (připomínka učitele 29. 7. 2026)
		const mrizkaVidei = document.getElementById('videa-mrizka-blok');
		if (!svg || !vrstva || !dataEl || !textyEl) return;

		const pohledy = JSON.parse(dataEl.textContent);
		const texty = JSON.parse(textyEl.textContent);
		const podleId = new Map(pohledy.map((p) => [p.id, p]));
		const karty = [...document.querySelectorAll('.mesto-karta')];
		const NS = 'http://www.w3.org/2000/svg';
		let ted = null;

		const pocetMist = (n) => `${n} ${n === 1 ? texty.tvaryMist[0] : n < 5 ? texty.tvaryMist[1] : texty.tvaryMist[2]}`;
		const prvek = (jmeno, atributy, text) => {
			const e = document.createElementNS(NS, jmeno);
			for (const [k, v] of Object.entries(atributy)) e.setAttribute(k, v);
			if (text !== undefined) e.textContent = text;
			return e;
		};

		function vykresli(pohled) {
			vrstva.textContent = '';
			// trasa: spojnice míst v pořadí návštěvy + šipky směru jízdy (pod vším ostatním).
			// Když jsou všechny položky jednotlivá města, vede trasa PŘES KOLEČKA (piny jsou
			// kvůli čitelnosti rozestoupené a skutečné polohy skoro splývají); mezi shluky
			// vede přes skutečné polohy.
			const poradiSlugu = new Map(pohled.body.map((b) => [b.slug, b.poradi]));
			const vsechnyMisto = pohled.polozky.length > 0 && pohled.polozky.every((p) => p.typ === 'misto');
			const mista = vsechnyMisto
				? [...pohled.polozky].sort((a, b) => (poradiSlugu.get(a.id) ?? 0) - (poradiSlugu.get(b.id) ?? 0))
				: pohled.body;
			// domov je jen na celkové mapě — trasa z něj vychází (přání učitele 29. 7. 2026)
			const jeKoren = pohled.id === 'vse';
			const domov = jeKoren ? texty.domov : null;
			// Má-li rok víc výjezdů (starší roky: prodloužené víkendy + prázdninová
			// cesta), kreslí se každý zvlášť a vrací se domů — jinak jedna linka.
			let trasy;
			if (texty.vyjezdMista) {
				const skupiny = new Map();
				for (const m of mista) {
					const cislo = texty.vyjezdMista[m.slug ?? m.id] ?? 1;
					if (!skupiny.has(cislo)) skupiny.set(cislo, []);
					skupiny.get(cislo).push(m);
				}
				trasy = [...skupiny.entries()]
					.sort((a, b) => a[0] - b[0])
					.map(([, body]) => (domov ? [{ x: domov.x, y: domov.y }, ...body, { x: domov.x, y: domov.y }] : body));
			} else {
				trasy = [domov ? [{ x: domov.x, y: domov.y }, ...mista] : mista];
			}
			for (const uzlyTrasy of trasy) {
				if (uzlyTrasy.length < 2) continue;
				const trasa = uzlyTrasy.map((b) => `${b.x},${b.y}`).join(' ');
				vrstva.appendChild(
					prvek('polyline', { class: 'trasa-cara', points: trasa, pathLength: 1000, 'stroke-width': pohled.pinR / 1.5 }),
				);
				for (let i = 0; i < uzlyTrasy.length - 1; i++) {
					const a = uzlyTrasy[i];
					const b = uzlyTrasy[i + 1];
					if (Math.hypot(b.x - a.x, b.y - a.y) < pohled.pinR * 2) continue; // šipka se nevejde
					const mx = (a.x + b.x) / 2;
					const my = (a.y + b.y) / 2;
					const uhel = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
					const s = pohled.pinR * 0.75;
					vrstva.appendChild(
						prvek('polygon', {
							class: 'trasa-sipka',
							points: `${s},0 ${-s * 0.6},${s * 0.7} ${-s * 0.6},${-s * 0.7}`,
							transform: `translate(${mx} ${my}) rotate(${uhel})`,
						}),
					);
				}
			}
			// drobné body míst — jen ta, která v tomhle pohledu nemají vlastní pin (žádná dvojitá kolečka)
			const mistaSPinem = new Set(pohled.polozky.filter((p) => p.typ === 'misto').map((p) => p.id));
			for (const b of pohled.body) {
				if (mistaSPinem.has(b.slug)) continue;
				vrstva.appendChild(
					prvek('circle', { class: 'pin pin-bod', cx: b.x, cy: b.y, r: pohled.pinR, 'stroke-width': pohled.pinR / 3.5 }),
				);
			}
			for (const p of pohled.polozky) {
				const odkaz = prvek('a', { href: `#${p.id}`, class: 'mapa-odkaz' });
				odkaz.appendChild(prvek('title', {}, p.typ === 'skupina' ? `${p.nazev} – ${pocetMist(p.pocet)}` : p.nazev));
				if (p.typ === 'skupina') {
					odkaz.appendChild(
						prvek('circle', { class: 'shluk-kruh', cx: p.x, cy: p.y, r: p.r, 'stroke-width': pohled.pinR / 3 }),
					);
					const ox = p.x + p.r * 0.72;
					const oy = p.y - p.r * 0.72;
					odkaz.appendChild(prvek('circle', { class: 'shluk-odznak', cx: ox, cy: oy, r: pohled.pinR * 0.95 }));
					odkaz.appendChild(
						prvek(
							'text',
							{ class: 'shluk-pocet', x: ox, y: oy + pohled.pinR * 0.35, 'text-anchor': 'middle', 'font-size': pohled.pinR * 1.2 },
							String(p.pocet),
						),
					);
				} else {
					// místo posunuté kvůli přehlednosti spojíme čárkou se skutečnou polohou
					if (Math.hypot(p.x - p.px, p.y - p.py) > pohled.pinR * 0.15) {
						vrstva.appendChild(
							prvek('line', { class: 'pin-spojnice', x1: p.px, y1: p.py, x2: p.x, y2: p.y, 'stroke-width': pohled.pinR / 6 }),
						);
					}
					odkaz.appendChild(prvek('circle', { class: 'pin-dotyk', cx: p.x, cy: p.y, r: pohled.pinR * 2.4 }));
					odkaz.appendChild(
						prvek('circle', { class: 'pin pin-hlavni', cx: p.x, cy: p.y, r: pohled.pinR, 'stroke-width': pohled.pinR / 3.5 }),
					);
				}
				vrstva.appendChild(odkaz);
			}
			for (const p of pohled.popisky) {
				const odkaz = prvek('a', { href: `#${p.cil}`, class: 'mapa-odkaz' });
				odkaz.appendChild(
					prvek(
						'text',
						{ class: 'pin-popisek', x: p.x, y: p.y, 'text-anchor': p.kotva, 'font-size': p.fs, 'stroke-width': pohled.pismo / 5 },
						p.text,
					),
				);
				vrstva.appendChild(odkaz);
			}
			if (domov) {
				const r = pohled.pinR;
				const g = prvek('g', { class: 'domov-znacka' });
				g.appendChild(prvek('title', {}, domov.nazev));
				g.appendChild(
					prvek('polygon', {
						class: 'domov-strecha',
						points: `${domov.x},${domov.y - r * 1.5} ${domov.x - r * 1.4},${domov.y - r * 0.2} ${domov.x + r * 1.4},${domov.y - r * 0.2}`,
						'stroke-width': r / 4,
					}),
				);
				g.appendChild(
					prvek('rect', {
						class: 'domov-zed',
						x: domov.x - r,
						y: domov.y - r * 0.3,
						width: r * 2,
						height: r * 1.5,
						'stroke-width': r / 4,
					}),
				);
				g.appendChild(
					prvek(
						'text',
						{
							class: 'pin-popisek domov-popisek',
							x: pohled.domovPopisek?.x ?? domov.x,
							y: pohled.domovPopisek?.y ?? domov.y + r * 3,
							'text-anchor': pohled.domovPopisek?.kotva ?? 'middle',
							'font-size': pohled.domovPopisek?.fs ?? pohled.pismo,
							'stroke-width': pohled.pismo / 5,
						},
						domov.nazev,
					),
				);
				vrstva.appendChild(g);
			}
		}

		function vykresliDrobecky(pohled) {
			if (!drobecky) return;
			drobecky.textContent = '';
			const kroky = [{ id: 'vse', nazev: texty.celaCesta }, ...pohled.cesta];
			kroky.forEach((krok, i) => {
				if (i > 0) drobecky.appendChild(document.createTextNode(' › '));
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'drobecek';
				b.dataset.cil = krok.id;
				b.textContent = krok.nazev;
				b.disabled = i === kroky.length - 1;
				drobecky.appendChild(b);
			});
		}

		function vykresliRozcestnik(pohled) {
			if (!rozcestnik) return;
			const ukazujeMista = pohled.slugy.length <= texty.max;
			rozcestnik.classList.toggle('je-skryte', ukazujeMista);
			rozcestnik.textContent = '';
			if (ukazujeMista) return;
			for (const p of pohled.polozky) {
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = `#${p.id}`;
				const jmeno = document.createElement('strong');
				if (p.vlajky) {
					const vlajky = document.createElement('span');
					vlajky.className = 'rozcestnik-vlajky';
					vlajky.textContent = p.vlajky;
					jmeno.appendChild(vlajky);
				}
				jmeno.appendChild(document.createTextNode(p.nazev));
				a.appendChild(jmeno);
				if (p.typ === 'skupina') {
					const pocet = document.createElement('span');
					pocet.className = 'rozcestnik-pocet';
					pocet.textContent = pocetMist(p.pocet);
					a.appendChild(pocet);
				}
				li.appendChild(a);
				rozcestnik.appendChild(li);
			}
		}

		function zobraz(id, skoc) {
			const pohled = podleId.get(id) ?? podleId.get('vse');
			if (!pohled || pohled === ted) {
				if (skoc) skocNaMisto(id);
				return;
			}
			ted = pohled;
			const v = pohled.vyrez;
			svg.setAttribute('viewBox', `${v.x} ${v.y} ${v.sirka} ${v.vyska}`);
			vykresli(pohled);
			vykresliDrobecky(pohled);
			vykresliRozcestnik(pohled);
			const ukazujeMista = pohled.slugy.length <= texty.max;
			for (const karta of karty) {
				karta.classList.toggle('je-skryte', !(ukazujeMista && pohled.slugy.includes(karta.dataset.slug)));
			}
			if (mrizkaVidei) mrizkaVidei.classList.toggle('je-skryte', pohled.id !== 'vse');
			if (napoveda) {
				napoveda.textContent = pohled.polozky.some((p) => p.typ === 'skupina') ? napoveda.dataset.text : '';
			}
			if (skoc) skocNaMisto(id);
		}

		function skocNaMisto(id) {
			const karta = karty.find((k) => k.dataset.slug === id && !k.classList.contains('je-skryte'));
			if (karta) karta.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}

		/** Pohled, ve kterém je dané místo vidět i s článkem (nejhlubší úroveň). */
		function pohledMista(slug) {
			const listy = pohledy.filter((p) => p.slugy.includes(slug) && p.slugy.length <= texty.max);
			return listy.length ? listy[listy.length - 1].id : 'vse';
		}

		function zpracujCil(cil) {
			if (!cil) return zobraz('vse', false);
			if (podleId.has(cil)) {
				// samostatné místo má vlastní pohled — zobrazíme ten, kde je i jeho článek
				const pohled = podleId.get(cil);
				if (pohled.slugy.length <= texty.max) return zobraz(pohled.id, true);
				return zobraz(cil, false);
			}
			if (karty.some((k) => k.dataset.slug === cil)) return zobraz(pohledMista(cil), true);
			zobraz('vse', false);
		}

		if (napoveda) napoveda.dataset.text = napoveda.textContent;
		document.addEventListener('click', (e) => {
			const drobecek = e.target.closest('.drobecek');
			if (drobecek) {
				zobraz(drobecek.dataset.cil, false);
				return;
			}
			const odkaz = e.target.closest('a[href^="#"]');
			if (!odkaz) return;
			const cil = decodeURIComponent(odkaz.getAttribute('href').slice(1));
			if (!cil) return;
			e.preventDefault();
			history.replaceState(null, '', `#${cil}`);
			zpracujCil(cil);
		});
		window.addEventListener('hashchange', () => zpracujCil(decodeURIComponent(location.hash.slice(1))));
		zpracujCil(decodeURIComponent(location.hash.slice(1)));
	})();

	// fotogalerie: seznam fotek se načte z úložiště přes /media/seznam,
	// zobrazí se náhledy a kliknutím se fotka zvětší přímo na stránce
	// (přání učitele 29. 7. 2026 — dřív se otevírala v nové kartě)
	for (const galerie of document.querySelectorAll('.galerie')) {
		const slozka = galerie.dataset.slozka;
		fetch(`/media/seznam?slozka=${encodeURIComponent(slozka)}`)
			.then((odpoved) => odpoved.json())
			.then((soubory) => {
				const originaly = soubory.filter((s) => !s.includes('/nahledy/'));
				galerie.innerHTML = '';
				if (originaly.length === 0) return;
				originaly.forEach((original, poradi) => {
					const nazev = original.split('/').pop();
					const nahled = `${slozka}/nahledy/${nazev.replace(/\.[^.]+$/, '.jpg')}`;
					const odkaz = document.createElement('a');
					odkaz.href = `/media/${original}`;
					odkaz.target = '_blank';
					odkaz.rel = 'noopener';
					odkaz.dataset.poradi = poradi;
					const obrazek = document.createElement('img');
					obrazek.src = `/media/${nahled}`;
					obrazek.loading = 'lazy';
					obrazek.alt = nazev;
					odkaz.appendChild(obrazek);
					galerie.appendChild(odkaz);
				});
			})
			.catch(() => {
				galerie.innerHTML = '';
			});
	}

	// zvětšení fotky přes celou obrazovku: kliknutí na náhled, listování šipkami,
	// zavření křížkem, klávesou Esc nebo kliknutím vedle fotky
	(function () {
		let fotky = [];
		let ted = 0;
		const vrstva = document.createElement('div');
		vrstva.className = 'lupa je-skryte';
		vrstva.innerHTML =
			'<button type="button" class="lupa-zavrit" aria-label="Zavřít">✕</button>' +
			'<button type="button" class="lupa-sip lupa-vlevo" aria-label="Předchozí fotka">‹</button>' +
			'<img alt="" />' +
			'<button type="button" class="lupa-sip lupa-vpravo" aria-label="Další fotka">›</button>';
		document.body.appendChild(vrstva);
		const obrazek = vrstva.querySelector('img');

		function ukaz(i) {
			if (!fotky.length) return;
			ted = (i + fotky.length) % fotky.length;
			obrazek.src = fotky[ted].href;
			obrazek.alt = fotky[ted].querySelector('img')?.alt ?? '';
			const jedina = fotky.length < 2;
			vrstva.querySelector('.lupa-vlevo').classList.toggle('je-skryte', jedina);
			vrstva.querySelector('.lupa-vpravo').classList.toggle('je-skryte', jedina);
		}
		function zavri() {
			vrstva.classList.add('je-skryte');
			obrazek.removeAttribute('src');
		}

		document.addEventListener('click', (e) => {
			const nahled = e.target.closest('.galerie a');
			if (nahled) {
				e.preventDefault();
				fotky = [...nahled.closest('.galerie').querySelectorAll('a')];
				vrstva.classList.remove('je-skryte');
				ukaz(fotky.indexOf(nahled));
				return;
			}
			if (e.target.closest('.lupa-vlevo')) return ukaz(ted - 1);
			if (e.target.closest('.lupa-vpravo')) return ukaz(ted + 1);
			if (e.target.closest('.lupa-zavrit') || e.target === vrstva) zavri();
		});
		document.addEventListener('keydown', (e) => {
			if (vrstva.classList.contains('je-skryte')) return;
			if (e.key === 'Escape') zavri();
			if (e.key === 'ArrowLeft') ukaz(ted - 1);
			if (e.key === 'ArrowRight') ukaz(ted + 1);
		});
	})();
</script>

