---
// Vedení proudu v plynech (F9). Jen jevy a čísla z výkladu (slug vedeni-proudu-v-plynech):
// Režim „jiskra": obvod jako obr-02 — baterie/zdroj, žárovka a dvě elektrody s mezerou
// vzduchu. Posuvník napětí má jen SLOVNÍ stupně (vypnuto … velmi velké) — výklad kV ani mm
// pro jiskru nemá. Vzduch je velice špatný vodič → žárovka nesvítí; proud projde, když
// (a) mezi elektrodami hoří svíčka (horký vzduch se ionizuje — obr-02), nebo (b) napětí
// vzroste tak, že vzduch ztratí izolační schopnost (nejvyšší stupeň) → přeskočí jiskra.
// Režim „bouřka": mrak se záporným nábojem dole a kladným nahoře, pod ním kladný náboj
// na zemi (obr-03); blesk do bleskosvodu = kovová tyč na střeše spojená kovovým vodičem
// se zemí; 2 až 3 km, 20 000–30 000 °C; Franklin a Diviš v 18. století; hrom vzniká
// rychlým rozpínáním ohřátého vzduchu. Pravidlo z Pro zvídavé: čím delší pauza mezi
// bleskem a hromem, tím dál je bouřka (bez přepočtu na km).
// Mobil: scéna 360 jednotek → na telefonu (~235 px) písmo ≥ 19 × 235 / 360 ≈ 12,4 px.
// Bez časové animace; stav = čisté funkce stavJiskry(U, svicka) a stavBourky(pauza) na SVG.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Jiskra a blesk — když vzduch přestane izolovat 🕹️</span></h2>
	<p>Vzduch je <strong>velice špatný vodič</strong> — proud jím projde, až když se <strong>ionizuje</strong>. Stane se to třeba v plameni (horký vzduch), nebo když napětí vzroste tak, že vzduch <strong>ztratí izolační schopnost</strong>. Blesk je obří jiskra dlouhá 2 až 3 km.</p>
	<p id="jis-rezimy">
		<button type="button" id="jis-r-jiskra" class="jis-tl jis-aktivni" data-rezim="jiskra">⚡ jiskra v laboratoři</button>
		<button type="button" id="jis-r-bourka" class="jis-tl" data-rezim="bourka">🌩️ bouřka venku</button>
	</p>
	<svg id="jis-svg" viewBox="0 0 360 340" role="img" aria-label="Obvod se zdrojem, žárovkou a dvěma elektrodami s mezerou vzduchu, nebo bouřkový mrak nad domem s bleskosvodem">
		<!-- REŽIM JISKRA (obvod jako obr-02) -->
		<g id="jis-scena-jiskra">
			<path d="M60 190 L60 40 L140 40 M152 40 L246 40 M278 40 L300 40 L300 190" fill="none" stroke="#2b2a26" stroke-width="4" />
			<line x1="140" y1="30" x2="140" y2="50" stroke="#2b2a26" stroke-width="8" />
			<line x1="152" y1="22" x2="152" y2="58" stroke="#2b2a26" stroke-width="4" />
			<text x="126" y="22" text-anchor="middle" font-size="19" font-weight="bold" fill="#1864ab">−</text>
			<text x="166" y="22" text-anchor="middle" font-size="19" font-weight="bold" fill="#c92a2a">+</text>
			<text x="146" y="82" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">zdroj napětí</text>
			<!-- žárovka: svítí, jen když obvodem prochází proud -->
			<g id="jis-paprsky" stroke="#e8a200" stroke-width="3" stroke-linecap="round">
				<line x1="262" y1="18" x2="262" y2="8" /><line x1="244" y1="24" x2="237" y2="17" /><line x1="280" y1="24" x2="287" y2="17" />
			</g>
			<circle cx="262" cy="40" r="16" fill="#fff" stroke="#2b2a26" stroke-width="3" />
			<circle id="jis-vlakno" cx="262" cy="40" r="11" fill="#ffd43b" />
			<!-- elektrody s mezerou vzduchu -->
			<line x1="60" y1="190" x2="126" y2="190" stroke="#2b2a26" stroke-width="5" />
			<line x1="234" y1="190" x2="300" y2="190" stroke="#2b2a26" stroke-width="5" />
			<circle cx="140" cy="190" r="14" fill="#868e96" stroke="#2b2a26" stroke-width="3" />
			<circle cx="220" cy="190" r="14" fill="#868e96" stroke="#2b2a26" stroke-width="3" />
			<text x="180" y="160" text-anchor="middle" font-size="19" font-weight="bold" fill="#495057">vzduch</text>
			<!-- svíčka pod mezerou -->
			<g id="jis-svicka-g" visibility="hidden">
				<rect x="171" y="226" width="18" height="50" rx="2" fill="#fff" stroke="#2b2a26" stroke-width="2.5" />
				<line x1="180" y1="226" x2="180" y2="218" stroke="#2b2a26" stroke-width="2" />
				<path d="M180 178 C191 194 191 212 180 220 C169 212 169 194 180 178 Z" fill="#ff922b" stroke="#e8590c" stroke-width="2" />
				<path d="M180 196 C184 204 184 212 180 216 C176 212 176 204 180 196 Z" fill="#ffe066" />
			</g>
			<polyline id="jis-jiskra" points="154,190 168,178 180,202 192,180 206,190" fill="none" stroke="#e8a200" stroke-width="4" stroke-linejoin="round" visibility="hidden" />
			<text id="jis-udaje" x="180" y="124" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26"></text>
			<text id="jis-napeti-pop" x="180" y="318" text-anchor="middle" font-size="19" fill="#2b2a26"></text>
		</g>
		<!-- REŽIM BOUŘKA (náboje jako obr-03) -->
		<g id="jis-scena-bourka" visibility="hidden">
			<rect x="4" y="286" width="352" height="50" fill="#b2f2bb" stroke="#2b2a26" stroke-width="2" />
			<!-- pozorovatel stojí vlevo, bouřka se posouvá blíž nebo dál -->
			<g stroke="#2b2a26" stroke-width="3" stroke-linecap="round" fill="none">
				<circle cx="28" cy="244" r="9" fill="#ffe8cc" />
				<line x1="28" y1="253" x2="28" y2="270" /><line x1="28" y1="270" x2="20" y2="286" /><line x1="28" y1="270" x2="36" y2="286" /><line x1="18" y1="260" x2="38" y2="260" />
			</g>
			<text x="28" y="226" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">ty</text>
			<g id="jis-bourka-g" transform="translate(0 0)">
				<g fill="#adb5bd" stroke="#495057" stroke-width="2">
					<ellipse cx="170" cy="76" rx="66" ry="30" /><ellipse cx="116" cy="92" rx="40" ry="22" /><ellipse cx="224" cy="92" rx="40" ry="22" />
				</g>
				<!-- kladný náboj nahoře, záporný dole v mraku -->
				<text x="170" y="70" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">+ + +</text>
				<text x="170" y="100" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">−  −  −</text>
				<!-- kladný náboj na zemi pod mrakem -->
				<text x="170" y="326" text-anchor="middle" font-size="19" font-weight="bold" fill="#2b2a26">+ + + + +</text>
				<!-- dům s bleskosvodem: tyč na střeše, kovový vodič po zdi až do země -->
				<rect x="176" y="236" width="60" height="50" fill="#ffe8cc" stroke="#2b2a26" stroke-width="3" />
				<polygon points="168,236 244,236 206,208" fill="#e8590c" stroke="#2b2a26" stroke-width="3" />
				<line id="jis-tyc" x1="206" y1="208" x2="206" y2="170" stroke="#2b2a26" stroke-width="4" />
				<polyline id="jis-svod" points="206,208 248,238 248,300 240,300" fill="none" stroke="#2b2a26" stroke-width="3" />
				<text x="190" y="170" text-anchor="end" font-size="19" fill="#2b2a26">bleskosvod</text>
				<polyline id="jis-blesk" points="214,112 198,132 216,138 200,156 206,170" fill="none" stroke="#e8a200" stroke-width="5" stroke-linejoin="round" visibility="hidden" />
				<text id="jis-blesk-info" x="190" y="142" text-anchor="end" font-size="19" font-weight="bold" fill="#2b2a26"></text>
			</g>
			<text id="jis-bourka-vysledek" x="180" y="24" text-anchor="middle" font-size="19" font-weight="bold" fill="#1864ab"></text>
		</g>
	</svg>
	<div id="jis-ovladani-jiskra">
		<label class="sim-posuvnik">Napětí zdroje: <output id="jis-out-u"></output>
			<input type="range" id="jis-u" min="0" max="4" step="1" value="2" />
		</label>
		<p><button type="button" class="jis-tl" id="jis-svicka">🕯️ zapal svíčku mezi elektrodami</button></p>
	</div>
	<div id="jis-ovladani-bourka" style="display:none">
		<p><button type="button" class="jis-tl" id="jis-zablyskni">🌩️ zablýskni</button></p>
		<label class="sim-posuvnik">Pauza mezi bleskem a hromem: <output id="jis-out-p"></output>
			<input type="range" id="jis-p" min="1" max="3" step="1" value="2" />
		</label>
	</div>
	<p class="jis-vzorec" id="jis-vzorec"></p>
	<p class="jis-stav" id="jis-stav" aria-live="polite">👉 Zvyšuj napětí, nebo zapal svíčku — a sleduj, kdy žárovka rozsvítí.</p>
</section>

<script>
	// === ČISTÁ ČÁST (bez DOM — kontrolovatelná výpočtem) ===
	const NAPETI = ['vypnuto', 'malé', 'střední', 'velké', 'velmi velké']; // jen slovně, bez kV
	const PRURAZ = NAPETI.length - 1; // až nejvyšší stupeň: vzduch ztratí izolační schopnost
	function stavJiskry(U, svicka) {
		const preskoci = !svicka && U >= PRURAZ; // jiskra přes studený vzduch
		const horkyVzduch = svicka && U > 0; // plamen ionizuje vzduch → vede (obr-02)
		return { napeti: NAPETI[U], preskoci, horkyVzduch, vede: preskoci || horkyVzduch };
	}
	const PAUZA = ['krátká', 'delší', 'dlouhá'];
	const VZDALENOST = ['blízko', 'dál', 'daleko'];
	const POSUN = 45; // o kolik se bouřka odsune s každým stupněm pauzy
	function stavBourky(pauza) {
		const i = pauza - 1; // posuvník 1–3
		return { pauza: PAUZA[i], vzdalenost: VZDALENOST[i], posun: i * POSUN };
	}
	// === KONEC ČISTÉ ČÁSTI ===

	let rezim = 'jiskra';
	let blesklo = false;
	let svicka = false;
	const svg = document.getElementById('jis-svg');
	svg.__stavJiskry = stavJiskry; svg.__stavBourky = stavBourky; // pro nezávislou kontrolu
	const g = (id) => document.getElementById(id);
	const viditelne = (id, ano) => g(id).setAttribute('visibility', ano ? 'visible' : 'hidden');

	function kresliJiskru() {
		const U = +g('jis-u').value;
		const s = stavJiskry(U, svicka);
		g('jis-out-u').textContent = s.napeti;
		viditelne('jis-svicka-g', svicka);
		viditelne('jis-jiskra', s.preskoci);
		viditelne('jis-paprsky', s.vede);
		g('jis-vlakno').setAttribute('opacity', s.vede ? 1 : 0.06);
		g('jis-svicka').textContent = svicka ? '💨 sfoukni svíčku' : '🕯️ zapal svíčku mezi elektrodami';
		g('jis-udaje').textContent = s.preskoci ? '⚡ jiskra — proud prochází'
			: s.horkyVzduch ? '🔥 proud prochází'
			: 'proud neprochází';
		g('jis-napeti-pop').textContent = `napětí: ${s.napeti}`;
		g('jis-vzorec').innerHTML = 'Vzduch je <strong>velice špatný vodič</strong>. Vodivý se stane, když se <strong>ionizuje</strong>: z molekul se uvolní elektrony a vzniknou ionty.';
		g('jis-stav').textContent = s.preskoci
			? '⚡ Napětí vzrostlo tak, že vzduch ztratil izolační schopnost a stal se vodivým. Proud přeskočil jako jiskra a žárovka svítí — tak vzniká i blesk.'
			: s.horkyVzduch
				? '🕯️ Plamen ohřál vzduch: molekuly do sebe častěji narážejí a uvolňují se z nich elektrony (ionizace). Horký vzduch je mnohem lepší vodič — proud prochází a žárovka svítí.'
				: U === 0
					? (svicka ? '🕯️ Svíčka hoří, ale bez napětí proud neteče. Přidej napětí.' : '🔌 Bez napětí se nic neděje. Přidej napětí, nebo zapal svíčku.')
					: '🛡️ Vzduch je zatím izolant — proud neprochází a žárovka nesvítí. Zvyšuj napětí, nebo mezi elektrody dej hořící svíčku.';
	}

	function kresliBourku() {
		const s = stavBourky(+g('jis-p').value);
		g('jis-out-p').textContent = s.pauza;
		g('jis-bourka-g').setAttribute('transform', `translate(${s.posun} 0)`);
		viditelne('jis-blesk', blesklo);
		g('jis-blesk-info').textContent = blesklo ? '20 000–30 000 °C' : '';
		g('jis-zablyskni').textContent = blesklo ? '🌫️ schovej blesk' : '🌩️ zablýskni';
		g('jis-bourka-vysledek').textContent = `${s.pauza} pauza → bouřka je ${s.vzdalenost}`;
		g('jis-vzorec').innerHTML = 'Světlo je rychlejší než zvuk, a proto vidíš blesk dřív, než uslyšíš hrom. <strong>Čím delší je pauza mezi bleskem a hromem, tím dál je bouřka.</strong> Pauzu můžeš odpočítávat v sekundách.';
		g('jis-stav').textContent = blesklo
			? '🌩️ Blesk je jiskrový výboj dlouhý 2 až 3 km, vzduch v něm má 20 000 až 30 000 °C. Uhodil do BLESKOSVODU: kovové tyče na střeše spojené kovovým vodičem se zemí, který blesk svede do země. Bleskosvod v 18. století nezávisle na sobě vynalezli Benjamin Franklin a Prokop Diviš. Hrom je zvuk, který vzniká rychlým rozpínáním ohřátého vzduchu.'
			: '👉 Dole v mraku je záporný náboj, nahoře kladný a na zemi pod mrakem kladný. Zablýskni tlačítkem a posuvníkem měň pauzu mezi bleskem a hromem. Čím dřív hrom, tím blíž bouřka!';
	}

	function prekresli() {
		viditelne('jis-scena-jiskra', rezim === 'jiskra');
		viditelne('jis-scena-bourka', rezim === 'bourka');
		g('jis-ovladani-jiskra').style.display = rezim === 'jiskra' ? '' : 'none';
		g('jis-ovladani-bourka').style.display = rezim === 'bourka' ? '' : 'none';
		g('jis-r-jiskra').classList.toggle('jis-aktivni', rezim === 'jiskra');
		g('jis-r-bourka').classList.toggle('jis-aktivni', rezim === 'bourka');
		if (rezim === 'jiskra') kresliJiskru(); else kresliBourku();
	}

	g('jis-r-jiskra').addEventListener('click', () => { rezim = 'jiskra'; prekresli(); });
	g('jis-r-bourka').addEventListener('click', () => { rezim = 'bourka'; prekresli(); });
	g('jis-svicka').addEventListener('click', () => { svicka = !svicka; kresliJiskru(); });
	g('jis-zablyskni').addEventListener('click', () => { blesklo = !blesklo; kresliBourku(); });
	g('jis-u').addEventListener('input', kresliJiskru);
	g('jis-p').addEventListener('input', kresliBourku);
	prekresli();
</script>

<style>
	#jis-svg { width: 100%; max-width: 460px; border: 3px solid #2b2a26; border-radius: 12px; background: #f8f9fa; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 460px; display: block; margin-top: 0.3rem; }
	.jis-tl { font: inherit; font-weight: 700; padding: 0.3rem 0.8rem; border: 3px solid #2b2a26; border-radius: 10px; background: #fff; cursor: pointer; margin: 0 0.4rem 0.4rem 0; }
	.jis-tl.jis-aktivni { background: #ffe8cc; }
	.jis-tl:active { transform: translateY(1px); }
	.jis-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
	.jis-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
</style>
