---
// Sestavení a oživení robota (informatika 8, VEX IQ, sestaveni-a-oziveni-robota).
//
// Výklad na téže stránce má pointu, kterou slovy nejde ukázat: chyba v ZAPOJENÍ
// portů se neprojeví hned při sestavování, ale AŽ při spuštění programu — a projeví
// se jinak, než chyba v programu. Simulace proto rozděluje dvě věci, které si děti
// pletou:
//   1. SCHÉMA ZAPOJENÍ (nahoře): mozek (Brain) má 12 portů, levý a pravý motor se
//      připojují kabelem do konkrétního portu. Program čeká motory v portu 1 (levý)
//      a portu 6 (pravý) — přesně podle typického návodu ke stavebnici. Do jednoho
//      portu nejde zapojit dva kabely najednou — vybraný port zmizí z nabídky
//      u druhého kabelu (fyzicky tam druhý konektor nevleze).
//   2. CO ROBOT UDĚLÁ (dole, POHLED SHORA na podlahu): spustí se STÁLE STEJNÝ
//      program „jeď 2 s vpřed" a je vidět, co udělá KAŽDÉ kolo zvlášť:
//        - kabel ve svém portu → kolo se točí správně dopředu (rychlost +1)
//        - kabel v portu toho DRUHÉHO motoru → kolo se točí obráceně (rychlost −1)
//        - kabel nikde (nebo ve volném portu, který program nepoužívá) → kolo mlčí (0)
//      Pohyb robota = průměr rychlostí obou kol (dopředu/dozadu) + rozdíl rychlostí
//      (otáčení). Klíčový případ ze zadání: PROHOZENÉ kabely (levý→port 6,
//      pravý→port 1) dají OBĚMA kolům rychlost −1 → průměr −1, rozdíl 0 →
//      robot COUVÁ (jede pozpátku, nekroutí se) — přesně jak to popisuje výklad
//      na stránce („Program bývá v pořádku — obvykle jsou motory zapojené
//      obráceně nebo prohozený levý a pravý"). Když mlčí jen jeden motor, robot
//      se stáčí k té straně, která nejede (mírný oblouk). Kdyby obě kola dostala
//      navzájem OPAČNÝ povel (jedno +1, druhé −1), robot by se točil na místě —
//      ale to by šlo jen tak, že by dva kabely mířily do téhož portu, a to
//      zapojení už UI nedovolí (viz bod 1), takže se to reálně nestane.
//
// POHLED SHORA (top-down), ne z boku: otáčení a couvání jsou v rovině podlahy
// naprosto přirozené (žádné „propadávání" pod čáru podlahy ani „kotrmelce"
// jako při rotaci nakreslené z boku). Stejný pohled shora používá i sesterská
// simulace VEXcode (žák naprogramuje robota) — děti ho už znají.
//
// Krok sestavení (podvozek → mozek → kabely → zapnutí) se musí dodržet v POŘADÍ:
// dokud není mozek na podvozku, nejde zapojovat kabely; dokud nejsou kabely
// (aspoň pokusně) zapojené, nejde spustit program — tlačítka jsou zamčená.
//
// Výchozí zapojení (levý → port 1, pravý → port 6) dá čistou, správnou jízdu —
// dítě nejdřív uvidí, jak to má vypadat, a pak si zkazí zapojení samo.
//
// Časování: program je vždy „drive for 2 seconds" — proto VŠECHNY možné výsledky
// animujeme STEJNĚ dlouho, 60 snímků (30 snímků ≈ 1 s; requestAnimationFrame je
// v náhledu zpomalený, počítá se podle POŘADÍ snímků, ne podle reálného času).

const PORT_X0 = 415;
const PORT_KROK = 27;
const PORT_Y1 = 52;
const PORT_Y2 = 84;
const porty = [];
for (let i = 1; i <= 12; i++) {
	const radek = i <= 6 ? 0 : 1;
	const sloupec = i <= 6 ? i - 1 : i - 7;
	porty.push({ cislo: i, x: PORT_X0 + sloupec * PORT_KROK, y: radek === 0 ? PORT_Y1 : PORT_Y2 });
}
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Proč robot mlčí, i když je program v pořádku 🔌</span></h2>
	<p>
		Sestav robota v pořádném pořadí a pak zapoj kabely motorů do portů mozku (Brain).
		Program je pořád stejný — <strong>„jeď 2 s vpřed"</strong>. Sleduj (pohled shora
		na podlahu), co se stane, když jsou kabely v jiných portech, než program čeká.
	</p>

	<p class="sb-radek">
		<button type="button" class="sb-tl sb-hlavni" id="sb-krok-podvozek">1. sestavit podvozek</button>
		<button type="button" class="sb-tl sb-hlavni" id="sb-krok-mozek" disabled>2. připojit mozek (Brain)</button>
		<button type="button" class="sb-tl" id="sb-reset">↺ od začátku</button>
	</p>

	<div class="sb-obal">
		<svg id="sb-scena" viewBox="0 0 640 340" role="img" aria-labelledby="sb-popis">
			<title id="sb-popis">Nahoře schéma zapojení kabelů do portů mozku, dole pohled shora na robota na podlaze</title>

			<!-- díly na stole, než je robot sestavený -->
			<g id="sb-dily-skupina">
				<rect x="60" y="150" width="110" height="60" rx="8" fill="#e9ecef" stroke="#2b2a26" stroke-width="3" transform="rotate(-8 115 180)" />
				<text x="115" y="184" text-anchor="middle" class="sb-popisek" transform="rotate(-8 115 180)">podvozek</text>
				<circle cx="240" cy="220" r="18" fill="#adb5bd" stroke="#2b2a26" stroke-width="3" />
				<circle cx="290" cy="230" r="18" fill="#adb5bd" stroke="#2b2a26" stroke-width="3" />
				<rect x="330" y="150" width="70" height="40" rx="6" fill="#ffd43b" stroke="#2b2a26" stroke-width="3" transform="rotate(6 365 170)" />
				<text x="365" y="174" text-anchor="middle" class="sb-popisek" transform="rotate(6 365 170)">Brain</text>
				<rect x="440" y="200" width="50" height="24" rx="5" fill="#ffa94d" stroke="#2b2a26" stroke-width="3" />
				<rect x="500" y="200" width="50" height="24" rx="5" fill="#66d9e8" stroke="#2b2a26" stroke-width="3" />
				<text x="465" y="240" text-anchor="middle" class="sb-popisek">motory</text>
			</g>

			<!-- schéma zapojení: mozek s porty, motory a kabely — zobrazí se po kroku 2 -->
			<g id="sb-zapojeni-skupina" opacity="0">
				<rect x="30" y="30" width="70" height="24" rx="5" fill="#ffa94d" stroke="#2b2a26" stroke-width="3" />
				<text x="65" y="46" text-anchor="middle" class="sb-popisek-mala">levý motor</text>
				<rect x="30" y="72" width="70" height="24" rx="5" fill="#66d9e8" stroke="#2b2a26" stroke-width="3" />
				<text x="65" y="88" text-anchor="middle" class="sb-popisek-mala">pravý motor</text>

				<rect x="400" y="16" width="180" height="90" rx="10" fill="#f1f3f5" stroke="#2b2a26" stroke-width="3" />
				<text x="490" y="12" text-anchor="middle" class="sb-popisek" id="sb-brain-nadpis">BRAIN</text>

				{porty.map((p) => (
					<g>
						<rect id={`sb-port-${p.cislo}`} x={p.x - 10} y={p.y - 10} width="20" height="20" rx="4"
							fill="#fff" stroke="#868e96" stroke-width="2" />
						<text x={p.x} y={p.y + 4} text-anchor="middle" class="sb-port-cislo">{p.cislo}</text>
					</g>
				))}

				<line id="sb-kabel-levy" x1="100" y1="42" x2="130" y2="42" stroke="#f08c00" stroke-width="4" stroke-linecap="round" />
				<line id="sb-kabel-pravy" x1="100" y1="84" x2="130" y2="84" stroke="#1098ad" stroke-width="4" stroke-linecap="round" />
			</g>

			<!-- robot na podlaze — POHLED SHORA, zobrazí se po kroku 2 -->
			<g id="sb-robot-skupina" opacity="0">
				<rect x="20" y="140" width="600" height="140" rx="10" fill="#f1f3f5" stroke="#868e96" stroke-width="2" />
				<line x1="330" y1="150" x2="380" y2="150" stroke="#adb5bd" stroke-width="3" marker-end="url(#sb-sipka)" />
				<text x="355" y="140" text-anchor="middle" class="sb-popisek-mala" fill="#868e96">vpřed</text>
				<defs>
					<marker id="sb-sipka" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
						<path d="M0,0 L8,4 L0,8 Z" fill="#adb5bd" />
					</marker>
				</defs>
				<polyline id="sb-stopa" points="" fill="none" stroke="#1971c2" stroke-width="2" stroke-dasharray="5 5" />
				<g id="sb-robot-top" transform="translate(320 210) rotate(0)">
					<rect x="-25" y="-18" width="50" height="36" rx="8" fill="#ffd43b" stroke="#2b2a26" stroke-width="3" />
					<polygon points="25,0 15,-10 15,10" fill="#e03131" stroke="#2b2a26" stroke-width="2" />
					<rect id="sb-kolo-levy" x="-18" y="-24" width="16" height="8" rx="2" fill="#ffa94d" stroke="#2b2a26" stroke-width="2" />
					<rect id="sb-kolo-pravy" x="-18" y="16" width="16" height="8" rx="2" fill="#66d9e8" stroke="#2b2a26" stroke-width="2" />
				</g>
			</g>
		</svg>
	</div>

	<p class="sb-radek" id="sb-radek-kabely" hidden>
		<strong>Kabel levého motoru →</strong>
		<select id="sb-port-levy" class="sb-vyber">
			<option value="">— nezapojeno —</option>
			<option value="1">port 1</option>
			<option value="4">port 4</option>
			<option value="6">port 6</option>
		</select>
		<strong>Kabel pravého motoru →</strong>
		<select id="sb-port-pravy" class="sb-vyber">
			<option value="">— nezapojeno —</option>
			<option value="1">port 1</option>
			<option value="4">port 4</option>
			<option value="6">port 6</option>
		</select>
	</p>

	<p class="sb-radek">
		<button type="button" class="sb-tl sb-hlavni" id="sb-spustit" disabled>⏩ zapnout a spustit program (2 s)</button>
	</p>

	<table class="sb-tabulka">
		<caption class="sb-titulek">Co je kde zapojené</caption>
		<tbody>
			<tr><th scope="row">levý motor čeká program v</th><td>portu 1</td><td class="sb-pozn">podle návodu ke stavebnici</td></tr>
			<tr><th scope="row">levý motor je doopravdy v</th><td id="sb-tab-levy"></td><td class="sb-pozn" id="sb-pozn-levy"></td></tr>
			<tr><th scope="row">pravý motor čeká program v</th><td>portu 6</td><td class="sb-pozn"></td></tr>
			<tr><th scope="row">pravý motor je doopravdy v</th><td id="sb-tab-pravy"></td><td class="sb-pozn" id="sb-pozn-pravy"></td></tr>
			<tr class="sb-duraz"><th scope="row">co robot udělá</th><td id="sb-tab-vysledek" colspan="2"></td></tr>
		</tbody>
	</table>

	<p class="sb-stav" id="sb-stav" aria-live="polite"></p>
</section>

<script>
	const PROG_LEVY = '1';
	const PROG_PRAVY = '6';
	const FRAMES = 60; // program je vždy „drive for 2 seconds" → VŽDY 60 snímků, ať dopadne jakkoli
	const FORWARD_TOTAL = 200; // px za celý běh, když obě kola jedou správně (průměr rychlostí = 1)
	const ROT_TOTAL = 180; // ° za celý běh na jednotku rozdílu rychlostí kol (max rozdíl je teď ±1, viz níže)

	const PORT_X0 = 415, PORT_KROK = 27, PORT_Y1 = 52, PORT_Y2 = 84;
	function portPozice(cislo) {
		const c = Number(cislo);
		if (!c) return null;
		const radek = c <= 6 ? 0 : 1;
		const sloupec = c <= 6 ? c - 1 : c - 7;
		return { x: PORT_X0 + sloupec * PORT_KROK, y: radek === 0 ? PORT_Y1 : PORT_Y2 };
	}

	const scenaEl = document.getElementById('sb-scena');
	const dilyEl = document.getElementById('sb-dily-skupina');
	const zapojeniEl = document.getElementById('sb-zapojeni-skupina');
	const robotSkupinaEl = document.getElementById('sb-robot-skupina');
	const robotTopEl = document.getElementById('sb-robot-top');
	const stopaEl = document.getElementById('sb-stopa');
	const koloLevyEl = document.getElementById('sb-kolo-levy');
	const koloPravyEl = document.getElementById('sb-kolo-pravy');
	const kabelLevyEl = document.getElementById('sb-kabel-levy');
	const kabelPravyEl = document.getElementById('sb-kabel-pravy');
	const radekKabelyEl = document.getElementById('sb-radek-kabely');
	const selectLevyEl = document.getElementById('sb-port-levy');
	const selectPravyEl = document.getElementById('sb-port-pravy');
	const tabLevyEl = document.getElementById('sb-tab-levy');
	const tabPravyEl = document.getElementById('sb-tab-pravy');
	const poznLevyEl = document.getElementById('sb-pozn-levy');
	const poznPravyEl = document.getElementById('sb-pozn-pravy');
	const tabVysledekEl = document.getElementById('sb-tab-vysledek');
	const stavEl = document.getElementById('sb-stav');
	const btnPodvozek = document.getElementById('sb-krok-podvozek');
	const btnMozek = document.getElementById('sb-krok-mozek');
	const btnSpustit = document.getElementById('sb-spustit');
	const btnReset = document.getElementById('sb-reset');
	const popisEl = document.getElementById('sb-popis');

	const BARVA_LEVY_VYCHOZI = '#ffa94d';
	const BARVA_PRAVY_VYCHOZI = '#66d9e8';

	// ——— čisté funkce: stav motoru a výsledný pohyb, ověřitelné bez prohlížeče ———
	/** Kabel motoru je ve 'spravne' portu, v portu 'druheho' motoru (zaměněný → točí se obráceně), nebo 'mlci'. */
	function stavMotoru(port, vlastniPort, druhyPort) {
		if (port === vlastniPort) return 'spravne';
		if (port === druhyPort) return 'zamnene';
		return 'mlci';
	}
	/** Rychlost kola: správně +1 (jede), zaměněně −1 (točí se obráceně), mlčí 0. */
	function rychlostKola(stav) {
		return stav === 'spravne' ? 1 : stav === 'zamnene' ? -1 : 0;
	}
	/**
	 * Pohyb robota ze dvou rychlostí kol (diferenciální podvozek):
	 *  avg  = (vL+vR)/2 … dopředu/dozadu (kladně dopředu, záporně couvá)
	 *  diff = vL-vR      … otáčení (kladně vpravo, záporně vlevo)
	 * S prohozenými kabely dostanou OBĚ kola stejnou zápornou rychlost →
	 * avg=−1, diff=0 → robot COUVÁ a nekroutí se (souhlasí s výkladem na stránce).
	 */
	function vyhodnotPohyb(vL, vR) {
		return { avg: (vL + vR) / 2, diff: vL - vR };
	}
	/** Krátký popis pro tabulku podle pohybu. */
	function popisekPohybu({ avg, diff }) {
		if (avg === 0 && diff === 0) return 'stojí, ticho';
		if (diff === 0) return avg > 0 ? 'jede rovně dopředu' : 'couvá (jede pozpátku)';
		if (avg === 0) return diff > 0 ? 'točí se na místě doprava' : 'točí se na místě doleva';
		const smer = avg > 0 ? 'a jede dopředu' : 'a couvá';
		return diff > 0 ? `otáčí se doprava ${smer}` : `otáčí se doleva ${smer}`;
	}

	let krok = 0; // 0 díly, 1 podvozek, 2 mozek + porty
	let bezi = false;
	let posledniVysledek = null; // { avg, diff }

	/** Do jednoho portu nejde zapojit dva kabely — zvolený port zmizí z nabídky u druhého kabelu. */
	function synchronizujMoznosti() {
		const vLevy = selectLevyEl.value;
		const vPravy = selectPravyEl.value;
		for (const opt of selectLevyEl.options) opt.disabled = opt.value !== '' && opt.value === vPravy;
		for (const opt of selectPravyEl.options) opt.disabled = opt.value !== '' && opt.value === vLevy;
	}

	function aktualizujKabely() {
		synchronizujMoznosti();
		const portLevy = selectLevyEl.value;
		const portPravy = selectPravyEl.value;
		const pozLevy = portPozice(portLevy);
		const pozPravy = portPozice(portPravy);
		kabelLevyEl.setAttribute('x2', String(pozLevy ? pozLevy.x : 130));
		kabelLevyEl.setAttribute('y2', String(pozLevy ? pozLevy.y : 42));
		kabelLevyEl.setAttribute('stroke-dasharray', pozLevy ? '' : '4 6');
		kabelPravyEl.setAttribute('x2', String(pozPravy ? pozPravy.x : 130));
		kabelPravyEl.setAttribute('y2', String(pozPravy ? pozPravy.y : 84));
		kabelPravyEl.setAttribute('stroke-dasharray', pozPravy ? '' : '4 6');
		for (let i = 1; i <= 12; i++) {
			const portEl = document.getElementById(`sb-port-${i}`);
			const jePripojenLevy = String(i) === portLevy;
			const jePripojenPravy = String(i) === portPravy;
			portEl.setAttribute('fill', jePripojenLevy ? '#ffd8a8' : jePripojenPravy ? '#99e9f2' : '#fff');
		}
		tabLevyEl.textContent = portLevy ? `portu ${portLevy}` : 'nikde — nezapojeno';
		tabPravyEl.textContent = portPravy ? `portu ${portPravy}` : 'nikde — nezapojeno';
		poznLevyEl.textContent = portLevy === PROG_LEVY ? 'sedí to' : portLevy === PROG_PRAVY ? 'to je port pravého motoru!' : portLevy ? 'program tenhle port nepoužívá' : 'motor je hluchý';
		poznPravyEl.textContent = portPravy === PROG_PRAVY ? 'sedí to' : portPravy === PROG_LEVY ? 'to je port levého motoru!' : portPravy ? 'program tenhle port nepoužívá' : 'motor je hluchý';
	}

	function aktualizujTlacitka() {
		btnPodvozek.disabled = krok !== 0 || bezi;
		btnMozek.disabled = krok !== 1 || bezi;
		radekKabelyEl.hidden = krok < 2;
		selectLevyEl.disabled = krok < 2 || bezi;
		selectPravyEl.disabled = krok < 2 || bezi;
		btnSpustit.disabled = krok < 2 || bezi;
	}

	function popisKroku() {
		if (krok === 0) return 'Na stole leží díly — podvozek, kola, mozek (Brain) a dva motory. Klikni na <strong>1. sestavit podvozek</strong>.';
		if (krok === 1) return 'Podvozek je hotový. Teď na něj klikni na <strong>2. připojit mozek (Brain)</strong> — kostku s 12 porty, do kterých se zapojují kabely.';
		return null; // od kroku 2 se stav řídí zapojením / výsledkem běhu
	}

	function popisVysledku({ avg, diff }, portLevy, portPravy) {
		if (avg === 1 && diff === 0) {
			return '🎉 <strong>Robot jede rovně dopředu!</strong> Levý motor je v portu 1 a pravý v portu 6 — přesně jak program čeká.';
		}
		if (avg === -1 && diff === 0) {
			return '↩️ <strong>Robot couvá</strong>, i když má program jet dopředu! Kabely levého a pravého motoru jsou '
				+ '<strong>prohozené</strong> — každý motor tak dostává povel pro tu druhou stranu a obě kola se točí obráceně. '
				+ 'Program je v pořádku — stačí přepojit kabely do portu 1 (levý) a portu 6 (pravý), robota rozebírat nemusíš.';
		}
		if (avg === 0 && diff === 0) {
			return '🤐 <strong>Robot stojí a je úplné ticho</strong> — ani jeden motor není v portu, který program používá (port 1 a port 6). '
				+ 'Program je v pořádku, chyba je v zapojení kabelů.';
		}
		if (diff > 0 && avg >= 0) {
			return `↪️ <strong>Robot se stáčí doprava</strong> — pravý motor `
				+ (portPravy ? `je v portu ${portPravy}, ale program čeká motor v portu 6 — proto ho neslyší.` : 'není zapojený v žádném portu — mlčí.')
				+ ' Levý motor jede správně. Zkontroluj port pravého motoru, ne program.';
		}
		if (diff < 0 && avg >= 0) {
			return `↩️ <strong>Robot se stáčí doleva</strong> — levý motor `
				+ (portLevy ? `je v portu ${portLevy}, ale program čeká motor v portu 1 — proto ho neslyší.` : 'není zapojený v žádném portu — mlčí.')
				+ ' Pravý motor jede správně. Zkontroluj port levého motoru, ne program.';
		}
		// couvá a zároveň se stáčí — jeden kabel zaměněný, druhý nezapojený
		return `↩️ <strong>Robot couvá a přitom se stáčí</strong> — jeden kabel je v portu toho druhého motoru (motor se točí obráceně) `
			+ 'a druhý motor vůbec neslyší program. Zkontroluj oba porty podle tabulky výše.';
	}

	function prekresli() {
		dilyEl.setAttribute('opacity', krok === 0 ? '1' : '0');
		zapojeniEl.setAttribute('opacity', krok >= 2 ? '1' : '0');
		robotSkupinaEl.setAttribute('opacity', krok >= 2 ? '1' : krok === 1 ? '0.35' : '0');
		if (krok >= 2) aktualizujKabely();
		aktualizujTlacitka();

		if (posledniVysledek) {
			tabVysledekEl.textContent = popisekPohybu(posledniVysledek);
			stavEl.innerHTML = popisVysledku(posledniVysledek, selectLevyEl.value, selectPravyEl.value);
		} else {
			tabVysledekEl.textContent = krok < 2 ? '—' : 'zatím nespuštěno';
			const kr = popisKroku();
			stavEl.innerHTML = kr ?? 'Zapoj kabely obou motorů do portů a klikni na <strong>zapnout a spustit program</strong>. '
				+ 'Chyba v zapojení se neprojeví, dokud program nespustíš.';
		}
		popisEl.textContent = krok < 2
			? 'Robot ještě není sestavený.'
			: `Mozek je připojený. Levý motor v portu ${selectLevyEl.value || 'nikde'}, pravý motor v portu ${selectPravyEl.value || 'nikde'}.`;
	}

	function nastavKolo(el, stav, barvaVychozi) {
		el.setAttribute('fill', stav === 'spravne' ? '#37b24d' : stav === 'zamnene' ? '#e03131' : stav === 'mlci' ? '#868e96' : barvaVychozi);
	}

	btnPodvozek.addEventListener('click', () => {
		if (krok !== 0) return;
		krok = 1;
		prekresli();
	});

	btnMozek.addEventListener('click', () => {
		if (krok !== 1) return;
		krok = 2;
		selectLevyEl.value = PROG_LEVY;
		selectPravyEl.value = PROG_PRAVY;
		posledniVysledek = null;
		robotTopEl.setAttribute('transform', 'translate(320 210) rotate(0)');
		stopaEl.setAttribute('points', '');
		nastavKolo(koloLevyEl, null, BARVA_LEVY_VYCHOZI);
		nastavKolo(koloPravyEl, null, BARVA_PRAVY_VYCHOZI);
		prekresli();
	});

	btnReset.addEventListener('click', () => {
		if (bezi) return;
		krok = 0;
		posledniVysledek = null;
		selectLevyEl.value = '';
		selectPravyEl.value = '';
		robotTopEl.setAttribute('transform', 'translate(320 210) rotate(0)');
		stopaEl.setAttribute('points', '');
		nastavKolo(koloLevyEl, null, BARVA_LEVY_VYCHOZI);
		nastavKolo(koloPravyEl, null, BARVA_PRAVY_VYCHOZI);
		prekresli();
	});

	selectLevyEl.addEventListener('change', () => { posledniVysledek = null; prekresli(); });
	selectPravyEl.addEventListener('change', () => { posledniVysledek = null; prekresli(); });

	btnSpustit.addEventListener('click', () => {
		if (krok < 2 || bezi) return;
		const portLevy = selectLevyEl.value;
		const portPravy = selectPravyEl.value;
		const levyStav = stavMotoru(portLevy, PROG_LEVY, PROG_PRAVY);
		const pravyStav = stavMotoru(portPravy, PROG_PRAVY, PROG_LEVY);
		const vL = rychlostKola(levyStav);
		const vR = rychlostKola(pravyStav);
		const vysledek = vyhodnotPohyb(vL, vR);
		nastavKolo(koloLevyEl, levyStav, BARVA_LEVY_VYCHOZI);
		nastavKolo(koloPravyEl, pravyStav, BARVA_PRAVY_VYCHOZI);

		bezi = true;
		aktualizujTlacitka();

		const START_X = 320, START_Y = 210;
		// Posun je ZÁMĚRNĚ jen podél pevné vodorovné osy (Y se při běhu nemění) a
		// otáčení se kreslí NEZÁVISLE na místě (heading neovlivňuje směr posunu).
		// Díky tomu jde obrys robota (tělo 50×36 + kola, poloměr od středu nejdál
		// R = √(25²+18²) = √949 ≈ 30,81, tedy < 31 px) spočítat přesně, ne odhadem:
		//   X středu se za celý běh mění jen o avg·FORWARD_TOTAL = avg·200,
		//   avg ∈ {−1; −0,5; 0; 0,5; 1} → X střed vždy v ⟨120; 520⟩,
		//   s obrysem (+/−31 px) tedy v ⟨89; 551⟩ ⊂ aréna x ⟨20; 620⟩ (rezerva 69 px).
		//   Y středu je po celý běh přesně START_Y = 210 (žádný posun),
		//   s obrysem (+/−31 px) tedy v ⟨179; 241⟩ ⊂ aréna y ⟨140; 280⟩ (rezerva 39 px).
		// Obrys tak zůstane uvnitř arény ve všech dosažitelných kombinacích portů.
		const krokDX = (vysledek.avg * FORWARD_TOTAL) / FRAMES; // px/snímek podél pevné osy X
		const krokRot = (vysledek.diff * ROT_TOTAL) / FRAMES; // °/snímek, jen otáčí obrázek na místě

		let x = START_X, heading = 0, snimek = 0;
		const stopa = [`${x},${START_Y}`];

		function tik() {
			snimek++;
			x += krokDX;
			heading += krokRot;
			robotTopEl.setAttribute('transform', `translate(${x.toFixed(1)} ${START_Y}) rotate(${heading.toFixed(1)})`);
			stopa.push(`${x.toFixed(1)},${START_Y}`);
			stopaEl.setAttribute('points', stopa.join(' '));
			if (snimek < FRAMES) {
				requestAnimationFrame(tik);
			} else {
				bezi = false;
				posledniVysledek = vysledek;
				prekresli();
			}
		}
		requestAnimationFrame(tik);
	});

	prekresli();

	// ——— háčky pro test bez prohlížeče ———
	scenaEl.__stavMotoru = stavMotoru;
	scenaEl.__rychlostKola = rychlostKola;
	scenaEl.__vyhodnotPohyb = vyhodnotPohyb;
	scenaEl.__meze = { PROG_LEVY, PROG_PRAVY, FRAMES, FORWARD_TOTAL, ROT_TOTAL };
	scenaEl.__stav = () => ({ krok, posledniVysledek, portLevy: selectLevyEl.value, portPravy: selectPravyEl.value });
</script>

