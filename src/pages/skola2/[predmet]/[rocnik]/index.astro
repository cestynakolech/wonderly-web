---
import { predmety, rocniky } from '../../../../data/predmety';
import { temata } from '../../../../data/temata';

export function getStaticPaths() {
	const paths = [];
	for (const p of predmety) {
		for (const r of rocniky) {
			paths.push({ params: { predmet: p.slug, rocnik: r.slug }, props: { predmet: p, rocnik: r } });
		}
	}
	return paths;
}

const { predmet, rocnik } = Astro.props;
const seznamTemat = temata[`${predmet.slug}/${rocnik.slug}`] ?? [];
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{predmet.nazev} – {rocnik.nazev} – Wonderly</title>
	</head>
	<body>
		<main>
			<p><a href={`/${predmet.slug}/`}>&larr; Zpět na {predmet.nazev}</a></p>
			<h1>{predmet.nazev} – {rocnik.nazev}</h1>
			{seznamTemat.length > 0 ? (
				<>
					<p>Vyber si téma.</p>
					<div class="grid">
						{seznamTemat.map((t) => (
							<a class="dlazdice" href={`/${predmet.slug}/${rocnik.slug}/${t.slug}/`} style={`background:${predmet.barva}`}>
								{t.nazev}
							</a>
						))}
					</div>
				</>
			) : (
				<p>Témata připravujeme.</p>
			)}
		</main>
		<style>
			main {
				max-width: 60rem;
				margin: 4rem auto;
				font-family: system-ui, sans-serif;
				padding: 0 1.5rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
				gap: 1.5rem;
				margin-top: 2rem;
			}
			.dlazdice {
				aspect-ratio: 1 / 1;
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				color: #fff;
				font-size: 1.4rem;
				font-weight: 700;
				text-decoration: none;
				border-radius: 1rem;
				padding: 1rem;
				box-sizing: border-box;
			}
		</style>
	</body>
</html>
