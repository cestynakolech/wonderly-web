		Klikni na zařízení (odpojí se dalším kliknutím) a pak na „Vyzkoušet zapojení".
	</p>
</section>

<script>
	// ——— rádio: konstanty scény (kalibrováno výpočtem, ne odhadem z náhledu) ———
	const AX_X0 = 140;         // x pro 0 m
	const AX_X1 = 840;         // x pro 100 m (celá šířka scény)
	const SCALE = 7;           // px na 1 m: (840-140)/100
	const DOSAH_M = 70;        // udávaný dosah výrobce (na volném prostranství) — jen popisek, ne hranice
	const UTLUM_NA_METR = 1;   // % síly signálu ubude na každý metr
	const UTLUM_NA_ZED = 15;   // % síly signálu ubude za každou zeď
	const PRAH = 30;           // % — pod touto silou je zpráva nečitelná
	const ANIM_MS = 1400;      // za tolik ms proletí fronta celou scénu
	const FADE_MS = 300;       // pak ještě dohasíná

	const boardX = (vzdalenost) => AX_X0 + vzdalenost * SCALE;

	/** Čistá funkce: síla signálu v % podle vzdálenosti (m) a počtu zdí. */
	function pureSila(vzdalenost, zdi) {
		const sila = 100 - UTLUM_NA_METR * vzdalenost - UTLUM_NA_ZED * zdi;
		return Math.max(0, Math.min(100, sila));
	}
	/** Čistá funkce: kde je vlnová fronta v čase `ms` od odeslání. */
	function pureFrontX(ms) {
		if (ms <= 0) return AX_X0;
		if (ms >= ANIM_MS) return AX_X1;
		return AX_X0 + (ms / ANIM_MS) * (AX_X1 - AX_X0);
	}
	/** Čistá funkce: průhlednost fronty v čase `ms` (1 → viditelná, 0 → zmizela). */
	function pureOpacity(ms) {
		if (ms <= 0) return 0;
		if (ms < ANIM_MS) return 1;
		if (ms < ANIM_MS + FADE_MS) return 1 - (ms - ANIM_MS) / FADE_MS;
		return 0;
	}

	const svg = document.getElementById('mr-svg');
	const frontEl = document.getElementById('mr-front');
	const deska2 = document.getElementById('mr-deska2');
	const deska3 = document.getElementById('mr-deska3');
	const obrazVysilacEl = document.getElementById('mr-obraz-vysilac');
	const skupinaVysilacTextEl = document.getElementById('mr-skupina-vysilac-text');
	const obraz2El = document.getElementById('mr-obraz2');
	const obraz3El = document.getElementById('mr-obraz3');
	const skupina2TextEl = document.getElementById('mr-skupina2-text');
	const skupina3TextEl = document.getElementById('mr-skupina3-text');
	const ram2El = document.getElementById('mr-ram2');
	const ram3El = document.getElementById('mr-ram3');
	const stavEl = document.getElementById('mr-stav');
	const btnOdeslat = document.getElementById('mr-btn-odeslat');
	const olVysilac = document.getElementById('mr-blok-vysilac');
	const ol2 = document.getElementById('mr-blok-2');
	const ol3 = document.getElementById('mr-blok-3');

	const skupina1Slider = document.getElementById('mr-skupina1');
	const skupina2Slider = document.getElementById('mr-skupina2');
	const skupina3Slider = document.getElementById('mr-skupina3');
	const vzdalenost2Slider = document.getElementById('mr-vzdalenost2');
	const vzdalenost3Slider = document.getElementById('mr-vzdalenost3');
	const zdi2Slider = document.getElementById('mr-zdi2');
	const zdi3Slider = document.getElementById('mr-zdi3');
	const out1 = document.getElementById('mr-out-skupina1');
	const out2 = document.getElementById('mr-out-skupina2');
	const out3 = document.getElementById('mr-out-skupina3');
	const outV2 = document.getElementById('mr-out-vzdalenost2');
	const outV3 = document.getElementById('mr-out-vzdalenost3');
	const outZdi2 = document.getElementById('mr-out-zdi2');
	const outZdi3 = document.getElementById('mr-out-zdi3');
	const sila2TextEl = document.getElementById('mr-sila2-text');
	const sila3TextEl = document.getElementById('mr-sila3-text');
	const sila2VyplnEl = document.getElementById('mr-sila2-vypln');
	const sila3VyplnEl = document.getElementById('mr-sila3-vypln');
	const vsechnyPosuvniky = [
		skupina1Slider, skupina2Slider, skupina3Slider,
		vzdalenost2Slider, vzdalenost3Slider, zdi2Slider, zdi3Slider,
	];

	let skupina1 = 7, skupina2 = 7, skupina3 = 3;
	let vzdalenost2 = 20, vzdalenost3 = 10;
	let zdi2 = 0, zdi3 = 1;
	let zprava = 'AHOJ';

	let bezi = false;
	let start = 0;
	let casovac = null;
	// vysledekN: null = ještě nerozhodnuto (fronta tam nedoletěla), 'ok' = přijato,
	// 'skupina' = signál dorazil silný, ale skupina nesedí, 'slaby' = síla klesla pod PRAH
	let vysledek2 = null;
	let vysledek3 = null;
	let poslednizprava2 = '?';
	let poslednizprava3 = '?';
	let zvyrazneckoVysilacDo = 0;
	let zvyraznecko2Do = 0;
	let zvyraznecko3Do = 0;

	/** Barva pruhu podle síly: nad 60 % zelená, nad prahem oranžová, pod prahem červená. */
	function barvaSily(s) {
		if (s < PRAH) return '#e03131';
		return s >= 60 ? '#2f9e44' : '#f08c00';
	}
	function renderSila() {
		const s2 = pureSila(vzdalenost2, zdi2);
		const s3 = pureSila(vzdalenost3, zdi3);
		sila2TextEl.textContent = String(s2);
		sila3TextEl.textContent = String(s3);
		sila2VyplnEl.style.width = s2 + '%';
		sila3VyplnEl.style.width = s3 + '%';
		sila2VyplnEl.style.background = barvaSily(s2);
		sila3VyplnEl.style.background = barvaSily(s3);
	}
	/** Rozhodne o příjmu: nejdřív skupina, pak síla signálu proti prahu. Čistá funkce. */
	function pureVyhodnotPrijem(skupinaVysilac, skupinaPrijimac, vzdalenost, zdi) {
		if (skupinaPrijimac !== skupinaVysilac) return 'skupina';
		return pureSila(vzdalenost, zdi) >= PRAH ? 'ok' : 'slaby';
	}
	function slovoZdi(n) {
		if (n === 0) return '0 zdí';
		if (n === 1) return '1 zeď';
		if (n <= 4) return `${n} zdi`;
		return `${n} zdí`;
	}

	function radkyVysilac() {
		return [
			'po spuštění',
			`   rádio nastav skupinu ${skupina1}`,
			'když stisknuto tlačítko A',
			`   rádio odešli řetězec „${zprava}“`,
		];
	}
	function radkyPrijimac(skupinaN) {
		return [
			'po spuštění',
			`   rádio nastav skupinu ${skupinaN}`,
			'když rádio přijme řetězec',
			'   ukaž řetězec (přijatý text)',
		];
	}
	function vykresliProgram(olEl, radky, zvyraznitIndexy) {
		olEl.textContent = '';
		radky.forEach((text, i) => {
			const li = document.createElement('li');
			li.textContent = text;
			// hlavička = řádek, který NENÍ odsazený (začátek bloku „po spuštění",
			// „když stisknuto tlačítko A" i „když rádio přijme řetězec" — všechny)
			const jeHlavicka = !text.startsWith('   ');
			if (zvyraznitIndexy.includes(i)) li.className = 'mr-nyni';
			else if (jeHlavicka) li.className = 'mr-hlavicka';
			olEl.appendChild(li);
		});
	}
	function renderBloky() {
		const nyni = Date.now();
		vykresliProgram(olVysilac, radkyVysilac(), nyni < zvyrazneckoVysilacDo ? [3] : []);
		vykresliProgram(ol2, radkyPrijimac(skupina2), nyni < zvyraznecko2Do ? [2, 3] : []);
		vykresliProgram(ol3, radkyPrijimac(skupina3), nyni < zvyraznecko3Do ? [2, 3] : []);
	}

	function renderPozice() {
		deska2.setAttribute('transform', `translate(${boardX(vzdalenost2)},0)`);
		deska3.setAttribute('transform', `translate(${boardX(vzdalenost3)},160)`);
		out1.textContent = String(skupina1);
		out2.textContent = String(skupina2);
		out3.textContent = String(skupina3);
		outV2.textContent = String(vzdalenost2);
		outV3.textContent = String(vzdalenost3);
		outZdi2.textContent = String(zdi2);
		outZdi3.textContent = String(zdi3);
		skupinaVysilacTextEl.textContent = `sk. ${skupina1}`;
		skupina2TextEl.textContent = `sk. ${skupina2}`;
		skupina3TextEl.textContent = `sk. ${skupina3}`;
		obrazVysilacEl.textContent = zprava;
		obraz2El.textContent = poslednizprava2;
		obraz3El.textContent = poslednizprava3;
		obraz2El.setAttribute('fill', vysledek2 === 'ok' ? '#69db7c' : vysledek2 === null ? '#ffd43b' : '#ff8787');
		obraz3El.setAttribute('fill', vysledek3 === 'ok' ? '#69db7c' : vysledek3 === null ? '#ffd43b' : '#ff8787');
		renderSila();
	}

	function popisVysledku(cislo, skupinaN, vzdalenostN, zdiN, vysledek) {
		const sila = pureSila(vzdalenostN, zdiN);
		if (vysledek === 'ok') {
			return `✅ Přijímač ${cislo}: zpráva „${zprava}“ dorazila — skupina ${skupinaN} sedí a síla signálu je ${sila} %.`;
		}
		if (vysledek === 'skupina') {
			return `❌ Přijímač ${cislo}: signál je silný (${sila} %), ale skupina rádia je jiná (${skupinaN} místo ${skupina1}) — zpráva se zahodila.`;
		}
		return `❌ Přijímač ${cislo}: síla signálu klesla na ${sila} % (${vzdalenostN} m, ${slovoZdi(zdiN)}) — pod čitelnou hranicí ${PRAH} %.`;
	}

	function tick() {
		const elapsed = Date.now() - start;
		const fx = pureFrontX(elapsed);
		const op = pureOpacity(elapsed);
		frontEl.setAttribute('x1', String(fx));
		frontEl.setAttribute('x2', String(fx));
		frontEl.setAttribute('opacity', String(op));

		const bx2 = boardX(vzdalenost2);
		const bx3 = boardX(vzdalenost3);
		if (vysledek2 === null && fx >= bx2) {
			vysledek2 = pureVyhodnotPrijem(skupina1, skupina2, vzdalenost2, zdi2);
			poslednizprava2 = vysledek2 === 'ok' ? zprava : '✗';
			if (vysledek2 === 'ok') zvyraznecko2Do = Date.now() + 800;
			ram2El.setAttribute('stroke', vysledek2 === 'ok' ? '#2f9e44' : '#e03131');
			ram2El.setAttribute('stroke-width', '5');
		}
		if (vysledek3 === null && fx >= bx3) {
			vysledek3 = pureVyhodnotPrijem(skupina1, skupina3, vzdalenost3, zdi3);
			poslednizprava3 = vysledek3 === 'ok' ? zprava : '✗';
			if (vysledek3 === 'ok') zvyraznecko3Do = Date.now() + 800;
			ram3El.setAttribute('stroke', vysledek3 === 'ok' ? '#2f9e44' : '#e03131');
			ram3El.setAttribute('stroke-width', '5');
		}

		renderPozice();
		renderBloky();

		if (elapsed >= ANIM_MS + FADE_MS) {
			bezi = false;
			clearInterval(casovac);
			casovac = null;
			vsechnyPosuvniky.forEach((s) => (s.disabled = false));
			document.querySelectorAll('.mr-zprava-tl').forEach((b) => (b.disabled = false));
			btnOdeslat.disabled = false;
			ram2El.setAttribute('stroke-width', '3');
			ram3El.setAttribute('stroke-width', '3');
			ram2El.setAttribute('stroke', '#2b2a26');
			ram3El.setAttribute('stroke', '#2b2a26');
			stavEl.textContent = popisVysledku(1, skupina2, vzdalenost2, zdi2, vysledek2)
				+ '\n' + popisVysledku(2, skupina3, vzdalenost3, zdi3, vysledek3);
		}
	}

	function odeslat() {
		if (bezi) return;
		vysledek2 = null;
		vysledek3 = null;
		poslednizprava2 = '?';
		poslednizprava3 = '?';
		bezi = true;
		start = Date.now();
		zvyrazneckoVysilacDo = start + 400;
		vsechnyPosuvniky.forEach((s) => (s.disabled = true));
		document.querySelectorAll('.mr-zprava-tl').forEach((b) => (b.disabled = true));
		btnOdeslat.disabled = true;
		stavEl.textContent = 'Vysílám zprávu…';
		if (casovac) clearInterval(casovac);
		casovac = setInterval(tick, 50);
		tick();
	}

	btnOdeslat.addEventListener('click', odeslat);

	document.querySelectorAll('.mr-zprava-tl').forEach((tl) => tl.addEventListener('click', () => {
		zprava = tl.dataset.zprava;
		document.querySelectorAll('.mr-zprava-tl').forEach((t) => t.classList.toggle('mr-aktivni', t === tl));
		renderPozice();
	}));

	skupina1Slider.addEventListener('input', () => { skupina1 = +skupina1Slider.value; renderPozice(); renderBloky(); });
	skupina2Slider.addEventListener('input', () => { skupina2 = +skupina2Slider.value; renderPozice(); renderBloky(); });
	skupina3Slider.addEventListener('input', () => { skupina3 = +skupina3Slider.value; renderPozice(); renderBloky(); });
	vzdalenost2Slider.addEventListener('input', () => { vzdalenost2 = +vzdalenost2Slider.value; renderPozice(); });
	vzdalenost3Slider.addEventListener('input', () => { vzdalenost3 = +vzdalenost3Slider.value; renderPozice(); });
	zdi2Slider.addEventListener('input', () => { zdi2 = +zdi2Slider.value; renderPozice(); });
	zdi3Slider.addEventListener('input', () => { zdi3 = +zdi3Slider.value; renderPozice(); });

	renderPozice();
	renderBloky();
	stavEl.textContent = 'Vysílač i Přijímač 1 mají skupinu 7 a silný signál (80 %) — zkus Odeslat. '
		+ 'Přijímač 2 má signál taky silný (75 %), ale jinou skupinu (3) — zprávu nedostane. '
		+ 'Zkus posunout vzdálenost nebo přidat zdi a sleduj, jak síla klesá pod 30 %.';

	// ——— ověřovací háčky ———
	svg.__pureFrontX = pureFrontX;
	svg.__pureOpacity = pureOpacity;
	svg.__pureSila = pureSila;
	svg.__boardX = boardX;
	svg.__DOSAH_M = DOSAH_M;
	svg.__PRAH = PRAH;
	svg.__stav = () => ({ skupina1, skupina2, skupina3, vzdalenost2, vzdalenost3, zdi2, zdi3, vysledek2, vysledek3, zprava });

	// ——— druhá část: piny a externí zařízení ———
	const pinySvg = document.getElementById('mr-piny-svg');
	const pinyDisplej = document.getElementById('mr-piny-displej');
	const pinyStav = document.getElementById('mr-piny-stav');
	const ledPasekEl = document.getElementById('mr-led-pasek');
	const motorRamenoEl = document.getElementById('mr-motor-rameno');
	const cidloHodnotaEl = document.getElementById('mr-cidlo-hodnota');
	const linky = {
		led: document.getElementById('mr-linka-led'),
		motor: document.getElementById('mr-linka-motor'),
		cidlo: document.getElementById('mr-linka-cidlo'),
	};
	const piny = { led: 'P0', motor: 'P1', cidlo: 'P2' };

	let pripojeno = { led: true, motor: false, cidlo: false };
	let testBezi = false;
	let testStart = 0;
	let testCasovac = null;

	function renderZapojeni() {
		document.querySelectorAll('.mr-zar-tl').forEach((tl) => {
			tl.classList.toggle('mr-aktivni', pripojeno[tl.dataset.zarizeni]);
		});
		Object.keys(linky).forEach((k) => linky[k].setAttribute('opacity', pripojeno[k] ? '1' : '0.15'));
	}
	document.querySelectorAll('.mr-zar-tl').forEach((tl) => tl.addEventListener('click', () => {
		const k = tl.dataset.zarizeni;
		pripojeno[k] = !pripojeno[k];
		renderZapojeni();
	}));

	function testTick() {
		const t = Date.now() - testStart;
		if (pripojeno.led) {
			const sviti = Math.floor(t / 150) % 2 === 0;
			ledPasekEl.setAttribute('fill', sviti ? '#ffd43b' : '#495057');
		}
		if (pripojeno.motor) {
			const uhel = Math.min(t / 900, 1) * 180;
			motorRamenoEl.setAttribute('transform', `rotate(${uhel} 300 164)`);
		}
		if (pripojeno.cidlo) {
			// program: přečti vlhkost → ukaž ji na displeji → při suchu ukaž smutný obličej
			if (t < 400) {
				cidloHodnotaEl.textContent = 'měřím…';
				pinyDisplej.textContent = '';
			} else if (t < 800) {
				cidloHodnotaEl.textContent = 'vlhkost: 20 %';
				pinyDisplej.textContent = '20';
			} else {
				cidloHodnotaEl.textContent = '🙁 sucho — zalévej!';
				pinyDisplej.textContent = '🙁';
			}
		}
		if (t >= 1200) {
			testBezi = false;
			clearInterval(testCasovac);
			testCasovac = null;
			const zapojena = Object.keys(pripojeno).filter((k) => pripojeno[k]);
			pinyStav.textContent = zapojena.length
				? `Vyzkoušeno: ${zapojena.map((k) => `${k === 'led' ? 'LED pásek' : k === 'motor' ? 'motorek' : 'čidlo vlhkosti'} na ${piny[k]}`).join(', ')}.`
				: 'Nic není připojené — klikni na zařízení a pak zkus znovu.';
		}
	}
	document.getElementById('mr-btn-vyzkouset').addEventListener('click', () => {
		if (testBezi) return;
		testBezi = true;
		testStart = Date.now();
		pinyDisplej.textContent = '';
		if (testCasovac) clearInterval(testCasovac);
		testCasovac = setInterval(testTick, 50);
		testTick();
	});

	renderZapojeni();
	pinySvg.__stavPinu = () => ({ pripojeno });
</script>

<style>
	#mr-svg, #mr-piny-svg {
		width: 100%;
		max-width: 920px;
		border: 3px solid #2b2a26;
		border-radius: 12px;
		background: #f8f9fa;
	}
	.mr-ovladani {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0.8rem 0;
	}
	.mr-panel {
		flex: 1 1 220px;
		border: 3px solid #2b2a26;
		border-radius: 12px;
		padding: 0.6rem 0.8rem;
		background: #fff;
	}
	.mr-panel h3 { margin: 0 0 0.4rem; font-size: 1rem; }
	.mr-panel label { display: block; font-weight: 700; margin: 0.4rem 0; }
	.mr-panel input[type='range'] { width: 100%; }
	.mr-zpravy-label { font-weight: 700; margin: 0.5rem 0 0.2rem; }
	.mr-zpravy { display: flex; flex-wrap: wrap; gap: 0.3rem; }
	.mr-sila-radek { font-weight: 700; margin: 0.5rem 0 0.2rem; }
	.mr-sila-bar { width: 100%; height: 14px; background: #e9ecef; border: 2px solid #2b2a26; border-radius: 7px; overflow: hidden; }
	.mr-sila-vypln { height: 100%; width: 0%; background: #2f9e44; transition: width 0.15s ease; }
	.mr-tl {
		font: inherit;
		font-weight: 700;
		padding: 0.25rem 0.8rem;
		border: 3px solid #2b2a26;
		border-radius: 10px;
		background: #fff;
		cursor: pointer;
		margin: 0 0.3rem 0.3rem 0;
	}
	.mr-tl.mr-aktivni { background: #ffe8cc; }
	.mr-tl:active { transform: translateY(1px); }
	.mr-tl[disabled] { opacity: 0.45; cursor: default; }
	.mr-odeslat { background: #d3f9d8; margin-top: 0.5rem; }
	.mr-vyzkouset { background: #d3f9d8; }
	.mr-programy {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0.8rem 0;
	}
	.mr-program {
		flex: 1 1 220px;
		background: #fff;
		border: 3px solid #2b2a26;
		border-radius: 12px;
		padding: 0.5rem 0.8rem;
	}
	.mr-program h4 { margin: 0 0 0.3rem; font-size: 0.95rem; }
	.mr-program ol { margin: 0; padding-left: 1.2rem; list-style: none; font-family: ui-monospace, monospace; white-space: pre; font-size: 0.85rem; }
	.mr-program li { font-weight: 700; padding: 0.1rem 0.3rem; border-radius: 6px; }
	.mr-program li.mr-hlavicka { color: #1971c2; }
	.mr-program li.mr-nyni { background: #fff3bf; outline: 2px dashed #f08c00; }
	.mr-stav { font-size: 1.02rem; font-weight: 700; min-height: 2.6rem; white-space: pre-line; color: #2b2a26; }
	.mr-oddil { border: none; border-top: 3px dashed #ced4da; margin: 1.4rem 0; }
	.mr-radek { margin: 0.5rem 0; }
</style>
