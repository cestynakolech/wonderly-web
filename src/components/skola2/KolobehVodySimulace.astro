---
// Koloběh vody (F8, skupenske-zmeny-vody-v-prirode): motorem je Slunce.
//
// Hlavní myšlenka je ta, kterou výklad označuje jako běžný omyl: voda se
// v koloběhu NESPOTŘEBOVÁVÁ ani nevyrábí. Proto se ve scéně počítá pořád
// týchž 100 dílů vody a posuvník Slunce je jen PŘESOUVÁ mezi mořem, vzduchem
// a ledem — součet zůstává 100 při každém nastavení.
//
// Bez Slunce se koloběh zastaví (voda zůstane ležet v moři a ledu), se sílícím
// Sluncem přibývá vody ve vzduchu a ledovce tají. Všechna čísla jsou celá.
// Kreslí se staticky, bez animací.
---

<section class="ramecek simulace">
	<h2><span class="podtrh">Koloběh vody — co ho pohání? 🕹️</span></h2>
	<p>Posuň <strong>Slunce</strong> a sleduj, kam se voda přestěhuje. Pozor na jednu věc: <strong>vody je pořád stejně</strong> — jen se přelévá mezi mořem, vzduchem a ledem.</p>
	<svg id="kol-svg" viewBox="0 0 660 470" role="img" aria-label="Koloběh vody v přírodě">
		<rect x="0" y="0" width="660" height="470" fill="#e7f5ff" />
		<!-- slunce -->
		<circle id="kol-slunce" cx="580" cy="60" r="30" fill="#ffd43b" stroke="#2b2a26" stroke-width="3" />
		<g id="kol-paprsky"></g>
		<!-- oblak (velikost podle vody ve vzduchu) -->
		<g id="kol-oblak"></g>
		<!-- hora s ledovcem -->
		<polygon points="400,330 500,150 600,330" fill="#dee2e6" stroke="#2b2a26" stroke-width="3" />
		<polygon id="kol-ledovec" points="500,150 470,204 530,204" fill="#fff" stroke="#2b2a26" stroke-width="2" />
		<!-- moře -->
		<rect x="0" y="330" width="660" height="70" fill="#4dabf7" stroke="#2b2a26" stroke-width="3" />
		<text x="120" y="372" font-size="15" font-weight="bold" fill="#fff">moře</text>
		<!-- šipky koloběhu (kreslí skript) -->
		<g id="kol-sipky"></g>
		<!-- počitadlo dílů -->
		<g id="kol-pocty" font-size="14" font-weight="bold" fill="#2b2a26"></g>
	</svg>
	<label class="sim-posuvnik">
		Síla Slunce: <output id="kol-out"></output>
		<input type="range" id="kol-slider" min="0" max="4" step="1" value="2" />
	</label>
	<p class="kol-vzorec" id="kol-vypocet"></p>
	<p class="kol-stav" id="kol-stav"></p>
</section>

<script>
	const CELKEM = 100;   // dílů vody — číslo, které se NIKDY nesmí změnit
	const slider = document.getElementById('kol-slider');
	const svg = document.getElementById('kol-svg');

	// ČISTÁ FUNKCE: kam se 100 dílů vody rozdělí při dané síle Slunce.
	// Slunce vodu jen PŘESOUVÁ — proto se součet vždy rovná CELKEM.
	function rozdeleni(slunce) {
		const vzduch = slunce * 2;          // víc slunce = víc vypařování
		const led = 14 - slunce * 3;        // a ledovce zároveň tají
		return { more: CELKEM - vzduch - led, vzduch, led };
	}
	svg.__rozdeleni = rozdeleni;
	svg.__celkem = CELKEM;

	// Skloňování: 1 díl · 2–4 díly · 0 a 5 a víc dílů. Bez toho scéna psala
	// „ve vzduchu: 4 dílů“ — chyba, které si žák všimne dřív než učiva.
	function dilu(n) {
		if (n === 1) return '1 díl';
		if (n >= 2 && n <= 4) return `${n} díly`;
		return `${n} dílů`;
	}
	svg.__dilu = dilu;

	function prekresli() {
		const s = +slider.value;
		const d = rozdeleni(s);
		document.getElementById('kol-out').textContent = ['žádné (noc)', 'slabé', 'střední', 'silné', 'nejsilnější'][s];

		// slunce: čím silnější, tím delší paprsky (při nule žádné)
		let p = '';
		for (let i = 0; i < 8 && s > 0; i++) {
			const uhel = (i * Math.PI) / 4;
			const od = 34, do_ = 34 + s * 6;
			p += `<line x1="${580 + Math.cos(uhel) * od}" y1="${60 + Math.sin(uhel) * od}"`
				+ ` x2="${580 + Math.cos(uhel) * do_}" y2="${60 + Math.sin(uhel) * do_}" stroke="#f59f00" stroke-width="3" />`;
		}
		document.getElementById('kol-paprsky').innerHTML = p;
		document.getElementById('kol-slunce').setAttribute('fill', s === 0 ? '#adb5bd' : '#ffd43b');

		// oblak: roste s vodou ve vzduchu; bez vody žádný
		const r = d.vzduch * 5;
		document.getElementById('kol-oblak').innerHTML = d.vzduch === 0 ? ''
			: `<ellipse cx="300" cy="128" rx="${r + 30}" ry="${r / 2 + 18}" fill="#f8f9fa" stroke="#2b2a26" stroke-width="3" />`
			+ `<ellipse cx="${256 - r / 4}" cy="142" rx="${r / 2 + 22}" ry="${r / 3 + 14}" fill="#f8f9fa" stroke="#2b2a26" stroke-width="3" />`
			+ `<text x="322" y="132" text-anchor="middle" font-size="13" font-weight="bold" fill="#2b2a26">oblak</text>`;

		// ledovec: taje se sílícím Sluncem (výška podle dílů ledu)
		const v = d.led * 4;
		document.getElementById('kol-ledovec').setAttribute('points',
			d.led === 0 ? '500,150 500,150 500,150' : `500,150 ${500 - v},${150 + v} ${500 + v},${150 + v}`);

		// šipky koloběhu — jen tam, kde se opravdu něco děje
		let sip = '';
		if (s > 0) {
			sip += '<path d="M150 330 L190 172" fill="none" stroke="#2b2a26" stroke-width="3" />'
				+ '<polygon points="188,160 178,176 194,180" fill="#2b2a26" />'
				+ '<text x="60" y="250" font-size="13" fill="#2b2a26">vypařování ↑</text>'
				+ '<text x="60" y="268" font-size="11" fill="#e8590c">spotřebuje teplo</text>';
			sip += '<path d="M360 168 L440 300" fill="none" stroke="#1971c2" stroke-width="3" />'
				+ '<polygon points="446,312 430,302 442,294" fill="#1971c2" />'
				+ '<text x="352" y="240" text-anchor="end" font-size="13" fill="#1971c2">srážky ↓</text>';
			sip += '<text x="300" y="86" text-anchor="middle" font-size="12" fill="#2f9e44">kondenzace: teplo se zase uvolní</text>';
		}
		if (d.led < 14) {
			sip += '<path d="M520 322 L300 328" fill="none" stroke="#1971c2" stroke-width="3" />'
				+ '<polygon points="292,329 308,320 309,334" fill="#1971c2" />'
				+ '<text x="330" y="352" font-size="12" fill="#fff">odtok řekou zpátky do moře</text>';
		}
		document.getElementById('kol-sipky').innerHTML = sip;

		// počitadlo: součet musí být vidět, o něj tu jde
		document.getElementById('kol-pocty').innerHTML =
			`<rect x="14" y="406" width="632" height="52" rx="8" fill="#fff" stroke="#2b2a26" stroke-width="3" />`
			+ `<text x="28" y="428">v moři: ${dilu(d.more)}</text>`
			+ `<text x="200" y="428">ve vzduchu: ${dilu(d.vzduch)}</text>`
			+ `<text x="392" y="428">v ledu a řekách: ${dilu(d.led)}</text>`
			+ `<text x="28" y="450" font-size="13" fill="#2f9e44">a dohromady pořád ${dilu(d.more + d.vzduch + d.led)} — Slunce vodu jen přestěhuje, nespotřebuje</text>`;

		document.getElementById('kol-vypocet').innerHTML =
			`${d.more} + ${d.vzduch} + ${d.led} = <strong>${d.more + d.vzduch + d.led} dílů</strong>. `
			+ 'Ať Sluncem hýbeš jakkoli, tohle číslo se nezmění — voda se v koloběhu nespotřebovává ani nevyrábí.';

		const stav = document.getElementById('kol-stav');
		if (s === 0) {
			stav.textContent = '🌙 Bez Slunce se koloběh zastaví: nic se nevypařuje, oblak není a voda jen leží v moři a v ledu. Slunce je motorem celého koloběhu — přidej ho posuvníkem.';
		} else if (s === 4) {
			stav.textContent = `☀️ Nejsilnější Slunce: ve vzduchu je ${dilu(d.vzduch)} vody, oblak je největší a z ledovce zbyly ${dilu(d.led)}. Voda s sebou stěhuje i energii — nabere ji nad teplým mořem a při vzniku oblaku ji zase odevzdá.`;
		} else {
			stav.textContent = `☀️ Slunce vypařuje vodu z moře, ve výšce se ochladí a zkondenzuje v oblak (${dilu(d.vzduch)}). Spadne jako srážky a řekou se vrátí zpátky do moře. V moři je teď ${dilu(d.more)}.`;
		}
	}

	slider.addEventListener('input', prekresli);
	prekresli();
</script>

<style>
	#kol-svg { width: 100%; max-width: 660px; border: 3px solid #2b2a26; border-radius: 12px; background: #e7f5ff; }
	.sim-posuvnik { display: block; font-weight: 700; margin: 0.7rem 0; }
	.sim-posuvnik input { width: 100%; max-width: 660px; display: block; margin-top: 0.3rem; }
	.kol-stav { font-size: 1.05rem; font-weight: 700; min-height: 1.6rem; }
	.kol-vzorec { font-size: 0.95rem; background: #f1f3f5; border-radius: 8px; padding: 0.5rem 0.7rem; }
</style>
